{
  "buildCommand": "bash scripts/vercel-build.sh",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] || [ \"${VERCEL_GIT_COMMIT_MESSAGE#\"[release]\"}\" = \"$VERCEL_GIT_COMMIT_MESSAGE\" ]",
  "rewrites": [
    {
      "source": "/api/manifest/:path*",
      "destination": "/api/manifest?p=:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
