# .ralph.env — project-specific config sourced by loop.sh before each iteration.
# Values are injected into the PROMPT_*.md templates via envsubst, so you edit
# this file once instead of hand-editing every prompt. Copy it to your project
# root and fill in the values below.

# Human-readable name of the project under construction.
PROJECT_NAME="capsule"

# Which CLI drives the loop. One of: claude (default), amp, codex, opencode.
# loop.sh maps this to each provider's headless/output/model flags, so you can
# swap the underlying LLM tool without editing the PROMPT_*.md templates.
RALPH_CLI="claude"

# Validation commands the agent runs to verify its work.
# capsule: vitest is the test gate; typecheck + prettier are the lint gate.
# BUILD_CMD is `bunx vite build` on purpose — `bun run build` runs
# scripts/vercel-build.sh, which DEPLOYS Convex and must never run in a loop.
TEST_CMD="bun run test"
LINT_CMD="bun run typecheck && bun run format:check"
BUILD_CMD="bunx vite build"

# Claude model per tier (any id accepted by `claude --model`). This three-tier
# convention lets you spend big only where it pays off — set each independently:
#   MODEL_PLAN   — deep reasoning: planning synthesis & analysis subagents.
#   MODEL_BUILD  — implementation: top-level build agent + the build/test subagent.
#   MODEL_REVIEW — high-volume read/search fan-out & acceptance-test review.
#                  Set to 'haiku' to cut cost on grep-style read subagents while
#                  keeping MODEL_PLAN on 'opus' for the single synthesis step.
# capsule on the GLM Coding Plan (Z.ai): opus and sonnet both remap to
# glm-5.3[1m], haiku remaps to glm-5.3-flash[1m] (see
# ~/.claude/switch-claude-profile.sh). Zero Anthropic quota.
MODEL_PLAN="opus"
MODEL_BUILD="opus"
MODEL_REVIEW="haiku"

# Optional: route the loop through an alternate provider profile defined in
# ~/.claude/switch-claude-profile.sh (claude | glm | minimax). The profile
# exports ANTHROPIC_BASE_URL/AUTH_TOKEN and remaps the opus/sonnet/haiku model
# aliases, so the MODEL_* values above keep working unchanged. Empty/absent =
# your default claude subscription.
RALPH_PROFILE="glm"

# Subagent fan-out caps injected into the prompts via envsubst. Lower these if
# your team hits API rate limits — e.g. RALPH_MAX_READ_AGENTS=50 throttles the
# read/search fan-out without hand-editing the prompt files.
#   RALPH_MAX_READ_AGENTS  — parallel read/search/review subagents (grep-style fan-out).
#   RALPH_MAX_BUILD_AGENTS — concurrent build/test subagents (keep low; backpressure is serial).
# capsule is a large repo but specs/ralph is small; 50 read agents covers it
# without a 250-agent stampede against the API.
RALPH_MAX_READ_AGENTS=50
RALPH_MAX_BUILD_AGENTS=1
