// Capsule procurement trigger — PurchaseNeed: the governed purchasing-order
// line emitted when an event or its prep list (IngredientDemand) is confirmed.
// User directive 2026-07-15: "when a prep list or event is confirmed it emits
// a purchasing order for the inventory of the dishes on the event". Vendor
// grouping stays a human procurement step (VendorOrder.open + addLine) because
// Ingredient carries no vendor linkage; needs link the resulting order lines
// back to the demand that caused them (product definition § 3).
// Compile chain: order.manifest → this file → production/task.manifest.

use "./order.manifest"

enum PurchaseNeedStatus {
  open
  ordered
  fulfilled
  cancelled
}

// One purchase need per confirmed IngredientDemand (OD018 resolved by user
// directive). Created by reaction, never by a user form.
entity PurchaseNeed mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  unique [tenantId, ingredientDemandId]
  timestamps
  versionProperty version: number

  property required eventId: uuid
  property required ingredientDemandId: uuid
  property required ingredientId: uuid
  property preferredVendorId: uuid?
  property required requiredQuantity: decimal(12, 4) = 0
  property required unit: UnitOfMeasure = "each"
  property purchasingWeekStart: datetime?
  property vendorOrderId: uuid?
  property vendorOrderLineId: uuid?
  property required status: PurchaseNeedStatus = "open"
  property openedAt: datetime?
  property orderedAt: datetime?
  property fulfilledAt: datetime?
  property cancelledAt: datetime?
  property cancellationReason: string?

  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]
  belongsTo ingredientDemand: IngredientDemand fields [tenantId, ingredientDemandId] references [tenantId, id]
  belongsTo ingredient: Ingredient fields [tenantId, ingredientId] references [tenantId, id]
  ref preferredVendor: Vendor fields [tenantId, preferredVendorId] references [tenantId, id]
  ref vendorOrder: VendorOrder fields [tenantId, vendorOrderId] references [tenantId, id]
  ref vendorOrderLine: VendorOrderLine fields [tenantId, vendorOrderLineId] references [tenantId, id]

  constraint needQuantityPositive: self.openedAt == null or self.requiredQuantity > 0 "Required quantity must be positive once opened"

  transition status from "open" to ["ordered", "cancelled"]
  transition status from "ordered" to ["fulfilled", "cancelled"]
  transition status from "fulfilled" to []
  transition status from "cancelled" to []

  // manageAccess: Event.approve (event_manager) foreach-creates PurchaseNeed;
  // inventoryAccess: purchasing staff. Do not invent a specialty "approve-only" cap.
  default policy purchaseNeedRead read: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "manageAccess") "Inventory staff and managers may read purchase needs"
  default policy purchaseNeedWrite write: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "manageAccess") "Inventory staff and managers may write purchase needs through commands"
  default policy purchaseNeedExecute execute: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "manageAccess") "Inventory staff and managers may execute purchase need commands"

  // Reserved runtime create name — required for the reaction-wired create path
  // (semantics.md § Manual parent id on create; PROMPT trap 3 correction).
  // Same-named params seed the bootstrap INSERT.
  command create(
    eventId: uuid,
    ingredientDemandId: uuid,
    ingredientId: uuid,
    requiredQuantity: decimal(12, 4),
    unit: UnitOfMeasure,
    optional purchasingWeekStart: datetime,
    optional preferredVendorId: uuid
  ) {
    guard self.openedAt == null
    guard self.deletedAt == null
    constraint createNeedQuantityPositive: requiredQuantity > 0 "Required quantity must be positive"
    // Full event requirement — weekly line applies on-hand once across consolidated needs.
    mutate requiredQuantity = requiredQuantity
    mutate purchasingWeekStart = purchasingWeekStart
    mutate preferredVendorId = preferredVendorId
    mutate openedAt = now()
    emit PurchaseNeedOpened {
      purchaseNeedId: self.id
      tenantId: self.tenantId
      eventId: eventId
      ingredientDemandId: ingredientDemandId
      ingredientId: ingredientId
      preferredVendorId: preferredVendorId
      requiredQuantity: requiredQuantity
      unit: unit
      purchasingWeekStart: purchasingWeekStart
      status: "open"
    }
  }

  command markOrdered(vendorOrderId: uuid, vendorOrderLineId: uuid) {
    guard self.status == "open"
    guard self.openedAt != null
    guard self.deletedAt == null
    compute previousStatus = self.status
    mutate vendorOrderId = vendorOrderId
    mutate vendorOrderLineId = vendorOrderLineId
    mutate status = "ordered"
    mutate orderedAt = now()
    emit PurchaseNeedOrdered {
      purchaseNeedId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      ingredientDemandId: self.ingredientDemandId
      ingredientId: self.ingredientId
      vendorOrderId: vendorOrderId
      vendorOrderLineId: vendorOrderLineId
      previousStatus: previousStatus
      status: "ordered"
    }
  }

  // A range-generated draft links each contributing demand to its combined
  // order line but deliberately leaves it open until the buyer submits.
  command assignToDraft(vendorOrderId: uuid, vendorOrderLineId: uuid) {
    guard self.status == "open"
    guard self.openedAt != null
    guard self.deletedAt == null
    // Idempotent: same draft line re-assign is a no-op; different line is blocked.
    guard self.vendorOrderId == null or (self.vendorOrderId == vendorOrderId and self.vendorOrderLineId == vendorOrderLineId)
    guard self.vendorOrderLineId == null or self.vendorOrderLineId == vendorOrderLineId
    mutate vendorOrderId = vendorOrderId
    mutate vendorOrderLineId = vendorOrderLineId
    emit PurchaseNeedDraftAssigned {
      purchaseNeedId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      ingredientDemandId: self.ingredientDemandId
      ingredientId: self.ingredientId
      vendorOrderId: vendorOrderId
      vendorOrderLineId: vendorOrderLineId
      status: "open"
    }
  }

  // Post-approve demand reconcile: revise open need quantity; weekly line re-ensures.
  command reviseRequired(requiredQuantity: decimal(12, 4)) {
    guard self.status == "open"
    guard self.openedAt != null
    guard self.deletedAt == null
    constraint reviseNeedQuantityPositive: requiredQuantity > 0 "Required quantity must be positive"
    mutate requiredQuantity = requiredQuantity
    emit PurchaseNeedOpened {
      purchaseNeedId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      ingredientDemandId: self.ingredientDemandId
      ingredientId: self.ingredientId
      preferredVendorId: self.preferredVendorId
      requiredQuantity: requiredQuantity
      unit: self.unit
      purchasingWeekStart: self.purchasingWeekStart
      status: "open"
    }
  }

  command markDraftOrdered() {
    guard self.status == "open"
    guard self.openedAt != null
    guard self.deletedAt == null
    guard self.vendorOrderId != null and self.vendorOrderLineId != null
    guard self.vendorOrder != null and self.vendorOrder.status == "submitted"
    compute previousStatus = self.status
    mutate status = "ordered"
    mutate orderedAt = now()
    emit PurchaseNeedOrdered {
      purchaseNeedId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      ingredientDemandId: self.ingredientDemandId
      ingredientId: self.ingredientId
      vendorOrderId: self.vendorOrderId
      vendorOrderLineId: self.vendorOrderLineId
      previousStatus: previousStatus
      status: "ordered"
    }
  }

  // Receiving automation stays deferred (OD019); fulfilment is an explicit
  // procurement acknowledgement until line-received targeting is product-defined.
  command markFulfilled() {
    guard self.status == "ordered"
    guard self.orderedAt != null
    guard self.deletedAt == null
    compute previousStatus = self.status
    mutate status = "fulfilled"
    mutate fulfilledAt = now()
    emit PurchaseNeedFulfilled {
      purchaseNeedId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      ingredientDemandId: self.ingredientDemandId
      ingredientId: self.ingredientId
      previousStatus: previousStatus
      status: "fulfilled"
    }
  }

  command cancel(reason: string) {
    guard self.status == "open" or self.status == "ordered"
    guard self.deletedAt == null
    guard roleAllows(user.role, "inventoryManageAccess")
    constraint cancelNeedReason: length(trim(reason)) > 0 "Cancellation reason is required"
    compute previousStatus = self.status
    mutate status = "cancelled"
    mutate cancelledAt = now()
    mutate cancellationReason = reason
    emit PurchaseNeedCancelled {
      purchaseNeedId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      ingredientDemandId: self.ingredientDemandId
      ingredientId: self.ingredientId
      previousStatus: previousStatus
      status: "cancelled"
      reason: reason
    }
  }

  store PurchaseNeed in durable
}

event PurchaseNeedOpened: "purchase_need.opened" {
  purchaseNeedId: string
  tenantId: string
  eventId: string
  ingredientDemandId: string
  ingredientId: string
  preferredVendorId: string?
  requiredQuantity: decimal(12, 4)
  unit: UnitOfMeasure
  purchasingWeekStart: datetime?
  status: PurchaseNeedStatus
}

event PurchaseNeedOrdered: "purchase_need.ordered" {
  purchaseNeedId: string
  tenantId: string
  eventId: string
  ingredientDemandId: string
  ingredientId: string
  vendorOrderId: string
  vendorOrderLineId: string
  previousStatus: PurchaseNeedStatus
  status: PurchaseNeedStatus
}

event PurchaseNeedDraftAssigned: "purchase_need.draft_assigned" {
  purchaseNeedId: string
  tenantId: string
  eventId: string
  ingredientDemandId: string
  ingredientId: string
  vendorOrderId: string
  vendorOrderLineId: string
  status: PurchaseNeedStatus
}

event PurchaseNeedFulfilled: "purchase_need.fulfilled" {
  purchaseNeedId: string
  tenantId: string
  eventId: string
  ingredientDemandId: string
  ingredientId: string
  previousStatus: PurchaseNeedStatus
  status: PurchaseNeedStatus
}

event PurchaseNeedCancelled: "purchase_need.cancelled" {
  purchaseNeedId: string
  tenantId: string
  eventId: string
  ingredientDemandId: string
  ingredientId: string
  previousStatus: PurchaseNeedStatus
  status: PurchaseNeedStatus
  reason: string
}

// ---------------------------------------------------------------------------
// Event approve / confirmation → purchasing-order flow.
// ---------------------------------------------------------------------------

// Compat first: restore purchaseEligibleEventId on calculated rows that predate
// the field (or lost it). Soft mutate — must stay BEFORE PurchaseNeed.create so
// the create fanOut can see repaired eligibility in the same approve transaction.
on EventApproved fanOut IngredientDemand where eventId = payload.eventId
  run IngredientDemand.ensurePurchaseEligible

// Event.approve → foreach-create PurchaseNeed for calculated demands that are
// still purchase-eligible (Manifest ≥3.6.36 cross-entity fanOut). Matching on
// purchaseEligibleEventId (not bare eventId) skips pending/superseded/already
// released rows so a guard failure cannot roll back approve.
// markReleased is chained from PurchaseNeedOpened (not a second EventApproved
// fanOut) so projection reaction order cannot clear eligibility before create.
on EventApproved fanOut IngredientDemand where purchaseEligibleEventId = payload.eventId
  run PurchaseNeed.create
  params {
    eventId: self.eventId
    ingredientDemandId: self.id
    ingredientId: self.ingredientId
    requiredQuantity: self.requiredQuantity
    unit: self.unit
    purchasingWeekStart: self.purchasingWeekStart
    preferredVendorId: self.preferredVendorId
  }

on PurchaseNeedOpened run IngredientDemand.markReleased
  resolve payload.ingredientDemandId

// Manual Demand Ledger confirm (before approve) still opens a purchase need.
// `resolve null` is the reaction-wired create path (null instanceId → create).
on IngredientDemandConfirmed run PurchaseNeed.create
  resolve null
  params {
    eventId: payload.eventId,
    ingredientDemandId: payload.ingredientDemandId,
    ingredientId: payload.ingredientId,
    preferredVendorId: payload.preferredVendorId,
    requiredQuantity: payload.requiredQuantity,
    unit: payload.unit
  }

// A range-generated order keeps its linked needs open while it is a draft.
// Submission, not line creation, is the point at which procurement is ordered.
on VendorOrderSubmitted fanOut PurchaseNeed where vendorOrderId = payload.vendorOrderId
  run markDraftOrdered

// Event cancellation stops open purchasing work (product definition § 3 /
// interconnection requirements: cancellation stops inappropriate downstream work).
on EventCancelled fanOut PurchaseNeed where eventId = payload.eventId
  run cancel
  params { reason: payload.reason }
