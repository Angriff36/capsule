// Capsule procurement — vendor orders, line receiving, and confirmed price facts.
// PurchaseNeed is authored in purchase-need.manifest. Line receipts remain the
// quantity-changing command; each receipt also creates an immutable ingredient /
// vendor price observation for costing and trend views.
// Compile entry: uses vendor → demand → stock → culinary → operations.

use "./vendor.manifest"

enum VendorOrderStatus {
  draft
  pending_approval
  submitted
  confirmed
  partially_received
  received
  cancelled
}

enum VendorOrderLineStatus {
  pending
  added
  receiving
  complete
  cancelled
}

// Order to one Vendor (capsule-pro PurchaseOrder). Totals are money facts;
// line receiving emits stock-update payloads for a later InventoryItem reaction.
entity VendorOrder mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required vendorId: uuid
  property eventId: uuid?
  property sourceRangeStart: datetime?
  property sourceRangeEnd: datetime?
  property orderNumber: string?
  property required subtotal: money(12, 2) = 0
  property required taxAmount: money(12, 2) = 0
  property required shippingAmount: money(12, 2) = 0
  property required totalAmount: money(12, 2) = 0
  property notes: string?
  property required status: VendorOrderStatus = "draft"
  property openedAt: datetime?
  property submittedAt: datetime?
  property confirmedAt: datetime?
  property receivedAt: datetime?
  property cancelledAt: datetime?
  property cancellationReason: string?
  property approvalRequestedAt: datetime?
  property approvedAt: datetime?
  property approvalNotes: string?

  belongsTo vendor: Vendor fields [tenantId, vendorId] references [tenantId, id]
  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]
  // Tenant-singleton purchasing config (unique [tenantId]) — supplies the
  // spend-approval threshold to submit-time checks.
  belongsTo purchasingConfig: WeeklyPurchasingConfig fields [tenantId] references [tenantId]
  hasMany lines: VendorOrderLine

  // Workflow flags for VendorOrderPage action routing. Current derived state
  // only — status / timestamps stay persisted. Spend-approval vs threshold
  // still needs tenant-singleton purchasingConfig hydrate (purchasingConfigId
  // is not populated today); UI keeps that comparison until Manifest pins it.
  computed isDraft: boolean = self.status == "draft"
  computed isPendingApproval: boolean = self.status == "pending_approval"
  computed isOpenForReceiving: boolean = self.status == "confirmed" or self.status == "partially_received"
  // Raw child status fields via count_of — not child computeds (parent rollup limitation).
  computed hasIncompleteLines: boolean = count_of(self.lines, (line) => line.deletedAt == null and line.status != "cancelled" and line.status != "complete") > 0

  constraint orderMoneyNonnegative: self.subtotal >= 0 and self.taxAmount >= 0 and self.shippingAmount >= 0 and self.totalAmount >= 0 "Order money amounts cannot be negative"
  constraint orderSourceRangeComplete: (self.sourceRangeStart == null and self.sourceRangeEnd == null) or (self.sourceRangeStart != null and self.sourceRangeEnd != null) "Order source range requires both a start and end"
  constraint orderSourceRangeOrdered: self.sourceRangeStart == null or self.sourceRangeEnd == null or self.sourceRangeStart <= self.sourceRangeEnd "Order source range end must not precede its start"

  transition status from "draft" to ["submitted", "pending_approval", "cancelled"]
  transition status from "pending_approval" to ["submitted", "draft", "cancelled"]
  transition status from "submitted" to ["confirmed", "cancelled"]
  transition status from "confirmed" to ["partially_received", "received", "cancelled"]
  transition status from "partially_received" to ["received", "cancelled"]
  transition status from "received" to []
  transition status from "cancelled" to []

  // manageAccess: Event.approve reaction chain ensures the weekly DRAFT.
  // procurementAccess: day-to-day purchasing. Submit stays a buyer action.
  default policy vendorOrderRead read: roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Procurement and managers may read vendor orders"
  default policy vendorOrderWrite write: roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Procurement and managers may write vendor orders through commands"
  default policy vendorOrderExecute execute: roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Procurement and managers may execute vendor order commands"

  command open(
    vendorId: uuid,
    optional eventId: uuid,
    optional sourceRangeStart: datetime,
    optional sourceRangeEnd: datetime,
    optional orderNumber: string,
    optional notes: string
  ) {
    guard self.openedAt == null
    guard self.status == "draft"
    guard self.deletedAt == null
    guard self.vendor != null and self.vendor.status == "active" and self.vendor.onboardedAt != null
    constraint openVendorMatch: vendorId == self.vendorId "Open vendorId must match the seeded vendor reference"
    constraint openEventMatch: eventId == null or self.eventId == null or eventId == self.eventId "Open eventId must match the seeded event reference when provided"
    constraint openSourceRangeComplete: (sourceRangeStart == null and sourceRangeEnd == null) or (sourceRangeStart != null and sourceRangeEnd != null) "Open source range requires both a start and end"
    constraint openSourceRangeOrdered: sourceRangeStart == null or sourceRangeEnd == null or sourceRangeStart <= sourceRangeEnd "Open source range end must not precede its start"
    mutate vendorId = vendorId
    mutate eventId = eventId != null ? eventId : self.eventId
    mutate sourceRangeStart = sourceRangeStart != null ? sourceRangeStart : self.sourceRangeStart
    mutate sourceRangeEnd = sourceRangeEnd != null ? sourceRangeEnd : self.sourceRangeEnd
    mutate orderNumber = orderNumber
    mutate notes = notes
    mutate openedAt = now()
    emit VendorOrderOpened {
      vendorOrderId: self.id
      tenantId: self.tenantId
      vendorId: vendorId
      eventId: eventId != null ? eventId : self.eventId
      sourceRangeStart: sourceRangeStart != null ? sourceRangeStart : self.sourceRangeStart
      sourceRangeEnd: sourceRangeEnd != null ? sourceRangeEnd : self.sourceRangeEnd
      orderNumber: orderNumber
      status: "draft"
    }
  }

  // Manifest weekly draft ensure (match else create from PurchaseNeedReadyForWeeklyDraft).
  command ensureWeeklyDraft(
    vendorId: uuid,
    sourceRangeStart: datetime,
    sourceRangeEnd: datetime,
    purchaseNeedId: uuid,
    ingredientDemandId: uuid,
    ingredientId: uuid,
    requiredQuantity: decimal(12, 4),
    unit: UnitOfMeasure
  ) {
    guard self.deletedAt == null
    guard self.status == "draft"
    guard self.vendor != null and self.vendor.status == "active" and self.vendor.onboardedAt != null
    mutate vendorId = vendorId
    mutate sourceRangeStart = sourceRangeStart
    mutate sourceRangeEnd = sourceRangeEnd
    mutate openedAt = self.openedAt == null ? now() : self.openedAt
    emit VendorOrderWeeklyDraftEnsured {
      vendorOrderId: self.id
      tenantId: self.tenantId
      vendorId: vendorId
      purchasingWeekStart: sourceRangeStart
      purchaseNeedId: purchaseNeedId
      ingredientDemandId: ingredientDemandId
      ingredientId: ingredientId
      requiredQuantity: requiredQuantity
      unit: unit
    }
  }

  command updateTotals(
    subtotal: money(12, 2),
    taxAmount: money(12, 2),
    shippingAmount: money(12, 2)
  ) {
    guard self.openedAt != null
    guard self.status == "draft" or self.status == "submitted"
    guard self.deletedAt == null
    constraint totalsNonnegative: subtotal >= 0 and taxAmount >= 0 and shippingAmount >= 0 "Order money amounts cannot be negative"
    compute previousTotal = self.totalAmount
    compute nextTotal = subtotal + taxAmount + shippingAmount
    mutate subtotal = subtotal
    mutate taxAmount = taxAmount
    mutate shippingAmount = shippingAmount
    mutate totalAmount = nextTotal
    emit VendorOrderTotalsUpdated {
      vendorOrderId: self.id
      tenantId: self.tenantId
      vendorId: self.vendorId
      eventId: self.eventId
      previousTotalAmount: previousTotal
      subtotal: subtotal
      taxAmount: taxAmount
      shippingAmount: shippingAmount
      totalAmount: nextTotal
    }
  }

  command submit() {
    guard self.openedAt != null
    guard self.status == "draft"
    guard self.deletedAt == null
    constraint submitUnderApprovalThreshold: self.purchasingConfig == null or self.purchasingConfig.orderApprovalThresholdAmount == null or self.totalAmount <= self.purchasingConfig.orderApprovalThresholdAmount "Orders above the spend approval threshold need manager approval — use submit for approval"
    compute previousStatus = self.status
    mutate status = "submitted"
    mutate submittedAt = now()
    emit VendorOrderSubmitted {
      vendorOrderId: self.id
      tenantId: self.tenantId
      vendorId: self.vendorId
      eventId: self.eventId
      previousStatus: previousStatus
      status: "submitted"
      totalAmount: self.totalAmount
    }
  }

  // Route an over-threshold order to a manager instead of sending it directly.
  command submitForApproval() {
    guard self.openedAt != null
    guard self.status == "draft"
    guard self.deletedAt == null
    mutate status = "pending_approval"
    mutate approvalRequestedAt = now()
    emit VendorOrderApprovalRequested {
      vendorOrderId: self.id
      tenantId: self.tenantId
      vendorId: self.vendorId
      eventId: self.eventId
      totalAmount: self.totalAmount
    }
  }

  // One-click manager approve — transmits the order immediately. Emits
  // VendorOrderSubmitted so downstream reactions (PurchaseNeed fanOut) still fire.
  command approve() {
    guard self.status == "pending_approval"
    guard self.deletedAt == null
    guard roleAllows(user.role, "manageAccess")
    compute previousStatus = self.status
    mutate status = "submitted"
    mutate approvedAt = now()
    mutate submittedAt = now()
    emit VendorOrderApproved {
      vendorOrderId: self.id
      tenantId: self.tenantId
      vendorId: self.vendorId
      eventId: self.eventId
      totalAmount: self.totalAmount
    }
    emit VendorOrderSubmitted {
      vendorOrderId: self.id
      tenantId: self.tenantId
      vendorId: self.vendorId
      eventId: self.eventId
      previousStatus: previousStatus
      status: "submitted"
      totalAmount: self.totalAmount
    }
  }

  // Manager returns the order to draft with notes for the buyer.
  command requestChanges(notes: string) {
    guard self.status == "pending_approval"
    guard self.deletedAt == null
    guard roleAllows(user.role, "manageAccess")
    constraint requestChangesNotes: length(trim(notes)) > 0 "Modification request notes are required"
    mutate status = "draft"
    mutate approvalNotes = notes
    mutate approvalRequestedAt = null
    emit VendorOrderChangesRequested {
      vendorOrderId: self.id
      tenantId: self.tenantId
      vendorId: self.vendorId
      eventId: self.eventId
      totalAmount: self.totalAmount
      notes: notes
    }
  }

  command confirm() {
    guard self.status == "submitted"
    guard self.submittedAt != null
    guard self.deletedAt == null
    compute previousStatus = self.status
    mutate status = "confirmed"
    mutate confirmedAt = now()
    emit VendorOrderConfirmed {
      vendorOrderId: self.id
      tenantId: self.tenantId
      vendorId: self.vendorId
      eventId: self.eventId
      previousStatus: previousStatus
      status: "confirmed"
      totalAmount: self.totalAmount
    }
  }

  command markPartiallyReceived() {
    guard self.status == "confirmed"
    guard self.confirmedAt != null
    guard self.deletedAt == null
    compute previousStatus = self.status
    mutate status = "partially_received"
    emit VendorOrderPartiallyReceived {
      vendorOrderId: self.id
      tenantId: self.tenantId
      vendorId: self.vendorId
      eventId: self.eventId
      previousStatus: previousStatus
      status: "partially_received"
      totalAmount: self.totalAmount
    }
  }

  command markReceived() {
    guard self.status == "confirmed" or self.status == "partially_received"
    guard self.confirmedAt != null
    guard self.deletedAt == null
    compute previousStatus = self.status
    mutate status = "received"
    mutate receivedAt = now()
    emit VendorOrderReceived {
      vendorOrderId: self.id
      tenantId: self.tenantId
      vendorId: self.vendorId
      eventId: self.eventId
      previousStatus: previousStatus
      status: "received"
      totalAmount: self.totalAmount
    }
  }

  command cancel(reason: string) {
    guard self.status == "draft" or self.status == "pending_approval" or self.status == "submitted" or self.status == "confirmed" or self.status == "partially_received"
    guard self.deletedAt == null
    // Draft abort (prep-list generate rollback) is a procurement action; later-stage
    // cancel stays manage-gated. Pending-approval orders are still pre-send, so the
    // buyer may pull them back too.
    guard roleAllows(user.role, "inventoryManageAccess") or ((self.status == "draft" or self.status == "pending_approval") and roleAllows(user.role, "procurementAccess"))
    constraint cancelOrderReason: length(trim(reason)) > 0 "Cancellation reason is required"
    compute previousStatus = self.status
    mutate status = "cancelled"
    mutate cancelledAt = now()
    mutate cancellationReason = reason
    emit VendorOrderCancelled {
      vendorOrderId: self.id
      tenantId: self.tenantId
      vendorId: self.vendorId
      eventId: self.eventId
      previousStatus: previousStatus
      status: "cancelled"
      totalAmount: self.totalAmount
      reason: reason
    }
  }

  store VendorOrder in durable
}

// Ordered/received quantity line for one Ingredient on a VendorOrder
// (capsule-pro PurchaseOrderItem). Every partial receipt creates an immutable
// InventoryLot with supplier and purchase-line provenance.
entity VendorOrderLine mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required vendorOrderId: uuid
  property required ingredientId: uuid
  property ingredientDemandId: uuid?
  property locationId: uuid?
  property required orderedQuantity: decimal(12, 4) = 0
  property required receivedQuantity: decimal(12, 4) = 0
  property required unit: UnitOfMeasure = "each"
  property required unitCost: money(12, 2) = 0
  property discrepancyQuantity: decimal(12, 4)?
  property discrepancyNotes: string?
  property required status: VendorOrderLineStatus = "pending"
  property addedAt: datetime?
  property completedAt: datetime?
  property cancelledAt: datetime?

  belongsTo vendorOrder: VendorOrder fields [tenantId, vendorOrderId] references [tenantId, id]
  belongsTo ingredient: Ingredient fields [tenantId, ingredientId] references [tenantId, id]
  belongsTo ingredientDemand: IngredientDemand fields [tenantId, ingredientDemandId] references [tenantId, id]
  belongsTo location: StorageLocation fields [tenantId, locationId] references [tenantId, id]
  hasMany demandLinks: VendorOrderLineDemand

  computed lineTotal: money(12, 2) = self.orderedQuantity * self.unitCost
  computed remainingQuantity: decimal(12, 4) = self.orderedQuantity - self.receivedQuantity
  // Receiving display flags — discrepancyQuantity stays a persisted buyer note.
  computed isFullyReceived: boolean = self.orderedQuantity > 0 and self.receivedQuantity >= self.orderedQuantity
  computed hasReceivingDiscrepancy: boolean = self.discrepancyQuantity != null and self.discrepancyQuantity > 0

  constraint lineOrderedPositive: self.addedAt == null or self.orderedQuantity > 0 "Ordered quantity must be positive once added"
  constraint lineReceivedNonnegative: self.receivedQuantity >= 0 "Received quantity cannot be negative"
  constraint lineReceivedNotOver: self.receivedQuantity <= self.orderedQuantity "Received quantity cannot exceed ordered quantity"
  constraint lineCostNonnegative: self.unitCost >= 0 "Unit cost cannot be negative"

  transition status from "pending" to ["added", "cancelled"]
  transition status from "added" to ["receiving", "complete", "cancelled"]
  transition status from "receiving" to ["complete", "cancelled"]
  transition status from "complete" to []
  transition status from "cancelled" to []

  default policy vendorOrderLineRead read: roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Procurement and managers may read vendor order lines"
  default policy vendorOrderLineWrite write: roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Procurement and managers may write vendor order lines through commands"
  default policy vendorOrderLineExecute execute: roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Procurement and managers may execute vendor order line commands"

  command addLine(
    vendorOrderId: uuid,
    ingredientId: uuid,
    orderedQuantity: decimal(12, 4),
    unit: UnitOfMeasure,
    unitCost: money(12, 2),
    optional ingredientDemandId: uuid,
    optional locationId: uuid
  ) {
    guard self.addedAt == null
    guard self.status == "pending"
    guard self.deletedAt == null
    guard self.vendorOrder != null and self.vendorOrder.status == "draft" and self.vendorOrder.openedAt != null
    guard self.ingredient != null and self.ingredient.status == "active"
    constraint addLineOrderMatch: vendorOrderId == self.vendorOrderId "Add line vendorOrderId must match the seeded order reference"
    constraint addLineIngredientMatch: ingredientId == self.ingredientId "Add line ingredientId must match the seeded ingredient reference"
    constraint addLineDemandMatch: ingredientDemandId == null or self.ingredientDemandId == null or ingredientDemandId == self.ingredientDemandId "Add line ingredientDemandId must match the seeded demand reference when provided"
    constraint addLineLocationMatch: locationId == null or self.locationId == null or locationId == self.locationId "Add line locationId must match the seeded location reference when provided"
    constraint addLineQuantityPositive: orderedQuantity > 0 "Ordered quantity must be positive"
    constraint addLineCostNonnegative: unitCost >= 0 "Unit cost cannot be negative"
    mutate vendorOrderId = vendorOrderId
    mutate ingredientId = ingredientId
    mutate ingredientDemandId = ingredientDemandId != null ? ingredientDemandId : self.ingredientDemandId
    mutate locationId = locationId != null ? locationId : self.locationId
    mutate orderedQuantity = orderedQuantity
    mutate unit = unit
    mutate unitCost = unitCost
    mutate status = "added"
    mutate addedAt = now()
    emit VendorOrderLineAdded {
      vendorOrderLineId: self.id
      tenantId: self.tenantId
      vendorOrderId: vendorOrderId
      ingredientId: ingredientId
      ingredientDemandId: ingredientDemandId != null ? ingredientDemandId : self.ingredientDemandId
      eventId: self.vendorOrder.eventId
      orderedQuantity: orderedQuantity
      unit: unit
      unitCost: unitCost
    }
  }

  // Weekly draft line ensure: create or revise consolidated shortage quantity.
  // weekNeed / onHand are reaction-param sums (command-body sum() is not projected).
  command ensureWeeklyLine(
    vendorOrderId: uuid,
    ingredientId: uuid,
    weekNeed: decimal(12, 4),
    onHand: decimal(12, 4),
    contributionQuantity: decimal(12, 4),
    unit: UnitOfMeasure,
    unitCost: money(12, 2),
    purchaseNeedId: uuid,
    ingredientDemandId: uuid
  ) {
    guard self.deletedAt == null
    guard self.vendorOrder != null and self.vendorOrder.status == "draft"
    guard self.ingredient != null and self.ingredient.status == "active"
    constraint ensureContributionPositive: contributionQuantity > 0 "Contribution quantity must be positive"
    compute orderQty = max(0.0001, weekNeed - onHand)
    mutate vendorOrderId = vendorOrderId
    mutate ingredientId = ingredientId
    mutate ingredientDemandId = ingredientDemandId
    mutate orderedQuantity = orderQty
    mutate unit = unit
    mutate unitCost = unitCost
    mutate status = self.addedAt == null ? "added" : self.status
    mutate addedAt = self.addedAt == null ? now() : self.addedAt
    emit VendorOrderLineWeeklyEnsured {
      vendorOrderLineId: self.id
      tenantId: self.tenantId
      vendorOrderId: vendorOrderId
      purchaseNeedId: purchaseNeedId
      ingredientDemandId: ingredientDemandId
      ingredientId: ingredientId
      orderedQuantity: orderQty
      contributionQuantity: contributionQuantity
      unit: unit
    }
  }

  command reviseQuantity(
    orderedQuantity: decimal(12, 4),
    optional unitCost: money(12, 2)
  ) {
    guard self.status == "added"
    guard self.deletedAt == null
    guard self.vendorOrder != null and self.vendorOrder.status == "draft"
    constraint reviseLineQuantityPositive: orderedQuantity > 0 "Ordered quantity must be positive"
    constraint reviseLineCostNonnegative: unitCost == null or unitCost >= 0 "Unit cost cannot be negative"
    mutate orderedQuantity = orderedQuantity
    mutate unitCost = unitCost != null ? unitCost : self.unitCost
    emit VendorOrderLineQuantityRevised {
      vendorOrderLineId: self.id
      tenantId: self.tenantId
      vendorOrderId: self.vendorOrderId
      ingredientId: self.ingredientId
      orderedQuantity: orderedQuantity
      unit: self.unit
      unitCost: unitCost != null ? unitCost : self.unitCost
    }
  }

  command recordReceipt(
    quantity: decimal(12, 4),
    locationId: uuid,
    unitPrice: money(12, 2),
    supplierLotNumber: string,
    optional discrepancyQuantity: decimal(12, 4),
    optional discrepancyNotes: string
  ) {
    guard self.addedAt != null
    guard self.status == "added" or self.status == "receiving"
    guard self.deletedAt == null
    guard self.vendorOrder != null and (self.vendorOrder.status == "confirmed" or self.vendorOrder.status == "partially_received")
    constraint receiptLocationMatch: self.locationId == null or locationId == self.locationId "Receipt locationId must match the seeded location when one was pre-set"
    constraint receiptQuantityPositive: quantity > 0 "Received quantity must be positive"
    constraint receiptNotOver: self.receivedQuantity + quantity <= self.orderedQuantity "Received quantity cannot exceed ordered quantity"
    constraint receiptPriceNonnegative: unitPrice >= 0 "Receipt unit price cannot be negative"
    constraint receiptSupplierLotRequired: length(trim(supplierLotNumber)) > 0 "Supplier lot number is required for traceability"
    constraint receiptDiscrepancyNonnegative: discrepancyQuantity == null or discrepancyQuantity >= 0 "Discrepancy quantity cannot be negative"
    compute previousReceived = self.receivedQuantity
    compute nextReceived = self.receivedQuantity + quantity
    compute nextStatus = nextReceived == self.orderedQuantity ? "complete" : "receiving"
    mutate locationId = locationId
    mutate receivedQuantity = nextReceived
    mutate unitCost = unitPrice
    mutate discrepancyQuantity = discrepancyQuantity != null ? discrepancyQuantity : self.discrepancyQuantity
    mutate discrepancyNotes = discrepancyNotes != null ? discrepancyNotes : self.discrepancyNotes
    mutate status = nextStatus
    mutate completedAt = nextReceived == self.orderedQuantity ? now() : self.completedAt
    emit VendorOrderLineReceived {
      vendorOrderLineId: self.id
      tenantId: self.tenantId
      vendorOrderId: self.vendorOrderId
      vendorId: self.vendorOrder.vendorId
      ingredientId: self.ingredientId
      ingredientDemandId: self.ingredientDemandId
      eventId: self.vendorOrder.eventId
      locationId: locationId
      supplierLotNumber: supplierLotNumber
      previousReceivedQuantity: previousReceived
      receivedQuantity: nextReceived
      receiptQuantity: quantity
      orderedQuantity: self.orderedQuantity
      unit: self.unit
      unitCost: unitPrice
      unitPrice: unitPrice
      discrepancyQuantity: discrepancyQuantity != null ? discrepancyQuantity : self.discrepancyQuantity
    }
  }

  command cancelLine(reason: string) {
    guard self.addedAt != null
    guard self.status == "added" or self.status == "receiving"
    guard self.deletedAt == null
    guard self.vendorOrder != null and (self.vendorOrder.status == "draft" or self.vendorOrder.status == "submitted" or self.vendorOrder.status == "confirmed")
    // Draft-line abort for prep-list generate rollback; later-stage cancel stays manage-gated.
    guard roleAllows(user.role, "inventoryManageAccess") or (self.vendorOrder.status == "draft" and roleAllows(user.role, "procurementAccess"))
    constraint cancelLineReason: length(trim(reason)) > 0 "Cancellation reason is required"
    mutate status = "cancelled"
    mutate cancelledAt = now()
    mutate deletedAt = now()
    emit VendorOrderLineCancelled {
      vendorOrderLineId: self.id
      tenantId: self.tenantId
      vendorOrderId: self.vendorOrderId
      ingredientId: self.ingredientId
      ingredientDemandId: self.ingredientDemandId
      eventId: self.vendorOrder.eventId
      orderedQuantity: self.orderedQuantity
      receivedQuantity: self.receivedQuantity
      unit: self.unit
      reason: reason
    }
  }

  store VendorOrderLine in durable
}

// Immutable lot receipt. The purchase-order line plus cumulative received
// quantity identifies one partial receipt, while supplierLotNumber supports
// downstream traceability and targeted recall workflows.
entity InventoryLot mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  unique [tenantId, vendorOrderLineId, cumulativeReceivedQuantity]
  timestamps
  versionProperty version: number

  property indexed required supplierLotNumber: string = ""
  property indexed required vendorOrderLineId: uuid
  property required vendorOrderId: uuid
  property indexed required vendorId: uuid
  property indexed required ingredientId: uuid
  property ingredientDemandId: uuid?
  property eventId: uuid?
  property indexed required locationId: uuid
  property required receiptQuantity: decimal(12, 4) = 0
  property required cumulativeReceivedQuantity: decimal(12, 4) = 0
  property required unit: UnitOfMeasure = "each"
  property required unitCost: money(12, 2) = 0
  property receivedAt: datetime?

  belongsTo vendorOrderLine: VendorOrderLine fields [tenantId, vendorOrderLineId] references [tenantId, id]
  belongsTo vendorOrder: VendorOrder fields [tenantId, vendorOrderId] references [tenantId, id]
  belongsTo vendor: Vendor fields [tenantId, vendorId] references [tenantId, id]
  belongsTo ingredient: Ingredient fields [tenantId, ingredientId] references [tenantId, id]
  belongsTo ingredientDemand: IngredientDemand fields [tenantId, ingredientDemandId] references [tenantId, id]
  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]
  belongsTo location: StorageLocation fields [tenantId, locationId] references [tenantId, id]

  constraint inventoryLotComplete: self.receivedAt == null or (length(trim(self.supplierLotNumber)) > 0 and self.receiptQuantity > 0 and self.cumulativeReceivedQuantity > 0) "Recorded inventory lots require a supplier lot number and positive receipt quantities"
  constraint inventoryLotCostNonnegative: self.unitCost >= 0 "Inventory lot unit cost cannot be negative"

  default policy inventoryLotRead read: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Inventory, procurement, and managers may read receipt lots"
  default policy inventoryLotWrite write: roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Procurement and managers may record receipt lots"
  default policy inventoryLotExecute execute: roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Procurement and managers may execute receipt lot commands"

  command record(
    supplierLotNumber: string,
    vendorOrderLineId: uuid,
    vendorOrderId: uuid,
    vendorId: uuid,
    ingredientId: uuid,
    optional ingredientDemandId: uuid,
    optional eventId: uuid,
    locationId: uuid,
    receiptQuantity: decimal(12, 4),
    cumulativeReceivedQuantity: decimal(12, 4),
    unit: UnitOfMeasure,
    unitCost: money(12, 2)
  ) {
    guard self.receivedAt == null or (self.supplierLotNumber == supplierLotNumber and self.vendorOrderLineId == vendorOrderLineId and self.vendorOrderId == vendorOrderId and self.vendorId == vendorId and self.ingredientId == ingredientId and self.ingredientDemandId == ingredientDemandId and self.eventId == eventId and self.locationId == locationId and self.receiptQuantity == receiptQuantity and self.cumulativeReceivedQuantity == cumulativeReceivedQuantity and self.unit == unit and self.unitCost == unitCost)
    guard self.deletedAt == null
    constraint recordInventoryLotNumberRequired: length(trim(supplierLotNumber)) > 0 "Supplier lot number is required for traceability"
    constraint recordInventoryLotReceiptPositive: receiptQuantity > 0 "Inventory lot receipt quantity must be positive"
    constraint recordInventoryLotCumulativePositive: cumulativeReceivedQuantity > 0 "Inventory lot cumulative quantity must be positive"
    constraint recordInventoryLotCostNonnegative: unitCost >= 0 "Inventory lot unit cost cannot be negative"
    mutate supplierLotNumber = supplierLotNumber
    mutate vendorOrderLineId = vendorOrderLineId
    mutate vendorOrderId = vendorOrderId
    mutate vendorId = vendorId
    mutate ingredientId = ingredientId
    mutate ingredientDemandId = ingredientDemandId
    mutate eventId = eventId
    mutate locationId = locationId
    mutate receiptQuantity = receiptQuantity
    mutate cumulativeReceivedQuantity = cumulativeReceivedQuantity
    mutate unit = unit
    mutate unitCost = unitCost
    mutate receivedAt = self.receivedAt == null ? now() : self.receivedAt
  }

  store InventoryLot in durable
}

// Immutable receipt-price fact. The cumulative received quantity identifies a
// particular partial receipt on a line and makes reaction retries idempotent.
entity IngredientPriceObservation mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  unique [tenantId, vendorOrderLineId, cumulativeReceivedQuantity]
  timestamps
  versionProperty version: number

  property indexed required ingredientId: uuid
  property indexed required vendorId: uuid
  property required vendorOrderId: uuid
  property indexed required vendorOrderLineId: uuid
  property required receiptQuantity: decimal(12, 4) = 0
  property required cumulativeReceivedQuantity: decimal(12, 4) = 0
  property required unit: UnitOfMeasure = "each"
  property required unitPrice: money(12, 2) = 0
  property observedAt: datetime?

  belongsTo ingredient: Ingredient fields [tenantId, ingredientId] references [tenantId, id]
  belongsTo vendor: Vendor fields [tenantId, vendorId] references [tenantId, id]
  belongsTo vendorOrder: VendorOrder fields [tenantId, vendorOrderId] references [tenantId, id]
  belongsTo vendorOrderLine: VendorOrderLine fields [tenantId, vendorOrderLineId] references [tenantId, id]

  constraint observationReceiptPositive: self.observedAt == null or self.receiptQuantity > 0 "Price observation receipt quantity must be positive"
  constraint observationCumulativePositive: self.observedAt == null or self.cumulativeReceivedQuantity > 0 "Price observation cumulative quantity must be positive"
  constraint observationPriceNonnegative: self.unitPrice >= 0 "Price observation unit price cannot be negative"

  default policy ingredientPriceObservationRead read: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Kitchen, procurement, and managers may read confirmed ingredient prices"
  default policy ingredientPriceObservationWrite write: roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Procurement and managers may record confirmed ingredient prices"
  default policy ingredientPriceObservationExecute execute: roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Procurement and managers may execute confirmed ingredient price commands"

  command record(
    ingredientId: uuid,
    vendorId: uuid,
    vendorOrderId: uuid,
    vendorOrderLineId: uuid,
    receiptQuantity: decimal(12, 4),
    cumulativeReceivedQuantity: decimal(12, 4),
    unit: UnitOfMeasure,
    unitPrice: money(12, 2)
  ) {
    guard self.observedAt == null or (self.ingredientId == ingredientId and self.vendorId == vendorId and self.vendorOrderId == vendorOrderId and self.vendorOrderLineId == vendorOrderLineId and self.receiptQuantity == receiptQuantity and self.cumulativeReceivedQuantity == cumulativeReceivedQuantity and self.unit == unit and self.unitPrice == unitPrice)
    guard self.deletedAt == null
    constraint recordObservationReceiptPositive: receiptQuantity > 0 "Price observation receipt quantity must be positive"
    constraint recordObservationCumulativePositive: cumulativeReceivedQuantity > 0 "Price observation cumulative quantity must be positive"
    constraint recordObservationPriceNonnegative: unitPrice >= 0 "Price observation unit price cannot be negative"
    mutate ingredientId = ingredientId
    mutate vendorId = vendorId
    mutate vendorOrderId = vendorOrderId
    mutate vendorOrderLineId = vendorOrderLineId
    mutate receiptQuantity = receiptQuantity
    mutate cumulativeReceivedQuantity = cumulativeReceivedQuantity
    mutate unit = unit
    mutate unitPrice = unitPrice
    mutate observedAt = self.observedAt == null ? now() : self.observedAt
  }

  store IngredientPriceObservation in durable
}

// Provenance contribution from one IngredientDemand to an aggregated weekly
// VendorOrderLine. Several Events may contribute to the same order line.
// vendorOrderId is denormalized (one-hop belongsTo) so draft guards project
// correctly — nested self.vendorOrderLine.vendorOrder is not hydrated on
// __rel_* locals in Convex createVia/link runners (Guard 2 always failed).
entity VendorOrderLineDemand mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required vendorOrderLineId: uuid
  property required ingredientDemandId: uuid
  property required vendorOrderId: uuid
  property required contributionQuantity: decimal(12, 4) = 0
  property required unit: UnitOfMeasure = "each"
  property linkedAt: datetime?
  property removedAt: datetime?

  belongsTo vendorOrderLine: VendorOrderLine fields [tenantId, vendorOrderLineId] references [tenantId, id]
  belongsTo ingredientDemand: IngredientDemand fields [tenantId, ingredientDemandId] references [tenantId, id]
  belongsTo vendorOrder: VendorOrder fields [tenantId, vendorOrderId] references [tenantId, id]

  constraint demandLinkQuantityPositive: self.linkedAt == null or self.contributionQuantity > 0 "Demand link contribution must be positive"

  default policy vendorOrderLineDemandRead read: roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Procurement and managers may read order demand links"
  default policy vendorOrderLineDemandWrite write: roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Procurement and managers may write order demand links through commands"
  default policy vendorOrderLineDemandExecute execute: roleAllows(user.role, "procurementAccess") or roleAllows(user.role, "manageAccess") "Procurement and managers may execute order demand link commands"

  command link(
    vendorOrderLineId: uuid,
    ingredientDemandId: uuid,
    vendorOrderId: uuid,
    contributionQuantity: decimal(12, 4),
    unit: UnitOfMeasure
  ) {
    guard self.deletedAt == null
    guard self.vendorOrderLine != null
    guard self.vendorOrder != null and self.vendorOrder.status == "draft"
    guard self.ingredientDemand != null
    // First link or idempotent revise of the same demand→line contribution.
    guard self.linkedAt == null or (self.vendorOrderLineId == vendorOrderLineId and self.ingredientDemandId == ingredientDemandId)
    constraint linkLineMatch: self.linkedAt == null or vendorOrderLineId == self.vendorOrderLineId "Demand link vendorOrderLineId must match the seeded line reference"
    constraint linkDemandMatch: self.linkedAt == null or ingredientDemandId == self.ingredientDemandId "Demand link ingredientDemandId must match the seeded demand reference"
    constraint linkOrderMatch: self.linkedAt == null or vendorOrderId == self.vendorOrderId "Demand link vendorOrderId must match the seeded order reference"
    constraint linkOrderOwnsLine: vendorOrderId == self.vendorOrderLine.vendorOrderId "Demand link vendorOrderId must own the vendor order line"
    constraint linkQuantityPositive: contributionQuantity > 0 "Demand link contribution must be positive"
    mutate vendorOrderLineId = vendorOrderLineId
    mutate ingredientDemandId = ingredientDemandId
    mutate vendorOrderId = vendorOrderId
    mutate contributionQuantity = contributionQuantity
    mutate unit = unit
    mutate linkedAt = self.linkedAt == null ? now() : self.linkedAt
    emit VendorOrderLineDemandLinked {
      vendorOrderLineDemandId: self.id
      tenantId: self.tenantId
      vendorOrderLineId: vendorOrderLineId
      ingredientDemandId: ingredientDemandId
      contributionQuantity: contributionQuantity
      unit: unit
    }
  }

  command revise(contributionQuantity: decimal(12, 4)) {
    guard self.linkedAt != null
    guard self.deletedAt == null
    guard self.vendorOrder != null and self.vendorOrder.status == "draft"
    constraint reviseQuantityPositive: contributionQuantity > 0 "Demand link contribution must be positive"
    mutate contributionQuantity = contributionQuantity
    emit VendorOrderLineDemandRevised {
      vendorOrderLineDemandId: self.id
      tenantId: self.tenantId
      vendorOrderLineId: self.vendorOrderLineId
      ingredientDemandId: self.ingredientDemandId
      contributionQuantity: contributionQuantity
      unit: self.unit
    }
  }

  command retire(reason: string) {
    guard self.linkedAt != null
    guard self.deletedAt == null
    guard self.vendorOrder != null and self.vendorOrder.status == "draft"
    constraint retireReasonPresent: length(trim(reason)) > 0 "Demand link retirement reason is required"
    mutate removedAt = now()
    mutate deletedAt = now()
    emit VendorOrderLineDemandRetired {
      vendorOrderLineDemandId: self.id
      tenantId: self.tenantId
      vendorOrderLineId: self.vendorOrderLineId
      ingredientDemandId: self.ingredientDemandId
      reason: reason
    }
  }

  store VendorOrderLineDemand in durable
}

