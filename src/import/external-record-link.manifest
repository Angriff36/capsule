// Capsule external record link — durable mapping from external system records to Capsule entities.
// Provides stable external ID mapping for TPP integration and import framework.
// Source + record type + stable external ID → Capsule entity ID

use "./import-run.manifest"

// External system identifiers - extensible for future integrations
enum ExternalSourceSystem {
  tpp_legacy
  csv_export
  api_sync
  quickbooks_online
  google_calendar
  stripe
  other
}

// Capsule entity types that can be linked to external records
enum CapsuleEntityType {
  event_record
  contact
  lead
  menu
  venue
  payment
  invoice
  contract
  proposal
  client
  vendor
  person
  task
  batch
  order
  delivery
  stock
  location
  pack_list
  // Revision-2 culinary model (2026-09-14)
  ingredient
  component
  component_portion_spec
  component_ingredient
  component_component
  dish
  dish_ingredient
  dish_component
  dish_task
  dish_container
  station
  unit
  event_dish
  prep_task
}

// Revision-2: whether a link is a machine suggestion, an approved identity, or
// a rejected candidate. Only approved links are identity; names never are.
enum LinkDecision {
  suggested
  approved
  rejected
}

// Link verification status
enum LinkVerificationStatus {
  unverified
  verified
  deprecated
}

// Conflict resolution status for duplicate mappings
enum ConflictStatus {
  resolved
  pending_conflict
  superseded
}

entity ExternalRecordLink mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  unique [tenantId, sourceSystem, sourceAccount, recordType, externalId, role, ordinal]
  timestamps
  versionProperty version: number

  // Core mapping fields
  property required sourceSystem: ExternalSourceSystem = "tpp_legacy"
  property required recordType: string = ""
  // No placeholder default: the identity fields are populated only by link(),
  // which makes link() the allocating command (the Builder had chosen discard,
  // so no governed link create existed; #371).
  property required externalId: string
  property required capsuleEntity: CapsuleEntityType = "contact"
  property required capsuleId: string
  // Revision-2 identity (2026-09-14). One legacy record may map to several
  // Capsule records, one link per role; ordinal separates several records of
  // one role from one source row. Nullable so pre-field links validate; the
  // authored key builder treats null account/role as "" and null ordinal as 0.
  property sourceAccount: string?
  property role: string?
  property ordinal: int?
  // Precomputed full key for indexed lookup (authored seam builds it).
  property indexed linkKey: string?
  property decision: LinkDecision?
  property suggestedBy: string?
  property decidedByUserId: string?
  property decidedAt: datetime?
  // Applied side: what Capsule last received from import (three-way baseline).
  property appliedValues: string?
  property appliedSourceVersion: string?
  property appliedAt: datetime?
  property appliedImportRunId: string?
  // Latest side: what the newest import saw, applied or not.
  property sourceVersion: string?
  property lastSeenAt: datetime?
  property lastSeenImportRunId: string?

  // Verification tracking
  property required verified: boolean = false
  property lastVerifiedAt: datetime?
  property verifiedByUserId: string?

  // Source tracking
  property sourceImportRunId: string?
  property effectiveStartDate: datetime?
  property effectiveEndDate: datetime?

  // Additional metadata
  property rawSourceData: string?
  property metadata: string?

  // Conflict resolution
  property required conflictStatus: ConflictStatus = "pending_conflict"
  property resolvedByUserId: string?
  property resolutionNote: string?

  // References
  ref sourceImportRun: ImportRun fields [tenantId, sourceImportRunId] references [tenantId, id]

  // Constraints
  constraint linkSourceSystemPresent: self.sourceSystem != null "Pick a source system for this match."
  constraint linkExternalIdPresent: length(trim(self.externalId)) > 0 "Give this match an external ID."
  constraint linkDatesOrdered: self.effectiveStartDate == null or self.effectiveEndDate == null or self.effectiveStartDate <= self.effectiveEndDate "This match's start date has to be on or before its end date."
  constraint linkVerifiedRequiresUser: self.verified == false or self.verifiedByUserId != null "This match can't be marked verified without picking who verified it."
  constraint linkResolvedRequiresUser: self.conflictStatus == "resolved" or self.resolvedByUserId == null "This match can't be marked resolved without picking who resolved it."

  // Policies
  default policy externalRecordLinkRead read: roleAllows(user.role, "importAccess") "Staff may see import matches"
  default policy externalRecordLinkWrite write: roleAllows(user.role, "importAccess") "Staff may update import matches"
  default policy externalRecordLinkExecute execute: roleAllows(user.role, "importAccess") "Staff may change import matches"

  // linkExternalRecord - Create a new external-to-Capsule mapping
  command link(
    sourceSystem: ExternalSourceSystem,
    recordType: string,
    externalId: string,
    capsuleEntity: CapsuleEntityType,
    capsuleId: string,
    optional verified: boolean,
    optional verifiedByUserId: string,
    optional sourceImportRunId: string,
    optional effectiveStartDate: datetime,
    optional effectiveEndDate: datetime,
    optional rawSourceData: string,
    optional metadata: string,
    optional sourceAccount: string,
    optional role: string,
    optional ordinal: int,
    optional linkKey: string,
    optional decision: LinkDecision,
    optional suggestedBy: string,
    optional sourceVersion: string,
    optional conflictStatus: ConflictStatus,
    optional resolutionNote: string
  ) {
    // No `self.createdAt == null` guard: timestamps fill createdAt into the
    // draft before guards run, so that guard failed on every create (#371).
    guard self.deletedAt == null
    constraint linkSourceSystemPresent: sourceSystem != null "Pick a source system for this match."
    constraint linkExternalIdPresent: length(trim(externalId)) > 0 "Give this match an external ID."
    // A link that is explicitly a pending conflict may have no Capsule record
    // yet (import commit: an event whose client was never imported, a
    // payment awaiting a reconciliation match). Every other link needs one.
    constraint linkCapsuleIdPresent: length(trim(capsuleId)) > 0 or conflictStatus == "pending_conflict" "Give this match a Capsule ID."
    constraint linkNotSuperseded: conflictStatus == null or conflictStatus != "superseded" "A new match can't start out replaced. Pick resolved or pending."
    constraint linkVerifiedRequiresUser: verified == null or verified == false or (verifiedByUserId != null and length(trim(verifiedByUserId)) > 0) "This match can't be marked verified without picking who verified it."
    constraint linkDatesOrdered: effectiveStartDate == null or effectiveEndDate == null or effectiveStartDate <= effectiveEndDate "This match's start date has to be on or before its end date."
    mutate sourceSystem = sourceSystem
    mutate recordType = recordType != null ? recordType : ""
    mutate externalId = externalId
    mutate capsuleEntity = capsuleEntity
    mutate capsuleId = capsuleId
    mutate verified = verified != null ? verified : false
    mutate verifiedByUserId = verifiedByUserId
    mutate lastVerifiedAt = verified != null and verified ? now() : null
    mutate sourceImportRunId = sourceImportRunId
    mutate effectiveStartDate = effectiveStartDate
    mutate effectiveEndDate = effectiveEndDate
    mutate rawSourceData = rawSourceData
    mutate metadata = metadata
    // Omitted → "pending_conflict" (the reconcile queue), as before
    // 2026-09-29. Import commit and catalog reclassification pass "resolved"
    // for links that need no reconciling.
    mutate conflictStatus = conflictStatus != null ? conflictStatus : "pending_conflict"
    mutate resolutionNote = resolutionNote
    // Stored as an explicit null, not absent: import lookups
    // (importCommit.findLink/linksForRun) and the cutover gate match
    // deletedAt == null exactly, which an absent field does not satisfy.
    mutate deletedAt = null
    mutate sourceAccount = sourceAccount
    mutate role = role
    mutate ordinal = ordinal != null ? ordinal : 0
    mutate linkKey = linkKey
    mutate decision = decision != null ? decision : "suggested"
    mutate suggestedBy = suggestedBy
    mutate sourceVersion = sourceVersion
    mutate lastSeenAt = now()
    mutate lastSeenImportRunId = sourceImportRunId
    emit ExternalRecordLinked {
      externalRecordLinkId: self.id
      tenantId: self.tenantId
      sourceSystem: sourceSystem
      recordType: recordType != null ? recordType : ""
      externalId: externalId
      capsuleEntity: capsuleEntity
      capsuleId: capsuleId
      verified: verified != null ? verified : false
      sourceImportRunId: sourceImportRunId
    }
  }

  // Revision-2: a repeat import saw this source record. Only the latest side
  // moves; the applied baseline and Capsule values are untouched. Absence from
  // a run leaves lastSeen where it was and never supersedes the link.
  command observe(optional sourceVersion: string, optional rawSourceData: string, optional importRunId: string) {
    guard self.deletedAt == null
    guard self.createdAt != null
    mutate sourceVersion = sourceVersion != null ? sourceVersion : self.sourceVersion
    mutate rawSourceData = rawSourceData != null ? rawSourceData : self.rawSourceData
    mutate lastSeenAt = now()
    mutate lastSeenImportRunId = importRunId != null ? importRunId : self.lastSeenImportRunId
  }

  // Revision-2: import wrote these field values into Capsule. Advances the
  // three-way baseline. Also called when Capsule already equals the source, so
  // an identical edit on both sides reconciles without a conflict.
  command recordApplied(appliedValues: string, optional appliedSourceVersion: string, optional importRunId: string) {
    guard self.deletedAt == null
    guard self.createdAt != null
    mutate appliedValues = appliedValues
    mutate appliedSourceVersion = appliedSourceVersion != null ? appliedSourceVersion : self.sourceVersion
    mutate appliedAt = now()
    mutate appliedImportRunId = importRunId != null ? importRunId : self.lastSeenImportRunId
  }

  // Revision-2: approve or reject a suggested identity. Approval is what makes
  // the link an identity; a display name never is.
  command decide(decision: LinkDecision, decidedByUserId: string) {
    guard self.deletedAt == null
    guard self.createdAt != null
    constraint decideUserPresent: length(trim(decidedByUserId)) > 0 "Pick who decided this."
    mutate decision = decision
    mutate decidedByUserId = decidedByUserId
    mutate decidedAt = now()
    mutate verified = decision == "approved"
    mutate verifiedByUserId = decision == "approved" ? decidedByUserId : self.verifiedByUserId
    mutate lastVerifiedAt = now()
    mutate conflictStatus = decision == "approved" ? "resolved" : self.conflictStatus
    mutate resolvedByUserId = decision == "approved" ? decidedByUserId : self.resolvedByUserId
  }

  // verifyLink - Mark a link as verified (e.g., after user confirmation)
  command verifyLink(
    verifiedByUserId: string,
    optional verified: boolean,
    optional metadata: string
  ) {
    guard self.deletedAt == null
    guard self.createdAt != null
    constraint verifyUserPresent: length(trim(verifiedByUserId)) > 0 "Pick who verified this."
    mutate verified = verified != null ? verified : true
    mutate verifiedByUserId = verifiedByUserId
    mutate lastVerifiedAt = now()
    mutate metadata = metadata != null ? metadata : self.metadata
    mutate conflictStatus = verified != null and verified ? "resolved" : self.conflictStatus
    mutate resolvedByUserId = verified != null and verified ? verifiedByUserId : self.resolvedByUserId
    emit ExternalRecordVerified {
      externalRecordLinkId: self.id
      tenantId: self.tenantId
      verified: verified != null ? verified : true
      verifiedByUserId: verifiedByUserId
      capsuleEntity: self.capsuleEntity
      capsuleId: self.capsuleId
    }
  }

  // unlinkExternalRecord - Remove a link (soft delete via discard)
  command unlinkExternalRecord(
    reason: string,
    optional unlinkedByUserId: string
  ) {
    guard self.deletedAt == null
    guard self.createdAt != null
    constraint unlinkReasonPresent: length(trim(reason)) > 0 "Say why you're taking this match off."
    mutate deletedAt = now()
    mutate effectiveEndDate = effectiveEndDate != null ? effectiveEndDate : now()
    emit ExternalRecordUnlinked {
      externalRecordLinkId: self.id
      tenantId: self.tenantId
      reason: reason
      unlinkedByUserId: unlinkedByUserId != null ? unlinkedByUserId : ""
      capsuleEntity: self.capsuleEntity
      capsuleId: self.capsuleId
      externalId: self.externalId
      sourceSystem: self.sourceSystem
    }
  }

  // updateCapsuleId - Update the Capsule entity ID for an existing link
  command updateCapsuleId(capsuleId: string) {
    guard self.deletedAt == null
    guard self.createdAt != null
    constraint updateCapsuleIdPresent: length(trim(capsuleId)) > 0 "Give this match a Capsule ID."
    compute previousCapsuleId = self.capsuleId
    mutate capsuleId = capsuleId
    mutate lastVerifiedAt = now()
    mutate verified = false  // Reset verification on ID change
    emit ExternalRecordCapsuleIdUpdated {
      externalRecordLinkId: self.id
      tenantId: self.tenantId
      previousCapsuleId: previousCapsuleId
      capsuleId: capsuleId
      capsuleEntity: self.capsuleEntity
    }
  }

  // resolveConflict - Mark a conflict as resolved
  command resolveConflict(
    conflictStatus: ConflictStatus,
    resolvedByUserId: string,
    optional resolutionNote: string
  ) {
    guard self.deletedAt == null
    guard self.createdAt != null
    constraint resolveUserPresent: length(trim(resolvedByUserId)) > 0 "Pick who resolved this."
    mutate conflictStatus = conflictStatus
    mutate resolvedByUserId = resolvedByUserId
    mutate resolutionNote = resolutionNote
    mutate lastVerifiedAt = now()
    emit ExternalRecordConflictResolved {
      externalRecordLinkId: self.id
      tenantId: self.tenantId
      conflictStatus: conflictStatus
      resolvedByUserId: resolvedByUserId
    }
  }

  // retire - Mark a link as superseded (no longer active)
  // No `createdAt != null` guard (2026-09-29): importCommit.revertImportRun
  // retires every live link of the run through here, including links written
  // before the timestamps existed, which a re-import relinked to the run.
  command retire(optional effectiveEndDate: datetime) {
    guard self.deletedAt == null
    mutate effectiveEndDate = effectiveEndDate != null ? effectiveEndDate : now()
    mutate conflictStatus = "superseded"
    mutate verified = false
    mutate lastVerifiedAt = now()
    emit ExternalRecordRetired {
      externalRecordLinkId: self.id
      tenantId: self.tenantId
      effectiveEndDate: effectiveEndDate != null ? effectiveEndDate : now()
    }
  }

  // discard - Soft delete a link
  command discard(reason: string) {
    guard self.deletedAt == null
    constraint discardReasonPresent: length(trim(reason)) > 0 "Say why you're deleting this match."
    mutate deletedAt = now()
    mutate effectiveEndDate = effectiveEndDate != null ? effectiveEndDate : now()
    emit ExternalRecordDiscarded {
      externalRecordLinkId: self.id
      tenantId: self.tenantId
      reason: reason
    }
  }

  // relink - A repeat import commit saw this external record again
  // (importCommit.upsertLink, 2026-09-29). Points the link at the Capsule
  // record the commit produced, records the run and raw source row, and sets
  // the reconcile state. A superseded link (its run was reverted) becomes
  // active again. No `createdAt != null` guard: links written before the
  // timestamps existed are re-imported through here too.
  command relink(
    capsuleEntity: CapsuleEntityType,
    capsuleId: string,
    sourceImportRunId: string,
    rawSourceData: string,
    conflictStatus: ConflictStatus,
    optional resolutionNote: string
  ) {
    guard self.deletedAt == null
    constraint relinkCapsuleIdPresent: length(trim(capsuleId)) > 0 or conflictStatus == "pending_conflict" "Give this match a Capsule ID."
    constraint relinkNotSuperseded: conflictStatus != "superseded" "A re-imported match can't be marked replaced. Pick resolved or pending."
    constraint relinkRunPresent: length(trim(sourceImportRunId)) > 0 "Say which import saw this item."
    mutate capsuleEntity = capsuleEntity
    mutate capsuleId = capsuleId
    mutate sourceImportRunId = sourceImportRunId
    mutate rawSourceData = rawSourceData
    mutate conflictStatus = conflictStatus
    mutate resolutionNote = resolutionNote != null ? resolutionNote : self.resolutionNote
    emit ExternalRecordRelinked {
      externalRecordLinkId: self.id
      tenantId: self.tenantId
      capsuleEntity: capsuleEntity
      capsuleId: capsuleId
      sourceImportRunId: sourceImportRunId
      conflictStatus: conflictStatus
    }
  }

  // Catalog reclassification (convex/catalogReclassification.ts, 2026-09-29).
  // These commands only touch role "reclassify" suggestion links. The seam
  // authorizes the reclassification itself (kitchen access) and runs them
  // through the tenant system runner, so the person who decided is passed
  // explicitly.

  // refreshSuggestion - The off-line planner re-ran; replace the suggestion
  // on a link nobody has decided or applied yet.
  command refreshSuggestion(capsuleEntity: CapsuleEntityType, metadata: string, suggestedBy: string) {
    guard self.deletedAt == null
    guard self.role == "reclassify"
    guard self.decision == "suggested"
    guard self.appliedAt == null
    constraint refreshSuggestionMetadataPresent: length(trim(metadata)) > 0 "This suggestion needs its details."
    constraint refreshSuggestionSourcePresent: length(trim(suggestedBy)) > 0 "Say where this suggestion came from."
    mutate capsuleEntity = capsuleEntity
    mutate metadata = metadata
    mutate suggestedBy = suggestedBy
    emit ExternalRecordSuggestionRefreshed {
      externalRecordLinkId: self.id
      tenantId: self.tenantId
      capsuleEntity: capsuleEntity
      suggestedBy: suggestedBy
    }
  }

  // decideReclassification - A person approves or rejects a suggestion,
  // optionally overriding its kind (capsuleEntity + metadata). Unlike
  // `decide`, it does not verify or resolve the link: an approved
  // reclassification is a cleanup decision, not an import identity.
  command decideReclassification(
    decision: LinkDecision,
    decidedByUserId: string,
    optional capsuleEntity: CapsuleEntityType,
    optional metadata: string
  ) {
    guard self.deletedAt == null
    guard self.role == "reclassify"
    guard self.appliedAt == null
    constraint decideReclassificationUserPresent: length(trim(decidedByUserId)) > 0 "Pick who decided this."
    constraint decideReclassificationNotSuggested: decision != "suggested" "Approve or reject this suggestion."
    mutate decision = decision
    mutate decidedByUserId = decidedByUserId
    mutate decidedAt = now()
    mutate capsuleEntity = capsuleEntity != null ? capsuleEntity : self.capsuleEntity
    mutate metadata = metadata != null ? metadata : self.metadata
    emit ExternalRecordReclassificationDecided {
      externalRecordLinkId: self.id
      tenantId: self.tenantId
      decision: decision
      decidedByUserId: decidedByUserId
      capsuleEntity: capsuleEntity != null ? capsuleEntity : self.capsuleEntity
    }
  }

  // recordReclassified - Apply ran for an approved suggestion; the link now
  // points at the record the dish became. resolutionNote keeps "dish:<id>".
  command recordReclassified(
    capsuleEntity: CapsuleEntityType,
    capsuleId: string,
    appliedValues: string,
    resolutionNote: string
  ) {
    guard self.deletedAt == null
    guard self.role == "reclassify"
    guard self.decision == "approved"
    guard self.appliedAt == null
    constraint recordReclassifiedCapsuleIdPresent: length(trim(capsuleId)) > 0 "Give this match a Capsule ID."
    mutate capsuleEntity = capsuleEntity
    mutate capsuleId = capsuleId
    mutate appliedAt = now()
    mutate appliedValues = appliedValues
    mutate resolutionNote = resolutionNote
    emit ExternalRecordReclassified {
      externalRecordLinkId: self.id
      tenantId: self.tenantId
      capsuleEntity: capsuleEntity
      capsuleId: capsuleId
      appliedValues: appliedValues
    }
  }

  // recordReclassifyFailure - Apply failed for this suggestion; the note says
  // why and the row stays approved so a later apply can retry it.
  command recordReclassifyFailure(resolutionNote: string) {
    guard self.deletedAt == null
    guard self.role == "reclassify"
    guard self.appliedAt == null
    constraint recordReclassifyFailureNotePresent: length(trim(resolutionNote)) > 0 "Say why this change failed."
    mutate resolutionNote = resolutionNote
    emit ExternalRecordReclassifyFailed {
      externalRecordLinkId: self.id
      tenantId: self.tenantId
      resolutionNote: resolutionNote
    }
  }

  store ExternalRecordLink in durable
}

// Queries
query findByExternal(
  tenantId: string,
  sourceSystem: ExternalSourceSystem,
  recordType: string,
  externalId: string
): ExternalRecordLink {
  assert tenantId != null
  assert sourceSystem != null
  assert recordType != null
  assert externalId != null
  filter self.tenantId == tenantId
  filter self.sourceSystem == sourceSystem
  filter self.recordType == recordType
  filter self.externalId == externalId
  filter self.deletedAt == null
  sort self.createdAt desc
  limit 1
}

query findByCapsule(
  tenantId: string,
  capsuleEntity: CapsuleEntityType,
  capsuleId: string
): ExternalRecordLink {
  assert tenantId != null
  assert capsuleEntity != null
  assert capsuleId != null
  filter self.tenantId == tenantId
  filter self.capsuleEntity == capsuleEntity
  filter self.capsuleId == capsuleId
  filter self.deletedAt == null
  sort self.createdAt desc
  limit 1
}

query findAllBySourceSystem(
  tenantId: string,
  sourceSystem: ExternalSourceSystem
): ExternalRecordLink[] {
  assert tenantId != null
  assert sourceSystem != null
  filter self.tenantId == tenantId
  filter self.sourceSystem == sourceSystem
  filter self.deletedAt == null
  sort self.createdAt desc
}

query findAllByImportRun(
  tenantId: string,
  sourceImportRunId: string
): ExternalRecordLink[] {
  assert tenantId != null
  assert sourceImportRunId != null
  filter self.tenantId == tenantId
  filter self.sourceImportRunId == sourceImportRunId
  filter self.deletedAt == null
  sort self.createdAt desc
}

query findUnverified(
  tenantId: string,
  optional sourceSystem: ExternalSourceSystem
): ExternalRecordLink[] {
  assert tenantId != null
  filter self.tenantId == tenantId
  filter self.verified == false
  filter sourceSystem == null or self.sourceSystem == sourceSystem
  filter self.deletedAt == null
  sort self.createdAt desc
}

// Events
event ExternalRecordLinked: "external_record_link.linked" {
  externalRecordLinkId: string
  tenantId: string
  sourceSystem: ExternalSourceSystem
  recordType: string
  externalId: string
  capsuleEntity: CapsuleEntityType
  capsuleId: string
  verified: boolean
  sourceImportRunId: string?
}

event ExternalRecordVerified: "external_record_link.verified" {
  externalRecordLinkId: string
  tenantId: string
  verified: boolean
  verifiedByUserId: string
  capsuleEntity: CapsuleEntityType
  capsuleId: string
}

event ExternalRecordUnlinked: "external_record_link.unlinked" {
  externalRecordLinkId: string
  tenantId: string
  reason: string
  unlinkedByUserId: string
  capsuleEntity: CapsuleEntityType
  capsuleId: string
  externalId: string
  sourceSystem: ExternalSourceSystem
}

event ExternalRecordCapsuleIdUpdated: "external_record_link.capsule_id_updated" {
  externalRecordLinkId: string
  tenantId: string
  previousCapsuleId: string
  capsuleId: string
  capsuleEntity: CapsuleEntityType
}

event ExternalRecordConflictResolved: "external_record_link.conflict_resolved" {
  externalRecordLinkId: string
  tenantId: string
  conflictStatus: ConflictStatus
  resolvedByUserId: string
}

event ExternalRecordRetired: "external_record_link.retired" {
  externalRecordLinkId: string
  tenantId: string
  effectiveEndDate: datetime
}

event ExternalRecordDiscarded: "external_record_link.discarded" {
  externalRecordLinkId: string
  tenantId: string
  reason: string
}

event ExternalRecordRelinked: "external_record_link.relinked" {
  externalRecordLinkId: string
  tenantId: string
  capsuleEntity: CapsuleEntityType
  capsuleId: string
  sourceImportRunId: string
  conflictStatus: ConflictStatus
}

event ExternalRecordSuggestionRefreshed: "external_record_link.suggestion_refreshed" {
  externalRecordLinkId: string
  tenantId: string
  capsuleEntity: CapsuleEntityType
  suggestedBy: string
}

event ExternalRecordReclassificationDecided: "external_record_link.reclassification_decided" {
  externalRecordLinkId: string
  tenantId: string
  decision: LinkDecision
  decidedByUserId: string
  capsuleEntity: CapsuleEntityType
}

event ExternalRecordReclassified: "external_record_link.reclassified" {
  externalRecordLinkId: string
  tenantId: string
  capsuleEntity: CapsuleEntityType
  capsuleId: string
  appliedValues: string
}

event ExternalRecordReclassifyFailed: "external_record_link.reclassify_failed" {
  externalRecordLinkId: string
  tenantId: string
  resolutionNote: string
}

// Revision-2 culinary model (2026-09-14). One field-level disagreement between
// the value last applied by import, the current Capsule value and the newest
// source value. Raised only when all three differ. A pending conflict whose
// source value has not changed is never raised again; a different source value
// updates this row instead of creating a second one.
enum ImportConflictStatus {
  pending
  keep_capsule
  take_source
  manual
}

entity ImportConflict mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required externalRecordLinkId: uuid
  property required field: string = ""
  property appliedValue: string?
  property capsuleValue: string?
  property sourceValue: string?
  property sourceVersion: string?
  property required status: ImportConflictStatus = "pending"
  property resolvedByUserId: string?
  property resolvedAt: datetime?
  property resolvedOnSourceVersion: string?
  property raisedAt: datetime?

  belongsTo externalRecordLink: ExternalRecordLink fields [tenantId, externalRecordLinkId] references [tenantId, id]

  constraint conflictFieldPresent: self.raisedAt == null or length(trim(self.field)) > 0 "Say which field is in conflict."

  transition status from "pending" to ["keep_capsule", "take_source", "manual"]
  transition status from "keep_capsule" to ["pending"]
  transition status from "take_source" to ["pending"]
  transition status from "manual" to ["pending"]

  default policy importConflictRead read: roleAllows(user.role, "importAccess") "Staff may see import conflicts"
  default policy importConflictWrite write: roleAllows(user.role, "importAccess") "Staff may update import conflicts"
  default policy importConflictExecute execute: roleAllows(user.role, "importAccess") "Staff may change import conflicts"

  command raise(
    externalRecordLinkId: uuid,
    field: string,
    optional appliedValue: string,
    optional capsuleValue: string,
    optional sourceValue: string,
    optional sourceVersion: string
  ) {
    guard self.raisedAt == null
    guard self.deletedAt == null
    constraint raiseFieldPresent: length(trim(field)) > 0 "Say which field is in conflict."
    mutate externalRecordLinkId = externalRecordLinkId
    mutate field = field
    mutate appliedValue = appliedValue
    mutate capsuleValue = capsuleValue
    mutate sourceValue = sourceValue
    mutate sourceVersion = sourceVersion
    mutate status = "pending"
    mutate raisedAt = now()
    emit ImportConflictRaised {
      importConflictId: self.id
      tenantId: self.tenantId
      externalRecordLinkId: externalRecordLinkId
      field: field
    }
  }

  // A newer source value on a still-pending conflict updates this row.
  command updateSource(sourceValue: string, optional sourceVersion: string, optional capsuleValue: string) {
    guard self.raisedAt != null
    guard self.deletedAt == null
    mutate sourceValue = sourceValue
    mutate sourceVersion = sourceVersion != null ? sourceVersion : self.sourceVersion
    mutate capsuleValue = capsuleValue != null ? capsuleValue : self.capsuleValue
    mutate status = "pending"
  }

  command settle(resolution: ImportConflictStatus, resolvedByUserId: string) {
    guard self.raisedAt != null
    guard self.deletedAt == null
    guard self.status == "pending"
    constraint settleUserPresent: length(trim(resolvedByUserId)) > 0 "Pick who resolved this disagreement."
    constraint settleNotPending: resolution != "pending" "Pick how you resolved this: keep the current value, use the new value, or fix it another way."
    mutate status = resolution
    mutate resolvedByUserId = resolvedByUserId
    mutate resolvedAt = now()
    mutate resolvedOnSourceVersion = self.sourceVersion
    emit ImportConflictResolved {
      importConflictId: self.id
      tenantId: self.tenantId
      externalRecordLinkId: self.externalRecordLinkId
      field: self.field
      status: resolution
    }
  }

  store ImportConflict in durable
}

event ImportConflictRaised: "import_conflict.raised" {
  importConflictId: string
  tenantId: string
  externalRecordLinkId: string
  field: string
}

event ImportConflictResolved: "import_conflict.resolved" {
  importConflictId: string
  tenantId: string
  externalRecordLinkId: string
  field: string
  status: ImportConflictStatus
}
