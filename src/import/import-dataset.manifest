const TPP_CONTACT_MAPPINGS: DatasetConfig = {
  datasetCategory: "contacts",
  targetEntity: "contact",
  uniqueKey: ["tpp_contact_id"],
  importOrder: 1,  // First (no dependencies)
  dependsOn: [],
  fieldMappings: [
    { sourceField: "ContactID", targetField: "externalId", mappingType: "directCopy", required: true, validationRules: [""] },
    { sourceField: "FirstName", targetField: "givenName", mappingType: "directCopy", required: true, validationRules: [""] },
    { sourceField: "LastName", targetField: "familyName", mappingType: "directCopy", required: true, validationRules: [""] },
    { sourceField: "Email", targetField: "email", mappingType: "directCopy", required: false, validationRules: [""] },
    { sourceField: "Phone", targetField: "phone", mappingType: "directCopy", required: false, validationRules: [] },
    { sourceField: "Mobile", targetField: "mobile", mappingType: "directCopy", required: false, validationRules: [] },
    { sourceField: "Title", targetField: "title", mappingType: "directCopy", required: false, validationRules: [] },
    { sourceField: "CompanyID", targetField: "companyId", mappingType: "lookupReference", required: false, validationRules: [""] },
    { sourceField: "IsPrimary", targetField: "isPrimary", mappingType: "transformValue", required: false, validationRules: [], transformation: "parseBoolean" },
    { sourceField: "IsBilling", targetField: "isBillingContact", mappingType: "transformValue", required: false, validationRules: [], transformation: "parseBoolean" },
    { sourceField: "Notes", targetField: "notes", mappingType: "directCopy", required: false, validationRules: [] },
    { sourceField: "CreatedDate", targetField: "createdAt", mappingType: "transformValue", required: false, validationRules: [""], transformation: "parseDateTime" }
  ]
}

