// Capsule import dataset — defines TPP field mappings for import framework.
// Each dataset specifies: source fields → Capsule entity fields, validation rules, transformations.
// Enables systematic TPP migration with clear field ownership and reproducible mappings.

use "./import-run.manifest"

// Dataset types matching ImportDatasetType enum
// These define WHAT to import from TPP legacy system
enum DatasetCategory {
  events           // TPP Events → Capsule Events
  contacts         // TPP Contacts → Capsule Contact/Company
  leads            // TPP Leads/Opportunities → Capsule Leads
  menus            // TPP Menus/Dishes → Capsule Menus/Dishes
  venues           // TPP Venues → Capsule Venues
  payments         // TPP Payments → Capsule Payments
  invoices         // TPP Invoices → Capsule Invoices
  proposals        // TPP Proposals → Capsule Proposals
}

// Field mapping types
enum MappingType {
  directCopy       // Direct field copy (string → string)
  transformValue   // Requires transformation (e.g., date format, enum mapping)
  lookupReference  // Requires lookup reference (e.g., clientId from external ID)
  computedField    // Computed field (e.g., duration from start/end dates)
  skipField        // Skip this field (not mapped)
}

// Validation rule types
enum ValidationRule {
  fieldRequired    // Field must be present
  formatCheck      // Field must match format (email, date, phone)
  rangeCheck       // Numeric value in range
  enumCheck        // Value must be in enum
  lookupCheck      // Reference must exist
  uniqueCheck      // Value must be unique within dataset
}

// Field mapping definition
interface FieldMapping {
  sourceField: string           // TPP field name
  targetField: string           // Capsule entity field
  mappingType: MappingType
  required: boolean             // Whether field is required for import
  validationRules: ValidationRule[]
  transformation?: string       // Transformation rule name (for MappingType.transform)
  defaultValue?: string         // Default value if source is empty
}

// Dataset configuration
interface DatasetConfig {
  datasetCategory: DatasetCategory
  targetEntity: CapsuleEntityType  // From external-record-link.manifest
  fieldMappings: FieldMapping[]
  uniqueKey: string[]              // Fields that form unique key
  importOrder: number               // Import order (1 = first, for dependencies)
  dependsOn: DatasetCategory[]     // Datasets that must be imported first
}

// ImportDataset entity — defines dataset configurations for TPP migration
entity ImportDataset mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required datasetCategory: DatasetCategory = "events"
  property required targetEntity: CapsuleEntityType = "event_record"
  property required config: string = "{}"              // JSON: DatasetConfig
  property required active: boolean = true
  property required importOrder: int = 1
  property required fieldMappingCount: int = 0
  property required dependsOn: string = "[]"           // JSON: DatasetCategory[]
  property required uniqueKeyFields: string = "[]"      // JSON: string[]

  // Metadata
  property name: string?
  property description: string?
  property schemaVersion: string?       // Dataset schema version (renamed to avoid conflict with entity version)
  property lastImportRunId: string?     // Reference to last successful import

  // Constraints
  constraint datasetCategoryValid: self.datasetCategory != null "Dataset category is required"
  constraint configValid: length(trim(self.config)) > 0 "Dataset config is required"
  constraint importOrderPositive: self.importOrder > 0 "Import order must be positive"

  // Policies
  default policy importDatasetRead read: roleAllows(user.role, "importAccess") "Staff may read import datasets"
  default policy importDatasetWrite write: roleAllows(user.role, "importAccess") "Staff may write import datasets"

  // register - Create a new dataset definition
  command register(
    datasetCategory: DatasetCategory,
    targetEntity: CapsuleEntityType,
    config: string,
    optional name: string,
    optional description: string,
    optional schemaVersion: string,
    optional importOrder: int,
    optional dependsOn: string,
    optional uniqueKeyFields: string
  ) {
    guard self.deletedAt == null
    guard self.createdAt == null
    constraint datasetCategoryValid: datasetCategory != null "Dataset category is required"
    constraint configPresent: length(trim(config)) > 0 "Dataset config is required"
    mutate datasetCategory = datasetCategory
    mutate targetEntity = targetEntity
    mutate config = config
    mutate name = name
    mutate description = description
    mutate schemaVersion = schemaVersion
    mutate importOrder = importOrder != null ? importOrder : 1
    mutate dependsOn = dependsOn != null ? dependsOn : "[]"
    mutate uniqueKeyFields = uniqueKeyFields != null ? uniqueKeyFields : "[]"
    mutate active = true
    mutate fieldMappingCount = 0  // Will be computed from config
    emit ImportDatasetRegistered {
      importDatasetId: self.id
      tenantId: self.tenantId
      datasetCategory: datasetCategory
      targetEntity: targetEntity
      name: name != null ? name : ""
    }
  }

  // updateConfig - Update dataset configuration
  command updateConfig(
    config: string,
    optional fieldMappingCount: number,
    optional name: string,
    optional description: string
  ) {
    guard self.deletedAt == null
    guard self.createdAt != null
    constraint configPresent: length(trim(config)) > 0 "Dataset config is required"
    mutate config = config
    mutate fieldMappingCount = fieldMappingCount != null ? fieldMappingCount : self.fieldMappingCount
    mutate name = name != null ? name : self.name
    mutate description = description != null ? description : self.description
    emit ImportDatasetConfigUpdated {
      importDatasetId: self.id
      tenantId: self.tenantId
      datasetCategory: self.datasetCategory
      fieldMappingCount: fieldMappingCount != null ? fieldMappingCount : self.fieldMappingCount
    }
  }

  // activate - Enable dataset for import
  command activate() {
    guard self.deletedAt == null
    guard self.createdAt != null
    mutate active = true
    emit ImportDatasetActivated {
      importDatasetId: self.id
      tenantId: self.tenantId
      datasetCategory: self.datasetCategory
    }
  }

  // deactivate - Disable dataset from import
  command deactivate() {
    guard self.deletedAt == null
    guard self.createdAt != null
    mutate active = false
    emit ImportDatasetDeactivated {
      importDatasetId: self.id
      tenantId: self.tenantId
      datasetCategory: self.datasetCategory
    }
  }

  // recordLastImport - Update reference to last successful import
  command recordLastImport(importRunId: string) {
    guard self.deletedAt == null
    guard self.createdAt != null
    constraint importRunPresent: length(trim(importRunId)) > 0 "Import run ID is required"
    mutate lastImportRunId = importRunId
    emit ImportDatasetLastImportRecorded {
      importDatasetId: self.id
      tenantId: self.tenantId
      datasetCategory: self.datasetCategory
      importRunId: importRunId
    }
  }

  store ImportDataset in durable
}

// Queries
query findByCategory(
  tenantId: string,
  datasetCategory: DatasetCategory
): ImportDataset {
  assert tenantId != null
  assert datasetCategory != null
  filter self.tenantId == tenantId
  filter self.datasetCategory == datasetCategory
  filter self.deletedAt == null
  limit 1
}

query listActiveByTenant(tenantId: string): ImportDataset[] {
  assert tenantId != null
  filter self.tenantId == tenantId
  filter self.active == true
  filter self.deletedAt == null
  sort self.importOrder asc
}

query listByImportOrder(tenantId: string): ImportDataset[] {
  assert tenantId != null
  filter self.tenantId == tenantId
  filter self.deletedAt == null
  sort self.importOrder asc
}

// Events
event ImportDatasetRegistered: "import_dataset.registered" {
  importDatasetId: string
  tenantId: string
  datasetCategory: DatasetCategory
  targetEntity: CapsuleEntityType
  name: string
}

event ImportDatasetConfigUpdated: "import_dataset.config_updated" {
  importDatasetId: string
  tenantId: string
  datasetCategory: DatasetCategory
  fieldMappingCount: number
}

event ImportDatasetActivated: "import_dataset.activated" {
  importDatasetId: string
  tenantId: string
  datasetCategory: DatasetCategory
}

event ImportDatasetDeactivated: "import_dataset.deactivated" {
  importDatasetId: string
  tenantId: string
  datasetCategory: DatasetCategory
}

event ImportDatasetLastImportRecorded: "import_dataset.last_import_recorded" {
  importDatasetId: string
  tenantId: string
  datasetCategory: DatasetCategory
  importRunId: string
}

// ============================================================================
// TPP EVENT DATASET CONFIGURATION (27 fields)
// ============================================================================

// Event field mappings: TPP → Capsule
// TPP has 27 event fields per spec §6.2
const TPP_EVENT_MAPPINGS: DatasetConfig = {
  datasetCategory: "events",
  targetEntity: "event_record",
  uniqueKey: ["tpp_event_id"],
  importOrder: 3,  // After contacts, venues
  dependsOn: ["contacts", "venues"],
  fieldMappings: [
    // Identity fields
    { sourceField: "EventID", targetField: "externalId", mappingType: "directCopy", required: true, validationRules: [""] },
    { sourceField: "EventName", targetField: "title", mappingType: "directCopy", required: true, validationRules: [""] },
    { sourceField: "EventType", targetField: "occasionId", mappingType: "lookupReference", required: false, validationRules: [""], transformation: "mapOccasion" },
    { sourceField: "ServiceStyle", targetField: "serviceStyleId", mappingType: "lookupReference", required: false, validationRules: [""], transformation: "mapServiceStyle" },

    // Date/time fields
    { sourceField: "EventDate", targetField: "startsAt", mappingType: "transformValue", required: true, validationRules: [""], transformation: "parseDateTime" },
    { sourceField: "StartTime", targetField: "startsAt", mappingType: "transformValue", required: true, validationRules: [""], transformation: "mergeDateTime" },
    { sourceField: "EndTime", targetField: "endsAt", mappingType: "transformValue", required: true, validationRules: [""], transformation: "mergeDateTime" },
    { sourceField: "SetupTime", targetField: "setupDuration", mappingType: "transformValue", required: false, validationRules: [""], transformation: "parseDuration" },
    { sourceField: "TeardownTime", targetField: "teardownDuration", mappingType: "transformValue", required: false, validationRules: [""], transformation: "parseDuration" },

    // Guest/headcount fields
    { sourceField: "GuaranteedCount", targetField: "guaranteedHeadcount", mappingType: "directCopy", required: false, validationRules: [""] },
    { sourceField: "ExpectedCount", targetField: "expectedHeadcount", mappingType: "directCopy", required: true, validationRules: [""] },
    { sourceField: "ActualCount", targetField: "actualHeadcount", mappingType: "directCopy", required: false, validationRules: [""] },

    // Venue/location fields
    { sourceField: "VenueID", targetField: "venueId", mappingType: "lookupReference", required: false, validationRules: [""] },
    { sourceField: "VenueName", targetField: "venueName", mappingType: "directCopy", required: false, validationRules: [] },
    { sourceField: "LocationAddress", targetField: "locationAddress", mappingType: "directCopy", required: false, validationRules: [] },
    { sourceField: "LocationCity", targetField: "locationCity", mappingType: "directCopy", required: false, validationRules: [] },
    { sourceField: "LocationState", targetField: "locationState", mappingType: "directCopy", required: false, validationRules: [] },
    { sourceField: "LocationZip", targetField: "locationPostalCode", mappingType: "directCopy", required: false, validationRules: [] },

    // Client/contact fields
    { sourceField: "ClientID", targetField: "clientId", mappingType: "lookupReference", required: true, validationRules: [""] },
    { sourceField: "PrimaryContactID", targetField: "primaryContactId", mappingType: "lookupReference", required: false, validationRules: [""] },
    { sourceField: "SalespersonID", targetField: "assignedToId", mappingType: "lookupReference", required: false, validationRules: [""] },

    // Financial fields
    { sourceField: "TotalRevenue", targetField: "quotedRevenue", mappingType: "transformValue", required: false, validationRules: [""], transformation: "parseMoney" },
    { sourceField: "DepositAmount", targetField: "depositAmount", mappingType: "transformValue", required: false, validationRules: [""], transformation: "parseMoney" },
    { sourceField: "BudgetAmount", targetField: "budgetAmount", mappingType: "transformValue", required: false, validationRules: [""], transformation: "parseMoney" },

    // Status/workflow fields
    { sourceField: "EventStatus", targetField: "stage", mappingType: "transformValue", required: true, validationRules: [""], transformation: "mapEventStage" },
    { sourceField: "Probability", targetField: "probability", mappingType: "directCopy", required: false, validationRules: [""] },

    // Notes/metadata
    { sourceField: "EventNotes", targetField: "notes", mappingType: "directCopy", required: false, validationRules: [] },
    { sourceField: "SpecialRequirements", targetField: "operationalRequirements", mappingType: "directCopy", required: false, validationRules: [] },
    { sourceField: "AccessibilityNeeds", targetField: "accessibilityRequirements", mappingType: "directCopy", required: false, validationRules: [] },

    // Timestamps
    { sourceField: "CreatedDate", targetField: "createdAt", mappingType: "transformValue", required: false, validationRules: [""], transformation: "parseDateTime" },
    { sourceField: "ModifiedDate", targetField: "updatedAt", mappingType: "transformValue", required: false, validationRules: [""], transformation: "parseDateTime" }
  ]
}

