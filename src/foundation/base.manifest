// Capsule foundation — single tenant declaration, role hierarchy, shared
// mixins, and the Organization account that operates inside a tenant.
//
// Every later domain file must `use` this module (or a successor entry that
// re-exports it) so tenant/roles are declared exactly once.

tenant tenantId : string from context.tenantId

// ---------------------------------------------------------------------------
// Roles — capability hierarchy for Capsule operators.
// Policies check roleAllows(user.role, "<capability>"); never role-name lists.
// Unknown roles deny by default. Deny is absolute over inherited allows.
// ---------------------------------------------------------------------------

role staff {
  allow staffAccess
  // Own workforce records remain subject to the organization's workforce switch.
  // Each self-service policy also requires the authenticated Person link.
  allow workforceSelfAccess
}

role kitchen_staff extends staff {
  allow kitchenAccess
}

role kitchen_lead extends kitchen_staff {
  allow kitchenLeadAccess
}

role sales_staff extends staff {
  allow salesAccess
}

role event_staff extends staff {
  allow eventAccess
}

role inventory_staff extends staff {
  allow inventoryAccess
}

role procurement_staff extends inventory_staff {
  allow procurementAccess
}

role logistics_staff extends staff {
  allow logisticsAccess
}

role driver extends logistics_staff {}

role workforce_staff extends staff {
  allow workforceAccess
}

role finance_staff extends staff {
  allow financeAccess
}

role manager extends staff {
  allow manageAccess
  // Import framework (ExternalRecordLink / ImportRun / ImportDataset) reads +
  // writes gate on importAccess. Granting at the manager tier propagates to
  // every *_manager, admin, owner, system — the operators who run TPP imports.
  // Without this, every generated import read returns [] for all users
  // (checkRole("importAccess") was unsatisfiable) and the reconcile queue +
  // source provenance are invisible. See docs §6.1/§6.4.
  allow importAccess
}

role kitchen_manager extends manager {
  allow kitchenAccess
  allow kitchenLeadAccess
  allow kitchenManageAccess
}

role sales_manager extends manager {
  allow salesAccess
  allow salesManageAccess
}

role event_manager extends manager {
  allow eventAccess
  allow eventManageAccess
}

role inventory_manager extends manager {
  allow inventoryAccess
  allow procurementAccess
  allow inventoryManageAccess
}

role logistics_manager extends manager {
  allow logisticsAccess
  allow logisticsManageAccess
}

role workforce_manager extends manager {
  allow workforceAccess
  allow workforceManageAccess
}

role finance_manager extends manager {
  allow financeAccess
  allow financeManageAccess
}

role admin extends manager {
  allow adminAccess
  allow kitchenAccess
  allow kitchenLeadAccess
  allow kitchenManageAccess
  allow salesAccess
  allow salesManageAccess
  allow eventAccess
  allow eventManageAccess
  allow inventoryAccess
  allow procurementAccess
  allow inventoryManageAccess
  allow logisticsAccess
  allow logisticsManageAccess
  allow workforceAccess
  allow workforceManageAccess
  allow financeAccess
  allow financeManageAccess
}

role owner extends admin {}

role system extends admin {}

// ---------------------------------------------------------------------------
// Mixins — applied with header form: `entity X mixin TenantScoped, SoftDeletable`
// Modifier keywords must follow `property` (e.g. `property indexed required`).
// ---------------------------------------------------------------------------

entity TenantScoped {
  property required id: uuid
  // Must match tenant declaration / context.tenantId (string), not uuid.
  property indexed required tenantId: string
}

entity SoftDeletable {
  property deletedAt: datetime?
}

// ---------------------------------------------------------------------------
// Organization — catering operator account inside a tenant.
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  active
  suspended
  deactivated
}

// How a route fetch treats traffic: expected traffic at the departure time,
// or plain road time.
enum RouteTrafficPolicy {
  traffic_aware
  no_traffic
}

entity Organization mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required searchable name: string
  property required status: OrganizationStatus = "active"
  property brandDisplayName: string?
  property brandAddress: string?
  property brandPrimaryColor: string?
  property brandAccentColor: string?
  // Convex storage id of the tenant logo. Lives on the tenant record, not
  // on a Clerk organization, so person-first admins (no Clerk org) keep
  // their upload (#237). The Clerk org image stays a read fallback.
  property brandLogoStorageId: string?
  // 4217 three-letter code used by financial reports as the tenant's
  // functional currency. Invoices issued in another currency store an
  // exchangeRate so reports can fold the issued total back into this code.
  property defaultCurrencyCode: string?
  property defaultExchangeRateScale: int = 6
  // Drive-time rules (spec §8.4, PL-ROUTES): extra minutes added before the
  // shop departure time, whether the route uses expected traffic, and how many
  // hours a fetched route stays current. Unset reads as 15 / traffic / 24.
  property routeSafetyBufferMinutes: int?
  property routeTrafficPolicy: RouteTrafficPolicy?
  property routeRefreshHours: int?
  // Event timing rules (spec §8.4, PL-TIMING): on-site setup before serve
  // for full and limited service, crew briefing before loading, the load
  // time used when no load rule matches, and the load rules themselves (JSON
  // list read by src/lib/eventTimingPolicy.ts). Unset reads as 180 / 90 / 0 /
  // 60 and no rules.
  property timingFullServiceSetupMinutes: int?
  property timingLimitedServiceSetupMinutes: int?
  property timingBriefingMinutes: int?
  property timingLoadBaselineMinutes: int?
  property timingLoadRulesJson: string?
  // Planning board: how loud each check is (JSON map of check to
  // fix | look | off, read by src/lib/planningChecks.ts). Unset = defaults.
  property planningChecksJson: string?
  // The fields each equipment category asks for: {"Ovens": ["Fuel", "Burners"]}.
  property equipmentFieldsJson: string?

  computed isOperable: boolean = self.status == "active" and self.deletedAt == null
  // 3-character ISO 4217, uppercase. Defaults to USD when unset so existing
  // tenants without a configured default continue to report in USD.
  computed functionalCurrencyCode: string = self.defaultCurrencyCode != null and length(trim(self.defaultCurrencyCode)) == 3 ? self.defaultCurrencyCode : "USD"

  constraint namePresent: length(trim(self.name)) > 0 "Give your company a name."

  transition status from "active" to ["suspended", "deactivated"]
  transition status from "suspended" to ["active", "deactivated"]
  transition status from "deactivated" to []

  default policy organizationRead read: roleAllows(user.role, "staffAccess") "Staff may see the company profile"
  default policy organizationWrite write: roleAllows(user.role, "manageAccess") "Managers may update the company profile"
  default policy organizationExecute execute: roleAllows(user.role, "manageAccess") "Managers may change the company profile"

  // Stricter than default manageAccess: admin-only registration.
  // Named non-default policies do not attach to commands on Manifest 3.6.3 —
  // use a command guard (see docs/projection-blockers.md PB004).
  command register(
    name: string,
    optional brandDisplayName: string,
    optional brandAddress: string,
    optional brandPrimaryColor: string,
    optional brandAccentColor: string
  ) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "adminAccess")
    constraint registerName: length(trim(name)) > 0 "Give your company a name."
    mutate name = name
    mutate brandDisplayName = brandDisplayName
    mutate brandAddress = brandAddress
    mutate brandPrimaryColor = brandPrimaryColor
    mutate brandAccentColor = brandAccentColor
    emit OrganizationRegistered {
      organizationId: self.id
      tenantId: self.tenantId
      name: name
      brandDisplayName: brandDisplayName
      brandAddress: brandAddress
      brandPrimaryColor: brandPrimaryColor
      brandAccentColor: brandAccentColor
    }
  }

  command rename(name: string) {
    guard self.status == "active"
    guard self.deletedAt == null
    constraint renameName: length(trim(name)) > 0 "Give your company a name."
    mutate name = name
    emit OrganizationRenamed {
      organizationId: self.id
      tenantId: self.tenantId
      name: name
    }
  }

  command configureBranding(
    displayName: string,
    address: string,
    primaryColor: string,
    accentColor: string
  ) {
    // Deleted tenant records cannot produce customer documents.
    guard self.deletedAt == null
    mutate brandDisplayName = displayName
    mutate brandAddress = address
    mutate brandPrimaryColor = primaryColor
    mutate brandAccentColor = accentColor
    emit OrganizationBrandingConfigured {
      organizationId: self.id
      tenantId: self.tenantId
      displayName: displayName
      address: address
      primaryColor: primaryColor
      accentColor: accentColor
    }
  }

  // Point the tenant logo at an uploaded Convex blob; omit storageId to
  // remove the logo. Blob upload/cleanup is the authored convex/brandLogo.ts seam.
  command setBrandLogo(optional storageId: string) {
    guard self.deletedAt == null
    compute previousStorageId = self.brandLogoStorageId
    mutate brandLogoStorageId = storageId
    emit OrganizationBrandLogoSet {
      organizationId: self.id
      tenantId: self.tenantId
      storageId: storageId
      previousStorageId: previousStorageId
    }
  }

  // Set the tenant's default (functional) currency. ISO 4217 three-letter
  // uppercase codes only — the same code is reused by financial reports.
  command setDefaultCurrency(currencyCode: string) {
    guard self.deletedAt == null
    constraint setDefaultCurrencyCodeFormat: length(trim(currencyCode)) == 3 "Enter a three-letter currency code, like USD."
    compute normalizedCode = toUpperCase(currencyCode)
    mutate defaultCurrencyCode = normalizedCode
    emit OrganizationDefaultCurrencySet {
      organizationId: self.id
      tenantId: self.tenantId
      currencyCode: normalizedCode
    }
  }

  // Company drive-time rules; the event route read and refresh use them.
  command configureRoutePolicy(
    safetyBufferMinutes: int,
    trafficPolicy: RouteTrafficPolicy,
    refreshHours: int
  ) {
    guard self.deletedAt == null
    constraint routeBufferRange: safetyBufferMinutes >= 0 and safetyBufferMinutes <= 240 "Use a safety buffer from 0 to 240 minutes."
    constraint routeRefreshRange: refreshHours >= 1 and refreshHours <= 720 "Refresh drive times every 1 to 720 hours."
    mutate routeSafetyBufferMinutes = safetyBufferMinutes
    mutate routeTrafficPolicy = trafficPolicy
    mutate routeRefreshHours = refreshHours
    emit OrganizationRoutePolicyConfigured {
      organizationId: self.id
      tenantId: self.tenantId
      safetyBufferMinutes: safetyBufferMinutes
      refreshHours: refreshHours
    }
  }

  // Company event timing rules; open events that follow them are re-planned.
  command configureTimingPolicy(
    fullServiceSetupMinutes: int,
    limitedServiceSetupMinutes: int,
    briefingMinutes: int,
    loadBaselineMinutes: int,
    optional loadRulesJson: string
  ) {
    guard self.deletedAt == null
    constraint timingFullSetupRange: fullServiceSetupMinutes >= 0 and fullServiceSetupMinutes <= 720 "Use a full service setup time from 0 to 720 minutes."
    constraint timingLimitedSetupRange: limitedServiceSetupMinutes >= 0 and limitedServiceSetupMinutes <= 720 "Use a limited service setup time from 0 to 720 minutes."
    constraint timingBriefingRange: briefingMinutes >= 0 and briefingMinutes <= 240 "Use a briefing time from 0 to 240 minutes."
    constraint timingLoadBaselineRange: loadBaselineMinutes >= 0 and loadBaselineMinutes <= 480 "Use a standard load time from 0 to 480 minutes."
    mutate timingFullServiceSetupMinutes = fullServiceSetupMinutes
    mutate timingLimitedServiceSetupMinutes = limitedServiceSetupMinutes
    mutate timingBriefingMinutes = briefingMinutes
    mutate timingLoadBaselineMinutes = loadBaselineMinutes
    mutate timingLoadRulesJson = loadRulesJson
    emit OrganizationTimingPolicyConfigured {
      organizationId: self.id
      tenantId: self.tenantId
    }
  }

  // How the planning board treats each check. Empty goes back to the defaults.
  command configurePlanningChecks(optional checksJson: string) {
    guard self.deletedAt == null
    mutate planningChecksJson = checksJson
    emit OrganizationPlanningChecksConfigured {
      organizationId: self.id
      tenantId: self.tenantId
    }
  }

  command configureEquipmentFields(optional fieldsJson: string) {
    guard self.deletedAt == null
    mutate equipmentFieldsJson = fieldsJson
    emit OrganizationEquipmentFieldsConfigured {
      organizationId: self.id
      tenantId: self.tenantId
    }
  }

  command suspend(reason: string = "") {
    guard self.status == "active"
    guard self.deletedAt == null
    mutate status = "suspended"
    emit OrganizationSuspended {
      organizationId: self.id
      tenantId: self.tenantId
      reason: reason
    }
  }

  command reactivate() {
    guard self.status == "suspended"
    guard self.deletedAt == null
    mutate status = "active"
    emit OrganizationReactivated {
      organizationId: self.id
      tenantId: self.tenantId
    }
  }

  command deactivate() {
    guard self.status == "active" or self.status == "suspended"
    mutate status = "deactivated"
    mutate deletedAt = now()
    emit OrganizationDeactivated {
      organizationId: self.id
      tenantId: self.tenantId
    }
  }

  store Organization in durable
}

event OrganizationRegistered: "organization.registered" {
  organizationId: string
  tenantId: string
  name: string
  brandDisplayName: string?
  brandAddress: string?
  brandPrimaryColor: string?
  brandAccentColor: string?
}

event OrganizationBrandingConfigured: "organization.branding_configured" {
  organizationId: string
  tenantId: string
  displayName: string
  address: string
  primaryColor: string
  accentColor: string
}

event OrganizationBrandLogoSet: "organization.brand_logo_set" {
  organizationId: string
  tenantId: string
  storageId: string?
  previousStorageId: string?
}

event OrganizationRenamed: "organization.renamed" {
  organizationId: string
  tenantId: string
  name: string
}

event OrganizationSuspended: "organization.suspended" {
  organizationId: string
  tenantId: string
  reason: string
}

event OrganizationReactivated: "organization.reactivated" {
  organizationId: string
  tenantId: string
}

event OrganizationDefaultCurrencySet: "organization.default_currency_set" {
  organizationId: string
  tenantId: string
  currencyCode: string
}

event OrganizationRoutePolicyConfigured: "organization.route_policy_configured" {
  organizationId: string
  tenantId: string
  safetyBufferMinutes: int
  refreshHours: int
}

event OrganizationTimingPolicyConfigured: "organization.timing_policy_configured" {
  organizationId: string
  tenantId: string
}

event OrganizationEquipmentFieldsConfigured: "organization.equipment_fields_configured" {
  organizationId: string
  tenantId: string
}

event OrganizationPlanningChecksConfigured: "organization.planning_checks_configured" {
  organizationId: string
  tenantId: string
}

event OrganizationDeactivated: "organization.deactivated" {
  organizationId: string
  tenantId: string
}
