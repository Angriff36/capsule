// IntegrationConnection — spec §12.1 "Common integration contract".
//
// One row per (tenant, provider): status, the provider-side account id, granted
// scopes, and last-successful-sync / last-error visibility. This is the record
// spec §12.1 asks for ("Integration Connection with tenant, provider, status,
// encrypted credentials/reference, scopes, and last successful sync") and the
// prerequisite for per-tenant Stripe Connect (issue #112) — a tenant's payments
// must settle to that tenant, which needs somewhere to hold its `acct_...` id.
//
// Stripe Connect direct charges need only the connected-account id plus the
// platform key, so no Stripe secret is stored here.
// ~~QuickBooks and Google Calendar keep replaying their encrypted tokens out of
// the shared `manifestEvents` ledger exactly as they do today; `credentialRef`
// is a pointer for those providers to adopt later, not a migration.~~
// Correction 2026-09-29: QuickBooks and Google Calendar now keep their OAuth
// connection on this row (convex/qboSync.ts, convex/googleCalendar.ts): the
// refresh token sits in `oauthRefreshToken` (encrypted at rest, private — no
// generated read returns it) and each reconcile lands through
// `recordReconciliation`. Tenants connected before this change still have
// their connection in the old `manifestEvents` ledger rows; the seams read
// those only while this row does not exist yet, and move the connection here
// on the next scheduled sync (no reconnect needed). No new ledger rows are
// written.

enum IntegrationProvider {
  stripe
  quickbooks
  google_calendar
  email
  sms
  nowsta
  instagram
  facebook
  tiktok
}

enum IntegrationConnectionStatus {
  disconnected
  pending
  connected
  error
  revoked
}

entity IntegrationConnection mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  unique [tenantId, provider]
  timestamps
  versionProperty version: number

  property required provider: IntegrationProvider = "stripe"
  property required status: IntegrationConnectionStatus = "disconnected"
  // Provider-side account identity: Stripe `acct_...`, QuickBooks realmId,
  // Google calendar id. Not a secret — safe to read.
  property externalAccountId: string?
  property displayName: string?
  // Space-separated granted scopes, verbatim from the provider.
  property scopes: string?
  // Pointer to where a secret lives (e.g. a manifestEvents ledger event type).
  // Never the secret itself.
  property credentialRef: string?
  property lastSuccessfulSyncAt: datetime?
  property lastErrorMessage: string?
  property lastErrorAt: datetime?
  // Stripe Connect onboarding: the provider tells us whether the account can
  // actually accept charges yet. Both false while onboarding is incomplete.
  property required chargesEnabled: boolean = false
  property required payoutsEnabled: boolean = false
  // Explicit nullable flag (not the timestamps mixin) so the create guard works.
  property connectedAt: datetime?

  // OAuth providers (QuickBooks, Google Calendar). The refresh token is sealed
  // at rest and `private`, so no generated read ever returns it; only the
  // provider seam reads it back to call the provider.
  property private encrypted oauthRefreshToken: string?
  // The current OAuth consent. Each consent gets a fresh id; scheduled sync
  // chains carry it and stop as soon as it no longer matches. Tenants that
  // connected before 2026-09-29 keep the id their ledger row carried.
  property engagementId: string?
  property connectedById: string?
  // When the current OAuth consent was granted. Never cleared: it marks a row
  // that the OAuth seams own (the cutover gate reads sync evidence from it).
  property grantedAt: datetime?
  // The latest reconcile of the current consent. `lastSyncSummary` holds the
  // provider's own counts as JSON (Calendar: createdOrUpdated/deleted/...;
  // QuickBooks: invoicesSynced/paymentsSynced/...).
  property lastSyncAt: datetime?
  property lastSyncStatus: string?
  property lastSyncFailedCount: int?
  property lastSyncSummary: string?
  // Per-record sync state from the old manifestEvents ledger has been copied
  // into IntegrationSyncRecord rows for this tenant and provider.
  property ledgerImportedAt: datetime?

  // Every command that writes `status` needs its transition declared, including
  // self-transitions — Manifest rejects an undeclared same-value write. The
  // commands write: markConnected/recordSyncSuccess → connected (callable while
  // already connected, i.e. a plain refresh), recordFailure → error (repeat
  // failures land error → error), disconnect → revoked (reachable from any
  // live state, including mid-onboarding), reauthorize → pending.
  // An incomplete matrix here is not a safety feature: a refused refresh gets
  // recorded as a provider failure and blocks payment links.
  transition status from "disconnected" to ["pending", "connected", "error", "revoked"]
  transition status from "pending" to ["connected", "error", "disconnected", "revoked"]
  transition status from "connected" to ["connected", "error", "revoked", "pending"]
  transition status from "error" to ["pending", "connected", "error", "revoked", "disconnected"]
  transition status from "revoked" to ["pending", "disconnected"]

  computed isUsable: boolean = self.status == "connected" and self.deletedAt == null
  // Stripe: a connected account that cannot accept charges must not be sent
  // customers. Non-payment providers ignore chargesEnabled.
  computed canAcceptCharges: boolean = self.status == "connected" and self.chargesEnabled and self.deletedAt == null

  // Read at the manager tier so an operator can see integration health; write
  // and execute at admin because connecting a payment account binds real money.
  default policy integrationConnectionRead read: roleAllows(user.role, "manageAccess") "Managers may see outside-service connections"
  default policy integrationConnectionWrite write: roleAllows(user.role, "adminAccess") "Admins may update outside-service connections"
  default policy integrationConnectionExecute execute: roleAllows(user.role, "adminAccess") "Admins may change outside-service connections"

  // Begin an onboarding/authorization attempt. Creates the row.
  // Named `authorize`, not `connect` — `connect` is a Manifest reserved word.
  command authorize(
    provider: IntegrationProvider,
    optional externalAccountId: string,
    optional displayName: string,
    optional scopes: string,
    optional credentialRef: string
  ) {
    guard self.connectedAt == null
    guard self.deletedAt == null
    guard user.id != null
    mutate provider = provider
    mutate externalAccountId = externalAccountId
    mutate displayName = displayName
    mutate scopes = scopes
    mutate credentialRef = credentialRef
    mutate status = "pending"
    mutate connectedAt = now()
    emit IntegrationConnectionStarted {
      connectionId: self.id
      tenantId: self.tenantId
      provider: provider
      externalAccountId: externalAccountId
    }
  }

  // Re-open onboarding on an existing row. Without this, a connection that was
  // revoked (or errored) could never be reconnected: `authorize` only creates,
  // and `markConnected` would attempt revoked → connected, which no transition
  // allows. Every non-terminal status may return to `pending`.
  command reauthorize() {
    guard self.connectedAt != null
    guard self.deletedAt == null
    guard user.id != null
    mutate status = "pending"
    mutate lastErrorMessage = null
    mutate lastErrorAt = null
    emit IntegrationConnectionReauthorized {
      connectionId: self.id
      tenantId: self.tenantId
      provider: self.provider
    }
  }

  // Provider confirmed the account. For Stripe this carries the account's real
  // charges/payouts capability so the UI never sends customers to a connected
  // account that cannot take money yet.
  command markConnected(
    optional externalAccountId: string,
    optional displayName: string,
    optional scopes: string,
    chargesEnabled: boolean,
    payoutsEnabled: boolean
  ) {
    guard self.connectedAt != null
    guard self.deletedAt == null
    guard user.id != null
    mutate externalAccountId = externalAccountId
    mutate displayName = displayName
    mutate scopes = scopes
    mutate chargesEnabled = chargesEnabled
    mutate payoutsEnabled = payoutsEnabled
    mutate status = "connected"
    mutate lastErrorMessage = null
    mutate lastErrorAt = null
    emit IntegrationConnectionEstablished {
      connectionId: self.id
      tenantId: self.tenantId
      provider: self.provider
      externalAccountId: externalAccountId
      chargesEnabled: chargesEnabled
    }
  }

  // §12.1 "visible pending/failed integration state" — a provider outage marks
  // the connection, it never rolls back unrelated user work.
  command recordFailure(reason: string) {
    guard self.connectedAt != null
    guard self.deletedAt == null
    constraint integrationFailureReason: length(trim(reason)) > 0 "Say why the connection failed."
    mutate status = "error"
    mutate lastErrorMessage = reason
    mutate lastErrorAt = now()
    emit IntegrationConnectionFailed {
      connectionId: self.id
      tenantId: self.tenantId
      provider: self.provider
      reason: reason
    }
  }

  // §12.1 "last successful sync".
  command recordSyncSuccess() {
    guard self.connectedAt != null
    guard self.deletedAt == null
    mutate status = "connected"
    mutate lastSuccessfulSyncAt = now()
    mutate lastErrorMessage = null
    mutate lastErrorAt = null
    emit IntegrationConnectionSynced {
      connectionId: self.id
      tenantId: self.tenantId
      provider: self.provider
    }
  }

  command disconnect(optional reason: string) {
    guard self.deletedAt == null
    guard user.id != null
    mutate status = "revoked"
    mutate chargesEnabled = false
    mutate payoutsEnabled = false
    mutate lastErrorMessage = reason
    // An OAuth provider forgets the token and ends the consent, so running
    // sync chains stop at their next tick.
    mutate oauthRefreshToken = null
    mutate engagementId = null
    emit IntegrationConnectionRevoked {
      connectionId: self.id
      tenantId: self.tenantId
      provider: self.provider
    }
  }

  // OAuth consent granted (QuickBooks, Google Calendar). Only the provider seam
  // runs this, as the tenant's system identity, after checking that the
  // person connecting may manage the workspace (the seam's own check, which
  // lets managers connect these two providers). The person is recorded
  // explicitly because the system identity is not them. Called right after
  // `authorize` (new row) or `reauthorize` (revoked row) in one transaction.
  command recordOAuthGrant(
    engagementId: string,
    externalAccountId: string,
    refreshToken: string,
    connectedById: string,
    grantedAt: datetime
  ) {
    guard user.role == "system" "Only Capsule can save an outside-service sign-in"
    guard self.connectedAt != null
    guard self.deletedAt == null
    guard self.provider == "quickbooks" or self.provider == "google_calendar" "Only QuickBooks and Google Calendar connect through OAuth"
    constraint oauthGrantEngagement: length(trim(engagementId)) > 0 "The connection needs an id."
    constraint oauthGrantToken: length(trim(refreshToken)) > 0 "The provider did not return a refresh token."
    mutate status = "connected"
    mutate externalAccountId = externalAccountId
    mutate oauthRefreshToken = refreshToken
    mutate engagementId = engagementId
    mutate connectedById = connectedById
    mutate grantedAt = grantedAt
    mutate lastSyncAt = null
    mutate lastSyncStatus = null
    mutate lastSyncFailedCount = null
    mutate lastSyncSummary = null
    mutate lastSuccessfulSyncAt = null
    mutate lastErrorMessage = null
    mutate lastErrorAt = null
    emit IntegrationConnectionGranted {
      connectionId: self.id
      tenantId: self.tenantId
      provider: self.provider
      engagementId: engagementId
      externalAccountId: externalAccountId
      connectedById: connectedById
    }
  }

  // QuickBooks hands out a new refresh token on every refresh; the next sync
  // needs the new one.
  command rotateOAuthCredential(engagementId: string, refreshToken: string) {
    guard user.role == "system" "Only CapsuleX rotates a stored credential"
    guard self.deletedAt == null
    guard self.engagementId == engagementId "That connection has been replaced"
    guard self.status == "connected" or self.status == "error"
    constraint oauthRotateToken: length(trim(refreshToken)) > 0 "The provider did not return a refresh token."
    mutate oauthRefreshToken = refreshToken
    emit IntegrationCredentialRotated {
      connectionId: self.id
      tenantId: self.tenantId
      provider: self.provider
    }
  }

  // One finished reconcile of the current consent. A clean run (nothing failed,
  // no error) counts as the last successful sync; anything else is the latest
  // failure. A refused refresh token (`needs_reconnect`) marks the connection
  // as failed until someone reconnects it.
  command recordReconciliation(
    engagementId: string,
    outcome: string,
    failedCount: int,
    summary: string,
    optional error: string
  ) {
    guard user.role == "system" "Only Capsule can save a sync result"
    guard self.deletedAt == null
    guard self.engagementId == engagementId "That connection has been replaced"
    guard self.status == "connected" or self.status == "error"
    compute clean = failedCount == 0 and error == null
    mutate status = outcome == "needs_reconnect" ? "error" : "connected"
    mutate lastSyncAt = now()
    mutate lastSyncStatus = outcome
    mutate lastSyncFailedCount = failedCount
    mutate lastSyncSummary = summary
    mutate lastSuccessfulSyncAt = clean ? now() : self.lastSuccessfulSyncAt
    mutate lastErrorMessage = clean ? null : (error != null ? error : "Some records did not sync.")
    mutate lastErrorAt = clean ? null : now()
    emit IntegrationConnectionReconciled {
      connectionId: self.id
      tenantId: self.tenantId
      provider: self.provider
      engagementId: engagementId
      outcome: outcome
      failedCount: failedCount
      error: error
    }
  }

  // The tenant's per-record sync state from the old manifestEvents ledger has
  // been copied into IntegrationSyncRecord rows; the seam stops reading it.
  command markLedgerImported() {
    guard user.role == "system" "Only CapsuleX imports sync history"
    guard self.deletedAt == null
    guard self.ledgerImportedAt == null
    mutate ledgerImportedAt = now()
    emit IntegrationLedgerImported {
      connectionId: self.id
      tenantId: self.tenantId
      provider: self.provider
    }
  }

  store IntegrationConnection in durable
}
