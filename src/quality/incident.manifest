// Capsule execution & quality — Incident (event-attached operational
// incident). Compile entry for quality slice; uses allergen-check → closeout
// chain. Battle boards are projection/UI aggregations (not entities here).

use "./allergen-check.manifest"

enum IncidentStatus {
  open
  investigating
  resolved
  dismissed
}

enum IncidentSeverity {
  low
  medium
  high
  critical
}

enum IncidentCategory {
  food_safety
  allergen
  injury
  equipment
  service
  other
}

enum CorrectiveActionStatus {
  open
  closed
}

// Operational incident recorded at/for an Event, optionally linked to prep,
// delivery, or shift work. Product §7 requires incident attachment; capsule-pro
// evidence has NO Incident entity — enums are product-closed vocabularies.
entity Incident mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required eventId: uuid
  property prepTaskId: uuid?
  property deliveryId: uuid?
  property shiftId: uuid?
  property required severity: IncidentSeverity = "medium"
  property required category: IncidentCategory = "other"
  property required description: string = ""
  property resolution: string?
  property dismissalReason: string?
  // Auth subject (user.id), not a Person doc id — a belongsTo Person here
  // makes the column v.id("people") and every report fails (issue #35 class).
  property reportedById: string?
  property required status: IncidentStatus = "open"
  // Allergen response lock: true while a required corrective action is open.
  // Nullable (not required+default) so pre-existing rows pass Convex schema validation.
  property correctiveActionRequired: boolean?
  property reportedAt: datetime?
  property investigatingAt: datetime?
  property resolvedAt: datetime?
  property dismissedAt: datetime?

  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]
  belongsTo prepTask: PrepTask fields [tenantId, prepTaskId] references [tenantId, id]
  belongsTo delivery: Delivery fields [tenantId, deliveryId] references [tenantId, id]
  belongsTo shift: Shift fields [tenantId, shiftId] references [tenantId, id]

  constraint incidentDescriptionPresent: self.reportedAt == null or length(trim(self.description)) > 0 "Reported incidents require a description"

  transition status from "open" to ["investigating", "resolved", "dismissed"]
  transition status from "investigating" to ["resolved", "dismissed"]
  transition status from "resolved" to []
  transition status from "dismissed" to []

  default policy incidentRead read: roleAllows(user.role, "eventAccess") or roleAllows(user.role, "kitchenAccess") "Event and kitchen staff may read incidents"
  default policy incidentWrite write: roleAllows(user.role, "eventAccess") or roleAllows(user.role, "kitchenAccess") "Event and kitchen staff may write incidents through commands"
  default policy incidentExecute execute: roleAllows(user.role, "eventAccess") or roleAllows(user.role, "kitchenAccess") "Event and kitchen staff may execute incident commands"

  command report(
    eventId: uuid,
    severity: IncidentSeverity,
    category: IncidentCategory,
    description: string,
    optional prepTaskId: uuid,
    optional deliveryId: uuid,
    optional shiftId: uuid
  ) {
    guard self.reportedAt == null
    guard self.status == "open"
    guard self.deletedAt == null
    guard self.event != null
    guard user.id != null
    constraint reportEventMatch: eventId == self.eventId "Report eventId must match the seeded event reference"
    constraint reportPrepMatch: prepTaskId == null or self.prepTaskId == null or prepTaskId == self.prepTaskId "Report prepTaskId must match the seeded prep task reference when provided"
    constraint reportDeliveryMatch: deliveryId == null or self.deliveryId == null or deliveryId == self.deliveryId "Report deliveryId must match the seeded delivery reference when provided"
    constraint reportShiftMatch: shiftId == null or self.shiftId == null or shiftId == self.shiftId "Report shiftId must match the seeded shift reference when provided"
    constraint reportDescriptionPresent: length(trim(description)) > 0 "Incident description is required"
    mutate eventId = eventId
    mutate prepTaskId = prepTaskId != null ? prepTaskId : self.prepTaskId
    mutate deliveryId = deliveryId != null ? deliveryId : self.deliveryId
    mutate shiftId = shiftId != null ? shiftId : self.shiftId
    mutate severity = severity
    mutate category = category
    mutate description = description
    mutate correctiveActionRequired = category == "allergen"
    mutate reportedById = user.id
    mutate reportedAt = now()
    emit IncidentReported {
      incidentId: self.id
      tenantId: self.tenantId
      eventId: eventId
      severity: severity
      category: category
      reportedById: user.id
      status: "open"
    }
  }

  command beginInvestigation() {
    guard self.status == "open"
    guard self.reportedAt != null
    guard self.deletedAt == null
    compute previousStatus = self.status
    mutate status = "investigating"
    mutate investigatingAt = now()
    emit IncidentInvestigationStarted {
      incidentId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      severity: self.severity
      previousStatus: previousStatus
      status: "investigating"
    }
  }

  // `resolve` is a reserved word — markResolved is the product resolve action.
  command markResolved(resolution: string) {
    guard self.status == "open" or self.status == "investigating"
    guard self.reportedAt != null
    guard self.deletedAt == null
    constraint resolveCorrectiveActionClosed: self.correctiveActionRequired != true "Allergen incidents stay locked until the corrective action is closed"
    constraint resolveTextPresent: length(trim(resolution)) > 0 "Resolution is required"
    compute previousStatus = self.status
    mutate resolution = resolution
    mutate status = "resolved"
    mutate resolvedAt = now()
    emit IncidentResolved {
      incidentId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      severity: self.severity
      previousStatus: previousStatus
      status: "resolved"
      resolution: resolution
    }
  }

  command dismiss(reason: string) {
    guard self.status == "open" or self.status == "investigating"
    guard self.reportedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventManageAccess") or roleAllows(user.role, "kitchenManageAccess")
    constraint dismissCorrectiveActionClosed: self.correctiveActionRequired != true "Allergen incidents stay locked until the corrective action is closed"
    constraint dismissReasonPresent: length(trim(reason)) > 0 "Dismissal reason is required"
    compute previousStatus = self.status
    mutate dismissalReason = reason
    mutate status = "dismissed"
    mutate dismissedAt = now()
    emit IncidentDismissed {
      incidentId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      severity: self.severity
      previousStatus: previousStatus
      status: "dismissed"
      reason: reason
    }
  }

  // Reaction target for CorrectiveActionClosed — not a user-facing action.
  // Idempotent (no lock guard): a throwing guard here would abort the
  // corrective-action close that triggered it.
  command clearCorrectiveActionLock() {
    guard self.deletedAt == null
    mutate correctiveActionRequired = false
    emit IncidentCorrectiveActionCleared {
      incidentId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      severity: self.severity
      status: self.status
    }
  }

  store Incident in durable
}

// Required follow-up work for an allergen incident. Opened alongside the
// incident report (the compiler has no child-creating reactions, so the app
// layer opens it); closing it unlocks the incident via reaction.
entity CorrectiveAction mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required incidentId: uuid
  property required eventId: uuid
  property required description: string = ""
  property resolutionNotes: string?
  // Auth subjects (user.id), not Person doc ids — see Incident.reportedById.
  property openedById: string?
  property closedById: string?
  property required status: CorrectiveActionStatus = "open"
  property openedAt: datetime?
  property closedAt: datetime?

  belongsTo incident: Incident fields [tenantId, incidentId] references [tenantId, id]
  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]

  constraint correctiveDescriptionPresent: self.openedAt == null or length(trim(self.description)) > 0 "Corrective actions require a description"

  transition status from "open" to ["closed"]
  transition status from "closed" to []

  default policy correctiveActionRead read: roleAllows(user.role, "eventAccess") or roleAllows(user.role, "kitchenAccess") "Event and kitchen staff may read corrective actions"
  default policy correctiveActionWrite write: roleAllows(user.role, "eventAccess") or roleAllows(user.role, "kitchenAccess") "Event and kitchen staff may write corrective actions through commands"
  default policy correctiveActionExecute execute: roleAllows(user.role, "eventAccess") or roleAllows(user.role, "kitchenAccess") "Event and kitchen staff may execute corrective action commands"

  command open(incidentId: uuid, eventId: uuid, description: string) {
    guard self.openedAt == null
    guard self.status == "open"
    guard self.deletedAt == null
    guard user.id != null
    constraint openIncidentMatch: incidentId == self.incidentId "Open incidentId must match the seeded incident reference"
    constraint openEventMatch: eventId == self.eventId "Open eventId must match the seeded event reference"
    constraint openDescriptionPresent: length(trim(description)) > 0 "Corrective action description is required"
    mutate incidentId = incidentId
    mutate eventId = eventId
    mutate description = description
    mutate openedById = user.id
    mutate openedAt = now()
    emit CorrectiveActionOpened {
      correctiveActionId: self.id
      tenantId: self.tenantId
      incidentId: incidentId
      eventId: eventId
      openedById: user.id
      status: "open"
    }
  }

  command close(resolutionNotes: string) {
    guard self.status == "open"
    guard self.openedAt != null
    guard self.deletedAt == null
    guard user.id != null
    constraint closeNotesPresent: length(trim(resolutionNotes)) > 0 "Resolution notes are required"
    mutate resolutionNotes = resolutionNotes
    mutate closedById = user.id
    mutate status = "closed"
    mutate closedAt = now()
    emit CorrectiveActionClosed {
      correctiveActionId: self.id
      tenantId: self.tenantId
      incidentId: self.incidentId
      eventId: self.eventId
      closedById: user.id
      status: "closed"
      resolutionNotes: resolutionNotes
    }
  }

  store CorrectiveAction in durable
}

event IncidentReported: "incident.reported" {
  incidentId: string
  tenantId: string
  eventId: string
  severity: IncidentSeverity
  category: IncidentCategory
  reportedById: string
  status: IncidentStatus
}

event IncidentInvestigationStarted: "incident.investigation_started" {
  incidentId: string
  tenantId: string
  eventId: string
  severity: IncidentSeverity
  previousStatus: IncidentStatus
  status: IncidentStatus
}

event IncidentResolved: "incident.resolved" {
  incidentId: string
  tenantId: string
  eventId: string
  severity: IncidentSeverity
  previousStatus: IncidentStatus
  status: IncidentStatus
  resolution: string
}

event IncidentDismissed: "incident.dismissed" {
  incidentId: string
  tenantId: string
  eventId: string
  severity: IncidentSeverity
  previousStatus: IncidentStatus
  status: IncidentStatus
  reason: string
}

event IncidentCorrectiveActionCleared: "incident.corrective_action_cleared" {
  incidentId: string
  tenantId: string
  eventId: string
  severity: IncidentSeverity
  status: IncidentStatus
}

event CorrectiveActionOpened: "corrective_action.opened" {
  correctiveActionId: string
  tenantId: string
  incidentId: string
  eventId: string
  openedById: string
  status: CorrectiveActionStatus
}

event CorrectiveActionClosed: "corrective_action.closed" {
  correctiveActionId: string
  tenantId: string
  incidentId: string
  eventId: string
  closedById: string
  status: CorrectiveActionStatus
  resolutionNotes: string
}

// CorrectiveActionClosed → unlock the allergen incident for resolution.
on CorrectiveActionClosed run Incident.clearCorrectiveActionLock
  resolve payload.incidentId
