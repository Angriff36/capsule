// Capsule sales/billing — compile entry for Invoice + Payment + PaymentMethod.
// CollectionCase / PaymentRefundAttempt / InvoiceLine are not modeled yet (OD040).
// Deposits implemented per deposit-tracking feature (2026-07-21).
// EventCancelled voids unpaid draft/sent/viewed/overdue invoices (D041).

use "./payment.manifest"

// Vision cascade: approved event ensures one Invoice issued from quoted price
// (match else create). Remains draft until finance sends — issue sets issuedAt.
// Currency code / exchange rate default to the tenant's functional currency
// (no exchangeRate field on EventApproved). Finance can adjust per invoice on
// the issue form before sending.
// invoiceSequence is a reaction-param count of the tenant's invoices; the
// command mints "INV-<n>" from it, so the auto-issued draft never carries the
// raw event document id (issues #136 / #165; same scheme as VendorOrder
// "PO-<n>", #140). Cascade params accept a bare count() only — composite
// expressions here are dropped silently by the compiler.
on EventApproved run Invoice.issue
  match eventId = payload.eventId
  else create
  params {
    clientId: payload.clientId
    eventId: payload.eventId
    invoiceSequence: count(Invoice where tenantId == payload.tenantId)
    subtotal: payload.quotedPrice
    taxAmount: 0
    discountAmount: 0
    total: payload.quotedPrice
  }

// The transactional operational callback voids eligible unpaid invoices through
// Invoice.markVoided. Paid/partial/voided/written-off invoices and payments stay
// recorded; event cancellation does not imply a refund.
