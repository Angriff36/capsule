// Capsule sales/billing — Payment against Invoice.
// Settlement applies to Invoice via reaction (replaces capsule-pro middleware).
// Chargeback / partial-refund / accepted-not-applied are not modeled yet (OD040).

use "./invoice-core.manifest"

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
}

enum PaymentMethodKind {
  card
  check
  cash
  ach
  other
}

enum PaymentReconciliationStatus {
  unreconciled
  matched
  disputed
  verified
}

enum PaymentExternalSource {
  tpp_legacy
  quickbooks_online
  nowsta
  stripe
  manual
  other
}

entity Payment mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required invoiceId: uuid
  property required clientId: uuid
  property clientMergeAuthorizationId: uuid?
  property mergeTargetClientId: uuid?
  property eventId: uuid?
  property required amount: money(12, 2) = 0
  property required method: PaymentMethodKind = "card"
  property required status: PaymentStatus = "pending"
  property paymentMethodId: uuid?
  property notes: string?
  property recordedAt: datetime?
  property settledAt: datetime?
  property failedAt: datetime?
  property refundedAt: datetime?
  property failureReason: string?
  property refundReason: string?

  // Reconciliation fields for TPP/QuickBooks/Nowsta payment matching per spec §6.4
  property required reconciliationStatus: PaymentReconciliationStatus = "unreconciled"
  property externalSource: PaymentExternalSource?
  property externalPaymentId: string?
  property providerTransactionIds: string?      // JSON: { qbo: "...", nowsta: "...", stripe: "..." }
  property reconciliationDetails: string?       // JSON: { matchedAt, matchConfidence, lastReconciledAt, reconciledBy, notes }
  property reconciledAt: datetime?
  property reconciledByUserId: string?

  belongsTo invoice: Invoice fields [tenantId, invoiceId] references [tenantId, id]
  belongsTo client: Client fields [tenantId, clientId] references [tenantId, id]
  ref clientMergeAuthorization: ClientMerge fields [tenantId, clientMergeAuthorizationId] references [tenantId, id]
  ref mergeTargetClient: Client fields [tenantId, mergeTargetClientId] references [tenantId, id]
  ref event: Event fields [tenantId, eventId] references [tenantId, id]
  ref paymentMethod: PaymentMethod fields [tenantId, paymentMethodId] references [tenantId, id]

  constraint paymentAmountPositive: self.recordedAt == null or self.amount > 0 "Payment amount must be positive"

  transition status from "pending" to ["processing", "completed", "failed"]
  transition status from "processing" to ["completed", "failed"]
  transition status from "completed" to ["refunded"]
  transition status from "failed" to []
  transition status from "refunded" to []

  default policy paymentRead read: roleAllows(user.role, "financeAccess") "Finance staff may read payments"
  default policy paymentWrite write: roleAllows(user.role, "financeAccess") "Finance staff may write payments through commands"
  default policy paymentExecute execute: roleAllows(user.role, "financeAccess") "Finance staff may execute payment commands"

  command record(
    invoiceId: uuid,
    clientId: uuid,
    amount: money(12, 2),
    method: PaymentMethodKind,
    optional eventId: uuid,
    optional paymentMethodId: uuid,
    optional notes: string
  ) {
    guard self.recordedAt == null
    guard self.status == "pending"
    guard self.deletedAt == null
    guard self.invoice != null
    guard self.client != null
    constraint recordInvoiceMatch: invoiceId == self.invoiceId "Record invoiceId must match the seeded invoice reference"
    constraint recordClientMatch: clientId == self.clientId "Record clientId must match the seeded client reference"
    constraint recordPositive: amount > 0 "Payment amount must be positive"
    mutate invoiceId = invoiceId
    mutate clientId = clientId
    mutate eventId = eventId != null ? eventId : self.eventId
    mutate amount = amount
    mutate method = method
    mutate paymentMethodId = paymentMethodId
    mutate notes = notes
    mutate recordedAt = now()
    emit PaymentRecorded {
      paymentId: self.id
      tenantId: self.tenantId
      invoiceId: invoiceId
      clientId: clientId
      eventId: eventId != null ? eventId : self.eventId
      amount: amount
      method: method
    }
  }

  command beginProcessing() {
    guard self.status == "pending"
    guard self.recordedAt != null
    guard self.deletedAt == null
    mutate status = "processing"
    emit PaymentProcessingStarted {
      paymentId: self.id
      tenantId: self.tenantId
      invoiceId: self.invoiceId
      amount: self.amount
    }
  }

  command settle() {
    guard self.status == "pending" or self.status == "processing"
    guard self.recordedAt != null
    guard self.deletedAt == null
    mutate status = "completed"
    mutate settledAt = now()
    emit PaymentSettled {
      paymentId: self.id
      tenantId: self.tenantId
      invoiceId: self.invoiceId
      clientId: self.clientId
      eventId: self.eventId
      amount: self.amount
      method: self.method
    }
  }

  command fail(reason: string) {
    guard self.status == "pending" or self.status == "processing"
    guard self.recordedAt != null
    guard self.deletedAt == null
    constraint failReasonPresent: length(trim(reason)) > 0 "Failure reason is required"
    mutate status = "failed"
    mutate failedAt = now()
    mutate failureReason = reason
    emit PaymentFailed {
      paymentId: self.id
      tenantId: self.tenantId
      invoiceId: self.invoiceId
      amount: self.amount
      reason: reason
    }
  }

  command refund(reason: string) {
    guard self.status == "completed"
    guard self.deletedAt == null
    constraint refundReasonPresent: length(trim(reason)) > 0 "Refund reason is required"
    mutate status = "refunded"
    mutate refundedAt = now()
    mutate refundReason = reason
    emit PaymentRefunded {
      paymentId: self.id
      tenantId: self.tenantId
      invoiceId: self.invoiceId
      clientId: self.clientId
      amount: self.amount
      reason: reason
    }
  }

  command stageClientMerge(clientMergeId: uuid, clientId: uuid) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "adminAccess")
    constraint stageDistinctClient: clientId != self.clientId "Payment already belongs to this client"
    mutate clientMergeAuthorizationId = clientMergeId
    mutate mergeTargetClientId = clientId
    emit PaymentClientMergeStaged {
      paymentId: self.id
      tenantId: self.tenantId
    }
  }

  command reassignClient() {
    guard self.deletedAt == null
    guard roleAllows(user.role, "adminAccess")
    guard self.clientMergeAuthorization != null
    guard self.clientMergeAuthorization.deletedAt == null
    guard self.clientMergeAuthorization.mergedAt != null
    guard self.mergeTargetClient != null
    guard self.mergeTargetClient.status == "active"
    guard self.mergeTargetClient.deletedAt == null
    constraint reassignAuthorizedSource: self.clientMergeAuthorization.duplicateClientId == self.clientId "Merge authorization does not match the payment client"
    constraint reassignAuthorizedTarget: self.clientMergeAuthorization.primaryClientId == self.mergeTargetClientId "Merge authorization does not match the primary client"
    compute previousClientId = self.clientId
    mutate clientId = self.mergeTargetClientId
    emit PaymentClientReassigned {
      paymentId: self.id
      tenantId: self.tenantId
      previousClientId: previousClientId
      clientId: self.mergeTargetClientId
    }
  }

  // markMatched - Mark payment as matched to external source (TPP/QBO/Nowsta)
  command markMatched(
    source: PaymentExternalSource,
    externalPaymentId: string,
    optional providerTransactionIds: string,
    optional notes: string
  ) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "financeAccess")
    constraint matchRequiresExternalId: length(trim(externalPaymentId)) > 0 "External payment ID is required for matching"
    mutate reconciliationStatus = "matched"
    mutate externalSource = source
    mutate externalPaymentId = externalPaymentId
    mutate providerTransactionIds = providerTransactionIds != null ? providerTransactionIds : self.providerTransactionIds
    mutate reconciliationDetails = notes != null ? notes : self.reconciliationDetails
    emit PaymentMatched {
      paymentId: self.id
      tenantId: self.tenantId
      source: source
      externalPaymentId: externalPaymentId
      amount: self.amount
    }
  }

  // verifyReconciliation - Verify payment reconciliation as correct
  command verifyReconciliation(optional notes: string) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "financeAccess")
    guard self.reconciliationStatus == "matched"
    mutate reconciliationStatus = "verified"
    mutate reconciledAt = now()
    mutate reconciledByUserId = user.id
    mutate reconciliationDetails = notes != null ? notes : self.reconciliationDetails
    emit PaymentReconciliationVerified {
      paymentId: self.id
      tenantId: self.tenantId
      externalPaymentId: self.externalPaymentId != null ? self.externalPaymentId : ""
      amount: self.amount
    }
  }

  // disputeReconciliation - Dispute payment reconciliation
  command disputeReconciliation(reason: string) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "financeAccess")
    constraint disputeRequiresReason: length(trim(reason)) > 0 "Dispute reason is required"
    mutate reconciliationStatus = "disputed"
    mutate reconciliationDetails = reason
    emit PaymentReconciliationDisputed {
      paymentId: self.id
      tenantId: self.tenantId
      reason: reason
    }
  }

  // updateProviderTransactionIds - Update provider transaction IDs (QBO, Nowsta, etc.)
  command updateProviderTransactionIds(providerTransactionIds: string) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "financeAccess")
    mutate providerTransactionIds = providerTransactionIds
    emit PaymentProviderIdsUpdated {
      paymentId: self.id
      tenantId: self.tenantId
    }
  }

  store Payment in durable
}

event PaymentClientMergeStaged: "payment.client_merge_staged" {
  paymentId: string
  tenantId: string
}

event PaymentClientReassigned: "payment.client_reassigned" {
  paymentId: string
  tenantId: string
  previousClientId: string
  clientId: string
}

event PaymentRecorded: "payment.recorded" {
  paymentId: string
  tenantId: string
  invoiceId: string
  clientId: string
  eventId: string?
  amount: money(12, 2)
  method: PaymentMethodKind
}

event PaymentProcessingStarted: "payment.processing_started" {
  paymentId: string
  tenantId: string
  invoiceId: string
  amount: money(12, 2)
}

event PaymentSettled: "payment.settled" {
  paymentId: string
  tenantId: string
  invoiceId: string
  clientId: string
  eventId: string?
  amount: money(12, 2)
  method: PaymentMethodKind
}

event PaymentFailed: "payment.failed" {
  paymentId: string
  tenantId: string
  invoiceId: string
  amount: money(12, 2)
  reason: string
}

event PaymentRefunded: "payment.refunded" {
  paymentId: string
  tenantId: string
  invoiceId: string
  clientId: string
  amount: money(12, 2)
  reason: string
}

event PaymentMatched: "payment.matched" {
  paymentId: string
  tenantId: string
  source: PaymentExternalSource
  externalPaymentId: string
  amount: money(12, 2)
}

event PaymentReconciliationVerified: "payment.reconciliation_verified" {
  paymentId: string
  tenantId: string
  externalPaymentId: string
  amount: money(12, 2)
}

event PaymentReconciliationDisputed: "payment.reconciliation_disputed" {
  paymentId: string
  tenantId: string
  reason: string
}

event PaymentProviderIdsUpdated: "payment.provider_ids_updated" {
  paymentId: string
  tenantId: string
}

// Settled payments apply to the invoice (replaces capsule-pro middleware).
on PaymentSettled run Invoice.applyPayment
  resolve payload.invoiceId
  params {
    paymentAmount: payload.amount
    paymentId: payload.paymentId
  }
