// Capsule sales/billing — Payment against Invoice.
// Settlement applies to Invoice via reaction (replaces capsule-pro middleware).
//
// Money meaning (PL-ACCOUNTING, BE-15.2): `amount` is what the client paid
// toward the invoice. At settle it splits into `appliedAmount` (lowers the
// invoice) and `unappliedAmount` (paid beyond what was owed, held for the
// client, never lost). A processing fee (`feeAmount`) and a tip
// (`gratuityAmount`) ride along but are never invoice principal. Refunds,
// chargebacks and returned bank (ACH) payments are separate totals: each takes
// from the held part first, then from the applied part, which raises the
// invoice balance again. So applied + unapplied + refunded + chargedBack +
// returned always equals amount, and every change keeps its reason and
// effective date on the ledger.

use "./invoice-core.manifest"

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
  charged_back
  returned
}

enum PaymentReversalKind {
  refund
  chargeback
  ach_return
}

enum PaymentMethodKind {
  card
  check
  cash
  ach
  other
}

enum PaymentReconciliationStatus {
  unreconciled
  matched
  disputed
  verified
}

enum PaymentExternalSource {
  tpp_legacy
  quickbooks_online
  nowsta
  stripe
  manual
  other
}

entity Payment mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required invoiceId: uuid
  property required clientId: uuid
  property clientMergeAuthorizationId: uuid?
  property mergeTargetClientId: uuid?
  property eventId: uuid?
  property required amount: money(12, 2) = 0
  property required method: PaymentMethodKind = "card"
  property required status: PaymentStatus = "pending"
  property paymentMethodId: uuid?
  property notes: string?
  property recordedAt: datetime?
  property settledAt: datetime?
  property failedAt: datetime?
  property refundedAt: datetime?
  property failureReason: string?
  property refundReason: string?

  // Accounting meaning (BE-15.2-03). Null on rows settled before these fields.
  property feeAmount: money(12, 2)?
  property gratuityAmount: money(12, 2)?
  property appliedAmount: money(12, 2)?
  property unappliedAmount: money(12, 2)?
  property refundedAmount: money(12, 2)?
  property chargedBackAmount: money(12, 2)?
  property returnedAmount: money(12, 2)?
  // When the money really moved, and the date it counts in the books.
  // recordedAt stays the time it was entered or imported (PR05-09).
  property occurredAt: datetime?
  property effectiveAt: datetime?
  // Provider account the external id belongs to (for example a Stripe
  // connected account). One provider payment id is used once per account.
  property providerAccount: string?
  // The outside payment this one is matched to in reconciliation (markMatched).
  property matchedSource: PaymentExternalSource?
  property matchedExternalId: string?

  // Reconciliation fields for TPP/QuickBooks/Nowsta payment matching per spec §6.4
  property required reconciliationStatus: PaymentReconciliationStatus = "unreconciled"
  property externalSource: PaymentExternalSource?
  property externalPaymentId: string?
  property providerTransactionIds: string?      // JSON: { qbo: "...", nowsta: "...", stripe: "..." }
  property reconciliationDetails: string?       // JSON: { matchedAt, matchConfidence, lastReconciledAt, reconciledBy, notes }
  property reconciledAt: datetime?
  property reconciledByUserId: string?

  belongsTo invoice: Invoice fields [tenantId, invoiceId] references [tenantId, id]
  belongsTo client: Client fields [tenantId, clientId] references [tenantId, id]
  ref clientMergeAuthorization: ClientMerge fields [tenantId, clientMergeAuthorizationId] references [tenantId, id]
  ref mergeTargetClient: Client fields [tenantId, mergeTargetClientId] references [tenantId, id]
  ref event: Event fields [tenantId, eventId] references [tenantId, id]
  ref paymentMethod: PaymentMethod fields [tenantId, paymentMethodId] references [tenantId, id]

  constraint paymentAmountPositive: self.recordedAt == null or self.amount > 0 "This payment's amount has to be more than zero. Enter how much was paid."
  constraint paymentSplitAddsUp: self.appliedAmount == null or round(((self.appliedAmount) + (self.unappliedAmount != null ? self.unappliedAmount : 0) + (self.refundedAmount != null ? self.refundedAmount : 0) + (self.chargedBackAmount != null ? self.chargedBackAmount : 0) + (self.returnedAmount != null ? self.returnedAmount : 0)) * 100) / 100 == round((self.amount) * 100) / 100 "This payment's applied, held, refunded and returned parts must add up to the amount paid"

  transition status from "pending" to ["processing", "completed", "failed"]
  transition status from "processing" to ["completed", "failed"]
  transition status from "completed" to ["refunded", "charged_back", "returned"]
  transition status from "failed" to []
  transition status from "refunded" to []
  transition status from "charged_back" to []
  transition status from "returned" to []

  default policy paymentRead read: roleAllows(user.role, "financeAccess") "Finance staff may see payments"
  default policy paymentWrite write: roleAllows(user.role, "financeAccess") "Finance staff may update payments"
  default policy paymentExecute execute: roleAllows(user.role, "financeAccess") "Finance staff may change payments"

  command record(
    invoiceId: uuid,
    clientId: uuid,
    amount: money(12, 2),
    method: PaymentMethodKind,
    optional eventId: uuid,
    optional paymentMethodId: uuid,
    optional notes: string,
    optional feeAmount: money(12, 2),
    optional gratuityAmount: money(12, 2),
    optional occurredAt: datetime,
    optional effectiveAt: datetime,
    optional externalSource: PaymentExternalSource,
    optional externalPaymentId: string,
    optional providerAccount: string
  ) {
    guard self.recordedAt == null
    guard self.status == "pending"
    guard self.deletedAt == null
    guard self.invoice != null
    guard self.client != null
    constraint recordInvoiceMatch: invoiceId == self.invoiceId "This payment is for a different invoice. Use the invoice already on this payment."
    constraint recordClientMatch: clientId == self.clientId "This payment is for a different client. Use the client already on this payment."
    constraint recordPositive: amount > 0 "This payment's amount has to be more than zero. Enter how much was paid."
    constraint recordFeeNonnegative: feeAmount == null or feeAmount >= 0 "A processing fee can't be negative. Use zero or more."
    constraint recordGratuityNonnegative: gratuityAmount == null or gratuityAmount >= 0 "A tip can't be negative. Use zero or more."
    constraint recordExternalIdHasSource: externalPaymentId == null or externalSource != null "Say which system this payment id comes from"
    mutate invoiceId = invoiceId
    mutate clientId = clientId
    mutate eventId = eventId != null ? eventId : self.eventId
    mutate amount = amount
    mutate method = method
    mutate paymentMethodId = paymentMethodId
    mutate notes = notes
    mutate feeAmount = feeAmount
    mutate gratuityAmount = gratuityAmount
    mutate occurredAt = occurredAt != null ? occurredAt : now()
    mutate effectiveAt = effectiveAt != null ? effectiveAt : (occurredAt != null ? occurredAt : now())
    mutate externalSource = externalSource
    mutate externalPaymentId = externalPaymentId != null and length(trim(externalPaymentId)) > 0 ? trim(externalPaymentId) : null
    mutate providerAccount = providerAccount
    mutate recordedAt = now()
    emit PaymentRecorded {
      paymentId: self.id
      tenantId: self.tenantId
      invoiceId: invoiceId
      clientId: clientId
      eventId: eventId != null ? eventId : self.eventId
      amount: amount
      method: method
    }
  }

  command beginProcessing() {
    guard self.status == "pending"
    guard self.recordedAt != null
    guard self.deletedAt == null
    mutate status = "processing"
    emit PaymentProcessingStarted {
      paymentId: self.id
      tenantId: self.tenantId
      invoiceId: self.invoiceId
      amount: self.amount
    }
  }

  // Applies what is still owed on an open invoice; anything paid beyond that
  // is held on the payment for the client (overpayment), never rejected.
  command settle() {
    guard self.status == "pending" or self.status == "processing"
    guard self.recordedAt != null
    guard self.deletedAt == null
    compute invoiceOpen = self.invoice != null and self.invoice.deletedAt == null and (self.invoice.status == "sent" or self.invoice.status == "viewed" or self.invoice.status == "overdue" or self.invoice.status == "partial")
    compute owed = invoiceOpen ? max(0, self.invoice.amountDue) : 0
    compute applied = round((min(self.amount, owed)) * 100) / 100
    compute unapplied = round((self.amount - applied) * 100) / 100
    mutate status = "completed"
    mutate settledAt = now()
    mutate appliedAmount = applied
    mutate unappliedAmount = unapplied
    emit PaymentSettled {
      paymentId: self.id
      tenantId: self.tenantId
      invoiceId: self.invoiceId
      clientId: self.clientId
      eventId: self.eventId
      amount: self.amount
      method: self.method
      appliedAmount: applied
      unappliedAmount: unapplied
      applyToInvoiceId: applied > 0 ? self.invoiceId : null
    }
  }

  command fail(reason: string) {
    guard self.status == "pending" or self.status == "processing"
    guard self.recordedAt != null
    guard self.deletedAt == null
    constraint failReasonPresent: length(trim(reason)) > 0 "Give a reason this payment failed"
    mutate status = "failed"
    mutate failedAt = now()
    mutate failureReason = reason
    emit PaymentFailed {
      paymentId: self.id
      tenantId: self.tenantId
      invoiceId: self.invoiceId
      amount: self.amount
      reason: reason
    }
  }

  // Refunds everything still on this payment. The applied part goes back on
  // the invoice balance (it used to stay "paid"); the held part leaves too.
  command refund(reason: string, optional effectiveAt: datetime) {
    guard self.status == "completed"
    guard self.deletedAt == null
    constraint refundReasonPresent: length(trim(reason)) > 0 "Give a reason for this refund"
    compute appliedBefore = self.appliedAmount != null ? self.appliedAmount : self.amount
    compute heldBefore = self.unappliedAmount != null ? self.unappliedAmount : 0
    compute refunded = round((appliedBefore + heldBefore) * 100) / 100
    mutate status = "refunded"
    mutate refundedAt = now()
    mutate refundReason = reason
    mutate appliedAmount = 0
    mutate unappliedAmount = 0
    mutate refundedAmount = round(((self.refundedAmount != null ? self.refundedAmount : 0) + refunded) * 100) / 100
    emit PaymentRefunded {
      paymentId: self.id
      tenantId: self.tenantId
      invoiceId: self.invoiceId
      clientId: self.clientId
      amount: refunded
      reason: reason
    }
    emit PaymentReversed {
      paymentId: self.id
      tenantId: self.tenantId
      invoiceId: self.invoiceId
      clientId: self.clientId
      kind: "refund"
      amount: refunded
      fromApplied: appliedBefore
      fromHeld: heldBefore
      reason: reason
      effectiveAt: effectiveAt != null ? effectiveAt : now()
      providerReversalId: null
      applyToInvoiceId: appliedBefore > 0 ? self.invoiceId : null
    }
  }

  // A refund of part of a payment, a card chargeback, or a returned bank
  // (ACH) payment. Takes from the held (overpaid) part first, then from the
  // applied part, which puts that much back on the invoice balance. The
  // original payment and its amount stay as they were.
  command reverse(
    kind: PaymentReversalKind,
    amount: money(12, 2),
    reason: string,
    optional effectiveAt: datetime,
    optional providerReversalId: string
  ) {
    guard self.status == "completed"
    guard self.deletedAt == null
    compute appliedBefore = self.appliedAmount != null ? self.appliedAmount : self.amount
    compute heldBefore = self.unappliedAmount != null ? self.unappliedAmount : 0
    constraint reversePositive: amount > 0 "The amount taken back has to be more than zero"
    constraint reverseReasonPresent: length(trim(reason)) > 0 "Give a reason money is being taken back"
    // Constraints run before computes, so this one spells the remainder out.
    constraint reverseWithinPayment: round((amount) * 100) / 100 <= round(((self.appliedAmount != null ? self.appliedAmount : self.amount) + (self.unappliedAmount != null ? self.unappliedAmount : 0)) * 100) / 100 "You can't take back more than is left on this payment"
    compute fromHeld = round((min(amount, heldBefore)) * 100) / 100
    compute fromApplied = round((amount - fromHeld) * 100) / 100
    compute appliedAfter = round((appliedBefore - fromApplied) * 100) / 100
    compute heldAfter = round((heldBefore - fromHeld) * 100) / 100
    compute nothingLeft = appliedAfter + heldAfter == 0
    mutate appliedAmount = appliedAfter
    mutate unappliedAmount = heldAfter
    mutate refundedAmount = kind == "refund" ? round(((self.refundedAmount != null ? self.refundedAmount : 0) + amount) * 100) / 100 : self.refundedAmount
    mutate chargedBackAmount = kind == "chargeback" ? round(((self.chargedBackAmount != null ? self.chargedBackAmount : 0) + amount) * 100) / 100 : self.chargedBackAmount
    mutate returnedAmount = kind == "ach_return" ? round(((self.returnedAmount != null ? self.returnedAmount : 0) + amount) * 100) / 100 : self.returnedAmount
    mutate refundedAt = kind == "refund" ? now() : self.refundedAt
    mutate refundReason = kind == "refund" ? reason : self.refundReason
    mutate status = nothingLeft ? (kind == "refund" ? "refunded" : (kind == "chargeback" ? "charged_back" : "returned")) : self.status
    emit PaymentReversed {
      paymentId: self.id
      tenantId: self.tenantId
      invoiceId: self.invoiceId
      clientId: self.clientId
      kind: kind
      amount: amount
      fromApplied: fromApplied
      fromHeld: fromHeld
      reason: reason
      effectiveAt: effectiveAt != null ? effectiveAt : now()
      providerReversalId: providerReversalId
      applyToInvoiceId: fromApplied > 0 ? self.invoiceId : null
    }
  }

  command stageClientMerge(clientMergeId: uuid, clientId: uuid) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "adminAccess")
    constraint stageDistinctClient: clientId != self.clientId "Payment already belongs to this client"
    mutate clientMergeAuthorizationId = clientMergeId
    mutate mergeTargetClientId = clientId
    emit PaymentClientMergeStaged {
      paymentId: self.id
      tenantId: self.tenantId
    }
  }

  command reassignClient() {
    guard self.deletedAt == null
    guard roleAllows(user.role, "adminAccess")
    guard self.clientMergeAuthorization != null
    guard self.clientMergeAuthorization.deletedAt == null
    guard self.clientMergeAuthorization.mergedAt != null
    guard self.mergeTargetClient != null
    guard self.mergeTargetClient.status == "active"
    guard self.mergeTargetClient.deletedAt == null
    constraint reassignAuthorizedSource: self.clientMergeAuthorization.duplicateClientId == self.clientId "Merge authorization does not match the payment client"
    constraint reassignAuthorizedTarget: self.clientMergeAuthorization.primaryClientId == self.mergeTargetClientId "Merge authorization does not match the primary client"
    compute previousClientId = self.clientId
    mutate clientId = self.mergeTargetClientId
    emit PaymentClientReassigned {
      paymentId: self.id
      tenantId: self.tenantId
      previousClientId: previousClientId
      clientId: self.mergeTargetClientId
    }
  }

  // markMatched - Mark payment as matched to external source (TPP/QBO/Nowsta)
  command markMatched(
    source: PaymentExternalSource,
    externalPaymentId: string,
    optional providerTransactionIds: string,
    optional notes: string
  ) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "financeAccess")
    constraint matchRequiresExternalId: length(trim(externalPaymentId)) > 0 "Give the external payment ID to match this to"
    // One payment, one outside transaction (BE-15.2-04): a payment already
    // matched to another outside id is not matched again. Unmatch it first by
    // disputing the match. The payment's own provider id (for example the
    // Stripe checkout it was paid by) is kept; the match id is stored beside it.
    constraint matchNotAlreadyAllocated: self.matchedExternalId == null or self.reconciliationStatus == "disputed" or (self.matchedExternalId == trim(externalPaymentId) and self.matchedSource == source) "This payment is already matched to another outside payment. Dispute that match first."
    mutate reconciliationStatus = "matched"
    mutate matchedSource = source
    mutate matchedExternalId = trim(externalPaymentId)
    mutate externalSource = self.externalPaymentId != null ? self.externalSource : source
    mutate externalPaymentId = self.externalPaymentId != null ? self.externalPaymentId : trim(externalPaymentId)
    mutate providerTransactionIds = providerTransactionIds != null ? providerTransactionIds : self.providerTransactionIds
    mutate reconciliationDetails = notes != null ? notes : self.reconciliationDetails
    emit PaymentMatched {
      paymentId: self.id
      tenantId: self.tenantId
      source: source
      externalPaymentId: externalPaymentId
      amount: self.amount
    }
  }

  // verifyReconciliation - Verify payment reconciliation as correct
  command verifyReconciliation(optional notes: string) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "financeAccess")
    guard self.reconciliationStatus == "matched"
    mutate reconciliationStatus = "verified"
    mutate reconciledAt = now()
    mutate reconciledByUserId = user.id
    mutate reconciliationDetails = notes != null ? notes : self.reconciliationDetails
    emit PaymentReconciliationVerified {
      paymentId: self.id
      tenantId: self.tenantId
      externalPaymentId: self.externalPaymentId != null ? self.externalPaymentId : ""
      amount: self.amount
    }
  }

  // disputeReconciliation - Dispute payment reconciliation
  command disputeReconciliation(reason: string) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "financeAccess")
    constraint disputeRequiresReason: length(trim(reason)) > 0 "Give a reason for this dispute"
    mutate reconciliationStatus = "disputed"
    mutate reconciliationDetails = reason
    emit PaymentReconciliationDisputed {
      paymentId: self.id
      tenantId: self.tenantId
      reason: reason
    }
  }

  // updateProviderTransactionIds - Update provider transaction IDs (QBO, Nowsta, etc.)
  command updateProviderTransactionIds(providerTransactionIds: string) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "financeAccess")
    mutate providerTransactionIds = providerTransactionIds
    emit PaymentProviderIdsUpdated {
      paymentId: self.id
      tenantId: self.tenantId
    }
  }

  store Payment in durable
}

event PaymentClientMergeStaged: "payment.client_merge_staged" {
  paymentId: string
  tenantId: string
}

event PaymentClientReassigned: "payment.client_reassigned" {
  paymentId: string
  tenantId: string
  previousClientId: string
  clientId: string
}

event PaymentRecorded: "payment.recorded" {
  paymentId: string
  tenantId: string
  invoiceId: string
  clientId: string
  eventId: string?
  amount: money(12, 2)
  method: PaymentMethodKind
}

event PaymentProcessingStarted: "payment.processing_started" {
  paymentId: string
  tenantId: string
  invoiceId: string
  amount: money(12, 2)
}

event PaymentSettled: "payment.settled" {
  paymentId: string
  tenantId: string
  invoiceId: string
  clientId: string
  eventId: string?
  amount: money(12, 2)
  method: PaymentMethodKind
  appliedAmount: money(12, 2)
  unappliedAmount: money(12, 2)
  applyToInvoiceId: string?
}

event PaymentReversed: "payment.reversed" {
  paymentId: string
  tenantId: string
  invoiceId: string
  clientId: string
  kind: PaymentReversalKind
  amount: money(12, 2)
  fromApplied: money(12, 2)
  fromHeld: money(12, 2)
  reason: string
  effectiveAt: datetime
  providerReversalId: string?
  applyToInvoiceId: string?
}

event PaymentFailed: "payment.failed" {
  paymentId: string
  tenantId: string
  invoiceId: string
  amount: money(12, 2)
  reason: string
}

event PaymentRefunded: "payment.refunded" {
  paymentId: string
  tenantId: string
  invoiceId: string
  clientId: string
  amount: money(12, 2)
  reason: string
}

event PaymentMatched: "payment.matched" {
  paymentId: string
  tenantId: string
  source: PaymentExternalSource
  externalPaymentId: string
  amount: money(12, 2)
}

event PaymentReconciliationVerified: "payment.reconciliation_verified" {
  paymentId: string
  tenantId: string
  externalPaymentId: string
  amount: money(12, 2)
}

event PaymentReconciliationDisputed: "payment.reconciliation_disputed" {
  paymentId: string
  tenantId: string
  reason: string
}

event PaymentProviderIdsUpdated: "payment.provider_ids_updated" {
  paymentId: string
  tenantId: string
}

// Settled payments apply to the invoice (replaces capsule-pro middleware).
// Only the applied part; nothing is applied when the invoice owed nothing.
on PaymentSettled run Invoice.applyPayment
  resolve payload.applyToInvoiceId
  params {
    paymentAmount: payload.appliedAmount
    paymentId: payload.paymentId
  }

// Money taken back from the applied part goes back on the invoice balance.
on PaymentReversed run Invoice.recordRefund
  resolve payload.applyToInvoiceId
  params {
    refundAmount: payload.fromApplied
    paymentId: payload.paymentId
  }
