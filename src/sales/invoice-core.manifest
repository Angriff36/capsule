// Capsule sales/billing — Invoice entity (Payment + entry reactions elsewhere).
// Governed JSON snapshots preserve calculated line items and named tax
// allocations atomically with issue; TaxRate configuration is a separate entity.

use "./payment-method.manifest"

enum InvoiceStatus {
  draft
  sent
  viewed
  overdue
  partial
  paid
  voided
  written_off
}

// Client invoice for an engagement. Optional eventId links the governed Event;
// stored amountPaid/amountDue are command-maintained (applyPayment) — a
// computed sum over hasMany cannot drive transitions (D040).
entity Invoice mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required clientId: uuid
  property clientMergeAuthorizationId: uuid?
  property mergeTargetClientId: uuid?
  property eventId: uuid?
  property unique invoiceNumber: string?
  property required subtotal: money(12, 2) = 0
  property required taxAmount: money(12, 2) = 0
  property required discountAmount: money(12, 2) = 0
  property required total: money(12, 2) = 0
  property required amountPaid: money(12, 2) = 0
  property required amountDue: money(12, 2) = 0
  // Nullable so invoices created before credit memo support stay schema-valid.
  property amountCredited: money(12, 2)?
  property creditMemoAmount: money(12, 2)?
  // Nullable so invoices created before line-item support stay schema-valid;
  // issue() defaults null to []. Required blocked the Convex schema push.
  property lineItems: json?
  property taxBreakdown: json?
  property required paymentTermsDays: int = 30
  // Deposit due is tracked separately from balance payments (deposit-tracking).
  // Nullable so pre-existing invoices stay schema-valid; readers default 0 / 14.
  property depositAmount: money(12, 2)?
  property depositPaidAt: datetime?
  property balanceReminderLeadDays: int?
  property balanceReminderSentAt: datetime?
  property dueDate: datetime?
  property notes: string?
  property required status: InvoiceStatus = "draft"
  property issuedAt: datetime?
  property sentAt: datetime?
  property viewedAt: datetime?
  property overdueSince: datetime?
  property paidAt: datetime?
  property voidedAt: datetime?
  property voidReason: string?
  property writtenOffAt: datetime?
  property writeOffReason: string?

  belongsTo client: Client fields [tenantId, clientId] references [tenantId, id]
  ref clientMergeAuthorization: ClientMerge fields [tenantId, clientMergeAuthorizationId] references [tenantId, id]
  ref mergeTargetClient: Client fields [tenantId, mergeTargetClientId] references [tenantId, id]
  ref event: Event fields [tenantId, eventId] references [tenantId, id]
  hasMany payments: Payment

  constraint invoiceIssuedComplete: self.issuedAt == null or (length(trim(self.invoiceNumber)) > 0 and self.subtotal >= 0 and self.taxAmount >= 0 and self.discountAmount >= 0 and self.total >= 0 and self.amountPaid >= 0 and self.amountDue >= 0) "Issued invoices require a number and non-negative money amounts"
  constraint invoiceTotalsConsistent: self.issuedAt == null or self.total == self.subtotal + self.taxAmount - self.discountAmount "Invoice total must equal subtotal plus tax minus discount"
  constraint invoiceBalanceConsistent: self.issuedAt == null or (self.amountCredited == null and self.amountDue == self.total - self.amountPaid) or (self.amountCredited != null and self.amountDue == self.total - self.amountPaid - self.amountCredited) "Invoice amount due must equal total minus payments and applied credits"

  transition status from "draft" to ["sent", "voided"]
  transition status from "sent" to ["viewed", "overdue", "partial", "paid", "voided"]
  transition status from "viewed" to ["overdue", "partial", "paid", "voided"]
  transition status from "overdue" to ["partial", "paid", "written_off", "voided"]
  transition status from "partial" to ["partial", "paid", "overdue", "written_off"]
  transition status from "paid" to ["partial"]
  transition status from "voided" to []
  transition status from "written_off" to []

  default policy invoiceRead read: roleAllows(user.role, "financeAccess") or roleAllows(user.role, "manageAccess") "Finance staff and managers may read invoices"
  default policy invoiceWrite write: roleAllows(user.role, "financeAccess") or roleAllows(user.role, "manageAccess") "Finance staff and managers may write invoices through commands"
  default policy invoiceExecute execute: roleAllows(user.role, "financeAccess") or roleAllows(user.role, "manageAccess") "Finance staff and managers may execute invoice commands"

  command issue(
    clientId: uuid,
    invoiceNumber: string,
    subtotal: money(12, 2),
    taxAmount: money(12, 2),
    discountAmount: money(12, 2),
    total: money(12, 2),
    optional eventId: uuid,
    optional paymentTermsDays: number,
    optional dueDate: datetime,
    optional notes: string,
    optional lineItems: json,
    optional taxBreakdown: json
  ) {
    guard self.issuedAt == null
    guard self.status == "draft"
    guard self.deletedAt == null
    guard self.client != null
    constraint issueClientMatch: clientId == self.clientId "Issue clientId must match the seeded client reference"
    constraint issueEventMatch: eventId == null or self.eventId == null or eventId == self.eventId "Issue eventId must match the seeded event reference when both are set"
    constraint issueNumber: length(trim(invoiceNumber)) > 0 "Invoice number is required"
    constraint issueMoneyNonnegative: subtotal >= 0 and taxAmount >= 0 and discountAmount >= 0 and total >= 0 "Invoice money amounts cannot be negative"
    constraint issueTotalMatch: total == subtotal + taxAmount - discountAmount "Invoice total must equal subtotal plus tax minus discount"
    mutate clientId = clientId
    mutate eventId = eventId != null ? eventId : self.eventId
    mutate invoiceNumber = invoiceNumber
    mutate subtotal = subtotal
    mutate taxAmount = taxAmount
    mutate discountAmount = discountAmount
    mutate total = total
    mutate amountPaid = 0
    mutate amountDue = total
    mutate amountCredited = 0
    mutate creditMemoAmount = 0
    mutate lineItems = lineItems != null ? lineItems : []
    mutate taxBreakdown = taxBreakdown != null ? taxBreakdown : []
    mutate paymentTermsDays = paymentTermsDays != null ? paymentTermsDays : 30
    mutate dueDate = dueDate
    mutate notes = notes
    mutate issuedAt = now()
    emit InvoiceIssued {
      invoiceId: self.id
      tenantId: self.tenantId
      clientId: clientId
      eventId: eventId != null ? eventId : self.eventId
      invoiceNumber: invoiceNumber
      total: total
      amountDue: total
    }
  }

  command send() {
    guard self.status == "draft"
    guard self.issuedAt != null
    guard self.deletedAt == null
    constraint sendBalance: self.amountDue > 0 "Cannot send an invoice with zero balance"
    mutate status = "sent"
    mutate sentAt = now()
    emit InvoiceSent {
      invoiceId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      eventId: self.eventId
      invoiceNumber: self.invoiceNumber
      total: self.total
      amountDue: self.amountDue
    }
  }

  command markViewed() {
    guard self.status == "sent"
    guard self.deletedAt == null
    mutate status = "viewed"
    mutate viewedAt = now()
    emit InvoiceViewed {
      invoiceId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      eventId: self.eventId
    }
  }

  command applyPayment(paymentAmount: money(12, 2), optional paymentId: string) {
    guard self.status == "sent" or self.status == "viewed" or self.status == "overdue" or self.status == "partial"
    guard self.deletedAt == null
    constraint applyPositive: paymentAmount > 0 "Payment amount must be positive"
    constraint applyWithinDue: paymentAmount <= self.amountDue "Payment amount cannot exceed amount due"
    compute nextPaid = self.amountPaid + paymentAmount
    compute nextDue = self.amountDue - paymentAmount
    mutate amountPaid = nextPaid
    mutate amountDue = nextDue
    mutate status = nextDue == 0 ? "paid" : "partial"
    mutate paidAt = nextDue == 0 ? now() : self.paidAt
    emit InvoicePaymentApplied {
      invoiceId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      eventId: self.eventId
      paymentId: paymentId
      paymentAmount: paymentAmount
      amountPaid: nextPaid
      amountDue: nextDue
      status: nextDue == 0 ? "paid" : "partial"
    }
  }

  command setDeposit(depositAmount: money(12, 2), optional balanceReminderLeadDays: number) {
    guard self.deletedAt == null
    guard self.depositPaidAt == null
    constraint depositNonnegative: depositAmount >= 0 "Deposit amount cannot be negative"
    constraint depositWithinTotal: self.total == 0 or depositAmount <= self.total "Deposit amount cannot exceed the invoice total"
    constraint depositLeadDays: balanceReminderLeadDays == null or balanceReminderLeadDays >= 0 "Reminder lead days cannot be negative"
    mutate depositAmount = depositAmount
    mutate balanceReminderLeadDays = balanceReminderLeadDays != null ? balanceReminderLeadDays : self.balanceReminderLeadDays
    emit InvoiceDepositSet {
      invoiceId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      eventId: self.eventId
      depositAmount: depositAmount
      balanceReminderLeadDays: balanceReminderLeadDays != null ? balanceReminderLeadDays : self.balanceReminderLeadDays
    }
  }

  // Deposit payment applies to the balance like applyPayment, plus stamps depositPaidAt.
  command markDepositPaid() {
    guard self.status == "sent" or self.status == "viewed" or self.status == "overdue" or self.status == "partial"
    guard self.deletedAt == null
    guard self.depositPaidAt == null
    constraint depositSet: self.depositAmount != null and self.depositAmount > 0 "No deposit is due on this invoice"
    constraint depositWithinDue: self.depositAmount != null and self.depositAmount <= self.amountDue "Deposit cannot exceed amount due"
    compute nextPaid = self.amountPaid + self.depositAmount
    compute nextDue = self.amountDue - self.depositAmount
    mutate amountPaid = nextPaid
    mutate amountDue = nextDue
    mutate depositPaidAt = now()
    mutate status = nextDue == 0 ? "paid" : "partial"
    mutate paidAt = nextDue == 0 ? now() : self.paidAt
    emit InvoiceDepositPaid {
      invoiceId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      eventId: self.eventId
      depositAmount: self.depositAmount
      amountPaid: nextPaid
      amountDue: nextDue
    }
  }

  // Balance-due reminder; the UI surfaces this at balanceReminderLeadDays
  // before the linked event's startsAt (manual trigger, markOverdue precedent).
  command sendBalanceReminder() {
    guard self.deletedAt == null
    guard self.balanceReminderSentAt == null
    constraint reminderBalance: self.amountDue > 0 "No outstanding balance to remind about"
    mutate balanceReminderSentAt = now()
    emit InvoiceBalanceReminderSent {
      invoiceId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      eventId: self.eventId
      amountDue: self.amountDue
    }
  }

  command recordRefund(refundAmount: money(12, 2), paymentId: string) {
    guard self.status == "paid" or self.status == "partial"
    guard self.deletedAt == null
    constraint refundPositive: refundAmount > 0 "Refund amount must be positive"
    constraint refundWithinPaid: refundAmount <= self.amountPaid "Refund amount cannot exceed amount paid"
    constraint refundPaymentId: length(trim(paymentId)) > 0 "Payment id is required for refund"
    compute nextPaid = self.amountPaid - refundAmount
    compute nextDue = self.amountDue + refundAmount
    mutate amountPaid = nextPaid
    mutate amountDue = nextDue
    mutate status = "partial"
    mutate paidAt = null
    emit InvoiceRefundRecorded {
      invoiceId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      eventId: self.eventId
      paymentId: paymentId
      refundAmount: refundAmount
      amountPaid: nextPaid
      amountDue: nextDue
    }
  }

  // Records total credit memos issued against this paid source invoice without
  // rewriting its payment history or reopening its settled balance.
  command recordCreditMemo(creditAmount: money(12, 2), creditMemoId: string) {
    guard self.status == "paid"
    guard self.deletedAt == null
    constraint creditMemoPositive: creditAmount > 0 "Credit memo amount must be positive"
    constraint creditMemoIdPresent: length(trim(creditMemoId)) > 0 "Credit memo id is required"
    compute priorCreditMemoAmount = self.creditMemoAmount != null ? self.creditMemoAmount : 0
    constraint creditMemoWithinPaid: creditAmount <= self.amountPaid - (self.creditMemoAmount != null ? self.creditMemoAmount : 0) "Credit memos cannot exceed the amount paid on the source invoice"
    compute nextCreditMemoAmount = priorCreditMemoAmount + creditAmount
    mutate creditMemoAmount = nextCreditMemoAmount
    emit InvoiceCreditMemoRecorded {
      invoiceId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      eventId: self.eventId
      creditMemoId: creditMemoId
      creditAmount: creditAmount
      creditMemoAmount: nextCreditMemoAmount
    }
  }

  // Applies a credit memo to an open target invoice. Payment totals remain
  // untouched so finance can distinguish cash received from account credit.
  command applyCredit(creditAmount: money(12, 2), creditMemoId: string) {
    guard self.status == "sent" or self.status == "viewed" or self.status == "overdue" or self.status == "partial"
    guard self.deletedAt == null
    constraint creditPositive: creditAmount > 0 "Applied credit must be positive"
    constraint creditWithinDue: creditAmount <= self.amountDue "Applied credit cannot exceed the target invoice balance"
    constraint appliedCreditMemoIdPresent: length(trim(creditMemoId)) > 0 "Credit memo id is required"
    compute priorAmountCredited = self.amountCredited != null ? self.amountCredited : 0
    compute nextAmountCredited = priorAmountCredited + creditAmount
    compute nextDue = self.amountDue - creditAmount
    mutate amountCredited = nextAmountCredited
    mutate amountDue = nextDue
    mutate status = nextDue == 0 ? "paid" : "partial"
    mutate paidAt = nextDue == 0 ? now() : self.paidAt
    emit InvoiceCreditApplied {
      invoiceId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      eventId: self.eventId
      creditMemoId: creditMemoId
      creditAmount: creditAmount
      amountCredited: nextAmountCredited
      amountDue: nextDue
    }
  }

  command markOverdue() {
    guard self.status == "sent" or self.status == "viewed" or self.status == "partial"
    guard self.deletedAt == null
    guard self.dueDate != null and self.dueDate < now()
    mutate status = "overdue"
    mutate overdueSince = now()
    emit InvoiceMarkedOverdue {
      invoiceId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      eventId: self.eventId
      amountDue: self.amountDue
    }
  }

  command markVoided(reason: string) {
    guard self.status == "draft" or self.status == "sent" or self.status == "viewed" or self.status == "overdue"
    guard self.deletedAt == null
    guard self.amountPaid == 0
    constraint voidReasonPresent: length(trim(reason)) > 0 "Void reason is required"
    mutate status = "voided"
    mutate voidReason = reason
    mutate voidedAt = now()
    emit InvoiceVoided {
      invoiceId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      eventId: self.eventId
      reason: reason
    }
  }

  command writeOff(reason: string, writeOffAmount: money(12, 2)) {
    guard self.status == "overdue" or self.status == "partial"
    guard self.deletedAt == null
    constraint writeOffReasonPresent: length(trim(reason)) > 0 "Write-off reason is required"
    constraint writeOffPositive: writeOffAmount > 0 "Write-off amount must be positive"
    constraint writeOffWithinDue: writeOffAmount <= self.amountDue "Write-off amount cannot exceed amount due"
    mutate status = "written_off"
    mutate amountDue = 0
    mutate writeOffReason = reason
    mutate writtenOffAt = now()
    emit InvoiceWrittenOff {
      invoiceId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      eventId: self.eventId
      reason: reason
      writeOffAmount: writeOffAmount
    }
  }

  command stageClientMerge(clientMergeId: uuid, clientId: uuid) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "adminAccess")
    constraint stageDistinctClient: clientId != self.clientId "Invoice already belongs to this client"
    mutate clientMergeAuthorizationId = clientMergeId
    mutate mergeTargetClientId = clientId
    emit InvoiceClientMergeStaged {
      invoiceId: self.id
      tenantId: self.tenantId
    }
  }

  command reassignClient() {
    guard self.deletedAt == null
    guard roleAllows(user.role, "adminAccess")
    guard self.clientMergeAuthorization != null
    guard self.clientMergeAuthorization.deletedAt == null
    guard self.clientMergeAuthorization.mergedAt != null
    guard self.mergeTargetClient != null
    guard self.mergeTargetClient.status == "active"
    guard self.mergeTargetClient.deletedAt == null
    constraint reassignAuthorizedSource: self.clientMergeAuthorization.duplicateClientId == self.clientId "Merge authorization does not match the invoice client"
    constraint reassignAuthorizedTarget: self.clientMergeAuthorization.primaryClientId == self.mergeTargetClientId "Merge authorization does not match the primary client"
    compute previousClientId = self.clientId
    mutate clientId = self.mergeTargetClientId
    emit InvoiceClientReassigned {
      invoiceId: self.id
      tenantId: self.tenantId
      previousClientId: previousClientId
      clientId: self.mergeTargetClientId
    }
  }

  store Invoice in durable
}

event InvoiceClientMergeStaged: "invoice.client_merge_staged" {
  invoiceId: string
  tenantId: string
}

event InvoiceClientReassigned: "invoice.client_reassigned" {
  invoiceId: string
  tenantId: string
  previousClientId: string
  clientId: string
}

event InvoiceIssued: "invoice.issued" {
  invoiceId: string
  tenantId: string
  clientId: string
  eventId: string?
  invoiceNumber: string
  total: money(12, 2)
  amountDue: money(12, 2)
}

event InvoiceSent: "invoice.sent" {
  invoiceId: string
  tenantId: string
  clientId: string
  eventId: string?
  invoiceNumber: string?
  total: money(12, 2)
  amountDue: money(12, 2)
}

event InvoiceViewed: "invoice.viewed" {
  invoiceId: string
  tenantId: string
  clientId: string
  eventId: string?
}

event InvoicePaymentApplied: "invoice.payment_applied" {
  invoiceId: string
  tenantId: string
  clientId: string
  eventId: string?
  paymentId: string?
  paymentAmount: money(12, 2)
  amountPaid: money(12, 2)
  amountDue: money(12, 2)
  status: InvoiceStatus
}

event InvoiceDepositSet: "invoice.deposit_set" {
  invoiceId: string
  tenantId: string
  clientId: string
  eventId: string?
  depositAmount: money(12, 2)
  balanceReminderLeadDays: number?
}

event InvoiceDepositPaid: "invoice.deposit_paid" {
  invoiceId: string
  tenantId: string
  clientId: string
  eventId: string?
  depositAmount: money(12, 2)
  amountPaid: money(12, 2)
  amountDue: money(12, 2)
}

event InvoiceBalanceReminderSent: "invoice.balance_reminder_sent" {
  invoiceId: string
  tenantId: string
  clientId: string
  eventId: string?
  amountDue: money(12, 2)
}

event InvoiceRefundRecorded: "invoice.refund_recorded" {
  invoiceId: string
  tenantId: string
  clientId: string
  eventId: string?
  paymentId: string
  refundAmount: money(12, 2)
  amountPaid: money(12, 2)
  amountDue: money(12, 2)
}

event InvoiceCreditMemoRecorded: "invoice.credit_memo_recorded" {
  invoiceId: string
  tenantId: string
  clientId: string
  eventId: string?
  creditMemoId: string
  creditAmount: money(12, 2)
  creditMemoAmount: money(12, 2)
}

event InvoiceCreditApplied: "invoice.credit_applied" {
  invoiceId: string
  tenantId: string
  clientId: string
  eventId: string?
  creditMemoId: string
  creditAmount: money(12, 2)
  amountCredited: money(12, 2)
  amountDue: money(12, 2)
}

event InvoiceMarkedOverdue: "invoice.marked_overdue" {
  invoiceId: string
  tenantId: string
  clientId: string
  eventId: string?
  amountDue: money(12, 2)
}

event InvoiceVoided: "invoice.voided" {
  invoiceId: string
  tenantId: string
  clientId: string
  eventId: string?
  reason: string
}

event InvoiceWrittenOff: "invoice.written_off" {
  invoiceId: string
  tenantId: string
  clientId: string
  eventId: string?
  reason: string
  writeOffAmount: money(12, 2)
}
