// Capsule sales — proactive outreach reminders for churn-candidate clients.
// A reminder is opened for a client who was active the prior year but has no
// booking in the current year; sales works it to completion or dismisses it.

enum ClientOutreachTaskStatus {
  open
  completed
  dismissed
}

entity ClientOutreachTask mixin TenantScoped {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required clientId: uuid
  property required reason: string = ""
  property required status: ClientOutreachTaskStatus = "open"
  // Auth subject from trusted runtime context, not a Person document id.
  property openedById: string?
  property openedAt: datetime?
  property resolvedAt: datetime?
  property resolutionNote: string?
  // A client merge moves the reminder to the client kept (PL-SOURCE-MERGE).
  property clientMergeAuthorizationId: uuid?
  property mergeTargetClientId: uuid?

  belongsTo client: Client fields [tenantId, clientId] references [tenantId, id]
  ref clientMergeAuthorization: ClientMerge fields [tenantId, clientMergeAuthorizationId] references [tenantId, id]
  ref mergeTargetClient: Client fields [tenantId, mergeTargetClientId] references [tenantId, id]

  constraint reminderReasonComplete: self.openedAt == null or length(trim(self.reason)) > 0 "Give this follow-up reminder a reason"

  transition status from "open" to ["completed", "dismissed"]
  transition status from "completed" to []
  transition status from "dismissed" to []

  default policy clientFollowUpReminderRead read: roleAllows(user.role, "salesAccess") "Sales staff may see client follow-up reminders"
  default policy clientFollowUpReminderWrite write: roleAllows(user.role, "salesAccess") "Sales staff may update client follow-up reminders"
  default policy clientFollowUpReminderExecute execute: roleAllows(user.role, "salesAccess") "Sales staff may change client follow-up reminders"

  command open(clientId: uuid, reason: string) {
    guard self.openedAt == null
    constraint openReminderReason: length(trim(reason)) > 0 "Give this follow-up reminder a reason"
    mutate clientId = clientId
    mutate reason = reason
    mutate status = "open"
    mutate openedById = user.id
    mutate openedAt = now()
    emit ClientOutreachTaskOpened {
      reminderId: self.id
      tenantId: self.tenantId
      clientId: clientId
    }
  }

  command complete(optional note: string) {
    guard self.status == "open"
    mutate status = "completed"
    mutate resolvedAt = now()
    mutate resolutionNote = note
    emit ClientOutreachTaskCompleted {
      reminderId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
    }
  }

  command dismiss(optional note: string) {
    guard self.status == "open"
    mutate status = "dismissed"
    mutate resolvedAt = now()
    mutate resolutionNote = note
    emit ClientOutreachTaskDismissed {
      reminderId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
    }
  }

  command stageClientMerge(clientMergeId: uuid, clientId: uuid) {
    guard roleAllows(user.role, "adminAccess")
    constraint stageDistinctClient: clientId != self.clientId "Reminder already belongs to this client"
    mutate clientMergeAuthorizationId = clientMergeId
    mutate mergeTargetClientId = clientId
    emit ClientOutreachTaskClientMergeStaged {
      reminderId: self.id
      tenantId: self.tenantId
    }
  }

  command reassignClient() {
    guard roleAllows(user.role, "adminAccess")
    guard self.clientMergeAuthorization != null
    guard self.clientMergeAuthorization.deletedAt == null
    guard self.clientMergeAuthorization.mergedAt != null
    guard self.mergeTargetClient != null
    guard self.mergeTargetClient.status == "active"
    guard self.mergeTargetClient.deletedAt == null
    constraint reassignAuthorizedSource: self.clientMergeAuthorization.duplicateClientId == self.clientId "Merge authorization does not match the reminder client"
    constraint reassignAuthorizedTarget: self.clientMergeAuthorization.primaryClientId == self.mergeTargetClientId "Merge authorization does not match the primary client"
    compute previousClientId = self.clientId
    mutate clientId = self.mergeTargetClientId
    emit ClientOutreachTaskClientReassigned {
      reminderId: self.id
      tenantId: self.tenantId
      previousClientId: previousClientId
      clientId: self.mergeTargetClientId
    }
  }

  store ClientOutreachTask in durable
}

event ClientOutreachTaskClientMergeStaged: "client_outreach_task.client_merge_staged" {
  reminderId: string
  tenantId: string
}

event ClientOutreachTaskClientReassigned: "client_outreach_task.client_reassigned" {
  reminderId: string
  tenantId: string
  previousClientId: string
  clientId: string
}

event ClientOutreachTaskOpened: "client_outreach_task.opened" {
  reminderId: string
  tenantId: string
  clientId: string
}

event ClientOutreachTaskCompleted: "client_outreach_task.completed" {
  reminderId: string
  tenantId: string
  clientId: string
}

event ClientOutreachTaskDismissed: "client_outreach_task.dismissed" {
  reminderId: string
  tenantId: string
  clientId: string
}
