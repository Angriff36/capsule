// Capsule documents — file attachments on Event, Client, Contract, Vendor,
// Delivery, Closeout, Dish, Ingredient, and StaffMessage (team chat) records.
// Binary content lives in Convex file storage (authored seam
// convex/fileStorage.ts issues upload URLs and resolves download URLs);
// this entity records the metadata, uploader identity, and timestamp.
// The parentType union is also hand-mirrored in convex/fileStorage.ts
// (listForParent) and src/features/attachments/AttachmentsSection.tsx —
// minus staffMessage, whose files are read only through convex/teamChat.ts.

use "../foundation/base.manifest"

enum AttachmentParentType {
  // "event" is a reserved word in Manifest, so the member is eventRecord.
  eventRecord
  client
  contract
  vendor
  delivery
  closeout
  // Culinary dish hero / primary image (Dish.setPrimaryImage).
  dish
  // Culinary ingredient catalog image (Ingredient.setPrimaryImage).
  ingredient
  // Team chat photo or file; parentId is the StaffMessage id.
  staffMessage
}

enum AttachmentEvidenceType {
  venueCondition
  leftoverFood
  equipmentReturn
  // Event photo gallery categories (parentType eventRecord).
  setup
  food
  service
  venue
}

event AttachmentAdded: "attachment.added" {
  attachmentId: string
  tenantId: string
  parentType: string
  parentId: string
  fileName: string
}

event AttachmentRemoved: "attachment.removed" {
  attachmentId: string
  tenantId: string
}

entity Attachment mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  // Not `indexed`: the Convex projection emits a by-index query typed
  // v.string() that fails typecheck against an enum column's literal union.
  property required parentType: AttachmentParentType = "eventRecord"
  property required indexed parentId: string
  property required fileName: string
  property required contentType: string
  property required fileSize: int = 0
  // Indexed so an orphaned upload (a blob no live row references) can be
  // recognised and discarded (convex/fileStorage.ts discardOrphanUploads).
  property required indexed storageId: string
  property evidenceType: AttachmentEvidenceType?
  property uploadedById: string?
  property uploadedAt: datetime?
  // Operator-selected photos to include in the post-event client feedback survey.
  property inFeedbackSurvey: boolean?

  // Team-chat files (parentType staffMessage) follow their message: the chat
  // seam (convex/teamChat.ts) shows them to the message's readers, and the
  // generated queries show them only to the uploader. `uploadedById == null`
  // is the create-time draft escape (the read policy runs before mutates).
  default policy attachmentRead read: roleAllows(user.role, "staffAccess") and (self.parentType != "staffMessage" or self.uploadedById == null or (user.id != null and self.uploadedById == user.id)) "Staff may read attachments; chat files stay with their message"
  default policy attachmentWrite write: roleAllows(user.role, "staffAccess") "Staff may write attachments through commands"
  default policy attachmentExecute execute: roleAllows(user.role, "staffAccess") "Staff may execute attachment commands"

  command attach(
    parentType: AttachmentParentType,
    parentId: string,
    fileName: string,
    contentType: string,
    fileSize: int,
    storageId: string,
    optional evidenceType: AttachmentEvidenceType
  ) {
    constraint attachParent: length(trim(parentId)) > 0 "Parent record is required"
    constraint attachFileName: length(trim(fileName)) > 0 "File name is required"
    constraint attachStorage: length(trim(storageId)) > 0 "Stored file reference is required"
    constraint attachSize: fileSize >= 0 "File size cannot be negative"
    mutate parentType = parentType
    mutate parentId = parentId
    mutate fileName = fileName
    mutate contentType = contentType
    mutate fileSize = fileSize
    mutate storageId = storageId
    mutate evidenceType = evidenceType
    mutate uploadedById = user.id
    mutate uploadedAt = now()
    emit AttachmentAdded {
      attachmentId: self.id
      tenantId: self.tenantId
      parentType: parentType
      parentId: parentId
      fileName: fileName
    }
  }

  command setSurveySelection(included: boolean) {
    guard self.deletedAt == null
    mutate inFeedbackSurvey = included
  }

  command remove() {
    guard self.deletedAt == null
    mutate deletedAt = now()
    emit AttachmentRemoved {
      attachmentId: self.id
      tenantId: self.tenantId
    }
  }

  store Attachment in durable
}
