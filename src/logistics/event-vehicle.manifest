// EventVehicleAssignment — a truck, a trailer, or a truck with its trailer,
// attached to ONE event from the Event Tracker.
//
// Owner correction 2026-09-19: in catering a "delivery" is the Drop-Off service
// style, not the truck trip of a full-service event. The Ops Final Lock process
// assigns the truck and trailer on the Event Tracker BEFORE the warehouse
// packs, so the assignment belongs to the event, not to a Delivery that only
// exists after a pack list is packed.
//
// One row per rig. An event can hold several rows (two trucks, a truck and a
// separate trailer). A row records who drives it and whether the load is
// already in the vehicle. Rows stay correctable up to and during the event:
// trucks break down and drivers call out.
//
// A rig's truck, trailer and driver are set when the row is made and never
// patched: an update command cannot check a NEW id against the caller's
// workspace (relations read the saved row). To change one, the tracker attaches
// the corrected rig and releases the old one.

use "../foundation/base.manifest"

entity EventVehicleAssignment mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  // Null once released, so "what is on this event now" is one index read.
  property indexed activeEventId: uuid?
  property required eventId: uuid
  property indexed vehicleId: uuid?
  property indexed trailerId: uuid?
  property driverId: uuid?
  property notes: string?
  property assignedAt: datetime?
  property preloadedAt: datetime?
  property releasedAt: datetime?
  // An outside vendor's own truck (a rental drop): named, not one of ours.
  property vendorName: string?
  // This run's own times (PL-ROUTE-LEGS). Unset = with the main crew: on site
  // at the event's setup time, the event's load time, stays to the end. Every
  // time still comes from the same event facts, so a change moves all runs.
  property arriveBeforeServeMinutes: float?
  property loadMinutes: float?
  // A drop run leaves this long after arriving; the truck can then do a
  // second trip (another row for the same truck).
  property leaveAfterMinutes: float?
  // Where this rig is loaded at the kitchen ("dock 2", "back lot"). Shown on
  // every pack line that rides on it (PL-DELIVERY).
  property loadingZone: string?
  // Why this truck or trailer may run while it is on another run at the same
  // time (the planner said so on the planning board). With it, the
  // same-time check lets the run through; without it, the clash is refused.
  property bookedTwiceReason: string?
  // Staff profile that said the load is in the vehicle. Missing when that
  // account is not linked to a profile.
  property preloadedByPersonId: uuid?

  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]
  belongsTo vehicle: Vehicle fields [tenantId, vehicleId] references [tenantId, id]
  belongsTo trailer: Trailer fields [tenantId, trailerId] references [tenantId, id]
  belongsTo driver: Person fields [tenantId, driverId] references [tenantId, id]

  computed isPreloaded: boolean = self.preloadedAt != null
  computed isReleased: boolean = self.releasedAt != null

  constraint assignmentHasRig: self.assignedAt == null or self.vehicleId != null or self.trailerId != null or (self.vendorName != null and length(trim(self.vendorName)) > 0) "An assignment needs a vehicle, a trailer or a vendor name"

  // The crew needs to know which truck they are on; the people who run events
  // and logistics set it from the tracker.
  default policy eventVehicleAssignmentRead read: roleAllows(user.role, "staffAccess") "Staff may see event vehicle assignments"
  default policy eventVehicleAssignmentWrite write: roleAllows(user.role, "eventAccess") or roleAllows(user.role, "salesAccess") or roleAllows(user.role, "logisticsAccess") or roleAllows(user.role, "manageAccess") "Event, sales and logistics staff and managers may update event vehicle assignments"
  default policy eventVehicleAssignmentExecute execute: roleAllows(user.role, "eventAccess") or roleAllows(user.role, "salesAccess") or roleAllows(user.role, "logisticsAccess") or roleAllows(user.role, "manageAccess") "Event, sales and logistics staff and managers may change event vehicle assignments"

  command assign(
    eventId: uuid,
    optional vehicleId: uuid,
    optional trailerId: uuid,
    optional driverId: uuid,
    optional notes: string,
    optional preloaded: boolean,
    optional vendorName: string,
    optional arriveBeforeServeMinutes: float,
    optional loadMinutes: float,
    optional leaveAfterMinutes: float,
    optional loadingZone: string,
    optional bookedTwiceReason: string
  ) {
    guard self.assignedAt == null
    guard self.deletedAt == null
    // Relations resolve inside the caller's workspace only: an id from another
    // workspace resolves to nothing and the assignment is refused.
    guard self.event != null and self.event.deletedAt == null
    guard vehicleId == null or self.vehicle != null
    guard trailerId == null or self.trailer != null
    guard driverId == null or self.driver != null
    constraint assignHasRig: vehicleId != null or trailerId != null or (vendorName != null and length(trim(vendorName)) > 0) "Select a vehicle or a trailer, or name the vendor"
    // A second trip on the same truck is booked with its own times, so the
    // booking check sees the real window (PL-DELIVERY).
    constraint assignArriveNotNegative: arriveBeforeServeMinutes == null or arriveBeforeServeMinutes >= 0 "Arrival before serve cannot be negative"
    constraint assignLoadNotNegative: loadMinutes == null or loadMinutes >= 0 "Load time cannot be negative"
    constraint assignLeaveAfterPositive: leaveAfterMinutes == null or leaveAfterMinutes > 0 "Time on site before leaving has to be more than zero"
    mutate eventId = eventId
    mutate activeEventId = eventId
    mutate vehicleId = vehicleId
    mutate trailerId = trailerId
    mutate driverId = driverId
    mutate vendorName = vendorName
    mutate notes = notes
    mutate arriveBeforeServeMinutes = arriveBeforeServeMinutes
    mutate loadMinutes = loadMinutes
    mutate leaveAfterMinutes = leaveAfterMinutes
    mutate loadingZone = loadingZone
    mutate bookedTwiceReason = bookedTwiceReason != null and length(trim(bookedTwiceReason)) > 0 ? trim(bookedTwiceReason) : null
    mutate preloadedAt = preloaded == true ? now() : null
    mutate preloadedByPersonId = preloaded == true ? user.personId : null
    mutate assignedAt = now()
    emit EventVehicleAssigned {
      eventVehicleAssignmentId: self.id
      tenantId: self.tenantId
      eventId: eventId
      vehicleId: vehicleId
      trailerId: trailerId
      driverId: driverId
    }
  }

  // The load is in the actual vehicle. Reversible: a repack unloads it.
  command markPreloaded() {
    guard self.assignedAt != null
    guard self.releasedAt == null
    guard self.deletedAt == null
    mutate preloadedAt = now()
    mutate preloadedByPersonId = user.personId
    emit EventVehiclePreloaded {
      eventVehicleAssignmentId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  command clearPreloaded() {
    guard self.preloadedAt != null
    guard self.deletedAt == null
    mutate preloadedAt = null
    mutate preloadedByPersonId = null
    emit EventVehiclePreloadCleared {
      eventVehicleAssignmentId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  // This run's own times. An omitted value goes back to the main crew's.
  command planLeg(
    optional arriveBeforeServeMinutes: float,
    optional loadMinutes: float,
    optional leaveAfterMinutes: float
  ) {
    guard self.assignedAt != null
    guard self.releasedAt == null
    guard self.deletedAt == null
    constraint legArriveNotNegative: arriveBeforeServeMinutes == null or arriveBeforeServeMinutes >= 0 "Arrival before serve cannot be negative"
    constraint legLoadNotNegative: loadMinutes == null or loadMinutes >= 0 "Load time cannot be negative"
    constraint legLeaveAfterPositive: leaveAfterMinutes == null or leaveAfterMinutes > 0 "Time on site before leaving has to be more than zero"
    mutate arriveBeforeServeMinutes = arriveBeforeServeMinutes
    mutate loadMinutes = loadMinutes
    mutate leaveAfterMinutes = leaveAfterMinutes
    emit EventVehicleLegPlanned {
      eventVehicleAssignmentId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  // Where this rig loads at the kitchen. Empty clears it.
  command setLoadingZone(optional loadingZone: string) {
    guard self.assignedAt != null
    guard self.releasedAt == null
    guard self.deletedAt == null
    mutate loadingZone = loadingZone != null and length(trim(loadingZone)) > 0 ? loadingZone : null
    emit EventVehicleLoadingZoneSet {
      eventVehicleAssignmentId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  // Take the rig off the event. The row stays as history.
  command release() {
    guard self.assignedAt != null
    guard self.releasedAt == null
    guard self.deletedAt == null
    mutate activeEventId = null
    mutate releasedAt = now()
    emit EventVehicleReleased {
      eventVehicleAssignmentId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      vehicleId: self.vehicleId
      trailerId: self.trailerId
    }
  }

  store EventVehicleAssignment in durable
}

event EventVehicleAssigned: "event_vehicle.assigned" {
  eventVehicleAssignmentId: string
  tenantId: string
  eventId: string
  vehicleId: string?
  trailerId: string?
  driverId: string?
}

event EventVehiclePreloaded: "event_vehicle.preloaded" {
  eventVehicleAssignmentId: string
  tenantId: string
  eventId: string
}

event EventVehiclePreloadCleared: "event_vehicle.preload_cleared" {
  eventVehicleAssignmentId: string
  tenantId: string
  eventId: string
}

event EventVehicleLegPlanned: "event_vehicle.leg_planned" {
  eventVehicleAssignmentId: string
  tenantId: string
  eventId: string
}

event EventVehicleLoadingZoneSet: "event_vehicle.loading_zone_set" {
  eventVehicleAssignmentId: string
  tenantId: string
  eventId: string
}

event EventVehicleReleased: "event_vehicle.released" {
  eventVehicleAssignmentId: string
  tenantId: string
  eventId: string
  vehicleId: string?
  trailerId: string?
}

// A cancelled event gives its rigs back.
on EventCancelled fanOut EventVehicleAssignment where activeEventId = payload.eventId
  run release
