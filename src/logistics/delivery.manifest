// Capsule logistics — Delivery (transport of one PackList).
// Maps product Delivery; capsule-pro evidence spans Dispatch/Route/Shipment.

use "./pack-list.manifest"

enum DeliveryStatus {
  scheduled
  in_transit
  delivered
  failed
  cancelled
}

entity Delivery mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required packListId: uuid
  property required eventId: uuid
  property driverId: uuid?
  property vehicleId: uuid?
  property required destination: string = ""
  property windowStartsAt: datetime?
  property windowEndsAt: datetime?
  property encrypted notes: string?
  property required status: DeliveryStatus = "scheduled"
  property scheduledAt: datetime?
  property departedAt: datetime?
  property deliveredAt: datetime?
  property failedAt: datetime?
  property failureReason: string?
  property cancelledAt: datetime?
  property cancellationReason: string?

  belongsTo packList: PackList fields [tenantId, packListId] references [tenantId, id]
  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]
  belongsTo driver: Person fields [tenantId, driverId] references [tenantId, id]
  belongsTo vehicle: Vehicle fields [tenantId, vehicleId] references [tenantId, id]

  constraint deliveryScheduledComplete: self.scheduledAt == null or (length(trim(self.destination)) > 0 and self.windowStartsAt != null and self.windowEndsAt != null and self.windowEndsAt > self.windowStartsAt) "Give this delivery a destination and a start and end time before you schedule it."

  transition status from "scheduled" to ["in_transit", "failed", "cancelled"]
  transition status from "in_transit" to ["delivered", "failed", "cancelled"]
  transition status from "delivered" to []
  transition status from "failed" to []
  transition status from "cancelled" to []

  // manageAccess: reserved for manager-driven cascade; logisticsAccess: packing staff.
  default policy deliveryRead read: roleAllows(user.role, "logisticsAccess") or roleAllows(user.role, "manageAccess") "Logistics staff and managers may see deliveries"
  default policy deliveryWrite write: roleAllows(user.role, "logisticsAccess") or roleAllows(user.role, "manageAccess") "Logistics staff and managers may update deliveries"
  default policy deliveryExecute execute: roleAllows(user.role, "logisticsAccess") or roleAllows(user.role, "manageAccess") "Logistics staff and managers may change deliveries"

  // Idempotent schedule: PackListPacked reaction may re-fire; do not duplicate.
  command schedule(
    packListId: uuid,
    eventId: uuid,
    destination: string,
    windowStartsAt: datetime,
    windowEndsAt: datetime,
    optional driverId: uuid,
    optional notes: string
  ) {
    guard self.deletedAt == null
    guard self.status == "scheduled"
    guard self.packList != null and (self.packList.status == "packed" or self.packList.status == "loaded" or self.packList.status == "dispatched")
    guard self.event != null
    guard self.scheduledAt == null or self.packListId == packListId
    constraint schedulePackListMatch: packListId == self.packListId "This delivery is for a different pack list. Pick the pack list already on this delivery."
    constraint scheduleEventMatch: eventId == self.eventId "This delivery is for a different event. Pick the event already on this delivery."
    constraint scheduleDriverMatch: driverId == null or self.driverId == null or driverId == self.driverId "This delivery is for a different driver. Leave the driver blank or pick the one already on this delivery."
    constraint scheduleDestinationPresent: length(trim(destination)) > 0 or length(trim(self.destination)) > 0 "Give this delivery a destination."
    constraint scheduleWindowDates: (self.scheduledAt != null) or (windowEndsAt > windowStartsAt) "This delivery's window end has to be after its start. Fix the times."
    mutate packListId = packListId
    mutate eventId = eventId
    mutate destination = length(trim(self.destination)) > 0 ? self.destination : destination
    mutate windowStartsAt = self.windowStartsAt != null ? self.windowStartsAt : windowStartsAt
    mutate windowEndsAt = self.windowEndsAt != null ? self.windowEndsAt : windowEndsAt
    mutate driverId = driverId != null ? driverId : self.driverId
    mutate notes = notes != null ? notes : self.notes
    mutate scheduledAt = self.scheduledAt != null ? self.scheduledAt : now()
    emit DeliveryScheduled {
      deliveryId: self.id
      tenantId: self.tenantId
      packListId: packListId
      eventId: eventId
      driverId: driverId != null ? driverId : self.driverId
      destination: length(trim(self.destination)) > 0 ? self.destination : destination
      windowStartsAt: self.windowStartsAt != null ? self.windowStartsAt : windowStartsAt
      windowEndsAt: self.windowEndsAt != null ? self.windowEndsAt : windowEndsAt
      status: "scheduled"
    }
  }

  command startTransit() {
    guard self.status == "scheduled"
    guard self.scheduledAt != null
    guard self.driverId != null
    guard self.deletedAt == null
    guard user.id != null
    guard self.driverId == user.id or roleAllows(user.role, "logisticsManageAccess")
    compute previousStatus = self.status
    mutate status = "in_transit"
    mutate departedAt = now()
    emit DeliveryTransitStarted {
      deliveryId: self.id
      tenantId: self.tenantId
      packListId: self.packListId
      eventId: self.eventId
      driverId: self.driverId
      previousStatus: previousStatus
      status: "in_transit"
      departedAt: self.departedAt
    }
  }

  command confirmDelivery() {
    guard self.status == "in_transit"
    guard self.departedAt != null
    guard self.deletedAt == null
    guard user.id != null
    guard self.driverId == user.id or roleAllows(user.role, "logisticsManageAccess")
    compute previousStatus = self.status
    mutate status = "delivered"
    mutate deliveredAt = now()
    emit DeliveryConfirmed {
      deliveryId: self.id
      tenantId: self.tenantId
      packListId: self.packListId
      eventId: self.eventId
      driverId: self.driverId
      previousStatus: previousStatus
      status: "delivered"
      deliveredAt: self.deliveredAt
    }
  }

  command markFailed(reason: string) {
    guard self.status == "scheduled" or self.status == "in_transit"
    guard self.scheduledAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "logisticsManageAccess")
    constraint failDeliveryReason: length(trim(reason)) > 0 "Say why this delivery failed."
    compute previousStatus = self.status
    mutate status = "failed"
    mutate failedAt = now()
    mutate failureReason = reason
    emit DeliveryFailed {
      deliveryId: self.id
      tenantId: self.tenantId
      packListId: self.packListId
      eventId: self.eventId
      driverId: self.driverId
      previousStatus: previousStatus
      status: "failed"
      reason: reason
    }
  }

  command cancel(reason: string) {
    guard self.status == "scheduled" or self.status == "in_transit"
    guard self.deletedAt == null
    guard roleAllows(user.role, "logisticsManageAccess")
    constraint cancelDeliveryReason: length(trim(reason)) > 0 "Say why you're cancelling this delivery."
    compute previousStatus = self.status
    mutate status = "cancelled"
    mutate cancelledAt = now()
    mutate cancellationReason = reason
    emit DeliveryCancelled {
      deliveryId: self.id
      tenantId: self.tenantId
      packListId: self.packListId
      eventId: self.eventId
      driverId: self.driverId
      previousStatus: previousStatus
      status: "cancelled"
      reason: reason
    }
  }

  // Automatic stand-down never changes completed logistics history.
  command standDownWithEvent() {
    guard self.status == "scheduled" or self.status == "in_transit"
    guard self.deletedAt == null
    // The parent event cancellation supplies the authorization and reason.
    guard self.event != null and self.event.stage == "cancelled"
    compute reason = self.event.cancellationReason != null ? self.event.cancellationReason : "Event cancelled"
    compute previousStatus = self.status
    mutate status = "cancelled"
    mutate cancelledAt = now()
    mutate cancellationReason = reason
    emit DeliveryCancelled {
      deliveryId: self.id
      tenantId: self.tenantId
      packListId: self.packListId
      eventId: self.eventId
      driverId: self.driverId
      previousStatus: previousStatus
      status: "cancelled"
      reason: reason
    }
  }

  // Driver and vehicle changes on a live delivery. The authored seams
  // (convex/driverAssignment.ts, convex/vehicleAssignment.ts) keep the
  // operator-readable pre-checks and call these commands; these guards make the
  // generated mutations safe to call directly. The vehicle calendar-overlap
  // check across sibling deliveries runs in the command transaction on
  // DeliveryVehicleAssigned (convex/lib/operationalEvents.ts) because an
  // aggregate cannot express a window overlap.
  command assignDriver(driverId: uuid) {
    guard self.deletedAt == null
    guard self.status == "scheduled" or self.status == "in_transit"
    constraint assignDriverActive: count(Person where id == driverId, status == "active") > 0 "Pick an active person in this workspace as the driver."
    mutate driverId = driverId
    emit DeliveryDriverAssigned {
      deliveryId: self.id
      tenantId: self.tenantId
      driverId: driverId
      eventId: self.eventId
    }
  }

  command unassignDriver() {
    guard self.deletedAt == null
    guard self.status == "scheduled" or self.status == "in_transit"
    guard self.driverId != null
    compute previousDriverId = self.driverId
    mutate driverId = null
    emit DeliveryDriverUnassigned {
      deliveryId: self.id
      tenantId: self.tenantId
      driverId: previousDriverId
      eventId: self.eventId
    }
  }

  command assignVehicle(vehicleId: uuid) {
    guard self.deletedAt == null
    guard self.status == "scheduled" or self.status == "in_transit"
    guard self.windowStartsAt != null and self.windowEndsAt != null
    // Present in this workspace and not retired (aggregates match equality only).
    constraint assignVehicleUsable: count(Vehicle where id == vehicleId) - count(Vehicle where id == vehicleId, operationalStatus == "retired") > 0 "Pick a vehicle in this workspace that is not retired."
    mutate vehicleId = vehicleId
    emit DeliveryVehicleAssigned {
      deliveryId: self.id
      tenantId: self.tenantId
      vehicleId: vehicleId
      eventId: self.eventId
      windowStartsAt: self.windowStartsAt
      windowEndsAt: self.windowEndsAt
    }
  }

  command unassignVehicle() {
    guard self.deletedAt == null
    guard self.status == "scheduled" or self.status == "in_transit"
    guard self.vehicleId != null
    compute previousVehicleId = self.vehicleId
    mutate vehicleId = null
    emit DeliveryVehicleUnassigned {
      deliveryId: self.id
      tenantId: self.tenantId
      vehicleId: previousVehicleId
      eventId: self.eventId
    }
  }

  store Delivery in durable
}

event DeliveryScheduled: "delivery.scheduled" {
  deliveryId: string
  tenantId: string
  packListId: string
  eventId: string
  driverId: string?
  destination: string
  windowStartsAt: datetime
  windowEndsAt: datetime
  status: DeliveryStatus
}

event DeliveryTransitStarted: "delivery.transit_started" {
  deliveryId: string
  tenantId: string
  packListId: string
  eventId: string
  driverId: string?
  previousStatus: DeliveryStatus
  status: DeliveryStatus
  departedAt: datetime?
}

event DeliveryConfirmed: "delivery.confirmed" {
  deliveryId: string
  tenantId: string
  packListId: string
  eventId: string
  driverId: string?
  previousStatus: DeliveryStatus
  status: DeliveryStatus
  deliveredAt: datetime?
}

event DeliveryFailed: "delivery.failed" {
  deliveryId: string
  tenantId: string
  packListId: string
  eventId: string
  driverId: string?
  previousStatus: DeliveryStatus
  status: DeliveryStatus
  reason: string
}

event DeliveryCancelled: "delivery.cancelled" {
  deliveryId: string
  tenantId: string
  packListId: string
  eventId: string
  driverId: string?
  previousStatus: DeliveryStatus
  status: DeliveryStatus
  reason: string
}

// Emitted by Delivery.assignVehicle / unassignVehicle (2026-09-29: the
// authored seam convex/vehicleAssignment.ts no longer writes these rows; it
// calls the commands, and the sibling-overlap check runs on
// DeliveryVehicleAssigned inside the command transaction).
event DeliveryVehicleAssigned: "delivery.vehicle_assigned" {
  deliveryId: string
  tenantId: string
  vehicleId: string
  eventId: string
  windowStartsAt: datetime?
  windowEndsAt: datetime?
}

event DeliveryVehicleUnassigned: "delivery.vehicle_unassigned" {
  deliveryId: string
  tenantId: string
  vehicleId: string
  eventId: string
}

event DeliveryDriverAssigned: "delivery.driver_assigned" {
  deliveryId: string
  tenantId: string
  driverId: string
  eventId: string
}

event DeliveryDriverUnassigned: "delivery.driver_unassigned" {
  deliveryId: string
  tenantId: string
  driverId: string
  eventId: string
}

// EventCancelled → cancel scheduled/in-transit deliveries for that event.
// The transactional operational callback selects unfinished records before
// invoking Delivery.standDownWithEvent. Settled history is not mutated.

// Vision cascade: packed pack list ensures one Delivery schedule (match else create).
on PackListPacked run Delivery.schedule
  match packListId = payload.packListId
  else create
  params {
    packListId: payload.packListId
    eventId: payload.eventId
    destination: payload.destination
    windowStartsAt: payload.windowStartsAt
    windowEndsAt: payload.windowEndsAt
  }
