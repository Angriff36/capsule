enum OrganizationCapability {
  kitchen
  inventory
  procurement
  events
  sales
  logistics
  workforce
  finance
  reports
  administration
}

entity OrganizationCapabilitySetting mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number
  property required capability: OrganizationCapability
  property required enabled: boolean = true
  property updatedBy: string?
  // Governed-creation marker. `capability` is a required creation param, so
  // createViaRegister seeds it on the draft before guards run and a
  // `self.capability == null` guard rejected every first-time registration
  // (#360). Same shape as Dish/Ingredient `introducedAt`.
  property registeredAt: datetime?
  default policy capabilitySettingRead read: user.id != null "Signed-in staff may see capability settings"
  default policy capabilitySettingWrite write: user.id != null "Signed-in staff may update capability settings"
  default policy capabilitySettingExecute execute: user.id != null "Signed-in staff may change capability settings"
  // updatedBy is the signed-in person, never a name the caller sends (CF-15).
  command register(capability: OrganizationCapability, enabled: boolean) {
    guard self.deletedAt == null
    guard self.registeredAt == null
    guard roleAllows(user.role, "adminAccess")
    mutate capability = capability
    mutate enabled = enabled
    mutate updatedBy = user.id
    mutate registeredAt = now()
    emit OrganizationCapabilitySettingRegistered {
      organizationCapabilitySettingId: self.id
      tenantId: self.tenantId
    }
  }
  command setEnabled(enabled: boolean) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "adminAccess")
    mutate enabled = enabled
    mutate updatedBy = user.id
    emit OrganizationCapabilitySettingEnabledSet {
      organizationCapabilitySettingId: self.id
      tenantId: self.tenantId
    }
  }
  store OrganizationCapabilitySetting in durable
}

// PL-AUDIT: every step leaves an event row (AC-193/AC-635).
event OrganizationCapabilitySettingRegistered: "organization.capability.setting.registered" {
  organizationCapabilitySettingId: string
  tenantId: string
}

event OrganizationCapabilitySettingEnabledSet: "organization.capability.setting.enabled.set" {
  organizationCapabilitySettingId: string
  tenantId: string
}
