// Tenant configuration for the in-app AI assistant (docs/systems/assistant.md).
// One row per tenant. The API key is private: generated reads never return it,
// so it only ever moves server-side (convex/assistantTurn.ts reads the row via
// an internal seam query keyed on the verified caller subject).
entity AssistantLlmConfig mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  unique [tenantId]
  timestamps
  versionProperty version: number

  property required baseUrl: string
  property private required apiKey: string
  property required model: string
  property configuredAt: datetime?

  default policy assistantLlmConfigRead read: roleAllows(user.role, "manageAccess") or roleAllows(user.role, "adminAccess") "Managers and admins may see assistant configuration"
  default policy assistantLlmConfigWrite write: roleAllows(user.role, "manageAccess") or roleAllows(user.role, "adminAccess") "Managers and admins may update assistant configuration"
  default policy assistantLlmConfigExecute execute: roleAllows(user.role, "manageAccess") or roleAllows(user.role, "adminAccess") "Managers and admins may change assistant configuration"

  // Configure is also the creation path (createViaConfigure) so first-time
  // setup and later correction are the same form — settings stay correctable.
  command configure(baseUrl: string, apiKey: string, model: string) {
    guard self.deletedAt == null
    constraint assistantBaseUrlHttp: startsWith(baseUrl, "https://") or startsWith(baseUrl, "http://localhost") or startsWith(baseUrl, "http://127.0.0.1") "The web address has to start with http:// or https://."
    constraint assistantApiKeyNonEmpty: trim(apiKey) != "" "Enter an API key."
    constraint assistantModelNonEmpty: trim(model) != "" "Enter a model name."
    mutate baseUrl = trim(baseUrl)
    mutate apiKey = apiKey
    mutate model = trim(model)
    mutate configuredAt = now()
  }

  store AssistantLlmConfig in durable
}

// Files a user attached to an assistant conversation. Uploads land in Convex
// storage anonymously; this row is what binds the blob to the uploader so the
// turn action only inlines bytes the caller owns (or that their tenant
// references). ~~Authored convex/assistantConfig.ts writes the rows.~~
// 2026-09-29: authored convex/assistantConfig.ts resolves the caller, checks
// the blob is an orphan (no live row in any tenant references it — a check
// that spans every table holding files, which a command cannot express) and
// then runs `register` as the caller tenant's system role, naming the
// caller as the uploader. Nobody else can run it: a direct call could claim a
// blob another tenant's record owns.

event AssistantUploadRegistered: "assistant_upload.registered" {
  assistantUploadId: string
  tenantId: string
  storageId: string
}
entity AssistantUpload mixin TenantScoped {
  key [tenantId, id]
  timestamps

  property indexed required storageId: string
  property indexed required uploadedByAuthSubjectId: string
  property required name: string

  default policy assistantUploadRead read: user.id != null "Staff may see assistant upload registrations"
  default policy assistantUploadWrite write: user.id != null "Staff may register assistant uploads"
  default policy assistantUploadExecute execute: user.id != null "Staff may change assistant uploads"

  // Governed creation — bind a freshly uploaded orphan blob to its uploader.
  command register(storageId: string, name: string, uploadedBy: string) {
    guard user.role == "system" "Upload files through the assistant"
    guard self.uploadedByAuthSubjectId == null "An upload is registered once"
    constraint registerStorage: length(trim(storageId)) > 0 "Nothing was uploaded."
    constraint registerUploader: length(trim(uploadedBy)) > 0 "Sign in first."
    mutate storageId = storageId
    mutate uploadedByAuthSubjectId = uploadedBy
    mutate name = name
    emit AssistantUploadRegistered {
      assistantUploadId: self.id
      tenantId: self.tenantId
      storageId: storageId
    }
  }

  store AssistantUpload in durable
}
