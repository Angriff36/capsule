// Capsule workforce-2 — TimeRecord + Qualification.
// Compile entry: uses logistics packing head (PackList/Delivery + prior chain).
// Scheduled work and open event staffing needs live in shift/assignment.manifest.

use "../logistics/packing.manifest"

enum TimeRecordStatus {
  open
  closed
  corrected
}

enum QualificationStatus {
  active
  expired
  revoked
}

// Worked time for a Person (maps capsule-pro TimeEntry). Optional Shift/Event
// refs; duration is a pure computed from clock datetimes (durationBetween).
// No pay-rate fields — none evidenced on TimeEntry.
entity TimeRecord mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required personId: uuid
  property shiftId: uuid?
  property eventId: uuid?
  property clockInAt: datetime?
  property clockOutAt: datetime?
  property breakMinutes: int? = 0
  property encrypted notes: string?
  property required status: TimeRecordStatus = "open"
  property correctedAt: datetime?

  belongsTo person: Person fields [tenantId, personId] references [tenantId, id]
  belongsTo shift: Shift fields [tenantId, shiftId] references [tenantId, id]
  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]

  // Pure datetime arithmetic (builtins.md durationBetween / durationMinutes) —
  // no now() in computed. Named workedMinutes to avoid shadowing the builtin.
  computed workedMinutes: number? = self.clockOutAt != null and self.clockInAt != null ? durationBetween(self.clockInAt, self.clockOutAt) / durationMinutes(1) : null

  constraint timeRecordClosedComplete: self.status == "open" or (self.clockInAt != null and self.clockOutAt != null and self.clockOutAt >= self.clockInAt) "This time entry's clock-out has to be at or after its clock-in."
  constraint timeRecordBreakNonNegative: self.breakMinutes == null or self.breakMinutes >= 0 "Break minutes can't be negative. Use zero or more."

  transition status from "open" to ["closed"]
  transition status from "closed" to ["corrected"]
  transition status from "corrected" to ["corrected"]

  default policy timeRecordRead read: roleAllows(user.role, "workforceAccess") or (roleAllows(user.role, "workforceSelfAccess") and user.personId != null and self.personId == user.personId) "Workforce staff or the linked person may see time entries"
  default policy timeRecordWrite write: roleAllows(user.role, "workforceAccess") or (roleAllows(user.role, "workforceSelfAccess") and user.personId != null and self.personId == user.personId) "Workforce staff or the linked person may update time entries"
  default policy timeRecordExecute execute: roleAllows(user.role, "workforceAccess") or (roleAllows(user.role, "workforceSelfAccess") and user.personId != null and self.personId == user.personId) "Workforce staff or the linked person may change time entries"

  // The linked Person is authoritative for self-service; the old direct-ID
  // identity path remains available only to unlinked bootstrap identities.
  command clockIn(
    personId: uuid,
    optional shiftId: uuid,
    optional eventId: uuid,
    optional notes: string
  ) {
    guard self.clockInAt == null
    guard self.status == "open"
    guard self.deletedAt == null
    guard user.id != null
    guard personId == user.personId or (user.personId == null and personId == user.id) or roleAllows(user.role, "workforceManageAccess")
    guard self.person != null and self.person.status == "active"
    constraint clockInPersonMatch: personId == self.personId "This clock-in is for a different person. Pick the person already on this time entry."
    constraint clockInShiftMatch: shiftId == null or self.shiftId == null or shiftId == self.shiftId "This clock-in is for a different shift. Leave the shift blank or pick the one already on this time entry."
    constraint clockInEventMatch: eventId == null or self.eventId == null or eventId == self.eventId "This clock-in is for a different event. Leave the event blank or pick the one already on this time entry."
    mutate personId = personId
    mutate shiftId = shiftId != null ? shiftId : self.shiftId
    mutate eventId = eventId != null ? eventId : self.eventId
    mutate notes = notes != null ? notes : self.notes
    mutate clockInAt = now()
    emit TimeRecordClockedIn {
      timeRecordId: self.id
      tenantId: self.tenantId
      personId: personId
      shiftId: shiftId != null ? shiftId : self.shiftId
      eventId: eventId != null ? eventId : self.eventId
      clockInAt: self.clockInAt
      status: "open"
    }
  }

  command clockOut(
    optional breakMinutes: number,
    optional notes: string
  ) {
    guard self.status == "open"
    guard self.clockInAt != null
    guard self.clockOutAt == null
    guard self.deletedAt == null
    guard user.id != null
    guard self.personId == user.personId or (user.personId == null and self.personId == user.id) or roleAllows(user.role, "workforceManageAccess")
    constraint clockOutBreakNonNegative: breakMinutes == null or breakMinutes >= 0 "Break minutes can't be negative. Use zero or more."
    mutate clockOutAt = now()
    mutate breakMinutes = breakMinutes != null ? breakMinutes : self.breakMinutes
    mutate notes = notes != null ? notes : self.notes
    mutate status = "closed"
    emit TimeRecordClockedOut {
      timeRecordId: self.id
      tenantId: self.tenantId
      personId: self.personId
      shiftId: self.shiftId
      eventId: self.eventId
      clockInAt: self.clockInAt
      clockOutAt: self.clockOutAt
      breakMinutes: breakMinutes != null ? breakMinutes : self.breakMinutes
      status: "closed"
    }
  }

  command correct(
    clockInAt: datetime,
    clockOutAt: datetime,
    optional breakMinutes: number,
    optional notes: string
  ) {
    guard self.status == "closed" or self.status == "corrected"
    guard self.clockInAt != null
    guard self.clockOutAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    constraint correctDates: clockOutAt >= clockInAt "The corrected clock-out has to be at or after the clock-in."
    constraint correctBreakNonNegative: breakMinutes == null or breakMinutes >= 0 "Break minutes can't be negative. Use zero or more."
    compute previousClockInAt = self.clockInAt
    compute previousClockOutAt = self.clockOutAt
    compute previousBreakMinutes = self.breakMinutes
    mutate clockInAt = clockInAt
    mutate clockOutAt = clockOutAt
    mutate breakMinutes = breakMinutes != null ? breakMinutes : self.breakMinutes
    mutate notes = notes != null ? notes : self.notes
    mutate status = "corrected"
    mutate correctedAt = now()
    emit TimeRecordCorrected {
      timeRecordId: self.id
      tenantId: self.tenantId
      personId: self.personId
      previousClockInAt: previousClockInAt
      previousClockOutAt: previousClockOutAt
      previousBreakMinutes: previousBreakMinutes
      clockInAt: clockInAt
      clockOutAt: clockOutAt
      breakMinutes: breakMinutes != null ? breakMinutes : self.breakMinutes
      status: "corrected"
    }
  }

  store TimeRecord in durable
}

// Certification/skill held by a Person (maps capsule-pro EmployeeCertification).
// isExpired via now() omitted — time-dependent computeds are nondeterministic (OD028).
entity Qualification mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required personId: uuid
  property required name: string = ""
  property certificationType: string?
  property issuingBody: string?
  property issuedAt: datetime?
  property expiresAt: datetime?
  property documentRef: string?
  property encrypted notes: string?
  property required status: QualificationStatus = "active"
  property grantedAt: datetime?
  property revokedAt: datetime?
  property expiredAt: datetime?

  belongsTo person: Person fields [tenantId, personId] references [tenantId, id]

  constraint qualificationGrantedComplete: self.grantedAt == null or (length(trim(self.name)) > 0 and self.certificationType != null and length(trim(self.certificationType)) > 0 and self.issuingBody != null and length(trim(self.issuingBody)) > 0 and self.issuedAt != null and (self.expiresAt == null or self.expiresAt > self.issuedAt)) "Give this certification a name, type, issuing body, and issue date. If it expires, the expiry has to be after the issue date."
  constraint qualificationExpiryOrder: self.expiresAt == null or self.issuedAt == null or self.expiresAt > self.issuedAt "This certification's expiry has to be after its issue date."

  transition status from "active" to ["expired", "revoked"]
  transition status from "expired" to []
  transition status from "revoked" to []

  default policy qualificationRead read: roleAllows(user.role, "workforceAccess") "Workforce staff may see qualifications"
  default policy qualificationWrite write: roleAllows(user.role, "workforceAccess") "Workforce staff may update qualifications"
  default policy qualificationExecute execute: roleAllows(user.role, "workforceAccess") "Workforce staff may change qualifications"

  command grant(
    personId: uuid,
    name: string,
    issuedAt: datetime,
    certificationType: string,
    issuingBody: string,
    optional expiresAt: datetime,
    optional documentRef: string,
    optional notes: string
  ) {
    guard self.grantedAt == null
    guard self.status == "active"
    guard self.deletedAt == null
    guard self.person != null and self.person.status == "active"
    guard roleAllows(user.role, "workforceManageAccess")
    constraint grantPersonMatch: personId == self.personId "This qualification is for a different person. Pick the person already on this qualification."
    constraint grantNamePresent: length(trim(name)) > 0 "Give this certification a name."
    constraint grantTypePresent: length(trim(certificationType)) > 0 "Pick a certification type."
    constraint grantIssuingBodyPresent: length(trim(issuingBody)) > 0 "Say who issued this certification."
    constraint grantExpiryOrder: expiresAt == null or expiresAt > issuedAt "This certification's expiry has to be after its issue date."
    mutate personId = personId
    mutate name = name
    mutate certificationType = certificationType
    mutate issuingBody = issuingBody
    mutate issuedAt = issuedAt
    mutate expiresAt = expiresAt != null ? expiresAt : self.expiresAt
    mutate documentRef = documentRef != null ? documentRef : self.documentRef
    mutate notes = notes != null ? notes : self.notes
    mutate grantedAt = now()
    emit QualificationGranted {
      qualificationId: self.id
      tenantId: self.tenantId
      personId: personId
      name: name
      certificationType: certificationType
      issuingBody: issuingBody
      issuedAt: issuedAt
      expiresAt: expiresAt != null ? expiresAt : self.expiresAt
      status: "active"
    }
  }

  command revoke(optional notes: string) {
    guard self.status == "active"
    guard self.grantedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    compute previousStatus = self.status
    mutate status = "revoked"
    mutate revokedAt = now()
    mutate notes = notes != null ? notes : self.notes
    emit QualificationRevoked {
      qualificationId: self.id
      tenantId: self.tenantId
      personId: self.personId
      name: self.name
      previousStatus: previousStatus
      status: "revoked"
    }
  }

  command expire() {
    guard self.status == "active"
    guard self.grantedAt != null
    guard self.expiresAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    compute previousStatus = self.status
    mutate status = "expired"
    mutate expiredAt = now()
    emit QualificationExpired {
      qualificationId: self.id
      tenantId: self.tenantId
      personId: self.personId
      name: self.name
      expiresAt: self.expiresAt
      previousStatus: previousStatus
      status: "expired"
    }
  }

  store Qualification in durable
}

event TimeRecordClockedIn: "time_record.clocked_in" {
  timeRecordId: string
  tenantId: string
  personId: string
  shiftId: string?
  eventId: string?
  clockInAt: datetime?
  status: TimeRecordStatus
}

event TimeRecordClockedOut: "time_record.clocked_out" {
  timeRecordId: string
  tenantId: string
  personId: string
  shiftId: string?
  eventId: string?
  clockInAt: datetime?
  clockOutAt: datetime?
  breakMinutes: number?
  status: TimeRecordStatus
}

event TimeRecordCorrected: "time_record.corrected" {
  timeRecordId: string
  tenantId: string
  personId: string
  previousClockInAt: datetime?
  previousClockOutAt: datetime?
  previousBreakMinutes: number?
  clockInAt: datetime
  clockOutAt: datetime
  breakMinutes: number?
  status: TimeRecordStatus
}

event QualificationGranted: "qualification.granted" {
  qualificationId: string
  tenantId: string
  personId: string
  name: string
  certificationType: string
  issuingBody: string
  issuedAt: datetime
  expiresAt: datetime?
  status: QualificationStatus
}

event QualificationRevoked: "qualification.revoked" {
  qualificationId: string
  tenantId: string
  personId: string
  name: string
  previousStatus: QualificationStatus
  status: QualificationStatus
}

event QualificationExpired: "qualification.expired" {
  qualificationId: string
  tenantId: string
  personId: string
  name: string
  expiresAt: datetime?
  previousStatus: QualificationStatus
  status: QualificationStatus
}
