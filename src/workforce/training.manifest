// Capsule workforce — reusable training modules, Person completions, and
// configurable shift types with explicit training prerequisites.

enum TrainingModuleCategory {
  food_safety
  equipment_operation
  service_standards
  other
}

enum TrainingModuleStatus {
  active
  retired
}

entity TrainingModule mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  unique [tenantId, name]
  timestamps
  versionProperty version: number

  property required searchable name: string = ""
  property required category: TrainingModuleCategory = "other"
  property description: string?
  property required passingScore: int = 80
  property required status: TrainingModuleStatus = "active"
  property definedAt: datetime?
  property retiredAt: datetime?
  // Mangia "Training Doc": the steps a trainer initials, one per line (a line
  // starting "- " is detail under the step above), and the quiz questions.
  property steps: string?
  property quiz: string?

  hasMany completions: TrainingCompletion
  hasMany shiftTypes: ShiftType

  constraint trainingModuleComplete: self.definedAt == null or length(trim(self.name)) > 0 "Give this training module a name."
  constraint trainingModulePassingScore: self.passingScore >= 0 and self.passingScore <= 100 "Set a passing score between 0 and 100."

  transition status from "active" to ["retired"]
  transition status from "retired" to ["active"]

  default policy trainingModuleRead read: roleAllows(user.role, "workforceAccess") "Workforce staff may see training modules"
  default policy trainingModuleWrite write: roleAllows(user.role, "workforceAccess") "Workforce staff may update training modules"
  default policy trainingModuleExecute execute: roleAllows(user.role, "workforceAccess") "Workforce staff may change training modules"

  command define(
    name: string,
    category: TrainingModuleCategory,
    passingScore: int,
    optional description: string,
    optional steps: string,
    optional quiz: string
  ) {
    guard self.definedAt == null
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    constraint defineTrainingModuleName: length(trim(name)) > 0 "Give this training module a name."
    constraint defineTrainingModulePassingScore: passingScore >= 0 and passingScore <= 100 "Set a passing score between 0 and 100."
    mutate name = name
    mutate category = category
    mutate passingScore = passingScore
    mutate description = description
    mutate steps = steps
    mutate quiz = quiz
    mutate status = "active"
    mutate definedAt = now()
    emit TrainingModuleDefined {
      trainingModuleId: self.id
      tenantId: self.tenantId
      name: name
      category: category
      passingScore: passingScore
    }
  }

  command setTrainingDoc(optional steps: string, optional quiz: string) {
    guard self.definedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    mutate steps = steps != null and length(trim(steps)) > 0 ? steps : null
    mutate quiz = quiz != null and length(trim(quiz)) > 0 ? quiz : null
  }

  command retire() {
    guard self.status == "active"
    guard self.definedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    mutate status = "retired"
    mutate retiredAt = now()
    emit TrainingModuleRetired {
      trainingModuleId: self.id
      tenantId: self.tenantId
      name: self.name
    }
  }

  command reactivate() {
    guard self.status == "retired"
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    mutate status = "active"
    mutate retiredAt = null
    emit TrainingModuleReactivated {
      trainingModuleId: self.id
      tenantId: self.tenantId
      name: self.name
    }
  }

  store TrainingModule in durable
}

entity TrainingCompletion mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required personId: uuid
  property required trainingModuleId: uuid
  property completedAt: datetime?
  property required assessmentScore: int = 0
  property encrypted notes: string?
  property recordedAt: datetime?

  belongsTo person: Person fields [tenantId, personId] references [tenantId, id]
  belongsTo trainingModule: TrainingModule fields [tenantId, trainingModuleId] references [tenantId, id]

  constraint trainingCompletionScore: self.assessmentScore >= 0 and self.assessmentScore <= 100 "Give an assessment score between 0 and 100."
  constraint trainingCompletionComplete: self.recordedAt == null or self.completedAt != null "Give this training completion a date."

  default policy trainingCompletionRead read: roleAllows(user.role, "workforceAccess") "Workforce staff may see training completions"
  default policy trainingCompletionWrite write: roleAllows(user.role, "workforceAccess") "Workforce staff may update training completions"
  default policy trainingCompletionExecute execute: roleAllows(user.role, "workforceAccess") "Workforce staff may change training completions"

  command record(
    personId: uuid,
    trainingModuleId: uuid,
    completedAt: datetime,
    assessmentScore: int,
    optional notes: string
  ) {
    guard self.recordedAt == null
    guard self.deletedAt == null
    guard self.person != null and self.person.status == "active"
    guard self.trainingModule != null and self.trainingModule.status == "active" and self.trainingModule.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    constraint recordTrainingPersonMatch: personId == self.personId "This training completion is for a different person. Pick the staff member already on this training completion."
    constraint recordTrainingModuleMatch: trainingModuleId == self.trainingModuleId "This training completion is for a different module. Pick the training module already on this completion."
    constraint recordTrainingScoreRange: assessmentScore >= 0 and assessmentScore <= 100 "Give an assessment score between 0 and 100."
    constraint recordTrainingPassingScore: assessmentScore >= self.trainingModule.passingScore "This score needs to meet the training module's passing score."
    mutate personId = personId
    mutate trainingModuleId = trainingModuleId
    mutate completedAt = completedAt
    mutate assessmentScore = assessmentScore
    mutate notes = notes
    mutate recordedAt = now()
    emit TrainingCompleted {
      trainingCompletionId: self.id
      tenantId: self.tenantId
      personId: personId
      trainingModuleId: trainingModuleId
      completedAt: completedAt
      assessmentScore: assessmentScore
    }
  }

  store TrainingCompletion in durable
}

// Skills matrix (Mangia "Utility Skills Matrix Criteria", 10-24-22): how far
// one person is in one area, 0 no knowledge, 1 beginner (works under a
// trainer), 2 independent, 3 expert, 4 trainer. The area is a training
// module. One row per person and module; a new rating changes it in place.
entity SkillLevel mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property indexed required personId: uuid
  property required trainingModuleId: uuid
  property required level: int = 0
  property note: string?
  property ratedAt: datetime?
  // Who gave the rating. Empty when that account is not linked to a staff
  // profile; rating is never blocked for that.
  property ratedByPersonId: uuid?

  belongsTo person: Person fields [tenantId, personId] references [tenantId, id]
  belongsTo trainingModule: TrainingModule fields [tenantId, trainingModuleId] references [tenantId, id]

  constraint skillLevelRange: self.level >= 0 and self.level <= 4 "Pick a level from 0 to 4."

  default policy skillLevelRead read: roleAllows(user.role, "workforceAccess") "Workforce staff may see skill levels"
  default policy skillLevelWrite write: roleAllows(user.role, "workforceAccess") "Workforce staff may update skill levels"
  default policy skillLevelExecute execute: roleAllows(user.role, "workforceAccess") "Workforce staff may change skill levels"

  command rate(
    personId: uuid,
    trainingModuleId: uuid,
    level: int,
    optional note: string
  ) {
    guard self.ratedAt == null
    guard self.deletedAt == null
    guard self.person != null
    guard self.trainingModule != null and self.trainingModule.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    constraint rateSkillLevelRange: level >= 0 and level <= 4 "Pick a level from 0 to 4."
    mutate personId = personId
    mutate trainingModuleId = trainingModuleId
    mutate level = level
    mutate note = note != null and length(trim(note)) > 0 ? trim(note) : null
    mutate ratedAt = now()
    mutate ratedByPersonId = user.personId
    emit SkillLevelRated {
      skillLevelId: self.id
      tenantId: self.tenantId
      personId: personId
      trainingModuleId: trainingModuleId
      level: level
    }
  }

  command changeLevel(level: int, optional note: string) {
    guard self.ratedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    constraint changeSkillLevelRange: level >= 0 and level <= 4 "Pick a level from 0 to 4."
    mutate level = level
    mutate note = note != null and length(trim(note)) > 0 ? trim(note) : null
    mutate ratedAt = now()
    mutate ratedByPersonId = user.personId
    emit SkillLevelRated {
      skillLevelId: self.id
      tenantId: self.tenantId
      personId: self.personId
      trainingModuleId: self.trainingModuleId
      level: level
    }
  }

  store SkillLevel in durable
}

// Training sign-off (Mangia "Training Doc" header and initial column): one
// trainee working through one module's steps with a trainer, from a start
// date to an end date. Each step the trainer initials is kept with the
// initials and the day. Steps can be initialled or cleared after the end
// date too - the record stays correctable.
entity TrainingSignOff mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property indexed required personId: uuid
  property required trainingModuleId: uuid
  property trainerPersonId: uuid?
  property startedAt: datetime?
  property finishedAt: datetime?
  // One line per initialled step: "<step text>|<initials>|<epoch ms>".
  property initialledSteps: string?
  property required quizDone: boolean = false
  property note: string?

  belongsTo person: Person fields [tenantId, personId] references [tenantId, id]
  belongsTo trainingModule: TrainingModule fields [tenantId, trainingModuleId] references [tenantId, id]
  belongsTo trainer: Person fields [tenantId, trainerPersonId] references [tenantId, id]

  constraint trainingSignOffDates: self.finishedAt == null or self.startedAt == null or self.finishedAt >= self.startedAt "The end date cannot be before the start date."

  default policy trainingSignOffRead read: roleAllows(user.role, "workforceAccess") "Workforce staff may see training sign-offs"
  default policy trainingSignOffWrite write: roleAllows(user.role, "workforceAccess") "Workforce staff may update training sign-offs"
  default policy trainingSignOffExecute execute: roleAllows(user.role, "workforceAccess") "Workforce staff may change training sign-offs"

  command beginTraining(
    personId: uuid,
    trainingModuleId: uuid,
    startedAt: datetime,
    optional trainerPersonId: uuid
  ) {
    guard self.deletedAt == null
    guard self.person != null
    guard self.trainingModule != null and self.trainingModule.deletedAt == null
    guard trainerPersonId == null or self.trainer != null
    guard roleAllows(user.role, "workforceManageAccess")
    mutate personId = personId
    mutate trainingModuleId = trainingModuleId
    mutate trainerPersonId = trainerPersonId
    mutate startedAt = startedAt
    emit TrainingSignOffStarted {
      trainingSignOffId: self.id
      tenantId: self.tenantId
      personId: personId
      trainingModuleId: trainingModuleId
    }
  }

  command initialTrainingSteps(initialledSteps: string) {
    guard self.startedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    mutate initialledSteps = length(trim(initialledSteps)) > 0 ? initialledSteps : null
  }

  command finishTraining(finishedAt: datetime, quizDone: boolean, optional note: string) {
    guard self.startedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    constraint finishTrainingSignOffDates: finishedAt >= self.startedAt "The end date cannot be before the start date."
    mutate finishedAt = finishedAt
    mutate quizDone = quizDone
    mutate note = note != null and length(trim(note)) > 0 ? trim(note) : null
    emit TrainingSignOffFinished {
      trainingSignOffId: self.id
      tenantId: self.tenantId
      personId: self.personId
      trainingModuleId: self.trainingModuleId
    }
  }

  command reopenTraining() {
    guard self.finishedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    mutate finishedAt = null
  }

  store TrainingSignOff in durable
}

entity ShiftType mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  unique [tenantId, name]
  timestamps
  versionProperty version: number

  property required searchable name: string = ""
  property description: string?
  property requiredTrainingModuleId: uuid?
  property required status: TrainingModuleStatus = "active"
  property definedAt: datetime?
  property retiredAt: datetime?

  belongsTo requiredTrainingModule: TrainingModule fields [tenantId, requiredTrainingModuleId] references [tenantId, id]

  constraint shiftTypeComplete: self.definedAt == null or length(trim(self.name)) > 0 "Give this shift type a name."

  transition status from "active" to ["retired"]
  transition status from "retired" to ["active"]

  default policy shiftTypeRead read: roleAllows(user.role, "workforceAccess") "Workforce staff may see shift types"
  default policy shiftTypeWrite write: roleAllows(user.role, "workforceAccess") "Workforce staff may update shift types"
  default policy shiftTypeExecute execute: roleAllows(user.role, "workforceAccess") "Workforce staff may change shift types"

  command define(
    name: string,
    optional description: string,
    optional requiredTrainingModuleId: uuid
  ) {
    guard self.definedAt == null
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    guard requiredTrainingModuleId == null or (self.requiredTrainingModule != null and self.requiredTrainingModule.status == "active" and self.requiredTrainingModule.deletedAt == null)
    constraint defineShiftTypeName: length(trim(name)) > 0 "Give this shift type a name."
    mutate name = name
    mutate description = description
    mutate requiredTrainingModuleId = requiredTrainingModuleId
    mutate status = "active"
    mutate definedAt = now()
    emit ShiftTypeDefined {
      shiftTypeId: self.id
      tenantId: self.tenantId
      name: name
      requiredTrainingModuleId: requiredTrainingModuleId
    }
  }

  command retire() {
    guard self.status == "active"
    guard self.definedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    mutate status = "retired"
    mutate retiredAt = now()
    emit ShiftTypeRetired {
      shiftTypeId: self.id
      tenantId: self.tenantId
      name: self.name
    }
  }

  command reactivate() {
    guard self.status == "retired"
    guard self.deletedAt == null
    guard roleAllows(user.role, "workforceManageAccess")
    mutate status = "active"
    mutate retiredAt = null
    emit ShiftTypeReactivated {
      shiftTypeId: self.id
      tenantId: self.tenantId
      name: self.name
    }
  }

  store ShiftType in durable
}

event TrainingModuleDefined: "training_module.defined" {
  trainingModuleId: string
  tenantId: string
  name: string
  category: TrainingModuleCategory
  passingScore: int
}

event TrainingModuleRetired: "training_module.retired" {
  trainingModuleId: string
  tenantId: string
  name: string
}

event TrainingModuleReactivated: "training_module.reactivated" {
  trainingModuleId: string
  tenantId: string
  name: string
}

event TrainingCompleted: "training.completed" {
  trainingCompletionId: string
  tenantId: string
  personId: string
  trainingModuleId: string
  completedAt: datetime
  assessmentScore: int
}

event SkillLevelRated: "skill_level.rated" {
  skillLevelId: string
  tenantId: string
  personId: string
  trainingModuleId: string
  level: int
}

event TrainingSignOffStarted: "training_sign_off.started" {
  trainingSignOffId: string
  tenantId: string
  personId: string
  trainingModuleId: string
}

event TrainingSignOffFinished: "training_sign_off.finished" {
  trainingSignOffId: string
  tenantId: string
  personId: string
  trainingModuleId: string
}

event ShiftTypeDefined: "shift_type.defined" {
  shiftTypeId: string
  tenantId: string
  name: string
  requiredTrainingModuleId: string?
}

event ShiftTypeRetired: "shift_type.retired" {
  shiftTypeId: string
  tenantId: string
  name: string
}

event ShiftTypeReactivated: "shift_type.reactivated" {
  shiftTypeId: string
  tenantId: string
  name: string
}
