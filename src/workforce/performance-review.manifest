// Capsule workforce — structured performance review entries per Person.
// Rating dimensions (reliability, quality, teamwork), free-text notes, the
// reviewer's identity, and a review date. Manager-only read visibility;
// used as context for shift assignment and compensation decisions.

use "../foundation/base.manifest"

entity PerformanceReview mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required personId: uuid
  property required reviewerId: uuid
  property eventId: uuid?
  property reviewDate: datetime?
  property required reliabilityRating: int = 0
  property required qualityRating: int = 0
  property required teamworkRating: int = 0
  property encrypted notes: string?
  // The role scorecard version this review measured against (spec §9.2/§9.4).
  // Scorecard rows are immutable versions, so the link stays interpretable.
  property scorecardId: uuid?
  // Shared with the person reviewed (My reviews). `notes` stays manager-private.
  property strengths: string?
  property opportunities: string?
  property comments: string?
  property followUp: string?
  property followUpDue: datetime?
  property recordedAt: datetime?

  belongsTo person: Person fields [tenantId, personId] references [tenantId, id]
  belongsTo reviewer: Person fields [tenantId, reviewerId] references [tenantId, id]
  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]
  belongsTo scorecard: RoleScorecard fields [tenantId, scorecardId] references [tenantId, id]

  // Ratings default to 0 on the draft; the strict 1..5 range is enforced by
  // the record command. Once recorded, all three dimensions must be in range.
  constraint reviewRatingsRange: self.recordedAt == null or (self.reliabilityRating >= 1 and self.reliabilityRating <= 5 and self.qualityRating >= 1 and self.qualityRating <= 5 and self.teamworkRating >= 1 and self.teamworkRating <= 5) "Once this review is on file, reliability, quality, and teamwork all need a rating between 1 and 5."

  // HR-only visibility (spec §9.4 "visibility follows HR permissions"): the
  // private notes are personnel records, so other managers do not read them.
  // The person reviewed sees their own reviews, without notes, through
  // convex/staffSelfReviews.ts.
  default policy performanceReviewRead read: roleAllows(user.role, "workforceManageAccess") "Workforce managers may see performance reviews"
  default policy performanceReviewWrite write: roleAllows(user.role, "workforceManageAccess") "Workforce managers may update performance reviews"
  default policy performanceReviewExecute execute: roleAllows(user.role, "workforceManageAccess") "Workforce managers may change performance reviews"

  command record(
    personId: uuid,
    reviewerId: uuid,
    optional eventId: uuid,
    reviewDate: datetime,
    reliabilityRating: int,
    qualityRating: int,
    teamworkRating: int,
    optional notes: string,
    optional scorecardId: uuid,
    optional strengths: string,
    optional opportunities: string,
    optional comments: string,
    optional followUp: string,
    optional followUpDue: datetime
  ) {
    guard self.recordedAt == null
    guard self.deletedAt == null
    guard self.person != null and self.person.status == "active"
    guard roleAllows(user.role, "workforceManageAccess")
    constraint recordReviewPersonMatch: personId == self.personId "This review is for a different person. Pick the staff member already on this review."
    constraint recordReviewReliability: reliabilityRating >= 1 and reliabilityRating <= 5 "Give a reliability rating between 1 and 5."
    constraint recordReviewQuality: qualityRating >= 1 and qualityRating <= 5 "Give a quality rating between 1 and 5."
    constraint recordReviewTeamwork: teamworkRating >= 1 and teamworkRating <= 5 "Give a teamwork rating between 1 and 5."
    mutate personId = personId
    mutate reviewerId = reviewerId
    mutate eventId = eventId
    mutate reviewDate = reviewDate
    mutate reliabilityRating = reliabilityRating
    mutate qualityRating = qualityRating
    mutate teamworkRating = teamworkRating
    mutate notes = notes
    mutate scorecardId = scorecardId
    mutate strengths = strengths
    mutate opportunities = opportunities
    mutate comments = comments
    mutate followUp = followUp
    mutate followUpDue = followUpDue
    mutate recordedAt = now()
    emit PerformanceReviewRecorded {
      performanceReviewId: self.id
      tenantId: self.tenantId
      personId: personId
      reviewerId: reviewerId
      eventId: eventId
      reviewDate: reviewDate
      reliabilityRating: reliabilityRating
      qualityRating: qualityRating
      teamworkRating: teamworkRating
    }
  }

  store PerformanceReview in durable
}

event PerformanceReviewRecorded: "performance_review.recorded" {
  performanceReviewId: string
  tenantId: string
  personId: string
  reviewerId: string
  eventId: string?
  reviewDate: datetime
  reliabilityRating: int
  qualityRating: int
  teamworkRating: int
}
