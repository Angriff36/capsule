event PrepTaskUnblocked: "prep_task.unblocked" {
  prepTaskId: string
  tenantId: string
  eventDishId: string
  eventId: string
  name: string
  quantity: decimal(12, 4)
  unit: UnitOfMeasure
  previousStatus: PrepTaskStatus
  status: PrepTaskStatus
}

event PrepTaskCancelled: "prep_task.cancelled" {
  prepTaskId: string
  tenantId: string
  eventDishId: string
  eventId: string
  name: string
  quantity: decimal(12, 4)
  unit: UnitOfMeasure
  previousStatus: PrepTaskStatus
  status: PrepTaskStatus
  reason: string
}

// Completing a predecessor unlocks every task that directly depends on it.
on PrepTaskCompleted fanOut PrepTaskDependency where predecessorTaskId = payload.prepTaskId
  run satisfy

// EventCancelled → stand down prep work for that event. standDown, not cancel:
// these fan out over every task including completed ones. See PrepTask.standDown.
on EventCancelled fanOut PrepTask where eventId = payload.eventId
  run standDown
  params { reason: payload.reason }

// EventDishRemoved → stand down prep lines for that event dish.
on EventDishRemoved fanOut PrepTask where eventDishId = payload.eventDishId
  run standDown
  params { reason: payload.reason }

on EventDishServingsAdjusted fanOut PrepTask where eventDishId = payload.eventDishId
  run syncServings
  params { quantityServings: payload.quantityServings }

// ---------------------------------------------------------------------------
// Adding a dish to an event builds its prep list.
//
// DishTask is the per-dish template ("brine the birds", "portion dressing").
// Until now those were instantiated CLIENT-side, so the prep list only existed
// once somebody opened the prep page. These two reactions make it server-side:
// the tasks are there the moment the dish is on the event.
// ---------------------------------------------------------------------------

// Compat first — repair activeDishId on templates that predate the field, in
// the same transaction, so legacy dishes still generate.
on EventDishAdded fanOut DishTask where dishId = payload.dishId
  run DishTask.backfillActiveKey

// One PrepTask per active template. match on (eventDishId, dishTaskId) makes a
// replayed EventDishAdded update the existing line instead of duplicating it.
on EventDishAdded fanOut DishTask where activeDishId = payload.dishId
  run PrepTask.open
  match eventDishId = payload.eventDishId, dishTaskId = self.id
  else create
  params {
    eventDishId: payload.eventDishId
    eventId: payload.eventId
    name: self.name
    // defaultQuantity is PER GUEST (EventPrepTaskSynchronizer.quantityFor uses
    // the same rule); blank means one per guest. Both must agree or the client
    // reconcile would resize every generated task on the next sync.
    quantity: self.defaultQuantity != null and self.defaultQuantity > 0 ? self.defaultQuantity * payload.quantityServings : payload.quantityServings
    unit: self.defaultUnit != null ? self.defaultUnit : "portion"
    dishTaskId: self.id
    dishId: payload.dishId
    category: self.category
    taskType: self.taskType
    componentId: self.componentId
    ingredientId: self.ingredientId
    specialInstructions: self.instructions
  }
