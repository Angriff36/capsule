}

event PrepTaskClaimed: "prep_task.claimed" {
  prepTaskId: string
  tenantId: string
  eventDishId: string
  eventId: string
  name: string
  assignedToId: string
  quantity: decimal(12, 4)
  unit: UnitOfMeasure
