  status: PrepTaskStatus
}

event PrepTaskAssigned: "prep_task.assigned" {
  prepTaskId: string
  tenantId: string
  eventDishId: string
  eventId: string
  name: string
  assignedToId: string
  previousAssignedToId: string?
  quantity: decimal(12, 4)
  unit: UnitOfMeasure
  previousStatus: PrepTaskStatus
  status: PrepTaskStatus
}

event PrepTaskReleased: "prep_task.released" {
  prepTaskId: string
  tenantId: string
  eventDishId: string
  eventId: string
  name: string
  previousAssignedToId: string?
  quantity: decimal(12, 4)
  unit: UnitOfMeasure
  previousStatus: PrepTaskStatus
  status: PrepTaskStatus
}

event PrepTaskStarted: "prep_task.started" {
  prepTaskId: string
  tenantId: string
  eventDishId: string
  eventId: string
  name: string
  assignedToId: string?
  quantity: decimal(12, 4)
  unit: UnitOfMeasure
  previousStatus: PrepTaskStatus
  status: PrepTaskStatus
}

event PrepTaskCompleted: "prep_task.completed" {
  prepTaskId: string
  tenantId: string
  eventDishId: string
  eventId: string
  name: string
  assignedToId: string?
  quantity: decimal(12, 4)
  completedQuantity: decimal(12, 4)
  unit: UnitOfMeasure
