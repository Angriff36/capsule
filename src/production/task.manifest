// Capsule production — PrepTask under EventDish (claim/start/complete + block).
// Hierarchy: Event → EventDish → PrepTask → optional Component (make-formula).
// Station is an open string property (Station entity deferred). Compile chain
// continues via batch.manifest → prep.manifest (entry).

use "../procurement/purchase-need.manifest"
use "../procurement/event-purchasing.manifest"

enum PrepTaskStatus {
  pending
  claimed
  in_progress
  blocked
  completed
  cancelled
}

// Prep work line for one EventDish (e.g. "chop romaine", "portion caesar dressing").
// Optional componentId links a MAKE line to its Component (dressing, brine, sauce…).
// eventId is denormalized from EventDish for Event readiness / EventCancelled fan-out.
entity PrepTask mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required eventDishId: uuid
  property required eventId: uuid
  property required searchable name: string = ""
  property dishTaskId: uuid?
  property ingredientId: uuid?
  property ingredientDemandId: uuid?
  property dishId: uuid?
  property componentId: uuid?
  property required category: string = "finish_at_event"
  property required taskType: string = "manual"
  property specialInstructions: string?
  property required isGenerated: boolean = true
  property required quantity: decimal(12, 4) = 0
  property completedQuantity: decimal(12, 4)?
  property required unit: UnitOfMeasure = "each"
  property station: string?
  property dueAt: datetime?
  property assignedToId: uuid?
  property notes: string?
  property required status: PrepTaskStatus = "pending"
  property claimedAt: datetime?
  property startedAt: datetime?
  property completedAt: datetime?
  property cancelledAt: datetime?
  property cancellationReason: string?
  property blockedAt: datetime?
  property blockReason: string?

  belongsTo eventDish: EventDish fields [tenantId, eventDishId] references [tenantId, id]
  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]
  belongsTo dishTask: DishTask fields [tenantId, dishTaskId] references [tenantId, id]
  belongsTo dish: Dish fields [tenantId, dishId] references [tenantId, id]
  belongsTo ingredient: Ingredient fields [tenantId, ingredientId] references [tenantId, id]
  belongsTo ingredientDemand: IngredientDemand fields [tenantId, ingredientDemandId] references [tenantId, id]
  belongsTo component: Component fields [tenantId, componentId] references [tenantId, id]
  belongsTo assignedTo: Person fields [tenantId, assignedToId] references [tenantId, id]
  // Keep this hasMany paired with PrepTaskDependency.dependentTask, which is
  // intentionally the edge entity's first PrepTask relation for Convex inverse hydration.
  hasMany incomingDependencies: PrepTaskDependency

  constraint prepNameComplete: self.claimedAt == null or length(trim(self.name)) > 0 "Prep tasks require a name once opened"
  constraint prepQuantityPositive: self.claimedAt == null or self.quantity >= 0 "Prep quantity cannot be negative"
  constraint prepCompletedNonnegative: self.completedQuantity == null or self.completedQuantity >= 0 "Completed quantity cannot be negative"

  transition status from "pending" to ["claimed", "blocked", "cancelled"]
  transition status from "claimed" to ["in_progress", "pending", "blocked", "cancelled"]
  transition status from "in_progress" to ["completed", "blocked", "cancelled"]
  transition status from "blocked" to ["pending", "cancelled"]
  transition status from "completed" to []
  transition status from "cancelled" to []

  default policy prepTaskRead read: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen and event managers may read prep tasks"
  default policy prepTaskWrite write: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen and event managers may write prep tasks through commands"
  default policy prepTaskExecute execute: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen and event managers may execute prep task commands"

  command open(
    eventDishId: uuid,
    eventId: uuid,
    name: string,
    quantity: decimal(12, 4),
    unit: UnitOfMeasure,
    optional ingredientId: uuid,
    optional ingredientDemandId: uuid,
    optional componentId: uuid,
    optional dishTaskId: uuid,
    optional dishId: uuid,
    optional category: string,
    optional taskType: string,
    optional specialInstructions: string,
    optional isGenerated: boolean,
    optional station: string,
    optional dueAt: datetime,
    optional notes: string
  ) {
    guard self.claimedAt == null
    guard self.status == "pending"
    guard self.deletedAt == null
    // Convex projection does not hydrate belongsTo for guards; seed FKs are authoritative.
    // eventDishId + eventId are command params so createViaOpen can seed both parents.
    guard self.eventDishId != null
    guard self.eventId != null
    constraint openEventDishMatch: eventDishId == self.eventDishId "Open eventDishId must match the seeded event dish reference"
    constraint openEventMatch: eventId == self.eventId "Open eventId must match the seeded event reference"
    constraint openEventAlign: self.eventDish == null or eventId == self.eventDish.eventId "PrepTask eventId must match EventDish.eventId"
    constraint openNameRequired: length(trim(name)) > 0 "Prep task name is required"
    constraint openQuantityPositive: quantity >= 0 "Prep quantity cannot be negative"
    mutate eventDishId = eventDishId
    mutate eventId = eventId
    mutate name = name
    mutate ingredientId = ingredientId != null ? ingredientId : self.ingredientId
    mutate ingredientDemandId = ingredientDemandId != null ? ingredientDemandId : self.ingredientDemandId
    mutate componentId = componentId != null ? componentId : self.componentId
    mutate dishTaskId = dishTaskId != null ? dishTaskId : self.dishTaskId
    mutate dishId = dishId != null ? dishId : self.dishId
    mutate category = category != null ? category : self.category
    mutate taskType = taskType != null ? taskType : self.taskType
    mutate specialInstructions = specialInstructions != null ? specialInstructions : self.specialInstructions
    mutate isGenerated = isGenerated != null ? isGenerated : self.isGenerated
    mutate quantity = quantity
    mutate unit = unit
    mutate station = station != null ? station : self.station
    mutate dueAt = dueAt != null ? dueAt : self.dueAt
    mutate notes = notes != null ? notes : self.notes
    emit PrepTaskOpened {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: eventDishId
      eventId: eventId
      name: name
      ingredientId: ingredientId != null ? ingredientId : self.ingredientId
      ingredientDemandId: ingredientDemandId != null ? ingredientDemandId : self.ingredientDemandId
      componentId: componentId != null ? componentId : self.componentId
      dishTaskId: dishTaskId != null ? dishTaskId : self.dishTaskId
      dishId: dishId != null ? dishId : self.dishId
      category: category != null ? category : self.category
      taskType: taskType != null ? taskType : self.taskType
      specialInstructions: specialInstructions != null ? specialInstructions : self.specialInstructions
      isGenerated: isGenerated != null ? isGenerated : self.isGenerated
      quantity: quantity
      unit: unit
      station: station != null ? station : self.station
      dueAt: dueAt != null ? dueAt : self.dueAt
      status: "pending"
    }
  }

  command revise(
    optional name: string,
    optional quantity: decimal(12, 4),
    optional unit: UnitOfMeasure,
    optional category: string,
    optional taskType: string,
    optional specialInstructions: string,
    optional ingredientId: uuid,
    optional componentId: uuid
  ) {
    guard self.status == "pending" or self.status == "claimed" or self.status == "in_progress" or self.status == "blocked"
    guard self.deletedAt == null
    constraint reviseNamePresent: name == null or length(trim(name)) > 0 "Prep task name cannot be blank"
    constraint reviseQuantityPositive: quantity == null or quantity > 0 "Prep quantity must be positive"
    mutate name = name != null ? name : self.name
    mutate quantity = quantity != null ? quantity : self.quantity
    mutate unit = unit != null ? unit : self.unit
    mutate category = category != null ? category : self.category
    mutate taskType = taskType != null ? taskType : self.taskType
    mutate specialInstructions = specialInstructions != null ? specialInstructions : self.specialInstructions
    mutate ingredientId = ingredientId != null ? ingredientId : self.ingredientId
    mutate componentId = componentId != null ? componentId : self.componentId
    mutate isGenerated = false
    emit PrepTaskRevised {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: self.eventDishId
      eventId: self.eventId
      name: name != null ? name : self.name
      quantity: quantity != null ? quantity : self.quantity
      unit: unit != null ? unit : self.unit
      category: category != null ? category : self.category
      taskType: taskType != null ? taskType : self.taskType
      specialInstructions: specialInstructions != null ? specialInstructions : self.specialInstructions
    }
  }

  command refreshGenerated(
    quantity: decimal(12, 4),
    optional unit: UnitOfMeasure,
    optional specialInstructions: string
  ) {
    guard self.status == "pending"
    guard self.deletedAt == null
    guard self.isGenerated == true
    constraint refreshQuantityPositive: quantity >= 0 "Generated prep task quantity cannot be negative"
    mutate quantity = quantity
    mutate unit = unit != null ? unit : self.unit
    mutate specialInstructions = specialInstructions != null ? specialInstructions : self.specialInstructions
    emit PrepTaskGeneratedRefreshed {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: self.eventDishId
      eventId: self.eventId
      quantity: quantity
      unit: self.unit
      specialInstructions: specialInstructions != null ? specialInstructions : self.specialInstructions
    }
  }

  // Derive the remaining work from this menu line and its recorded output.
  // Updating its remaining quantity must not restart or reassign active work.
  command reconcileRemainingWork(expectedVersion: int) {
    guard self.deletedAt == null and self.isGenerated == true
    guard self.status == "pending" or self.status == "claimed" or self.status == "in_progress" or self.status == "blocked"
    // Closed events and removed menu lines retain their recorded work.
    guard self.event != null and self.event.deletedAt == null and self.event.stage != "completed" and self.event.stage != "closed_out" and self.event.stage != "cancelled"
    guard self.eventDish != null and self.eventDish.deletedAt == null and self.eventDish.removedAt == null
    guard self.dishTask != null and self.dishTask.deletedAt == null and self.dishTask.status == "active"
    guard self.version == expectedVersion
    compute recipeUnit = self.dishTask.defaultUnit != null ? self.dishTask.defaultUnit : "portion"
    compute sourceMass = recipeUnit == "gram" ? 1 : recipeUnit == "kilogram" ? 1000 : recipeUnit == "ounce" ? 28.349523125 : recipeUnit == "pound" ? 453.59237 : 0
    compute sourceVolume = recipeUnit == "milliliter" ? 1 : recipeUnit == "liter" ? 1000 : recipeUnit == "teaspoon" ? 4.92892159375 : recipeUnit == "tablespoon" ? 14.78676478125 : recipeUnit == "cup" ? 236.5882365 : recipeUnit == "pint" ? 473.176473 : recipeUnit == "quart" ? 946.352946 : recipeUnit == "gallon" ? 3785.411784 : 0
    compute targetMass = self.unit == "gram" ? 1 : self.unit == "kilogram" ? 1000 : self.unit == "ounce" ? 28.349523125 : self.unit == "pound" ? 453.59237 : 0
    compute targetVolume = self.unit == "milliliter" ? 1 : self.unit == "liter" ? 1000 : self.unit == "teaspoon" ? 4.92892159375 : self.unit == "tablespoon" ? 14.78676478125 : self.unit == "cup" ? 236.5882365 : self.unit == "pint" ? 473.176473 : self.unit == "quart" ? 946.352946 : self.unit == "gallon" ? 3785.411784 : 0
    // Never credit a different ingredient/component or convert across dimensions.
    guard (self.dishTask.defaultUnit != null ? self.dishTask.defaultUnit : "portion") == self.unit or ((self.dishTask.defaultUnit == "gram" or self.dishTask.defaultUnit == "kilogram" or self.dishTask.defaultUnit == "ounce" or self.dishTask.defaultUnit == "pound") and (self.unit == "gram" or self.unit == "kilogram" or self.unit == "ounce" or self.unit == "pound")) or ((self.dishTask.defaultUnit == "milliliter" or self.dishTask.defaultUnit == "liter" or self.dishTask.defaultUnit == "teaspoon" or self.dishTask.defaultUnit == "tablespoon" or self.dishTask.defaultUnit == "cup" or self.dishTask.defaultUnit == "pint" or self.dishTask.defaultUnit == "quart" or self.dishTask.defaultUnit == "gallon") and (self.unit == "milliliter" or self.unit == "liter" or self.unit == "teaspoon" or self.unit == "tablespoon" or self.unit == "cup" or self.unit == "pint" or self.unit == "quart" or self.unit == "gallon"))
    guard count_of(self.eventDish.prepTasks, (task) => task.deletedAt == null and task.status != "cancelled" and task.dishTaskId == self.dishTaskId and not (task.unit == self.unit or ((self.unit == "gram" or self.unit == "kilogram" or self.unit == "ounce" or self.unit == "pound") and (task.unit == "gram" or task.unit == "kilogram" or task.unit == "ounce" or task.unit == "pound")) or ((self.unit == "milliliter" or self.unit == "liter" or self.unit == "teaspoon" or self.unit == "tablespoon" or self.unit == "cup" or self.unit == "pint" or self.unit == "quart" or self.unit == "gallon") and (task.unit == "milliliter" or task.unit == "liter" or task.unit == "teaspoon" or task.unit == "tablespoon" or task.unit == "cup" or task.unit == "pint" or task.unit == "quart" or task.unit == "gallon")))) == 0
    guard count_of(self.eventDish.prepTasks, (task) => task.deletedAt == null and task.status != "cancelled" and task.dishTaskId == self.dishTaskId and task.status == "completed" and ((task.componentId != null ? task.componentId : null) != (self.dishTask.componentId != null ? self.dishTask.componentId : null) or (task.ingredientId != null ? task.ingredientId : null) != (self.dishTask.ingredientId != null ? self.dishTask.ingredientId : null))) == 0
    compute unitRatio = recipeUnit == self.unit ? 1 : (sourceMass > 0 ? sourceMass / targetMass : sourceVolume / targetVolume)
    compute requiredWork = (self.dishTask.defaultQuantity != null ? self.dishTask.defaultQuantity : 1) * self.eventDish.quantityServings * unitRatio
    compute completedWork = sum(self.eventDish.prepTasks, (task) => task.deletedAt == null and task.status != "cancelled" and task.dishTaskId == self.dishTaskId and task.status == "completed" ? (task.completedQuantity != null ? task.completedQuantity : task.quantity) * (task.unit == self.unit ? 1 : (targetMass > 0 ? (task.unit == "gram" ? 1 : task.unit == "kilogram" ? 1000 : task.unit == "ounce" ? 28.349523125 : task.unit == "pound" ? 453.59237 : 0) / targetMass : (targetVolume > 0 ? (task.unit == "milliliter" ? 1 : task.unit == "liter" ? 1000 : task.unit == "teaspoon" ? 4.92892159375 : task.unit == "tablespoon" ? 14.78676478125 : task.unit == "cup" ? 236.5882365 : task.unit == "pint" ? 473.176473 : task.unit == "quart" ? 946.352946 : task.unit == "gallon" ? 3785.411784 : 0) / targetVolume : 0))) : 0)
    compute otherOpenWork = sum(self.eventDish.prepTasks, (task) => task.deletedAt == null and task.status != "cancelled" and task.dishTaskId == self.dishTaskId and task.status != "completed" ? task.quantity * (task.unit == self.unit ? 1 : (targetMass > 0 ? (task.unit == "gram" ? 1 : task.unit == "kilogram" ? 1000 : task.unit == "ounce" ? 28.349523125 : task.unit == "pound" ? 453.59237 : 0) / targetMass : (targetVolume > 0 ? (task.unit == "milliliter" ? 1 : task.unit == "liter" ? 1000 : task.unit == "teaspoon" ? 4.92892159375 : task.unit == "tablespoon" ? 14.78676478125 : task.unit == "cup" ? 236.5882365 : task.unit == "pint" ? 473.176473 : task.unit == "quart" ? 946.352946 : task.unit == "gallon" ? 3785.411784 : 0) / targetVolume : 0))) : 0) - self.quantity
    compute remainingWork = requiredWork > completedWork + otherOpenWork ? requiredWork - completedWork - otherOpenWork : 0
    mutate quantity = round(remainingWork * 10000) / 10000
    emit PrepTaskGeneratedRefreshed {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: self.eventDishId
      eventId: self.eventId
      quantity: self.quantity
      unit: self.unit
      specialInstructions: self.specialInstructions
    }
  }


  // Attendance/menu edits update uncompleted generated work in the same
  // transaction as demand. Preserve assignments, progress and kitchen notes.
  command syncServings(quantityServings: number) {
    guard self.deletedAt == null
    constraint syncServingsNonnegative: quantityServings >= 0 "Prep servings cannot be negative"
    compute canRefresh = self.isGenerated and self.dishTask != null and self.status != "completed" and self.status != "cancelled"
    compute perServing = self.dishTask != null and self.dishTask.defaultQuantity != null ? self.dishTask.defaultQuantity : 1
    // Exact dimensional conversion; preserve the work unit when compatible.
    // Mirrors src/lib/recipeUnitConversion.ts; no density or batch-size guesses.
    compute recipeUnit = self.dishTask != null and self.dishTask.defaultUnit != null ? self.dishTask.defaultUnit : "portion"
    compute sourceMass = recipeUnit == "gram" ? 1 : recipeUnit == "kilogram" ? 1000 : recipeUnit == "ounce" ? 28.349523125 : recipeUnit == "pound" ? 453.59237 : 0
    compute sourceVolume = recipeUnit == "milliliter" ? 1 : recipeUnit == "liter" ? 1000 : recipeUnit == "teaspoon" ? 4.92892159375 : recipeUnit == "tablespoon" ? 14.78676478125 : recipeUnit == "cup" ? 236.5882365 : recipeUnit == "pint" ? 473.176473 : recipeUnit == "quart" ? 946.352946 : recipeUnit == "gallon" ? 3785.411784 : 0
    compute targetMass = self.unit == "gram" ? 1 : self.unit == "kilogram" ? 1000 : self.unit == "ounce" ? 28.349523125 : self.unit == "pound" ? 453.59237 : 0
    compute targetVolume = self.unit == "milliliter" ? 1 : self.unit == "liter" ? 1000 : self.unit == "teaspoon" ? 4.92892159375 : self.unit == "tablespoon" ? 14.78676478125 : self.unit == "cup" ? 236.5882365 : self.unit == "pint" ? 473.176473 : self.unit == "quart" ? 946.352946 : self.unit == "gallon" ? 3785.411784 : 0
    compute unitRatio = recipeUnit == self.unit ? 1 : (sourceMass > 0 and targetMass > 0 ? sourceMass / targetMass : (sourceVolume > 0 and targetVolume > 0 ? sourceVolume / targetVolume : 1))
    compute compatibleUnit = recipeUnit == self.unit or (sourceMass > 0 and targetMass > 0) or (sourceVolume > 0 and targetVolume > 0)
    mutate quantity = canRefresh ? perServing * quantityServings * unitRatio : self.quantity
    mutate unit = canRefresh and not compatibleUnit ? recipeUnit : self.unit
    emit PrepTaskGeneratedRefreshed {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: self.eventDishId
      eventId: self.eventId
      quantity: self.quantity
      unit: self.unit
      specialInstructions: self.specialInstructions
    }
  }

  // Restore an imported work item's recipe identity without rewriting work.
  command linkRecipe(dishTaskId: uuid, dishId: uuid, optional componentId: uuid) {
    guard self.deletedAt == null
    constraint linkRecipeTask: self.dishTaskId == null or self.dishTaskId == dishTaskId "Prep already belongs to a different recipe step"
    constraint linkRecipeDish: self.dishId == null or self.dishId == dishId "Prep already belongs to a different dish"
    constraint linkRecipeEventDish: self.eventDish == null or self.eventDish.dishId == dishId "Recipe dish must match the event menu line"
    constraint linkRecipeComponent: self.componentId == null or self.componentId == componentId "Prep already belongs to a different component"
    mutate dishTaskId = dishTaskId
    mutate dishId = dishId
    mutate componentId = componentId != null ? componentId : self.componentId
  }

  // Correct a reviewed recipe link before work starts; retain assignments and quantities.
  command replaceRecipeComponent(previousComponentId: uuid, componentId: uuid) {
    guard self.deletedAt == null
    guard self.status == "pending" or self.status == "claimed"
    constraint replacementMatchesRecipe: self.componentId == previousComponentId "Prep recipe changed since replacement was reviewed"
    mutate componentId = componentId
  }

  command claim() {
    guard self.status == "pending"
    guard self.deletedAt == null
    guard user.personId != null
    constraint claimQuantityReady: self.quantity > 0 "Prep quantity must be positive before claim"
    compute previousStatus = self.status
    // user.id is the IdP subject; this field is a Person reference
    // (belongsTo ... references [tenantId, id]). Writing user.id here stored a
    // Clerk id in a Person FK, so the relation never resolved. personId comes
    // from the linked staff profile — see Person.linkAccount.
    mutate assignedToId = user.personId
    mutate status = "claimed"
    mutate claimedAt = now()
    emit PrepTaskClaimed {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: self.eventDishId
      eventId: self.eventId
      name: self.name
      assignedToId: user.personId
      quantity: self.quantity
      unit: self.unit
      previousStatus: previousStatus
      status: "claimed"
    }
  }

  // Lead/manager puts a cook on a prep line (or moves it) before work starts.
  // Pending → claimed with assignee; claimed → reassign without restarting the clock.
  command assign(personId: uuid) {
    // Work changes hands while it is live, not only before it starts: a cook
    // goes home, a station is behind, a lead pulls several steps together as
    // one job. Handing over never rewinds the step - a started step stays
    // started and a blocked step stays blocked, so nothing hides a stall.
    guard self.status == "pending" or self.status == "claimed" or self.status == "in_progress" or self.status == "blocked"
    guard self.deletedAt == null
    guard personId != null
    constraint assignQuantityReady: self.quantity > 0 "Prep quantity must be positive before assign"
    compute previousStatus = self.status
    compute previousAssignee = self.assignedToId
    compute nextStatus = self.status == "in_progress" ? "in_progress" : (self.status == "blocked" ? "blocked" : "claimed")
    mutate assignedToId = personId
    mutate status = nextStatus
    mutate claimedAt = self.claimedAt != null ? self.claimedAt : now()
    emit PrepTaskAssigned {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: self.eventDishId
      eventId: self.eventId
      name: self.name
      assignedToId: personId
      previousAssignedToId: previousAssignee
      quantity: self.quantity
      unit: self.unit
      previousStatus: previousStatus
      status: nextStatus
    }
  }

  command release() {
    guard self.status == "claimed"
    guard self.claimedAt != null
    guard self.deletedAt == null
    guard self.assignedToId == user.id or roleAllows(user.role, "kitchenLeadAccess")
    compute previousStatus = self.status
    compute previousAssignee = self.assignedToId
    mutate assignedToId = null
    mutate status = "pending"
    mutate claimedAt = null
    emit PrepTaskReleased {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: self.eventDishId
      eventId: self.eventId
      name: self.name
      previousAssignedToId: previousAssignee
      quantity: self.quantity
      unit: self.unit
      previousStatus: previousStatus
      status: "pending"
    }
  }

  command start() {
    guard self.status == "claimed"
    guard self.claimedAt != null
    guard self.assignedToId != null
    guard self.deletedAt == null
    constraint startPredecessorsComplete: count_of(self.incomingDependencies, (dependency) => dependency.isSatisfied == false) == 0 "All predecessor prep tasks must be complete before this task can start"
    compute previousStatus = self.status
    mutate status = "in_progress"
    mutate startedAt = now()
    emit PrepTaskStarted {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: self.eventDishId
      eventId: self.eventId
      name: self.name
      assignedToId: self.assignedToId
      quantity: self.quantity
      unit: self.unit
      previousStatus: previousStatus
      status: "in_progress"
    }
  }

  command complete(optional completedQuantity: decimal(12, 4)) {
    guard self.status == "in_progress"
    guard self.startedAt != null
    guard self.deletedAt == null
    constraint completeQuantityNonnegative: completedQuantity == null or completedQuantity >= 0 "Completed quantity cannot be negative"
    compute previousStatus = self.status
    compute nextCompleted = completedQuantity != null ? completedQuantity : self.quantity
    mutate completedQuantity = nextCompleted
    mutate status = "completed"
    mutate completedAt = now()
    emit PrepTaskCompleted {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: self.eventDishId
      eventId: self.eventId
      name: self.name
      assignedToId: self.assignedToId
      quantity: self.quantity
      completedQuantity: nextCompleted
      unit: self.unit
      previousStatus: previousStatus
      status: "completed"
    }
  }

  command markBlocked(reason: string) {
    guard self.status == "pending" or self.status == "claimed" or self.status == "in_progress"
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenLeadAccess")
    constraint blockReasonRequired: length(trim(reason)) > 0 "Block reason is required"
    compute previousStatus = self.status
    mutate status = "blocked"
    mutate blockedAt = now()
    mutate blockReason = reason
    emit PrepTaskBlocked {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: self.eventDishId
      eventId: self.eventId
      name: self.name
      quantity: self.quantity
      unit: self.unit
      previousStatus: previousStatus
      status: "blocked"
      reason: reason
    }
  }

  command unblock() {
    guard self.status == "blocked"
    guard self.blockedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenLeadAccess")
    compute previousStatus = self.status
    // Unblocking clears the block, not the handover. A blocked task can be
    // handed to another cook while it is stuck; erasing assignedToId here
    // threw that away the moment work resumed. The task returns to the
    // pending pool still naming whoever owns it, and they claim it as usual.
    mutate status = "pending"
    mutate blockedAt = null
    mutate blockReason = null
    mutate claimedAt = null
    mutate startedAt = null
    emit PrepTaskUnblocked {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: self.eventDishId
      eventId: self.eventId
      name: self.name
      quantity: self.quantity
      unit: self.unit
      previousStatus: previousStatus
      status: "pending"
    }
  }

  command cancel(reason: string) {
    guard self.status == "pending" or self.status == "claimed" or self.status == "in_progress" or self.status == "blocked"
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenLeadAccess")
    constraint cancelPrepReason: length(trim(reason)) > 0 "Cancellation reason is required"
    compute previousStatus = self.status
    mutate status = "cancelled"
    mutate cancelledAt = now()
    mutate cancellationReason = reason
    emit PrepTaskCancelled {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: self.eventDishId
      eventId: self.eventId
      name: self.name
      quantity: self.quantity
      unit: self.unit
      previousStatus: previousStatus
      status: "cancelled"
      reason: reason
    }
  }

  // Cascade twin of cancel, for EventDishRemoved / EventCancelled. Those fan
  // out over an event's ENTIRE prep list, so a command that throws on settled
  // work makes the whole removal fail: one cook finishing one step used to make
  // a dish impossible to pull from service, which is exactly when you need to
  // pull it. Finished work stays finished here — the task is left alone rather
  // than rejected. eventManageAccess is granted because the fan-out runs as the
  // acting user, and an event manager killing their own event is not a kitchen
  // lead. `cancel` stays narrow: it is the button a human presses.
  command standDown(reason: string) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenLeadAccess") or roleAllows(user.role, "eventManageAccess")
    constraint standDownPrepReason: length(trim(reason)) > 0 "Stand-down reason is required"
    compute previousStatus = self.status
    compute alreadySettled = self.status == "completed" or self.status == "cancelled"
    mutate status = alreadySettled ? self.status : "cancelled"
    mutate cancelledAt = alreadySettled ? self.cancelledAt : now()
    mutate cancellationReason = alreadySettled ? self.cancellationReason : reason
    emit PrepTaskCancelled {
      prepTaskId: self.id
      tenantId: self.tenantId
      eventDishId: self.eventDishId
      eventId: self.eventId
      name: self.name
      quantity: self.quantity
      unit: self.unit
      previousStatus: previousStatus
      status: self.status
      reason: reason
    }
  }

  store PrepTask in durable
}

// Directed sequencing edge: predecessorTask must complete before dependentTask starts.
// Dependencies are declared while the dependent task is still waiting in the prep queue.
entity PrepTaskDependency mixin TenantScoped {
  key [tenantId, id]
  timestamps

  property required dependentTaskId: uuid
  property required predecessorTaskId: uuid
  property required isSatisfied: boolean = false

  // dependentTask must remain first: PrepTask.incomingDependencies resolves this
  // inverse edge when the generated start command hydrates its count_of constraint.
  belongsTo dependentTask: PrepTask fields [tenantId, dependentTaskId] references [tenantId, id]
  belongsTo predecessorTask: PrepTask fields [tenantId, predecessorTaskId] references [tenantId, id]

  default policy prepTaskDependencyRead read: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen and event managers may read prep task dependencies"
  default policy prepTaskDependencyWrite write: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen and event managers may declare prep task dependencies"
  default policy prepTaskDependencyExecute execute: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen and event managers may execute prep task dependency commands"

  command declare(dependentTaskId: uuid, predecessorTaskId: uuid) {
    guard self.dependentTask != null
    guard self.predecessorTask != null
    guard self.dependentTask.status == "pending"
    constraint dependencyTasksDistinct: dependentTaskId != predecessorTaskId "A prep task cannot depend on itself"
    constraint dependencyEventAlign: self.dependentTask.eventId == self.predecessorTask.eventId "Predecessor prep tasks must belong to the same event"
    mutate dependentTaskId = dependentTaskId
    mutate predecessorTaskId = predecessorTaskId
    mutate isSatisfied = self.predecessorTask.status == "completed"
    emit PrepTaskDependencyDeclared {
      prepTaskDependencyId: self.id
      tenantId: self.tenantId
      dependentTaskId: dependentTaskId
      predecessorTaskId: predecessorTaskId
      isSatisfied: self.predecessorTask.status == "completed"
    }
  }

  command satisfy() {
    guard self.isSatisfied == false
    guard self.predecessorTask != null
    guard self.predecessorTask.status == "completed"
    mutate isSatisfied = true
    emit PrepTaskDependencySatisfied {
      prepTaskDependencyId: self.id
      tenantId: self.tenantId
      dependentTaskId: self.dependentTaskId
      predecessorTaskId: self.predecessorTaskId
    }
  }

  store PrepTaskDependency in durable
}

event PrepTaskDependencyDeclared: "prep_task_dependency.declared" {
  prepTaskDependencyId: string
  tenantId: string
  dependentTaskId: string
  predecessorTaskId: string
  isSatisfied: boolean
}

event PrepTaskDependencySatisfied: "prep_task_dependency.satisfied" {
  prepTaskDependencyId: string
  tenantId: string
  dependentTaskId: string
  predecessorTaskId: string
}

event PrepTaskOpened: "prep_task.opened" {
  prepTaskId: string
  tenantId: string
  eventDishId: string
  eventId: string
  name: string
  ingredientId: string?
  ingredientDemandId: string?
  dishId: string?
  componentId: string?
  dishTaskId: string?
  category: string
  taskType: string
  specialInstructions: string?
  isGenerated: boolean
  quantity: decimal(12, 4)
  unit: UnitOfMeasure
  station: string?
  dueAt: datetime?
  status: PrepTaskStatus
}

event PrepTaskRevised: "prep_task.revised" {
  prepTaskId: string
  tenantId: string
  eventDishId: string
  eventId: string
  name: string
  quantity: decimal(12, 4)
  unit: UnitOfMeasure
  category: string
  taskType: string
  specialInstructions: string?
}

event PrepTaskGeneratedRefreshed: "prep_task.generated_refreshed" {
  prepTaskId: string
  tenantId: string
  eventDishId: string
  eventId: string
  quantity: decimal(12, 4)
  unit: UnitOfMeasure
