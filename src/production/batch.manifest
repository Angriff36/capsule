// Capsule production — ProductionBatch (component yield execution).
// Product-required; capsule-pro has NO ProductionBatch entity evidence.

use "./task.manifest"

enum ProductionBatchStatus {
  planned
  in_progress
  completed
  cancelled
}

entity ProductionBatch mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required componentId: uuid
  property eventId: uuid?
  property required plannedYield: decimal(12, 4) = 0
  property actualYield: decimal(12, 4)?
  property required yieldUnit: UnitOfMeasure = "portion"
  property notes: string?
  property required status: ProductionBatchStatus = "planned"
  property plannedAt: datetime?
  property startedAt: datetime?
  property completedAt: datetime?
  property cancelledAt: datetime?
  property cancellationReason: string?

  belongsTo component: Component fields [tenantId, componentId] references [tenantId, id]
  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]

  constraint batchPlannedPositive: self.plannedAt == null or self.plannedYield > 0 "Planned yield must be positive once planned"
  constraint batchActualNonnegative: self.actualYield == null or self.actualYield >= 0 "Actual yield cannot be negative"

  transition status from "planned" to ["in_progress", "cancelled"]
  transition status from "in_progress" to ["completed", "cancelled"]
  transition status from "completed" to []
  transition status from "cancelled" to []

  // manageAccess: Event.approve cascade (event_manager) must plan batches.
  default policy productionBatchRead read: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may read production batches"
  default policy productionBatchWrite write: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may write production batches through commands"
  default policy productionBatchExecute execute: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may execute production batch commands"

  // Idempotent plan: Event.approve fanOut may re-fire; do not fail or duplicate.
  command plan(
    componentId: uuid,
    plannedYield: decimal(12, 4),
    yieldUnit: UnitOfMeasure,
    optional eventId: uuid,
    optional notes: string
  ) {
    guard self.deletedAt == null
    guard self.status == "planned"
    guard self.plannedAt == null or self.componentId == componentId
    guard self.plannedAt != null or (self.component != null and self.component.status == "published")
    constraint planComponentMatch: componentId == self.componentId "Plan componentId must match the seeded component reference"
    constraint planEventMatch: eventId == null or self.eventId == null or eventId == self.eventId "Plan eventId must match the seeded event reference when provided"
    constraint planYieldPositive: plannedYield > 0 or self.plannedYield > 0 "Planned yield must be positive"
    mutate componentId = componentId
    mutate eventId = eventId != null ? eventId : self.eventId
    mutate plannedYield = self.plannedAt != null ? self.plannedYield : plannedYield
    mutate yieldUnit = self.plannedAt != null ? self.yieldUnit : yieldUnit
    mutate notes = notes != null ? notes : self.notes
    mutate plannedAt = self.plannedAt != null ? self.plannedAt : now()
    emit ProductionBatchPlanned {
      productionBatchId: self.id
      tenantId: self.tenantId
      componentId: componentId
      eventId: eventId != null ? eventId : self.eventId
      plannedYield: self.plannedAt != null ? self.plannedYield : plannedYield
      yieldUnit: self.plannedAt != null ? self.yieldUnit : yieldUnit
      status: "planned"
    }
  }

  command start() {
    guard self.status == "planned"
    guard self.plannedAt != null
    guard self.deletedAt == null
    compute previousStatus = self.status
    mutate status = "in_progress"
    mutate startedAt = now()
    emit ProductionBatchStarted {
      productionBatchId: self.id
      tenantId: self.tenantId
      componentId: self.componentId
      eventId: self.eventId
      plannedYield: self.plannedYield
      yieldUnit: self.yieldUnit
      previousStatus: previousStatus
      status: "in_progress"
    }
  }

  command complete(actualYield: decimal(12, 4)) {
    guard self.status == "in_progress"
    guard self.startedAt != null
    guard self.deletedAt == null
    constraint completeYieldNonnegative: actualYield >= 0 "Actual yield cannot be negative"
    compute previousStatus = self.status
    mutate actualYield = actualYield
    mutate status = "completed"
    mutate completedAt = now()
    emit ProductionBatchCompleted {
      productionBatchId: self.id
      tenantId: self.tenantId
      componentId: self.componentId
      eventId: self.eventId
      plannedYield: self.plannedYield
      actualYield: actualYield
      yieldUnit: self.yieldUnit
      previousStatus: previousStatus
      status: "completed"
    }
  }

  command cancel(reason: string) {
    guard self.status == "planned" or self.status == "in_progress"
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenLeadAccess")
    constraint cancelBatchReason: length(trim(reason)) > 0 "Cancellation reason is required"
    compute previousStatus = self.status
    mutate status = "cancelled"
    mutate cancelledAt = now()
    mutate cancellationReason = reason
    emit ProductionBatchCancelled {
      productionBatchId: self.id
      tenantId: self.tenantId
      componentId: self.componentId
      eventId: self.eventId
      plannedYield: self.plannedYield
      actualYield: self.actualYield
      yieldUnit: self.yieldUnit
      previousStatus: previousStatus
      status: "cancelled"
      reason: reason
    }
  }

  store ProductionBatch in durable
}

event ProductionBatchPlanned: "production_batch.planned" {
  productionBatchId: string
  tenantId: string
  componentId: string
  eventId: string?
  plannedYield: decimal(12, 4)
  yieldUnit: UnitOfMeasure
  status: ProductionBatchStatus
}

event ProductionBatchStarted: "production_batch.started" {
  productionBatchId: string
  tenantId: string
  componentId: string
  eventId: string?
  plannedYield: decimal(12, 4)
  yieldUnit: UnitOfMeasure
  previousStatus: ProductionBatchStatus
  status: ProductionBatchStatus
}

event ProductionBatchCompleted: "production_batch.completed" {
  productionBatchId: string
  tenantId: string
  componentId: string
  eventId: string?
  plannedYield: decimal(12, 4)
  actualYield: decimal(12, 4)
  yieldUnit: UnitOfMeasure
  previousStatus: ProductionBatchStatus
  status: ProductionBatchStatus
}

event ProductionBatchCancelled: "production_batch.cancelled" {
  productionBatchId: string
  tenantId: string
  componentId: string
  eventId: string?
  plannedYield: decimal(12, 4)
  actualYield: decimal(12, 4)?
  yieldUnit: UnitOfMeasure
  previousStatus: ProductionBatchStatus
  status: ProductionBatchStatus
  reason: string
}

// Vision cascade: approved event plans one ProductionBatch per seeded dish component.
on EventApproved fanOut EventDishComponentSeed where eventId = payload.eventId
  run ProductionBatch.plan
  match eventId = payload.eventId, componentId = self.componentId
  else create
  params {
    componentId: self.componentId
    plannedYield: self.servings
    yieldUnit: "portion"
    eventId: payload.eventId
  }
