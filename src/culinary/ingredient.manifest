// Capsule culinary ingredients — closed unit/allergen vocabularies and Ingredient.

use "../operations/event.manifest"

enum UnitOfMeasure {
  each
  gram
  kilogram
  ounce
  pound
  milliliter
  liter
  teaspoon
  tablespoon
  cup
  pint
  quart
  gallon
  portion
  // Units the real printed prep sheets use that the catalog units cannot
  // express. Transcribed from work/list3.jpg / list4.jpg / list5.jpg into
  // work/prep-lists-from-photos.csv: "BALL WATERMELON 1.00 melon",
  // "MAKE HUCKLEBERRY COBBLER 0.75 batch", "PIPE PESTO CREAM 15.00 serving",
  // "PORTION BOTTLED WATERS 4.00 bottles". Units are opaque labels here —
  // nothing converts between them — so widening is additive.
  serving
  batch
  melon
  bottle
}

// US major food allergens (Big-8) plus sesame (FASTER Act). Evidence stored
// free-form strings; this slice governs the culinary catalog vocabulary.
enum AllergenCode {
  milk
  eggs
  fish
  crustacean_shellfish
  tree_nuts
  peanuts
  wheat
  soybeans
  sesame
}

enum IngredientStatus {
  active
  discontinued
}

entity Ingredient mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required searchable name: string = ""
  property required unit: UnitOfMeasure = "each"
  property allergens: list<AllergenCode> = []
  property required costPerUnit: money(12, 2) = 0
  property category: string?
  // Kitchen-configured alternatives evaluated against live stock when demand
  // cannot be fully reserved. Ranking is derived from allergens and unit cost.
  property substituteIngredientIds: list<uuid> = []
  // Ordered operator preference plus a scalar first choice for Manifest routing.
  property preferredVendorIds: list<uuid> = []
  property preferredVendorId: uuid?
  property required status: IngredientStatus = "active"
  property introducedAt: datetime?
  property discontinuedAt: datetime?
  property discontinuationReason: string?
  // Canonical lineage: null = root; otherwise a version of that root.
  property canonicalIngredientId: uuid?
  // Optional so existing ingredient rows validate before backfill; UI treats null as 1.
  property editionNumber: int? = 1
  property mergedIntoIngredientId: uuid?

  // Nutrition per one `unit` of this ingredient. All optional so pre-field rows
  // validate under Convex schema push; component/menu panels aggregate the values
  // that are present and flag lines whose ingredient has none. Energy in kcal,
  // macros + fiber + sugar in grams, sodium/calcium/iron in milligrams.
  property caloriesPerUnit: decimal(10, 2)?
  property proteinGramsPerUnit: decimal(10, 2)?
  property carbsGramsPerUnit: decimal(10, 2)?
  property fatGramsPerUnit: decimal(10, 2)?
  property fiberGramsPerUnit: decimal(10, 2)?
  property sugarGramsPerUnit: decimal(10, 2)?
  property sodiumMgPerUnit: decimal(10, 2)?
  property calciumMgPerUnit: decimal(10, 2)?
  property ironMgPerUnit: decimal(10, 2)?

  hasMany componentLines: ComponentIngredient
  hasMany stockLines: InventoryItem
  belongsTo canonicalIngredient: Ingredient fields [tenantId, canonicalIngredientId] references [tenantId, id]
  belongsTo mergedIntoIngredient: Ingredient fields [tenantId, mergedIntoIngredientId] references [tenantId, id]

  computed isActive: boolean = self.status == "active"
  computed isDiscontinued: boolean = self.status == "discontinued"
  computed isCanonicalRoot: boolean = self.canonicalIngredientId == null and self.mergedIntoIngredientId == null

  constraint ingredientIdentityComplete: self.introducedAt == null or length(trim(self.name)) > 0 "Introduced ingredients require a name"
  constraint ingredientCostNonnegative: self.costPerUnit >= 0 "Ingredient cost per unit cannot be negative"

  transition status from "active" to ["discontinued"]
  transition status from "discontinued" to ["active"]

  default policy ingredientRead read: roleAllows(user.role, "kitchenAccess") "Kitchen staff may read ingredients"
  default policy ingredientWrite write: roleAllows(user.role, "kitchenAccess") "Kitchen staff may write ingredients through commands"
  default policy ingredientExecute execute: roleAllows(user.role, "kitchenAccess") "Kitchen staff may execute ingredient commands"

  command introduce(
    name: string,
    unit: UnitOfMeasure,
    costPerUnit: money(12, 2),
    optional allergens: list<AllergenCode>,
    optional category: string,
    optional preferredVendorId: uuid
  ) {
    guard self.introducedAt == null
    guard self.deletedAt == null
    constraint introduceIngredientName: length(trim(name)) > 0 "Ingredient name is required"
    constraint introduceIngredientCost: costPerUnit >= 0 "Ingredient cost per unit cannot be negative"
    mutate name = name
    mutate unit = unit
    mutate costPerUnit = costPerUnit
    mutate allergens = allergens != null ? allergens : []
    mutate category = category
    mutate preferredVendorId = preferredVendorId
    mutate introducedAt = now()
    emit IngredientIntroduced {
      ingredientId: self.id
      tenantId: self.tenantId
      name: name
      unit: unit
      costPerUnit: costPerUnit
      allergens: allergens != null ? allergens : []
    }
  }

  command setPreferredVendor(optional preferredVendorId: uuid) {
    guard self.introducedAt != null
    guard self.deletedAt == null
    mutate preferredVendorId = preferredVendorId
  }

  command configureSubstitutes(substituteIngredientIds: list<uuid>) {
    guard self.introducedAt != null
    guard self.deletedAt == null
    mutate substituteIngredientIds = substituteIngredientIds
  }

  command setPreferredVendors(
    preferredVendorIds: list<uuid>,
    optional preferredVendorId: uuid
  ) {
    guard self.introducedAt != null
    guard self.deletedAt == null
    mutate preferredVendorIds = preferredVendorIds
    mutate preferredVendorId = preferredVendorId
  }

  command updateDetails(
    name: string,
    unit: UnitOfMeasure,
    optional category: string
  ) {
    guard self.status == "active"
    guard self.deletedAt == null
    constraint updateIngredientName: length(trim(name)) > 0 "Ingredient name is required"
    mutate name = name
    mutate unit = unit
    mutate category = category
    emit IngredientDetailsUpdated {
      ingredientId: self.id
      tenantId: self.tenantId
      name: name
      unit: unit
    }
  }

  command classifyAllergens(allergens: list<AllergenCode>) {
    guard self.status == "active"
    guard self.deletedAt == null
    mutate allergens = allergens
    emit IngredientAllergensClassified {
      ingredientId: self.id
      tenantId: self.tenantId
      allergens: allergens
    }
  }

  // Full nutrition panel per unit. The editor always sends every field, so an
  // omitted param intentionally clears that value (null = "not recorded").
  command setNutrition(
    optional caloriesPerUnit: decimal(10, 2),
    optional proteinGramsPerUnit: decimal(10, 2),
    optional carbsGramsPerUnit: decimal(10, 2),
    optional fatGramsPerUnit: decimal(10, 2),
    optional fiberGramsPerUnit: decimal(10, 2),
    optional sugarGramsPerUnit: decimal(10, 2),
    optional sodiumMgPerUnit: decimal(10, 2),
    optional calciumMgPerUnit: decimal(10, 2),
    optional ironMgPerUnit: decimal(10, 2)
  ) {
    guard self.status == "active"
    guard self.deletedAt == null
    constraint nutritionCaloriesNonnegative: caloriesPerUnit == null or caloriesPerUnit >= 0 "Calories cannot be negative"
    constraint nutritionProteinNonnegative: proteinGramsPerUnit == null or proteinGramsPerUnit >= 0 "Protein cannot be negative"
    constraint nutritionCarbsNonnegative: carbsGramsPerUnit == null or carbsGramsPerUnit >= 0 "Carbohydrates cannot be negative"
    constraint nutritionFatNonnegative: fatGramsPerUnit == null or fatGramsPerUnit >= 0 "Fat cannot be negative"
    constraint nutritionFiberNonnegative: fiberGramsPerUnit == null or fiberGramsPerUnit >= 0 "Fiber cannot be negative"
    constraint nutritionSugarNonnegative: sugarGramsPerUnit == null or sugarGramsPerUnit >= 0 "Sugar cannot be negative"
    constraint nutritionSodiumNonnegative: sodiumMgPerUnit == null or sodiumMgPerUnit >= 0 "Sodium cannot be negative"
    constraint nutritionCalciumNonnegative: calciumMgPerUnit == null or calciumMgPerUnit >= 0 "Calcium cannot be negative"
    constraint nutritionIronNonnegative: ironMgPerUnit == null or ironMgPerUnit >= 0 "Iron cannot be negative"
    mutate caloriesPerUnit = caloriesPerUnit
    mutate proteinGramsPerUnit = proteinGramsPerUnit
    mutate carbsGramsPerUnit = carbsGramsPerUnit
    mutate fatGramsPerUnit = fatGramsPerUnit
    mutate fiberGramsPerUnit = fiberGramsPerUnit
    mutate sugarGramsPerUnit = sugarGramsPerUnit
    mutate sodiumMgPerUnit = sodiumMgPerUnit
    mutate calciumMgPerUnit = calciumMgPerUnit
    mutate ironMgPerUnit = ironMgPerUnit
    emit IngredientNutritionSet {
      ingredientId: self.id
      tenantId: self.tenantId
    }
  }

  command updateCosting(costPerUnit: money(12, 2)) {
    guard self.status == "active"
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenManageAccess")
    constraint costingNonnegative: costPerUnit >= 0 "Ingredient cost per unit cannot be negative"
    compute previousCostPerUnit = self.costPerUnit
    mutate costPerUnit = costPerUnit
    emit IngredientCostingUpdated {
      ingredientId: self.id
      tenantId: self.tenantId
      previousCostPerUnit: previousCostPerUnit
      costPerUnit: costPerUnit
      unit: self.unit
    }
  }

  // Discontinue = remove from the kitchen book (soft-delete). Component lines that
  // still reference the id keep working; the row is hidden from catalog pickers.
  // Reason is optional — no mandatory prompt for kitchen ops.
  command discontinue(optional reason: string) {
    guard self.status == "active"
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenManageAccess")
    mutate status = "discontinued"
    mutate discontinuedAt = now()
    mutate discontinuationReason = reason != null ? reason : "Deleted"
    mutate deletedAt = now()
    emit IngredientDiscontinued {
      ingredientId: self.id
      tenantId: self.tenantId
      reason: reason != null ? reason : "Deleted"
    }
  }

  command reinstate() {
    guard self.status == "discontinued"
    guard roleAllows(user.role, "kitchenManageAccess")
    mutate status = "active"
    mutate discontinuedAt = null
    mutate discontinuationReason = null
    mutate deletedAt = null
    emit IngredientReinstated {
      ingredientId: self.id
      tenantId: self.tenantId
    }
  }

  // One-click hide. Works on active or already-discontinued rows — no restore first.
  command purge() {
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenManageAccess")
    mutate status = "discontinued"
    mutate discontinuedAt = self.discontinuedAt != null ? self.discontinuedAt : now()
    mutate discontinuationReason = "Deleted"
    mutate deletedAt = now()
    emit IngredientPurged {
      ingredientId: self.id
      tenantId: self.tenantId
      reason: "Deleted"
    }
  }

  // Attach an already-introduced ingredient as an edition of a canonical root.
  command linkAsEdition(sourceIngredientId: uuid, optional editionNumber: int) {
    guard self.introducedAt != null
    guard self.deletedAt == null
    guard self.mergedIntoIngredientId == null
    constraint linkIngredientEditionSelf: sourceIngredientId != self.id "An ingredient cannot be an edition of itself"
    constraint linkIngredientEditionNumber: editionNumber == null or editionNumber > 0 "Edition number must be positive"
    mutate canonicalIngredientId = sourceIngredientId
    mutate editionNumber = editionNumber != null ? editionNumber : self.editionNumber
    emit IngredientEditionCreated {
      ingredientId: self.id
      tenantId: self.tenantId
      sourceIngredientId: sourceIngredientId
      name: self.name
      editionNumber: editionNumber != null ? editionNumber : self.editionNumber
    }
  }

  command mergeInto(targetIngredientId: uuid, reason: string) {
    guard self.status == "active"
    guard self.deletedAt == null
    guard self.mergedIntoIngredientId == null
    constraint mergeIngredientSelf: targetIngredientId != self.id "Cannot merge an ingredient into itself"
    constraint mergeIngredientReason: length(trim(reason)) > 0 "Merge reason is required"
    mutate mergedIntoIngredientId = targetIngredientId
    mutate status = "discontinued"
    mutate discontinuedAt = now()
    mutate discontinuationReason = reason
    mutate deletedAt = now()
    emit IngredientMerged {
      ingredientId: self.id
      tenantId: self.tenantId
      targetIngredientId: targetIngredientId
      reason: reason
    }
  }

  store Ingredient in durable
}

event IngredientIntroduced: "ingredient.introduced" {
  ingredientId: string
  tenantId: string
  name: string
  unit: UnitOfMeasure
  costPerUnit: money(12, 2)
  allergens: list<AllergenCode>
}

event IngredientDetailsUpdated: "ingredient.details_updated" {
  ingredientId: string
  tenantId: string
  name: string
  unit: UnitOfMeasure
}

event IngredientAllergensClassified: "ingredient.allergens_classified" {
  ingredientId: string
  tenantId: string
  allergens: list<AllergenCode>
}

event IngredientNutritionSet: "ingredient.nutrition_set" {
  ingredientId: string
  tenantId: string
}

event IngredientCostingUpdated: "ingredient.costing_updated" {
  ingredientId: string
  tenantId: string
  previousCostPerUnit: money(12, 2)
  costPerUnit: money(12, 2)
  unit: UnitOfMeasure
}

event IngredientDiscontinued: "ingredient.discontinued" {
  ingredientId: string
  tenantId: string
  reason: string
}

event IngredientReinstated: "ingredient.reinstated" {
  ingredientId: string
  tenantId: string
}

event IngredientPurged: "ingredient.purged" {
  ingredientId: string
  tenantId: string
  reason: string
}

event IngredientEditionCreated: "ingredient.edition_created" {
  ingredientId: string
  tenantId: string
  sourceIngredientId: string
  name: string
  editionNumber: number
}

event IngredientMerged: "ingredient.merged" {
  ingredientId: string
  tenantId: string
  targetIngredientId: string
  reason: string
}
