// Capsule culinary MenuDish — Dish lines on a Menu (catalog composition).
// Compile via menu.manifest.

use "./menu.manifest"

// Menu ↔ Dish membership. Required for priced/curated offerings — not deferred.
entity MenuDish mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required menuId: uuid
  property required dishId: uuid
  property required sortOrder: int = 0
  property sellingPrice: money(12, 2)?
  // A dated price change: from scheduledPriceEffectiveAt on, new quotes and
  // the public menu use scheduledSellingPrice. Published proposal revisions
  // keep the price they were sent with.
  property scheduledSellingPrice: money(12, 2)?
  property scheduledPriceEffectiveAt: datetime?
  property course: string?
  property serviceStyle: string?
  property specialInstructions: string?
  property addedAt: datetime?
  property removedAt: datetime?

  belongsTo menu: Menu fields [tenantId, menuId] references [tenantId, id]
  belongsTo dish: Dish fields [tenantId, dishId] references [tenantId, id]

  // salesAccess: sales browses the published catalog for proposal menu
  // selection (sales/proposal-dish-selection.manifest).
  default policy menuDishRead read: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "salesAccess") "Kitchen and sales staff may see menu dish lines"
  default policy menuDishWrite write: roleAllows(user.role, "kitchenAccess") "Kitchen staff may update menu dish lines"
  default policy menuDishExecute execute: roleAllows(user.role, "kitchenAccess") "Kitchen staff may change menu dish lines"

  command add(
    menuId: uuid,
    dishId: uuid,
    optional sortOrder: number,
    optional sellingPrice: money(12, 2),
    optional course: string,
    optional serviceStyle: string,
    optional specialInstructions: string
  ) {
    guard self.addedAt == null
    guard self.deletedAt == null
    guard self.menu != null and self.menu.status == "draft"
    constraint addMenuMatch: menuId == self.menuId "This menu dish is for a different menu. Pick the menu already on this menu dish."
    constraint addSellingPriceNonnegative: sellingPrice == null or sellingPrice >= 0 "This menu dish's price can't be negative. Use zero or more."
    mutate menuId = menuId
    mutate dishId = dishId
    mutate sortOrder = sortOrder != null ? sortOrder : 0
    mutate sellingPrice = sellingPrice
    mutate course = course
    mutate serviceStyle = serviceStyle
    mutate specialInstructions = specialInstructions
    mutate addedAt = now()
    emit MenuDishAdded {
      menuDishId: self.id
      tenantId: self.tenantId
      menuId: menuId
      dishId: dishId
      sortOrder: sortOrder != null ? sortOrder : 0
      sellingPrice: sellingPrice
      course: course
      serviceStyle: serviceStyle
    }
  }

  command updateDetails(
    optional sortOrder: number,
    optional course: string,
    optional serviceStyle: string,
    optional specialInstructions: string
  ) {
    guard self.addedAt != null
    guard self.deletedAt == null
    guard self.menu != null and self.menu.status == "draft"
    mutate sortOrder = sortOrder != null ? sortOrder : self.sortOrder
    mutate course = course
    mutate serviceStyle = serviceStyle
    mutate specialInstructions = specialInstructions
    emit MenuDishDetailsUpdated {
      menuDishId: self.id
      tenantId: self.tenantId
      menuId: self.menuId
      dishId: self.dishId
      sortOrder: sortOrder != null ? sortOrder : self.sortOrder
      course: course
      serviceStyle: serviceStyle
    }
  }

  command updateSellingPrice(sellingPrice: money(12, 2)) {
    guard self.addedAt != null
    guard self.deletedAt == null
    guard self.menu != null and (self.menu.status == "draft" or self.menu.status == "published")
    guard roleAllows(user.role, "kitchenManageAccess")
    constraint sellingPriceNonnegative: sellingPrice >= 0 "This menu dish's price can't be negative. Use zero or more."
    compute previousSellingPrice = self.sellingPrice
    mutate sellingPrice = sellingPrice
    // A dated change whose day has already come is replaced by this price;
    // one still in the future stays planned.
    compute scheduleStillAhead = self.scheduledPriceEffectiveAt != null and self.scheduledPriceEffectiveAt > now()
    mutate scheduledSellingPrice = scheduleStillAhead ? self.scheduledSellingPrice : null
    mutate scheduledPriceEffectiveAt = scheduleStillAhead ? self.scheduledPriceEffectiveAt : null
    emit MenuDishSellingPriceUpdated {
      menuDishId: self.id
      tenantId: self.tenantId
      menuId: self.menuId
      dishId: self.dishId
      previousSellingPrice: previousSellingPrice
      sellingPrice: sellingPrice
    }
  }

  // Plan a new price from a date. A planned change whose day has already
  // come first becomes the current price, so no earlier change is lost.
  command schedulePriceChange(sellingPrice: money(12, 2), effectiveAt: datetime) {
    guard self.addedAt != null
    guard self.deletedAt == null
    guard self.menu != null and (self.menu.status == "draft" or self.menu.status == "published")
    guard roleAllows(user.role, "kitchenManageAccess")
    constraint scheduledPriceNonnegative: sellingPrice >= 0 "This menu dish's price can't be negative. Use zero or more."
    compute earlierChangeDue = self.scheduledPriceEffectiveAt != null and self.scheduledPriceEffectiveAt <= now()
    mutate sellingPrice = earlierChangeDue ? self.scheduledSellingPrice : self.sellingPrice
    mutate scheduledSellingPrice = sellingPrice
    mutate scheduledPriceEffectiveAt = effectiveAt
    emit MenuDishPriceChangeScheduled {
      menuDishId: self.id
      tenantId: self.tenantId
      menuId: self.menuId
      dishId: self.dishId
      sellingPrice: sellingPrice
      effectiveAt: effectiveAt
    }
  }

  // A planned price that should not happen after all: the current price stays.
  command cancelPriceChange() {
    guard self.addedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenManageAccess")
    constraint cancelPlannedChange: self.scheduledPriceEffectiveAt != null and self.scheduledPriceEffectiveAt > now() "There is no price change still to come on this dish."
    mutate scheduledSellingPrice = null
    mutate scheduledPriceEffectiveAt = null
    emit MenuDishPriceChangeCancelled {
      menuDishId: self.id
      tenantId: self.tenantId
      menuId: self.menuId
      dishId: self.dishId
    }
  }

  command remove(reason: string) {
    guard self.addedAt != null
    guard self.deletedAt == null
    guard self.menu != null and (self.menu.status == "draft" or self.menu.status == "published")
    constraint removeMenuDishReason: length(trim(reason)) > 0 "Say why you're removing this."
    mutate deletedAt = now()
    mutate removedAt = now()
    emit MenuDishRemoved {
      menuDishId: self.id
      tenantId: self.tenantId
      menuId: self.menuId
      dishId: self.dishId
      reason: reason
    }
  }

  store MenuDish in durable
}

event MenuDishAdded: "menu_dish.added" {
  menuDishId: string
  tenantId: string
  menuId: string
  dishId: string
  sortOrder: number
  sellingPrice: money(12, 2)?
  course: string?
  serviceStyle: string?
}

event MenuDishSellingPriceUpdated: "menu_dish.selling_price_updated" {
  menuDishId: string
  tenantId: string
  menuId: string
  dishId: string
  previousSellingPrice: money(12, 2)?
  sellingPrice: money(12, 2)
}

event MenuDishPriceChangeScheduled: "menu_dish.price_change_scheduled" {
  menuDishId: string
  tenantId: string
  menuId: string
  dishId: string
  sellingPrice: money(12, 2)
  effectiveAt: datetime
}

event MenuDishPriceChangeCancelled: "menu_dish.price_change_cancelled" {
  menuDishId: string
  tenantId: string
  menuId: string
  dishId: string
}

event MenuDishDetailsUpdated:"menu_dish.details_updated" {
  menuDishId: string
  tenantId: string
  menuId: string
  dishId: string
  sortOrder: number
  course: string?
  serviceStyle: string?
}

event MenuDishRemoved: "menu_dish.removed" {
  menuDishId: string
  tenantId: string
  menuId: string
  dishId: string
  reason: string
}
