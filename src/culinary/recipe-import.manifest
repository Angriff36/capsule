// Capsule culinary recipe import — durable import workflow and line resolution.

use "./recipe.manifest"

enum RecipeImportSourceKind {
  pasted_text
  text_file
  csv_bundle
}

enum RecipeImportStatus {
  uploaded
  parsed
  reviewing
  ready
  finalizing
  completed
  failed
  cancelled
}

enum RecipeImportMatchStatus {
  unresolved
  exact
  possible
  new
  confirmed_existing
  confirmed_new
}

entity RecipeImport mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required sourceKind: RecipeImportSourceKind = "pasted_text"
  property sourceFilename: string?
  property required rawSourceText: string = ""
  property required sourceByteCount: int = 0
  property required sourceFingerprint: string = ""
  property parsedName: string?
  property parsedDescription: string?
  property parsedCategory: string?
  property parsedCuisine: string?
  property parsedInstructions: string?
  property parsedYieldQuantity: decimal(10, 2)?
  property parsedYieldUnit: UnitOfMeasure?
  property parsedBatchMultiplier: decimal(10, 4)?
  property required parsedLineCount: int = 0
  property required resolvedLineCount: int = 0
  property required status: RecipeImportStatus = "uploaded"
  property parsingFailureDetail: string?
  property finalizationFailureDetail: string?
  property resultingRecipeId: uuid?
  property uploadedAt: datetime?
  property parsedAt: datetime?
  property reviewStartedAt: datetime?
  property readyAt: datetime?
  property finalizationStartedAt: datetime?
  property completedAt: datetime?
  property failedAt: datetime?
  property cancelledAt: datetime?

  hasMany lines: RecipeImportLine
  belongsTo resultingRecipe: Recipe fields [tenantId, resultingRecipeId] references [tenantId, id]

  constraint importSourcePresent: self.uploadedAt == null or length(trim(self.rawSourceText)) > 0 "Import source content is required"
  constraint importYieldPositive: self.parsedYieldQuantity == null or self.parsedYieldQuantity > 0 "Parsed yield quantity must be positive when present"
  constraint importBatchPositive: self.parsedBatchMultiplier == null or self.parsedBatchMultiplier > 0 "Parsed batch multiplier must be positive when present"
  constraint importLineCountsNonnegative: self.parsedLineCount >= 0 and self.resolvedLineCount >= 0 "Import line counts cannot be negative"
  constraint importResolvedWithinParsed: self.resolvedLineCount <= self.parsedLineCount "Resolved line count cannot exceed parsed line count"
  constraint importCompletionRequiresRecipe: self.completedAt == null or self.resultingRecipeId != null "Completed imports require a resulting recipe"

  transition status from "uploaded" to ["parsed", "failed", "cancelled"]
  transition status from "parsed" to ["reviewing", "failed", "cancelled"]
  transition status from "reviewing" to ["ready", "failed", "cancelled"]
  transition status from "ready" to ["finalizing", "reviewing", "failed", "cancelled"]
  transition status from "finalizing" to ["completed", "failed", "reviewing", "cancelled"]
  transition status from "completed" to []
  transition status from "failed" to ["reviewing", "cancelled"]
  transition status from "cancelled" to []

  default policy recipeImportRead read: roleAllows(user.role, "kitchenAccess") "Kitchen staff may read recipe imports"
  default policy recipeImportWrite write: roleAllows(user.role, "kitchenAccess") "Kitchen staff may write recipe imports through commands"
  default policy recipeImportExecute execute: roleAllows(user.role, "kitchenAccess") "Kitchen staff may execute recipe import commands"

  command upload(
    sourceKind: RecipeImportSourceKind,
    rawSourceText: string,
    sourceByteCount: int,
    sourceFingerprint: string,
    optional sourceFilename: string
  ) {
    guard self.uploadedAt == null
    guard self.deletedAt == null
    constraint uploadSourcePresent: length(trim(rawSourceText)) > 0 "Import source content is required"
    constraint uploadByteCountNonnegative: sourceByteCount >= 0 "Source byte count cannot be negative"
    constraint uploadFingerprintPresent: length(trim(sourceFingerprint)) > 0 "Source fingerprint is required"
    mutate sourceKind = sourceKind
    mutate sourceFilename = sourceFilename
    mutate rawSourceText = rawSourceText
    mutate sourceByteCount = sourceByteCount
    mutate sourceFingerprint = sourceFingerprint
    mutate status = "uploaded"
    mutate uploadedAt = now()
    emit RecipeImportUploaded {
      recipeImportId: self.id
      tenantId: self.tenantId
      sourceKind: sourceKind
      sourceByteCount: sourceByteCount
      sourceFingerprint: sourceFingerprint
    }
  }

  command recordParse(
    parsedName: string,
    parsedLineCount: int,
    optional parsedDescription: string,
    optional parsedCategory: string,
    optional parsedCuisine: string,
    optional parsedInstructions: string,
    optional parsedYieldQuantity: decimal(10, 2),
    optional parsedYieldUnit: UnitOfMeasure,
    optional parsedBatchMultiplier: decimal(10, 4)
  ) {
    guard self.status == "uploaded"
    guard self.uploadedAt != null
    guard self.deletedAt == null
    constraint parseNamePresent: length(trim(parsedName)) > 0 "Parsed recipe name is required"
    constraint parseLineCountNonnegative: parsedLineCount >= 0 "Parsed line count cannot be negative"
    constraint parseYieldPositive: parsedYieldQuantity == null or parsedYieldQuantity > 0 "Parsed yield quantity must be positive when present"
    constraint parseBatchPositive: parsedBatchMultiplier == null or parsedBatchMultiplier > 0 "Parsed batch multiplier must be positive when present"
    mutate parsedName = parsedName
    mutate parsedDescription = parsedDescription
    mutate parsedCategory = parsedCategory
    mutate parsedCuisine = parsedCuisine
    mutate parsedInstructions = parsedInstructions
    mutate parsedYieldQuantity = parsedYieldQuantity
    mutate parsedYieldUnit = parsedYieldUnit
    mutate parsedBatchMultiplier = parsedBatchMultiplier != null ? parsedBatchMultiplier : 1
    mutate parsedLineCount = parsedLineCount
    mutate resolvedLineCount = 0
    mutate status = "parsed"
    mutate parsedAt = now()
    emit RecipeImportParsed {
      recipeImportId: self.id
      tenantId: self.tenantId
      parsedName: parsedName
      parsedLineCount: parsedLineCount
    }
  }

  command beginReview() {
    guard self.status == "parsed"
    guard self.parsedAt != null
    guard self.deletedAt == null
    mutate status = "reviewing"
    mutate reviewStartedAt = now()
    emit RecipeImportReviewStarted {
      recipeImportId: self.id
      tenantId: self.tenantId
    }
  }

  command recordResolutionProgress(resolvedLineCount: int) {
    guard self.status == "reviewing"
    guard self.reviewStartedAt != null
    guard self.deletedAt == null
    constraint progressNonnegative: resolvedLineCount >= 0 "Resolved line count cannot be negative"
    constraint progressWithinParsed: resolvedLineCount <= self.parsedLineCount "Resolved line count cannot exceed parsed line count"
    mutate resolvedLineCount = resolvedLineCount
    emit RecipeImportResolutionProgressRecorded {
      recipeImportId: self.id
      tenantId: self.tenantId
      resolvedLineCount: resolvedLineCount
      parsedLineCount: self.parsedLineCount
    }
  }

  command approveReview() {
    guard self.status == "reviewing"
    guard self.reviewStartedAt != null
    guard self.deletedAt == null
    guard self.parsedLineCount > 0
    guard self.resolvedLineCount == self.parsedLineCount
    mutate status = "ready"
    mutate readyAt = now()
    emit RecipeImportReviewApproved {
      recipeImportId: self.id
      tenantId: self.tenantId
      parsedLineCount: self.parsedLineCount
    }
  }

  command beginFinalization() {
    guard self.status == "ready"
    guard self.readyAt != null
    guard self.deletedAt == null
    mutate status = "finalizing"
    mutate finalizationStartedAt = now()
    emit RecipeImportFinalizationStarted {
      recipeImportId: self.id
      tenantId: self.tenantId
    }
  }

  command recordRecipe(resultingRecipeId: uuid) {
    guard self.status == "finalizing"
    guard self.finalizationStartedAt != null
    guard self.deletedAt == null
    guard self.resultingRecipe != null
    mutate resultingRecipeId = resultingRecipeId
    emit RecipeImportRecipeRecorded {
      recipeImportId: self.id
      tenantId: self.tenantId
      resultingRecipeId: resultingRecipeId
    }
  }

  command markFailed(failureDetail: string, optional duringParsing: boolean) {
    guard self.status != "completed"
    guard self.status != "cancelled"
    guard self.deletedAt == null
    constraint failureDetailPresent: length(trim(failureDetail)) > 0 "Failure detail is required"
    compute previousStatus = self.status
    mutate status = "failed"
    mutate failedAt = now()
    mutate parsingFailureDetail = duringParsing == true ? failureDetail : self.parsingFailureDetail
    mutate finalizationFailureDetail = duringParsing == true ? self.finalizationFailureDetail : failureDetail
    emit RecipeImportFailed {
      recipeImportId: self.id
      tenantId: self.tenantId
      previousStatus: previousStatus
      failureDetail: failureDetail
    }
  }

  command resumeReview() {
    guard self.status == "failed" or self.status == "finalizing"
    guard self.deletedAt == null
    mutate status = "reviewing"
    mutate failedAt = null
    mutate finalizationStartedAt = null
    mutate finalizationFailureDetail = null
    emit RecipeImportReviewResumed {
      recipeImportId: self.id
      tenantId: self.tenantId
    }
  }

  command complete() {
    guard self.status == "finalizing"
    guard self.finalizationStartedAt != null
    guard self.resultingRecipeId != null
    guard self.deletedAt == null
    mutate status = "completed"
    mutate completedAt = now()
    emit RecipeImportCompleted {
      recipeImportId: self.id
      tenantId: self.tenantId
      resultingRecipeId: self.resultingRecipeId
    }
  }

  command cancel(reason: string) {
    guard self.status != "completed"
    guard self.deletedAt == null
    constraint cancelReasonPresent: length(trim(reason)) > 0 "Cancellation reason is required"
    compute previousStatus = self.status
    mutate status = "cancelled"
    mutate cancelledAt = now()
    emit RecipeImportCancelled {
      recipeImportId: self.id
      tenantId: self.tenantId
      previousStatus: previousStatus
      reason: reason
    }
  }

  store RecipeImport in durable
}

entity RecipeImportLine mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required importId: uuid
  property required sourceOrder: int = 0
  property required sourceLine: string = ""
  property parsedQuantity: decimal(10, 4)?
  property parsedUnit: UnitOfMeasure?
  property parsedIngredientName: string?
  property preparationNote: string?
  property required matchStatus: RecipeImportMatchStatus = "unresolved"
  property matchedIngredientId: uuid?
  property possibleMatchIngredientIds: list<string> = []
  property resolvedAt: datetime?

  belongsTo import: RecipeImport fields [tenantId, importId] references [tenantId, id]
  belongsTo matchedIngredient: Ingredient fields [tenantId, matchedIngredientId] references [tenantId, id]

  constraint lineMatchedIngredientAllowed: self.matchStatus == "exact" or self.matchStatus == "confirmed_existing" or self.matchedIngredientId == null "Only exact or confirmed existing lines may carry a matched ingredient id"
  constraint lineConfirmedNewWithoutMatch: self.matchStatus != "confirmed_new" or self.matchedIngredientId == null "Confirmed new lines remain unmatched until ingredient creation succeeds"

  default policy recipeImportLineRead read: roleAllows(user.role, "kitchenAccess") "Kitchen staff may read recipe import lines"
  default policy recipeImportLineWrite write: roleAllows(user.role, "kitchenAccess") "Kitchen staff may write recipe import lines through commands"
  default policy recipeImportLineExecute execute: roleAllows(user.role, "kitchenAccess") "Kitchen staff may execute recipe import line commands"

  command stage(
    importId: uuid,
    sourceOrder: int,
    sourceLine: string,
    optional parsedQuantity: decimal(10, 4),
    optional parsedUnit: UnitOfMeasure,
    optional parsedIngredientName: string,
    optional preparationNote: string
  ) {
    guard self.resolvedAt == null
    guard self.deletedAt == null
    guard self.import != null
    constraint stageImportMatch: importId == self.importId "Stage importId must match the seeded import reference"
    constraint stageSourceLinePresent: length(trim(sourceLine)) > 0 "Source line is required"
    constraint stageOrderNonnegative: sourceOrder >= 0 "Source order cannot be negative"
    mutate importId = importId
    mutate sourceOrder = sourceOrder
    mutate sourceLine = sourceLine
    mutate parsedQuantity = parsedQuantity
    mutate parsedUnit = parsedUnit
    mutate parsedIngredientName = parsedIngredientName
    mutate preparationNote = preparationNote
    mutate matchStatus = "unresolved"
    emit RecipeImportLineStaged {
      recipeImportLineId: self.id
      tenantId: self.tenantId
      importId: importId
      sourceOrder: sourceOrder
    }
  }

  command suggestExactMatch(matchedIngredientId: uuid) {
    guard self.resolvedAt == null
    guard self.deletedAt == null
    guard self.matchedIngredient != null and self.matchedIngredient.status == "active"
    mutate matchStatus = "exact"
    mutate matchedIngredientId = matchedIngredientId
    mutate possibleMatchIngredientIds = []
    emit RecipeImportLineExactMatchSuggested {
      recipeImportLineId: self.id
      tenantId: self.tenantId
      importId: self.importId
      matchedIngredientId: matchedIngredientId
    }
  }

  command suggestPossibleMatches(possibleMatchIngredientIds: list<string>) {
    guard self.resolvedAt == null
    guard self.deletedAt == null
    mutate matchStatus = "possible"
    mutate matchedIngredientId = null
    mutate possibleMatchIngredientIds = possibleMatchIngredientIds
    emit RecipeImportLinePossibleMatchesSuggested {
      recipeImportLineId: self.id
      tenantId: self.tenantId
      importId: self.importId
      candidateCount: length(possibleMatchIngredientIds)
    }
  }

  command markNew() {
    guard self.resolvedAt == null
    guard self.deletedAt == null
    mutate matchStatus = "new"
    mutate matchedIngredientId = null
    mutate possibleMatchIngredientIds = []
    emit RecipeImportLineMarkedNew {
      recipeImportLineId: self.id
      tenantId: self.tenantId
      importId: self.importId
    }
  }

  command confirmExisting(matchedIngredientId: uuid) {
    guard self.resolvedAt == null
    guard self.deletedAt == null
    guard self.matchedIngredient != null and self.matchedIngredient.status == "active"
    mutate matchStatus = "confirmed_existing"
    mutate matchedIngredientId = matchedIngredientId
    mutate resolvedAt = now()
    emit RecipeImportLineExistingConfirmed {
      recipeImportLineId: self.id
      tenantId: self.tenantId
      importId: self.importId
      matchedIngredientId: matchedIngredientId
    }
  }

  command confirmNew() {
    guard self.resolvedAt == null
    guard self.deletedAt == null
    mutate matchStatus = "confirmed_new"
    mutate matchedIngredientId = null
    mutate resolvedAt = now()
    emit RecipeImportLineNewConfirmed {
      recipeImportLineId: self.id
      tenantId: self.tenantId
      importId: self.importId
    }
  }

  command attachCreatedIngredient(matchedIngredientId: uuid) {
    guard self.matchStatus == "confirmed_new"
    guard self.resolvedAt != null
    guard self.deletedAt == null
    guard self.matchedIngredient != null and self.matchedIngredient.status == "active"
    mutate matchedIngredientId = matchedIngredientId
    emit RecipeImportLineCreatedIngredientAttached {
      recipeImportLineId: self.id
      tenantId: self.tenantId
      importId: self.importId
      matchedIngredientId: matchedIngredientId
    }
  }

  command resetResolution() {
    guard self.deletedAt == null
    mutate matchStatus = "unresolved"
    mutate matchedIngredientId = null
    mutate possibleMatchIngredientIds = []
    mutate resolvedAt = null
    emit RecipeImportLineResolutionReset {
      recipeImportLineId: self.id
      tenantId: self.tenantId
      importId: self.importId
    }
  }

  command discard(reason: string) {
    guard self.deletedAt == null
    constraint discardReasonPresent: length(trim(reason)) > 0 "Discard reason is required"
    mutate deletedAt = now()
    emit RecipeImportLineDiscarded {
      recipeImportLineId: self.id
      tenantId: self.tenantId
      importId: self.importId
      reason: reason
    }
  }

  store RecipeImportLine in durable
}

event RecipeImportUploaded: "recipe_import.uploaded" {
  recipeImportId: string
  tenantId: string
  sourceKind: RecipeImportSourceKind
  sourceByteCount: int
  sourceFingerprint: string
}

event RecipeImportParsed: "recipe_import.parsed" {
  recipeImportId: string
  tenantId: string
  parsedName: string
  parsedLineCount: int
}

event RecipeImportReviewStarted: "recipe_import.review_started" {
  recipeImportId: string
  tenantId: string
}

event RecipeImportResolutionProgressRecorded: "recipe_import.resolution_progress_recorded" {
  recipeImportId: string
  tenantId: string
  resolvedLineCount: int
  parsedLineCount: int
}

event RecipeImportReviewApproved: "recipe_import.review_approved" {
  recipeImportId: string
  tenantId: string
  parsedLineCount: int
}

event RecipeImportFinalizationStarted: "recipe_import.finalization_started" {
  recipeImportId: string
  tenantId: string
}

event RecipeImportRecipeRecorded: "recipe_import.recipe_recorded" {
  recipeImportId: string
  tenantId: string
  resultingRecipeId: string
}

event RecipeImportFailed: "recipe_import.failed" {
  recipeImportId: string
  tenantId: string
  previousStatus: RecipeImportStatus
  failureDetail: string
}

event RecipeImportReviewResumed: "recipe_import.review_resumed" {
  recipeImportId: string
  tenantId: string
}

event RecipeImportCompleted: "recipe_import.completed" {
  recipeImportId: string
  tenantId: string
  resultingRecipeId: string
}

event RecipeImportCancelled: "recipe_import.cancelled" {
  recipeImportId: string
  tenantId: string
  previousStatus: RecipeImportStatus
  reason: string
}

event RecipeImportLineStaged: "recipe_import_line.staged" {
  recipeImportLineId: string
  tenantId: string
  importId: string
  sourceOrder: int
}

event RecipeImportLineExactMatchSuggested: "recipe_import_line.exact_match_suggested" {
  recipeImportLineId: string
  tenantId: string
  importId: string
  matchedIngredientId: string
}

event RecipeImportLinePossibleMatchesSuggested: "recipe_import_line.possible_matches_suggested" {
  recipeImportLineId: string
  tenantId: string
  importId: string
  candidateCount: int
}

event RecipeImportLineMarkedNew: "recipe_import_line.marked_new" {
  recipeImportLineId: string
  tenantId: string
  importId: string
}

event RecipeImportLineExistingConfirmed: "recipe_import_line.existing_confirmed" {
  recipeImportLineId: string
  tenantId: string
  importId: string
  matchedIngredientId: string
}

event RecipeImportLineNewConfirmed: "recipe_import_line.new_confirmed" {
  recipeImportLineId: string
  tenantId: string
  importId: string
}

event RecipeImportLineCreatedIngredientAttached: "recipe_import_line.created_ingredient_attached" {
  recipeImportLineId: string
  tenantId: string
  importId: string
  matchedIngredientId: string
}

event RecipeImportLineResolutionReset: "recipe_import_line.resolution_reset" {
  recipeImportLineId: string
  tenantId: string
  importId: string
}

event RecipeImportLineDiscarded: "recipe_import_line.discarded" {
  recipeImportLineId: string
  tenantId: string
  importId: string
  reason: string
}
