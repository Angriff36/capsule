// Capsule culinary EventDish — a Dish on an Event with servings.
// PrepTasks belong to EventDish (not bare Event). See production/task.manifest.

use "./menu-dish.manifest"

// One plate line on an event. Removing a line soft-deletes THAT row.
// Re-adding the same Dish is a NEW EventDish row (new id) via addToEvent — not
// resurrecting the deleted line.
//
// Live food-cost / batch scaling (2026-07-23):
//   targetHeadcount defaults to Event.expectedHeadcount; optional
//   headcountOverride when not every guest receives the dish.
//   requiredBatches = ceil(targetHeadcount / Recipe.servesPerYield) per
//   attached DishRecipe line; estimatedCost sums batch × liveBatchCost.
//   quantityServings remains for prep-list sync — not the cost authority.
entity EventDish mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required eventId: uuid
  property required dishId: uuid
  // Prep-list / ops servings. Callers should pass Event.expectedHeadcount;
  // do not force 1 when the dish is for the whole event. Live food cost uses
  // targetHeadcount below, not this field.
  property required quantityServings: int = 1
  // 0/null = no override (use Event.expectedHeadcount). >0 = this dish's guest count.
  // Optional so pre-field EventDish rows still validate under Convex schema push.
  property headcountOverride: int? = 0
  // Denormalized from Event at add time for BOM → weekly purchasing reactions.
  property purchasingWeekStart: datetime?
  property course: string?
  property serviceStyle: string?
  property specialInstructions: string?
  property addedAt: datetime?
  property removedAt: datetime?

  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]
  belongsTo dish: Dish fields [tenantId, dishId] references [tenantId, id]

  computed targetHeadcount: int = self.headcountOverride != null and self.headcountOverride > 0 ? self.headcountOverride : self.event.expectedHeadcount
  // Display helper: largest batch count across attached recipes (lemonade = one recipe).
  // Headcount uses self.targetHeadcount (sibling computed; Convex helpers assign in order).
  computed requiredBatches: int = max_of(filter(self.dish.recipeLines, (line) => line.deletedAt == null and line.attachedAt != null), (line) => line.recipe.servesPerYield > 0 ? ceil(self.targetHeadcount / line.recipe.servesPerYield) : 0)
  computed requiredYieldQuantity: decimal(10, 2) = max_of(filter(self.dish.recipeLines, (line) => line.deletedAt == null and line.attachedAt != null), (line) => (line.recipe.servesPerYield > 0 ? ceil(self.targetHeadcount / line.recipe.servesPerYield) : 0) * line.recipe.yieldQuantity)
  // Sum of ceil(headcount / servesPerYield) × same-unit ingredient batch cost per attached recipe.
  // Batch cost is inlined (not line.recipe.liveBatchCost) so Convex hydrate can load
  // recipe.ingredientLines → ingredient without a nested compute pass.
  computed estimatedCost: money(12, 2) = sum(filter(self.dish.recipeLines, (line) => line.deletedAt == null and line.attachedAt != null), (line) => (line.recipe.servesPerYield > 0 ? ceil(self.targetHeadcount / line.recipe.servesPerYield) : 0) * sum(filter(line.recipe.ingredientLines, (il) => il.deletedAt == null and il.addedAt != null), (il) => il.unit == il.ingredient.unit ? il.quantity * (il.wasteFactor != null ? il.wasteFactor : 1) * il.ingredient.costPerUnit : 0))

  // Zero servings = 86'd / not serving; remove() is the other path.
  constraint eventDishServingsNonnegative: self.addedAt == null or self.quantityServings >= 0 "Event dish servings cannot be negative"
  constraint eventDishHeadcountOverrideNonnegative: self.headcountOverride == null or self.headcountOverride >= 0 "Headcount override cannot be negative"

  // Read: any staff on this tenant. Write/execute: managers+.
  default policy eventDishRead read: roleAllows(user.role, "staffAccess") "Employed staff may read event dishes"
  default policy eventDishWrite write: roleAllows(user.role, "manageAccess") "Managers may write event dishes through commands"
  default policy eventDishExecute execute: roleAllows(user.role, "manageAccess") "Managers may execute event dish commands"

  // Add this dish to the event (create).
  command addToEvent(
    eventId: uuid,
    dishId: uuid,
    quantityServings: number,
    optional headcountOverride: int,
    optional course: string,
    optional serviceStyle: string,
    optional specialInstructions: string
  ) {
    // This row is already live — don't double-add the same id.
    // To put the same Dish back after remove: allocate a NEW EventDish and call addToEvent.
    guard self.addedAt == null
    guard self.deletedAt == null
    // Live event only — includes executing (86/swap mid-service). Not cancelled/done.
    guard self.event != null and (self.event.stage == "planning" or self.event.stage == "pending_approval" or self.event.stage == "approved" or self.event.stage == "executing")
    // Seed check: createVia pre-writes eventId on the row; the arg must match
    // that seed. Fails only on buggy/mismatched API calls — not a business "can't move dishes" rule.
    constraint addToEventEventMatch: eventId == self.eventId "addToEvent eventId must match the seeded event reference"
    constraint addToEventServingsNonnegative: quantityServings >= 0 "Event dish servings cannot be negative"
    constraint addToEventHeadcountOverrideNonnegative: headcountOverride == null or headcountOverride >= 0 "Headcount override cannot be negative"
    mutate eventId = eventId
    mutate dishId = dishId
    mutate quantityServings = quantityServings
    mutate headcountOverride = headcountOverride != null ? headcountOverride : 0
    mutate purchasingWeekStart = self.event.purchasingWeekStart
    mutate course = course
    mutate serviceStyle = serviceStyle
    mutate specialInstructions = specialInstructions
    mutate addedAt = now()
    emit EventDishAdded {
      eventDishId: self.id
      tenantId: self.tenantId
      eventId: eventId
      dishId: dishId
      quantityServings: quantityServings
      headcountOverride: headcountOverride != null ? headcountOverride : 0
      purchasingWeekStart: self.event.purchasingWeekStart
      course: course
      serviceStyle: serviceStyle
    }
  }

  command adjustServings(quantityServings: number) {
    guard self.addedAt != null
    guard self.deletedAt == null
    // Live event + post-event correction. Zero = 86 without deleting the line.
    // Refunds are Invoice/Payment — not this field. Cancelled stays locked.
    guard self.event != null and (self.event.stage == "planning" or self.event.stage == "pending_approval" or self.event.stage == "approved" or self.event.stage == "executing" or self.event.stage == "completed" or self.event.stage == "closed_out")
    constraint adjustServingsNonnegative: quantityServings >= 0 "Event dish servings cannot be negative"
    compute previousQuantityServings = self.quantityServings
    mutate quantityServings = quantityServings
    emit EventDishServingsAdjusted {
      eventDishId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      dishId: self.dishId
      previousQuantityServings: previousQuantityServings
      quantityServings: quantityServings
    }
  }

  // Override how many guests this dish is prepared for (0 clears → Event.expectedHeadcount).
  command setHeadcountOverride(headcountOverride: int) {
    guard self.addedAt != null
    guard self.deletedAt == null
    guard self.event != null and (self.event.stage == "planning" or self.event.stage == "pending_approval" or self.event.stage == "approved" or self.event.stage == "executing" or self.event.stage == "completed" or self.event.stage == "closed_out")
    constraint setHeadcountOverrideNonnegative: headcountOverride >= 0 "Headcount override cannot be negative"
    mutate headcountOverride = headcountOverride
    emit EventDishHeadcountOverrideSet {
      eventDishId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      dishId: self.dishId
      headcountOverride: headcountOverride
    }
  }

  command changeCourse(optional course: string, optional serviceStyle: string) {
    guard self.addedAt != null
    guard self.deletedAt == null
    guard self.event != null and (self.event.stage == "planning" or self.event.stage == "pending_approval" or self.event.stage == "approved" or self.event.stage == "executing")
    mutate course = course
    mutate serviceStyle = serviceStyle
    emit EventDishCourseChanged {
      eventDishId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      dishId: self.dishId
      course: course
      serviceStyle: serviceStyle
    }
  }

  command updateInstructions(optional specialInstructions: string) {
    guard self.addedAt != null
    guard self.deletedAt == null
    // Notes are allowed through executing — kitchen/service still needs them.
    guard self.event != null and (self.event.stage == "planning" or self.event.stage == "pending_approval" or self.event.stage == "approved" or self.event.stage == "executing")
    mutate specialInstructions = specialInstructions
    emit EventDishInstructionsUpdated {
      eventDishId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      dishId: self.dishId
    }
  }

  // Feed a proposal menu selection into this event's dish lines
  // (ProposalAccepted cascade, sales/proposal-dish-selection.manifest).
  // Idempotent on an existing live (eventId, dishId) line: first write wins,
  // kitchen edits are preserved (ClientFollowUpReminder.open pattern), and
  // seedDishId goes out null so the BOM hop does not re-seed.
  command confirmFromProposal(
    eventId: uuid,
    dishId: uuid,
    quantityServings: number,
    optional course: string,
    optional serviceStyle: string,
    optional specialInstructions: string
  ) {
    guard self.deletedAt == null
    guard self.event != null and (self.event.stage == "planning" or self.event.stage == "pending_approval" or self.event.stage == "approved" or self.event.stage == "executing")
    constraint confirmFromProposalEventMatch: eventId == self.eventId "confirmFromProposal eventId must match the seeded event reference"
    constraint confirmFromProposalServingsNonnegative: quantityServings >= 0 "Event dish servings cannot be negative"
    compute wasExistingLine = self.addedAt != null
    mutate eventId = eventId
    mutate dishId = dishId
    mutate quantityServings = self.addedAt != null ? self.quantityServings : quantityServings
    mutate purchasingWeekStart = self.event.purchasingWeekStart
    mutate course = self.addedAt != null ? self.course : course
    mutate serviceStyle = self.addedAt != null ? self.serviceStyle : serviceStyle
    mutate specialInstructions = self.addedAt != null ? self.specialInstructions : specialInstructions
    mutate addedAt = self.addedAt != null ? self.addedAt : now()
    emit EventDishConfirmedFromProposal {
      eventDishId: self.id
      tenantId: self.tenantId
      eventId: eventId
      dishId: dishId
      seedDishId: wasExistingLine ? null : dishId
      quantityServings: self.quantityServings
      purchasingWeekStart: self.event.purchasingWeekStart
      course: self.course
      serviceStyle: self.serviceStyle
    }
  }

  // Bridge for the container -> pack list chain. fanOut walks one level, but the
  // path is PackList -> EventDish -> DishContainer, so this re-emits the pack
  // list id alongside this row's dish and servings for the second fanOut.
  command requestContainerPack(packListId: uuid) {
    guard self.deletedAt == null
    emit EventDishContainerPackRequested {
      eventDishId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      dishId: self.dishId
      packListId: packListId
      quantityServings: self.quantityServings
    }
  }

  command remove(reason: string) {
    guard self.addedAt != null
    guard self.deletedAt == null
    // Includes executing — ran out / pull from service. Not after the event is done/cancelled.
    guard self.event != null and (self.event.stage == "planning" or self.event.stage == "pending_approval" or self.event.stage == "approved" or self.event.stage == "executing")
    constraint removeEventDishReason: length(trim(reason)) > 0 "Removal reason is required"
    compute previousQuantityServings = self.quantityServings
    mutate deletedAt = now()
    mutate removedAt = now()
    emit EventDishRemoved {
      eventDishId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      dishId: self.dishId
      previousQuantityServings: previousQuantityServings
      reason: reason
    }
  }

  store EventDish in durable
}

event EventDishContainerPackRequested: "event_dish.container_pack_requested" {
  eventDishId: string
  tenantId: string
  eventId: string
  dishId: string
  packListId: string
  quantityServings: number
}

event EventDishAdded: "event_dish.added" {
  eventDishId: string
  tenantId: string
  eventId: string
  dishId: string
  quantityServings: number
  headcountOverride: int
  purchasingWeekStart: datetime?
  course: string?
  serviceStyle: string?
}

event EventDishConfirmedFromProposal: "event_dish.confirmed_from_proposal" {
  eventDishId: string
  tenantId: string
  eventId: string
  dishId: string
  // Non-null only when the confirmation created a fresh line — keys the BOM
  // seed hop (procurement/event-purchasing.manifest); pre-existing lines
  // already seeded at addToEvent time.
  seedDishId: string?
  quantityServings: number
  purchasingWeekStart: datetime?
  course: string?
  serviceStyle: string?
}

event EventDishServingsAdjusted: "event_dish.servings_adjusted" {
  eventDishId: string
  tenantId: string
  eventId: string
  dishId: string
  previousQuantityServings: number
  quantityServings: number
}

event EventDishHeadcountOverrideSet: "event_dish.headcount_override_set" {
  eventDishId: string
  tenantId: string
  eventId: string
  dishId: string
  headcountOverride: int
}

event EventDishCourseChanged: "event_dish.course_changed" {
  eventDishId: string
  tenantId: string
  eventId: string
  dishId: string
  course: string?
  serviceStyle: string?
}

event EventDishInstructionsUpdated: "event_dish.instructions_updated" {
  eventDishId: string
  tenantId: string
  eventId: string
  dishId: string
}

event EventDishRemoved: "event_dish.removed" {
  eventDishId: string
  tenantId: string
  eventId: string
  dishId: string
  previousQuantityServings: number
  reason: string
}
