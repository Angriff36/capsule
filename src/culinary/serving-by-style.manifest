// Packaging and serving by service style, and recipe equipment (Ryan
// 2026-10-04, recipe_sheet.csv: one packaging line per service style —
// drop off, bring hot, cook on site). The event's service style picks which
// line the prep and pack lists show. Equipment is a list, not one text box.

use "../foundation/base.manifest"
use "./component.manifest"
use "./dish.manifest"
use "../operations/service-style.manifest"

// How a recipe or a dish version is packaged and served for one service style.
// Exactly one of componentId (a recipe) or dishId (a dish or version) is set.
entity StylePackaging mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property indexed componentId: uuid?
  property indexed dishId: uuid?
  property required serviceStyleId: uuid
  property required instructions: string = ""
  // The pan, bain marie or vessel it goes out in ("1/3 pan, cater wrap").
  property container: string?
  property addedAt: datetime?
  property removedAt: datetime?

  belongsTo component: Component fields [tenantId, componentId] references [tenantId, id]
  belongsTo dish: Dish fields [tenantId, dishId] references [tenantId, id]
  belongsTo serviceStyle: ServiceStyle fields [tenantId, serviceStyleId] references [tenantId, id]

  constraint stylePackagingOwner: self.addedAt == null or (self.componentId != null) != (self.dishId != null) "Packaging belongs to one recipe or one dish."
  constraint stylePackagingText: self.addedAt == null or length(trim(self.instructions)) > 0 "Write how it is packaged or served."

  default policy stylePackagingRead read: roleAllows(user.role, "staffAccess") "Staff may see packaging instructions"
  default policy stylePackagingWrite write: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may update packaging instructions"
  default policy stylePackagingExecute execute: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may change packaging instructions"

  command add(serviceStyleId: uuid, instructions: string, optional componentId: uuid, optional dishId: uuid, optional container: string) {
    guard self.addedAt == null
    mutate serviceStyleId = serviceStyleId
    mutate componentId = componentId
    mutate dishId = dishId
    mutate instructions = trim(instructions)
    mutate container = container
    mutate addedAt = now()
    emit StylePackagingAdded {
      stylePackagingId: self.id
      tenantId: self.tenantId
    }
  }

  command revise(instructions: string, optional container: string) {
    guard self.deletedAt == null
    constraint stylePackagingRevisedText: length(trim(instructions)) > 0 "Write how it is packaged or served."
    mutate instructions = trim(instructions)
    mutate container = container
    emit StylePackagingRevised {
      stylePackagingId: self.id
      tenantId: self.tenantId
    }
  }

  command remove() {
    guard self.deletedAt == null
    mutate removedAt = now()
    mutate deletedAt = now()
    emit StylePackagingRemoved {
      stylePackagingId: self.id
      tenantId: self.tenantId
    }
  }

  store StylePackaging in durable
}

// One piece of equipment a recipe needs (tilt skillet, immersion blender).
entity ComponentEquipment mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property indexed required componentId: uuid
  property required name: string = ""
  property sortOrder: int = 0
  property addedAt: datetime?

  belongsTo component: Component fields [tenantId, componentId] references [tenantId, id]

  constraint componentEquipmentName: self.addedAt == null or length(trim(self.name)) > 0 "Name the equipment."

  default policy componentEquipmentRead read: roleAllows(user.role, "staffAccess") "Staff may see recipe equipment"
  default policy componentEquipmentWrite write: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may update recipe equipment"
  default policy componentEquipmentExecute execute: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may change recipe equipment"

  command add(componentId: uuid, name: string, optional sortOrder: int) {
    guard self.addedAt == null
    mutate componentId = componentId
    mutate name = trim(name)
    mutate sortOrder = sortOrder != null ? sortOrder : 0
    mutate addedAt = now()
    emit ComponentEquipmentAdded {
      componentEquipmentId: self.id
      tenantId: self.tenantId
    }
  }

  command remove() {
    guard self.deletedAt == null
    mutate deletedAt = now()
    emit ComponentEquipmentRemoved {
      componentEquipmentId: self.id
      tenantId: self.tenantId
    }
  }

  store ComponentEquipment in durable
}

event StylePackagingAdded: "style_packaging.added" {
  stylePackagingId: string
  tenantId: string
}

event StylePackagingRevised: "style_packaging.revised" {
  stylePackagingId: string
  tenantId: string
}

event StylePackagingRemoved: "style_packaging.removed" {
  stylePackagingId: string
  tenantId: string
}

event ComponentEquipmentAdded: "component_equipment.added" {
  componentEquipmentId: string
  tenantId: string
}

event ComponentEquipmentRemoved: "component_equipment.removed" {
  componentEquipmentId: string
  tenantId: string
}
