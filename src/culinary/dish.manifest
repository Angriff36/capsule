// Revision-2 culinary model (2026-09-14). The link between a prep step and the
// food requirement(s) it acts on. Several steps may act on one requirement
// (cut potatoes, then par-steam the same potatoes) and one step may act on
// several requirements (dredge bacon in brown sugar). The step quantity is
// WORK; the requirement quantity is CONSUMPTION. Only requirements feed
// purchasing.
entity DishTaskMaterial mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required dishTaskId: uuid
  property dishIngredientId: uuid?
  property dishComponentId: uuid?
  property dishContainerId: uuid?
  property workQuantity: decimal(12, 4)?
  property workUnit: UnitOfMeasure?
  property linkedAt: datetime?

  belongsTo dishTask: DishTask fields [tenantId, dishTaskId] references [tenantId, id]
  belongsTo dishIngredient: DishIngredient fields [tenantId, dishIngredientId] references [tenantId, id]
  belongsTo dishComponent: DishComponent fields [tenantId, dishComponentId] references [tenantId, id]
  belongsTo dishContainer: DishContainer fields [tenantId, dishContainerId] references [tenantId, id]

  constraint materialHasTarget: self.linkedAt == null or self.dishIngredientId != null or self.dishComponentId != null or self.dishContainerId != null "A task material must point at a requirement"

  default policy dishTaskMaterialRead read: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may read task materials"
  default policy dishTaskMaterialWrite write: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may write task materials through commands"
  default policy dishTaskMaterialExecute execute: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may execute task material commands"

  command link(
    dishTaskId: uuid,
    optional dishIngredientId: uuid,
    optional dishComponentId: uuid,
    optional dishContainerId: uuid,
    optional workQuantity: decimal(12, 4),
    optional workUnit: UnitOfMeasure
  ) {
    guard self.linkedAt == null
    guard self.deletedAt == null
    constraint linkMaterialTarget: dishIngredientId != null or dishComponentId != null or dishContainerId != null "A task material must point at a requirement"
    constraint linkWorkQuantity: workQuantity == null or workQuantity > 0 "Work quantity must be positive"
    mutate dishTaskId = dishTaskId
    mutate dishIngredientId = dishIngredientId
    mutate dishComponentId = dishComponentId
    mutate dishContainerId = dishContainerId
    mutate workQuantity = workQuantity
    mutate workUnit = workUnit
    mutate linkedAt = now()
    emit DishTaskMaterialLinked {
      dishTaskMaterialId: self.id
      tenantId: self.tenantId
      dishTaskId: dishTaskId
      dishIngredientId: dishIngredientId
      dishComponentId: dishComponentId
      dishContainerId: dishContainerId
    }
  }

  command unlink(reason: string) {
    guard self.linkedAt != null
    guard self.deletedAt == null
    constraint unlinkMaterialReason: length(trim(reason)) > 0 "Reason is required"
    mutate deletedAt = now()
    emit DishTaskMaterialUnlinked {
      dishTaskMaterialId: self.id
      tenantId: self.tenantId
      dishTaskId: self.dishTaskId
      reason: reason
    }
  }

  store DishTaskMaterial in durable
}

event DishTaskMaterialLinked: "dish_task_material.linked" {
  dishTaskMaterialId: string
  tenantId: string
  dishTaskId: string
  dishIngredientId: string?
  dishComponentId: string?
  dishContainerId: string?
}

event DishTaskMaterialUnlinked: "dish_task_material.unlinked" {
  dishTaskMaterialId: string
  tenantId: string
  dishTaskId: string
  reason: string
}
