// Capsule culinary Dish — finished served product.
// A Dish is NOT a Component. It may compose many Components via DishComponent.
// Menu: menu.manifest. MenuDish: menu-dish.manifest. EventDish: event-dish.manifest.

use "./component.manifest"
use "./component-import.manifest"

enum DishStatus {
  active
  retired
}

entity Dish mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required searchable name: string = ""
  property description: string?
  // Kitchen recipe data is separate from the customer-facing description.
  property recipeInstructions: string?
  property recipeSourceText: string?
  property recipeSourceYield: string?
  property recipeSourceFingerprint: string?
  // Reusable service guidance is separate from recipe preparation; event-only
  // instructions remain on EventDish.
  property serviceInstructions: string?
  property serviceInstructionsSource: string?
  property category: string?
  property course: string?
  property serviceStyle: string?
  property required portionSize: decimal(10, 2) = 1
  property required portionUnit: UnitOfMeasure = "portion"
  property dietaryTags: list<string> = []
  // Stored on Dish so Convex schema matches existing documents. Multi-hop
  // Ingredient aggregation is maintained via classifyAllergens (not computed),
  // because dropping this property leaves orphan fields that fail schema validation.
  property allergenSummary: list<AllergenCode> = []
  property required status: DishStatus = "active"
  property introducedAt: datetime?
  property retiredAt: datetime?
  property retirementReason: string?
  // Convex storage id for the customer-facing hero image (upload via Attachment).
  property primaryImageStorageId: string?
  property primaryImageFileName: string?
  // Canonical lineage: null means this row is a canonical root; otherwise a version of that root.
  property canonicalDishId: uuid?
  // Optional so existing dish rows validate before backfill; UI treats null as 1.
  property editionNumber: int? = 1
  // Soft merge pointer — keep row for reference integrity; pickers prefer the target.
  property mergedIntoDishId: uuid?
  // Revision-2: food | supply | service | package. Null reads as food.
  property kind: DishKind?

  hasMany ingredientLines: DishIngredient
  hasMany componentLines: DishComponent
  hasMany prepTasks: DishTask
  belongsTo canonicalDish: Dish fields [tenantId, canonicalDishId] references [tenantId, id]
  belongsTo mergedIntoDish: Dish fields [tenantId, mergedIntoDishId] references [tenantId, id]

  computed isActive: boolean = self.status == "active"
  computed isRetired: boolean = self.status == "retired"
  computed isCanonicalRoot: boolean = self.canonicalDishId == null and self.mergedIntoDishId == null

  constraint dishIdentityComplete: self.introducedAt == null or length(trim(self.name)) > 0 "Introduced dishes require a name"
  constraint dishPortionPositive: self.introducedAt == null or self.portionSize > 0 "Dish portion size must be positive"

  transition status from "active" to ["retired"]
  transition status from "retired" to ["active"]

  // salesAccess: sales browses the published catalog for proposal menu
  // selection (sales/proposal-dish-selection.manifest).
  // Event managers compose package recipes as well as their event menu lines.
  default policy dishRead read: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "salesAccess") or roleAllows(user.role, "manageAccess") "Kitchen, sales and managers may read dishes"
  default policy dishWrite write: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may write dishes through commands"
  default policy dishExecute execute: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may execute dish commands"

  command introduce(
    name: string,
    portionSize: decimal(10, 2),
    portionUnit: UnitOfMeasure,
    optional description: string,
    optional category: string,
    optional course: string,
    optional serviceStyle: string,
    optional dietaryTags: list<string>,
    optional allergenSummary: list<AllergenCode>
  ) {
    guard self.introducedAt == null
    guard self.deletedAt == null
    constraint introduceDishName: length(trim(name)) > 0 "Dish name is required"
    constraint introduceDishPortion: portionSize > 0 "Dish portion size must be positive"
    mutate name = name
    mutate portionSize = portionSize
    mutate portionUnit = portionUnit
    mutate description = description
    mutate category = category
    mutate course = course
    mutate serviceStyle = serviceStyle
    mutate dietaryTags = dietaryTags != null ? dietaryTags : []
    mutate allergenSummary = allergenSummary != null ? allergenSummary : []
    mutate introducedAt = now()
    emit DishIntroduced {
      dishId: self.id
      tenantId: self.tenantId
      name: name
      portionSize: portionSize
      portionUnit: portionUnit
      allergenSummary: allergenSummary != null ? allergenSummary : []
    }
  }

  // Revision-2: what this row is. Supplies never enter food purchasing.
  command classifyKind(kind: DishKind) {
    guard self.deletedAt == null
    mutate kind = kind
    emit DishKindClassified {
      dishId: self.id
      tenantId: self.tenantId
      kind: kind
    }
  }

  command reviseDetails(
    name: string,
    optional description: string,
    optional category: string,
    optional course: string,
    optional serviceStyle: string,
    optional dietaryTags: list<string>
  ) {
    guard self.status == "active"
    guard self.deletedAt == null
    constraint reviseDishName: length(trim(name)) > 0 "Dish name is required"
    mutate name = name
    mutate description = description
    mutate category = category
    mutate course = course
    mutate serviceStyle = serviceStyle
    mutate dietaryTags = dietaryTags != null ? dietaryTags : self.dietaryTags
    emit DishDetailsRevised {
      dishId: self.id
      tenantId: self.tenantId
      name: name
    }
  }

  command saveRecipe(instructions: string, sourceText: string, sourceYield: string, sourceFingerprint: string) {
    guard self.status == "active"
    guard self.deletedAt == null
    mutate recipeInstructions = instructions
    mutate recipeSourceText = sourceText
    mutate recipeSourceYield = sourceYield
    mutate recipeSourceFingerprint = sourceFingerprint
    emit DishRecipeSaved {
      dishId: self.id
      tenantId: self.tenantId
      sourceFingerprint: sourceFingerprint
    }
  }

  command saveServiceInstructions(instructions: string, source: string) {
    guard self.status == "active"
    guard self.deletedAt == null
    constraint serviceInstructionsSourcePresent: length(trim(source)) > 0 "Service instruction source is required"
    mutate serviceInstructions = instructions
    mutate serviceInstructionsSource = source
    emit DishServiceInstructionsSaved {
      dishId: self.id
      tenantId: self.tenantId
      source: source
    }
  }

  command updatePortioning(portionSize: decimal(10, 2), portionUnit: UnitOfMeasure) {
    guard self.status == "active"
    guard self.deletedAt == null
    constraint updateDishPortion: portionSize > 0 "Dish portion size must be positive"
    compute previousPortionSize = self.portionSize
    compute previousPortionUnit = self.portionUnit
    mutate portionSize = portionSize
    mutate portionUnit = portionUnit
    emit DishPortioningUpdated {
      dishId: self.id
      tenantId: self.tenantId
      previousPortionSize: previousPortionSize
      previousPortionUnit: previousPortionUnit
      portionSize: portionSize
      portionUnit: portionUnit
    }
  }

  command classifyAllergens(allergenSummary: list<AllergenCode>) {
    guard self.status == "active"
    guard self.deletedAt == null
    mutate allergenSummary = allergenSummary
    emit DishAllergensClassified {
      dishId: self.id
      tenantId: self.tenantId
      allergenSummary: allergenSummary
    }
  }

  // Retire = remove from the kitchen book (soft-delete). Historical EventDish
  // references keep their dishId; the row is hidden from catalog pickers.
  // Reason is optional — catering ops should not be blocked by audit prompts.
  command retire(optional reason: string) {
    guard self.status == "active"
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenAccess")
    mutate status = "retired"
    mutate retiredAt = now()
    mutate retirementReason = reason != null ? reason : "Deleted"
    mutate deletedAt = now()
    emit DishRetired {
      dishId: self.id
      tenantId: self.tenantId
      reason: reason != null ? reason : "Deleted"
    }
  }

  command reinstate() {
    guard self.status == "retired"
    guard roleAllows(user.role, "kitchenAccess")
    mutate status = "active"
    mutate retiredAt = null
    mutate retirementReason = null
    mutate deletedAt = null
    emit DishReinstated {
      dishId: self.id
      tenantId: self.tenantId
    }
  }

  // One-click hide from the kitchen book. Works whether the row is still
  // active or already retired/merged without deletedAt — no restore dance.
  command purge() {
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenAccess")
    mutate status = "retired"
    mutate retiredAt = self.retiredAt != null ? self.retiredAt : now()
    mutate retirementReason = "Deleted"
    mutate deletedAt = now()
    emit DishPurged {
      dishId: self.id
      tenantId: self.tenantId
      reason: "Deleted"
    }
  }

  command setPrimaryImage(storageId: string, optional fileName: string) {
    guard self.status == "active"
    guard self.deletedAt == null
    constraint primaryImageStorage: length(trim(storageId)) > 0 "Primary image storage id is required"
    mutate primaryImageStorageId = storageId
    mutate primaryImageFileName = fileName
    emit DishPrimaryImageSet {
      dishId: self.id
      tenantId: self.tenantId
      storageId: storageId
    }
  }

  command clearPrimaryImage() {
    guard self.status == "active"
    guard self.deletedAt == null
    mutate primaryImageStorageId = null
    mutate primaryImageFileName = null
    emit DishPrimaryImageCleared {
      dishId: self.id
      tenantId: self.tenantId
    }
  }

  // Attach an already-introduced dish as an edition of a canonical root.
  // Birth stays on introduce so createViaIntroduce remains the catalog create path.
  command linkAsEdition(sourceDishId: uuid, optional editionNumber: int) {
    guard self.introducedAt != null
    guard self.deletedAt == null
    guard self.mergedIntoDishId == null
    constraint linkEditionSelf: sourceDishId != self.id "A dish cannot be an edition of itself"
    constraint linkEditionNumber: editionNumber == null or editionNumber > 0 "Edition number must be positive"
    mutate canonicalDishId = sourceDishId
    mutate editionNumber = editionNumber != null ? editionNumber : self.editionNumber
    emit DishEditionCreated {
      dishId: self.id
      tenantId: self.tenantId
      sourceDishId: sourceDishId
      name: self.name
      editionNumber: editionNumber != null ? editionNumber : self.editionNumber
    }
  }

  // Soft-merge into another dish: hide this row and point pickers at the survivor.
  command mergeInto(targetDishId: uuid, reason: string) {
    guard self.status == "active"
    guard self.deletedAt == null
    guard self.mergedIntoDishId == null
    constraint mergeIntoSelf: targetDishId != self.id "Cannot merge a dish into itself"
    constraint mergeIntoReason: length(trim(reason)) > 0 "Merge reason is required"
    mutate mergedIntoDishId = targetDishId
    mutate status = "retired"
    mutate retiredAt = now()
    mutate retirementReason = reason
    mutate deletedAt = now()
    emit DishMerged {
      dishId: self.id
      tenantId: self.tenantId
      targetDishId: targetDishId
      reason: reason
    }
  }

  store Dish in durable
}

// A dish's own ingredient line. The dish IS the recipe: a sirloin steak is a
// dish and its steak, salt and oil belong here, not on some separate record you
// have to create first. Only the parts you actually make by hand — the
// peppercorn sauce, the honey cinnamon butter — become Components with
// ingredient lines of their own.
//
// Quantity is PER SERVING, the same rule as DishTask.defaultQuantity, because
// that is how the printed sheets are costed ("P: 100 Serving").
entity DishIngredient mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required dishId: uuid
  property required ingredientId: uuid
  property required quantity: decimal(10, 4) = 0
  property required unit: UnitOfMeasure = "each"
  property required sortOrder: int = 0
  // Waste / trim multiplier (1.0 = no waste). Applied before live cost.
  property wasteFactor: decimal(10, 4)? = 1
  property prepNotes: string?
  // Revision-2: basis the per-portion quantity is stated in. Null means not
  // classified (Capsule-entered lines are purchase basis by construction);
  // an explicit "unknown" from import evidence blocks purchasing.
  property quantityBasis: QuantityBasis?
  property quantityBasisSource: string?
  property addedAt: datetime?

  belongsTo dish: Dish fields [tenantId, dishId] references [tenantId, id]
  belongsTo ingredient: Ingredient fields [tenantId, ingredientId] references [tenantId, id]

  computed adjustedQuantity: decimal(10, 4) = self.quantity * (self.wasteFactor != null ? self.wasteFactor : 1)
  computed unitsMatchIngredientPrice: boolean = self.unit == self.ingredient.unit
  computed liveIngredientCost: money(12, 2) = self.unit == self.ingredient.unit ? self.quantity * (self.wasteFactor != null ? self.wasteFactor : 1) * self.ingredient.costPerUnit : 0

  constraint dishLineQuantityPositive: self.addedAt == null or self.quantity > 0 "Dish ingredient quantity must be positive"
  constraint dishLineWasteFactorPositive: self.addedAt == null or self.wasteFactor == null or self.wasteFactor > 0 "Waste factor must be greater than 0"

  default policy dishIngredientRead read: roleAllows(user.role, "kitchenAccess") "Kitchen staff may read dish ingredient lines"
  default policy dishIngredientWrite write: roleAllows(user.role, "kitchenAccess") "Kitchen staff may write dish ingredient lines through commands"
  default policy dishIngredientExecute execute: roleAllows(user.role, "kitchenAccess") "Kitchen staff may execute dish ingredient line commands"

  command add(
    dishId: uuid,
    ingredientId: uuid,
    quantity: decimal(10, 4),
    unit: UnitOfMeasure,
    optional sortOrder: number,
    optional wasteFactor: decimal(10, 4),
    optional prepNotes: string
  ) {
    guard self.addedAt == null
    guard self.deletedAt == null
    constraint addDishLineQuantity: quantity > 0 "Dish ingredient quantity must be positive"
    constraint addDishLineWasteFactor: wasteFactor == null or wasteFactor > 0 "Waste factor must be greater than 0"
    mutate dishId = dishId
    mutate ingredientId = ingredientId
    mutate quantity = quantity
    mutate unit = unit
    mutate wasteFactor = wasteFactor != null ? wasteFactor : 1
    mutate sortOrder = sortOrder != null ? sortOrder : 0
    mutate prepNotes = prepNotes
    mutate addedAt = now()
    emit DishIngredientAdded {
      dishIngredientId: self.id
      tenantId: self.tenantId
      dishId: dishId
      ingredientId: ingredientId
      quantity: quantity
      unit: unit
      wasteFactor: wasteFactor != null ? wasteFactor : 1
    }
  }

  command adjustQuantity(quantity: decimal(10, 4), unit: UnitOfMeasure) {
    guard self.addedAt != null
    guard self.deletedAt == null
    constraint adjustDishLineQuantity: quantity > 0 "Dish ingredient quantity must be positive"
    compute previousQuantity = self.quantity
    mutate quantity = quantity
    mutate unit = unit
    emit DishIngredientQuantityAdjusted {
      dishIngredientId: self.id
      tenantId: self.tenantId
      dishId: self.dishId
      ingredientId: self.ingredientId
      previousQuantity: previousQuantity
      quantity: quantity
      unit: unit
    }
  }

  command remove(reason: string) {
    guard self.addedAt != null
    guard self.deletedAt == null
    constraint removeDishLineReason: length(trim(reason)) > 0 "Removal reason is required"
    mutate deletedAt = now()
    emit DishIngredientRemoved {
      dishIngredientId: self.id
      tenantId: self.tenantId
      dishId: self.dishId
      ingredientId: self.ingredientId
      reason: reason
    }
  }

  store DishIngredient in durable
}

// Dish ↔ Component composition line. One Dish may include many Components
// (e.g. Caesar salad → dressing component + crouton component).
entity DishComponent mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required dishId: uuid
  property required componentId: uuid
  property required sortOrder: int = 0
  // Snapshot of Component yield/batch at attach so EventDish→BOM reactions can
  // compute quantities without nested relation hydration on fanOut rows.
  property required yieldQuantity: decimal(10, 2) = 1
  property required batchMultiplier: decimal(10, 4) = 1
  property role: string?
  // Revision-2: a named output size of the recipe (10 oz dough ball) and how
  // many pieces one portion of this dish uses. Null = the plain yield path.
  property portionSpecId: uuid?
  property pieceCount: decimal(12, 4)?
  property quantityBasis: QuantityBasis?
  property attachedAt: datetime?
  property removedAt: datetime?

  belongsTo dish: Dish fields [tenantId, dishId] references [tenantId, id]
  belongsTo component: Component fields [tenantId, componentId] references [tenantId, id]
  belongsTo portionSpec: ComponentPortionSpec fields [tenantId, portionSpecId] references [tenantId, id]

  default policy dishComponentRead read: roleAllows(user.role, "kitchenAccess") "Kitchen staff may read dish component composition"
  default policy dishComponentWrite write: roleAllows(user.role, "kitchenAccess") "Kitchen staff may write dish component composition through commands"
  default policy dishComponentExecute execute: roleAllows(user.role, "kitchenAccess") "Kitchen staff may execute dish component composition commands"

  command attach(
    dishId: uuid,
    componentId: uuid,
    yieldQuantity: decimal(10, 2),
    optional batchMultiplier: decimal(10, 4),
    optional sortOrder: number,
    optional role: string
  ) {
    guard self.attachedAt == null
    guard self.deletedAt == null
    guard self.dish != null and self.dish.status == "active"
    constraint attachDishMatch: dishId == self.dishId "Attach dishId must match the seeded dish reference"
    constraint attachYieldPositive: yieldQuantity > 0 "Attached component yield must be positive"
    constraint attachBatchPositive: batchMultiplier == null or batchMultiplier > 0 "Attached component batch multiplier must be positive"
    mutate dishId = dishId
    mutate componentId = componentId
    mutate yieldQuantity = yieldQuantity
    mutate batchMultiplier = batchMultiplier != null ? batchMultiplier : 1
    mutate sortOrder = sortOrder != null ? sortOrder : 0
    mutate role = role
    mutate attachedAt = now()
    emit DishComponentAttached {
      dishComponentId: self.id
      tenantId: self.tenantId
      dishId: dishId
      componentId: componentId
      yieldQuantity: yieldQuantity
      batchMultiplier: batchMultiplier != null ? batchMultiplier : 1
      sortOrder: sortOrder != null ? sortOrder : 0
      role: role
    }
  }

  // Point this usage at a portion spec (pieces per portion) instead of the
  // plain yield. pieceCount is the per-portion piece count as recorded (3.15
  // stays 3.15; rounding is a separate, scoped rule).
  command setPortionSpec(portionSpecId: uuid, pieceCount: decimal(12, 4), optional quantityBasis: QuantityBasis) {
    guard self.attachedAt != null
    guard self.deletedAt == null
    constraint portionSpecPiecesPositive: pieceCount > 0 "Pieces per portion must be positive"
    mutate portionSpecId = portionSpecId
    mutate pieceCount = pieceCount
    mutate quantityBasis = quantityBasis != null ? quantityBasis : self.quantityBasis
    emit DishComponentPortionSpecSet {
      dishComponentId: self.id
      tenantId: self.tenantId
      dishId: self.dishId
      componentId: self.componentId
      portionSpecId: portionSpecId
      pieceCount: pieceCount
    }
  }

  command detach(reason: string) {
    guard self.attachedAt != null
    guard self.deletedAt == null
    constraint detachReason: length(trim(reason)) > 0 "Detach reason is required"
    mutate deletedAt = now()
    mutate removedAt = now()
    emit DishComponentDetached {
      dishComponentId: self.id
      tenantId: self.tenantId
      dishId: self.dishId
      componentId: self.componentId
      reason: reason
    }
  }

  store DishComponent in durable
}

enum DishTaskStatus {
  active
  retired
}

// Revision-2 culinary model (2026-09-14). "event" is a reserved word, so the
// on-site stage is spelled at_event.
enum DishTaskStage {
  kitchen
  at_event
  pack
}

// resolved = the step is fully specified. choice_pending = the source says
// "make OR portion" (or chef's choice) and nobody has picked. content_missing =
// the step points at a recipe with no ingredients or no method on file.
enum TaskResolution {
  resolved
  choice_pending
  content_missing
}

// What a Dish row IS. Supplies (plasticware, place settings) and packages
// print as dish headings on the sheet but must never enter food purchasing.
enum DishKind {
  food
  supply
  service
  package
}

// Reusable work instruction for preparing or serving a Dish. This is a
// template only; Event-specific work is represented by PrepTask.
entity DishTask mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required dishId: uuid
  // Conditional-cascade key: mirrors dishId while this step is active, null once
  // retired. EventDishAdded fans out on THIS field so a retired step stops
  // generating prep tasks — fanOut takes a single predicate, so the filter has
  // to live in the key. Same trick as IngredientDemand.purchaseEligibleEventId.
  property indexed activeDishId: uuid?
  property required searchable name: string = ""
  property required category: string = "finish_at_event"
  property required taskType: string = "manual"
  property defaultQuantity: decimal(12, 4)?
  property defaultUnit: UnitOfMeasure?
  // Where the work happens ("Apps - Passed - Finish at Event", "Finish at
  // Kitchen"). Real prep sheets group by this; PrepTask carries the same field.
  property station: string?
  property sortOrder: int = 0
  property componentId: uuid?
  property ingredientId: uuid?
  property instructions: string?
  // Revision-2 work specification. All optional so existing rows validate;
  // null stage/resolution read as kitchen/resolved on the sheet.
  property stage: DishTaskStage?
  property resolution: TaskResolution?
  property choiceOptions: list<string>?
  property leadTimeMinDays: int?
  property leadTimeMaxDays: int?
  property sequenceAfterDishTaskId: uuid?
  property stationId: uuid?
  property required status: DishTaskStatus = "active"
  property activeAt: datetime?
  property retiredAt: datetime?
  property retirementReason: string?

  belongsTo dish: Dish fields [tenantId, dishId] references [tenantId, id]
  belongsTo component: Component fields [tenantId, componentId] references [tenantId, id]
  belongsTo ingredient: Ingredient fields [tenantId, ingredientId] references [tenantId, id]
  hasMany materials: DishTaskMaterial

  constraint dishTaskNameComplete: self.status == "retired" or length(trim(self.name)) > 0 "Dish task name is required"
  constraint dishTaskQuantityPositive: self.defaultQuantity == null or self.defaultQuantity > 0 "Dish task quantity must be positive"
  constraint dishTaskSortNonnegative: self.sortOrder >= 0 "Dish task sort order cannot be negative"

  transition status from "active" to ["retired"]
  transition status from "retired" to ["active"]

  default policy dishTaskRead read: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may read dish task templates"
  default policy dishTaskWrite write: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may write dish task templates through commands"
  default policy dishTaskExecute execute: roleAllows(user.role, "kitchenAccess") or roleAllows(user.role, "manageAccess") "Kitchen staff and managers may execute dish task template commands"

  command add(
    dishId: uuid,
    name: string,
    optional category: string,
    optional taskType: string,
    optional defaultQuantity: decimal(12, 4),
    optional defaultUnit: UnitOfMeasure,
    optional station: string,
    optional sortOrder: number,
    optional componentId: uuid,
    optional ingredientId: uuid,
    optional instructions: string,
    // Batched source repair links existing work before materializing missing rows.
    optional synchronizePrep: boolean
  ) {
    guard self.status == "active"
    guard self.deletedAt == null
    guard self.dish != null and self.dish.status == "active"
    constraint addDishMatch: dishId == self.dishId "Dish task dishId must match the seeded Dish reference"
    constraint addNamePresent: length(trim(name)) > 0 "Dish task name is required"
    constraint addQuantityPositive: defaultQuantity == null or defaultQuantity > 0 "Dish task quantity must be positive"
    constraint addSortNonnegative: sortOrder == null or sortOrder >= 0 "Dish task sort order cannot be negative"
    mutate dishId = dishId
    mutate activeDishId = dishId
    mutate name = name
    mutate category = category != null ? category : "finish_at_event"
    mutate taskType = taskType != null ? taskType : "manual"
    mutate defaultQuantity = defaultQuantity
    mutate defaultUnit = defaultUnit
    mutate station = station
    mutate sortOrder = sortOrder != null ? sortOrder : 0
    mutate componentId = componentId
    mutate ingredientId = ingredientId
    mutate instructions = instructions
    mutate activeAt = now()
    compute syncPrepRequested = synchronizePrep != null ? synchronizePrep : true
    emit DishTaskAdded {
      synchronizePrep: syncPrepRequested
      dishTaskId: self.id
      tenantId: self.tenantId
      dishId: dishId
      name: name
      category: category != null ? category : "finish_at_event"
      taskType: taskType != null ? taskType : "manual"
      componentId: componentId
      ingredientId: ingredientId
      defaultQuantity: defaultQuantity
      defaultUnit: defaultUnit
      sortOrder: sortOrder != null ? sortOrder : 0
    }
  }

  command revise(
    name: string,
    optional category: string,
    optional taskType: string,
    optional defaultQuantity: decimal(12, 4),
    optional defaultUnit: UnitOfMeasure,
    optional station: string,
    optional sortOrder: number,
    optional componentId: uuid,
    optional ingredientId: uuid,
    optional instructions: string,
    // Batched source repair links existing work before materializing missing rows.
    optional synchronizePrep: boolean
  ) {
    guard self.status == "active"
    guard self.deletedAt == null
    guard self.dish != null and self.dish.status == "active"
    constraint reviseNamePresent: length(trim(name)) > 0 "Dish task name is required"
    constraint reviseQuantityPositive: defaultQuantity == null or defaultQuantity > 0 "Dish task quantity must be positive"
    constraint reviseSortNonnegative: sortOrder == null or sortOrder >= 0 "Dish task sort order cannot be negative"
    mutate name = name
    mutate category = category != null ? category : self.category
    mutate taskType = taskType != null ? taskType : self.taskType
    mutate defaultQuantity = defaultQuantity
    mutate defaultUnit = defaultUnit
    mutate station = station
    mutate sortOrder = sortOrder != null ? sortOrder : self.sortOrder
    mutate componentId = componentId
    mutate ingredientId = ingredientId
    mutate instructions = instructions
    compute syncPrepRequested = synchronizePrep != null ? synchronizePrep : true
    emit DishTaskRevised {
      synchronizePrep: syncPrepRequested
      dishTaskId: self.id
      tenantId: self.tenantId
      dishId: self.dishId
      name: name
      category: self.category
      taskType: self.taskType
    }
  }

  // Revision-2 work specification: stage, sequence, lead time, station and
  // choice state. Every field keeps its stored value when omitted.
  command specifyWork(
    optional stage: DishTaskStage,
    optional resolution: TaskResolution,
    optional choiceOptions: list<string>,
    optional leadTimeMinDays: int,
    optional leadTimeMaxDays: int,
    optional sequenceAfterDishTaskId: uuid,
    optional stationId: uuid
  ) {
    guard self.status == "active"
    guard self.deletedAt == null
    constraint specifyLeadTimeNonnegative: (leadTimeMinDays == null or leadTimeMinDays >= 0) and (leadTimeMaxDays == null or leadTimeMaxDays >= 0) "Lead time cannot be negative"
    constraint specifySequenceNotSelf: sequenceAfterDishTaskId == null or sequenceAfterDishTaskId != self.id "A step cannot follow itself"
    mutate stage = stage != null ? stage : self.stage
    mutate resolution = resolution != null ? resolution : self.resolution
    mutate choiceOptions = choiceOptions != null ? choiceOptions : self.choiceOptions
    mutate leadTimeMinDays = leadTimeMinDays != null ? leadTimeMinDays : self.leadTimeMinDays
    mutate leadTimeMaxDays = leadTimeMaxDays != null ? leadTimeMaxDays : self.leadTimeMaxDays
    mutate sequenceAfterDishTaskId = sequenceAfterDishTaskId != null ? sequenceAfterDishTaskId : self.sequenceAfterDishTaskId
    mutate stationId = stationId != null ? stationId : self.stationId
    emit DishTaskWorkSpecified {
      dishTaskId: self.id
      tenantId: self.tenantId
      dishId: self.dishId
      stage: stage != null ? stage : self.stage
      resolution: resolution != null ? resolution : self.resolution
    }
  }

  command retire(reason: string) {
    guard self.status == "active"
    guard self.deletedAt == null
    constraint retireReasonPresent: length(trim(reason)) > 0 "Dish task retirement reason is required"
    mutate retiredAt = now()
    mutate retirementReason = reason
    mutate status = "retired"
    mutate activeDishId = null
    emit DishTaskRetired {
      dishTaskId: self.id
      tenantId: self.tenantId
      dishId: self.dishId
      reason: reason
    }
  }

  // Compat for templates added before activeDishId existed. Soft mutate — no
  // guards that can fail, so it can never roll back the EventDishAdded that
  // triggers it. Wired as a fanOut ahead of PrepTask generation.
  command backfillActiveKey() {
    mutate activeDishId = (self.deletedAt == null and self.status == "active" and self.activeDishId == null) ? self.dishId : self.activeDishId
  }

  store DishTask in durable
}

