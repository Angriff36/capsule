// Capsule culinary recipes — Recipe, RecipeStep (method), RecipeIngredient (BOM).
// A Recipe is a make-formula, not a finished Dish. Dishes compose Recipes via DishRecipe.

use "./ingredient.manifest"

enum RecipeStatus {
  draft
  published
  retired
}

entity Recipe mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required searchable name: string = ""
  property category: string?
  property cuisine: string?
  property description: string?
  property instructions: string?
  property required versionNumber: int = 1
  property required yieldQuantity: decimal(10, 2) = 1
  property required yieldUnit: UnitOfMeasure = "portion"
  // Guests served by one yieldQuantity batch (e.g. 1 gallon lemonade → 5 people).
  // Optional so pre-field Recipe rows validate under Convex schema push.
  property servesPerYield: int? = 1
  property batchMultiplier: decimal(10, 4)? = 1
  property required status: RecipeStatus = "draft"
  property draftedAt: datetime?
  property publishedAt: datetime?
  property retiredAt: datetime?
  property retirementReason: string?

  hasMany steps: RecipeStep
  hasMany ingredientLines: RecipeIngredient

  computed isPublished: boolean = self.status == "published"
  computed isEditable: boolean = self.status == "draft"
  // Live batch cost from non-deleted ingredient lines (Ingredient.costPerUnit).
  // Inlined line cost (not line.liveIngredientCost) so Convex projection can emit one expression.
  computed liveBatchCost: money(12, 2) = sum(filter(self.ingredientLines, (line) => line.deletedAt == null and line.addedAt != null), (line) => line.unit == line.ingredient.unit ? line.quantity * (line.wasteFactor != null ? line.wasteFactor : 1) * line.ingredient.costPerUnit : 0)
  computed liveCostPerGuest: money(12, 2) = self.servesPerYield > 0 ? sum(filter(self.ingredientLines, (line) => line.deletedAt == null and line.addedAt != null), (line) => line.unit == line.ingredient.unit ? line.quantity * (line.wasteFactor != null ? line.wasteFactor : 1) * line.ingredient.costPerUnit : 0) / self.servesPerYield : 0

  constraint recipeIdentityComplete: self.draftedAt == null or length(trim(self.name)) > 0 "Drafted recipes require a name"
  constraint recipeYieldPositive: self.yieldQuantity > 0 "Recipe yield quantity must be positive"
  constraint recipeServesPerYieldPositive: self.servesPerYield > 0 "Serves per yield must be a positive integer"
  constraint recipeBatchPositive: self.batchMultiplier > 0 "Recipe batch multiplier must be positive"

  transition status from "draft" to ["published", "retired"]
  transition status from "published" to ["draft", "retired"]
  transition status from "retired" to []

  default policy recipeRead read: roleAllows(user.role, "kitchenAccess") "Kitchen staff may read recipes"
  default policy recipeWrite write: roleAllows(user.role, "kitchenAccess") "Kitchen staff may write recipes through commands"
  default policy recipeExecute execute: roleAllows(user.role, "kitchenAccess") "Kitchen staff may execute recipe commands"

  command draft(
    name: string,
    yieldQuantity: decimal(10, 2),
    yieldUnit: UnitOfMeasure,
    optional servesPerYield: int,
    optional batchMultiplier: decimal(10, 4),
    optional category: string,
    optional cuisine: string,
    optional description: string,
    optional instructions: string
  ) {
    guard self.draftedAt == null
    guard self.deletedAt == null
    constraint draftRecipeName: length(trim(name)) > 0 "Recipe name is required"
    constraint draftYieldPositive: yieldQuantity > 0 "Recipe yield quantity must be positive"
    constraint draftServesPerYieldPositive: servesPerYield == null or servesPerYield > 0 "Serves per yield must be a positive integer"
    constraint draftBatchPositive: batchMultiplier == null or batchMultiplier > 0 "Recipe batch multiplier must be positive"
    mutate name = name
    mutate yieldQuantity = yieldQuantity
    mutate yieldUnit = yieldUnit
    mutate servesPerYield = servesPerYield != null ? servesPerYield : 1
    mutate batchMultiplier = batchMultiplier != null ? batchMultiplier : 1
    mutate category = category
    mutate cuisine = cuisine
    mutate description = description
    mutate instructions = instructions
    mutate versionNumber = 1
    mutate draftedAt = now()
    emit RecipeDrafted {
      recipeId: self.id
      tenantId: self.tenantId
      name: name
      yieldQuantity: yieldQuantity
      yieldUnit: yieldUnit
      servesPerYield: servesPerYield != null ? servesPerYield : 1
      batchMultiplier: batchMultiplier != null ? batchMultiplier : 1
      versionNumber: 1
    }
  }

  command reviseDraft(
    name: string,
    yieldQuantity: decimal(10, 2),
    yieldUnit: UnitOfMeasure,
    batchMultiplier: decimal(10, 4),
    optional servesPerYield: int,
    optional category: string,
    optional cuisine: string,
    optional description: string,
    optional instructions: string
  ) {
    guard self.status == "draft"
    guard self.deletedAt == null
    constraint reviseRecipeName: length(trim(name)) > 0 "Recipe name is required"
    constraint reviseYieldPositive: yieldQuantity > 0 "Recipe yield quantity must be positive"
    constraint reviseServesPerYieldPositive: servesPerYield == null or servesPerYield > 0 "Serves per yield must be a positive integer"
    constraint reviseBatchPositive: batchMultiplier > 0 "Recipe batch multiplier must be positive"
    mutate name = name
    mutate yieldQuantity = yieldQuantity
    mutate yieldUnit = yieldUnit
    mutate servesPerYield = servesPerYield != null ? servesPerYield : self.servesPerYield
    mutate batchMultiplier = batchMultiplier
    mutate category = category
    mutate cuisine = cuisine
    mutate description = description
    mutate instructions = instructions
    emit RecipeDraftRevised {
      recipeId: self.id
      tenantId: self.tenantId
      name: name
      yieldQuantity: yieldQuantity
      yieldUnit: yieldUnit
      servesPerYield: servesPerYield != null ? servesPerYield : self.servesPerYield
      batchMultiplier: batchMultiplier
      versionNumber: self.versionNumber
    }
  }

  // How many guests one yieldQuantity batch serves.
  command setServesPerYield(servesPerYield: int) {
    guard self.deletedAt == null
    constraint setServesPerYieldPositive: servesPerYield > 0 "Serves per yield must be a positive integer"
    mutate servesPerYield = servesPerYield
    emit RecipeServesPerYieldSet {
      recipeId: self.id
      tenantId: self.tenantId
      servesPerYield: servesPerYield
    }
  }

  command publishVersion() {
    guard self.status == "draft"
    guard self.draftedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenManageAccess")
    mutate status = "published"
    mutate publishedAt = now()
    emit RecipeVersionPublished {
      recipeId: self.id
      tenantId: self.tenantId
      versionNumber: self.versionNumber
      yieldQuantity: self.yieldQuantity
      yieldUnit: self.yieldUnit
      batchMultiplier: self.batchMultiplier
    }
  }

  command retract() {
    guard self.status == "published"
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenManageAccess")
    compute nextVersion = self.versionNumber + 1
    mutate status = "draft"
    mutate publishedAt = null
    mutate versionNumber = nextVersion
    emit RecipeVersionRetracted {
      recipeId: self.id
      tenantId: self.tenantId
      versionNumber: nextVersion
    }
  }

  // Retire = remove from the kitchen book (soft-delete). Reason optional.
  command retire(optional reason: string) {
    guard self.status == "draft" or self.status == "published"
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenManageAccess")
    mutate status = "retired"
    mutate retiredAt = now()
    mutate retirementReason = reason != null ? reason : "Deleted"
    mutate deletedAt = now()
    emit RecipeRetired {
      recipeId: self.id
      tenantId: self.tenantId
      reason: reason != null ? reason : "Deleted"
    }
  }

  // One-click hide from any non-deleted status — no restore dance.
  command purge() {
    guard self.deletedAt == null
    guard roleAllows(user.role, "kitchenManageAccess")
    mutate status = "retired"
    mutate retiredAt = self.retiredAt != null ? self.retiredAt : now()
    mutate retirementReason = "Deleted"
    mutate deletedAt = now()
    emit RecipePurged {
      recipeId: self.id
      tenantId: self.tenantId
      reason: "Deleted"
    }
  }

  store Recipe in durable
}

entity RecipeIngredient mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required recipeId: uuid
  property required ingredientId: uuid
  property required quantity: decimal(10, 4) = 0
  property required unit: UnitOfMeasure = "each"
  property required sortOrder: int = 0
  // Waste / trim multiplier (1.0 = no waste). Applied before live cost.
  // Optional so pre-field RecipeIngredient rows validate under Convex schema push.
  property wasteFactor: decimal(10, 4)? = 1
  property prepNotes: string?
  property addedAt: datetime?

  belongsTo recipe: Recipe fields [tenantId, recipeId] references [tenantId, id]
  belongsTo ingredient: Ingredient fields [tenantId, ingredientId] references [tenantId, id]

  computed adjustedQuantity: decimal(10, 4) = self.quantity * (self.wasteFactor != null ? self.wasteFactor : 1)
  // Capsule prices recipes from Ingredient.costPerUnit (catalog). Same-unit
  // only — do not silently multiply incompatible UnitOfMeasure values.
  // Cross-unit conversion remains in RecipeCostCalculator until Manifest owns factors.
  computed unitsMatchIngredientPrice: boolean = self.unit == self.ingredient.unit
  computed liveIngredientCost: money(12, 2) = self.unit == self.ingredient.unit ? self.quantity * (self.wasteFactor != null ? self.wasteFactor : 1) * self.ingredient.costPerUnit : 0

  constraint lineQuantityPositive: self.addedAt == null or self.quantity > 0 "Recipe ingredient quantity must be positive"
  constraint lineWasteFactorPositive: self.addedAt == null or self.wasteFactor == null or self.wasteFactor > 0 "Waste factor must be greater than 0"

  default policy recipeIngredientRead read: roleAllows(user.role, "kitchenAccess") "Kitchen staff may read recipe ingredient lines"
  default policy recipeIngredientWrite write: roleAllows(user.role, "kitchenAccess") "Kitchen staff may write recipe ingredient lines through commands"
  default policy recipeIngredientExecute execute: roleAllows(user.role, "kitchenAccess") "Kitchen staff may execute recipe ingredient line commands"

  command add(
    recipeId: uuid,
    ingredientId: uuid,
    quantity: decimal(10, 4),
    unit: UnitOfMeasure,
    optional sortOrder: number,
    optional wasteFactor: decimal(10, 4),
    optional prepNotes: string
  ) {
    guard self.addedAt == null
    guard self.deletedAt == null
    constraint addLineQuantity: quantity > 0 "Recipe ingredient quantity must be positive"
    constraint addLineWasteFactor: wasteFactor == null or wasteFactor > 0 "Waste factor must be greater than 0"
    mutate recipeId = recipeId
    mutate ingredientId = ingredientId
    mutate quantity = quantity
    mutate unit = unit
    mutate wasteFactor = wasteFactor != null ? wasteFactor : 1
    mutate sortOrder = sortOrder != null ? sortOrder : 0
    mutate prepNotes = prepNotes
    mutate addedAt = now()
    emit RecipeIngredientAdded {
      recipeIngredientId: self.id
      tenantId: self.tenantId
      recipeId: recipeId
      ingredientId: ingredientId
      quantity: quantity
      unit: unit
      wasteFactor: wasteFactor != null ? wasteFactor : 1
    }
  }

  command setWasteFactor(wasteFactor: decimal(10, 4)) {
    guard self.addedAt != null
    guard self.deletedAt == null
    constraint setWasteFactorPositive: wasteFactor > 0 "Waste factor must be greater than 0"
    mutate wasteFactor = wasteFactor
    emit RecipeIngredientWasteFactorSet {
      recipeIngredientId: self.id
      tenantId: self.tenantId
      recipeId: self.recipeId
      ingredientId: self.ingredientId
      wasteFactor: wasteFactor
    }
  }

  command adjustQuantity(quantity: decimal(10, 4), unit: UnitOfMeasure) {
    guard self.addedAt != null
    guard self.deletedAt == null
    constraint adjustLineQuantity: quantity > 0 "Recipe ingredient quantity must be positive"
    compute previousQuantity = self.quantity
    compute previousUnit = self.unit
    mutate quantity = quantity
    mutate unit = unit
    emit RecipeIngredientQuantityAdjusted {
      recipeIngredientId: self.id
      tenantId: self.tenantId
      recipeId: self.recipeId
      ingredientId: self.ingredientId
      previousQuantity: previousQuantity
      previousUnit: previousUnit
      quantity: quantity
      unit: unit
    }
  }

  command remove(reason: string) {
    guard self.addedAt != null
    guard self.deletedAt == null
    constraint removeLineReason: length(trim(reason)) > 0 "Removal reason is required"
    mutate deletedAt = now()
    emit RecipeIngredientRemoved {
      recipeIngredientId: self.id
      tenantId: self.tenantId
      recipeId: self.recipeId
      ingredientId: self.ingredientId
      quantity: self.quantity
      unit: self.unit
      reason: reason
    }
  }

  store RecipeIngredient in durable
}

// Ordered method step on a Recipe (e.g. "Combine oil with anchovies").
entity RecipeStep mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required recipeId: uuid
  property required searchable instruction: string = ""
  property required sortOrder: int = 0
  property durationMinutes: int?
  property addedAt: datetime?

  belongsTo recipe: Recipe fields [tenantId, recipeId] references [tenantId, id]

  constraint stepInstructionComplete: self.addedAt == null or length(trim(self.instruction)) > 0 "Recipe steps require an instruction"

  default policy recipeStepRead read: roleAllows(user.role, "kitchenAccess") "Kitchen staff may read recipe steps"
  default policy recipeStepWrite write: roleAllows(user.role, "kitchenAccess") "Kitchen staff may write recipe steps through commands"
  default policy recipeStepExecute execute: roleAllows(user.role, "kitchenAccess") "Kitchen staff may execute recipe step commands"

  command add(
    recipeId: uuid,
    instruction: string,
    optional sortOrder: number,
    optional durationMinutes: number
  ) {
    guard self.addedAt == null
    guard self.deletedAt == null
    constraint addStepInstruction: length(trim(instruction)) > 0 "Recipe step instruction is required"
    constraint addStepDuration: durationMinutes == null or durationMinutes >= 0 "Recipe step duration cannot be negative"
    mutate recipeId = recipeId
    mutate instruction = instruction
    mutate sortOrder = sortOrder != null ? sortOrder : 0
    mutate durationMinutes = durationMinutes
    mutate addedAt = now()
    emit RecipeStepAdded {
      recipeStepId: self.id
      tenantId: self.tenantId
      recipeId: recipeId
      instruction: instruction
      sortOrder: sortOrder != null ? sortOrder : 0
    }
  }

  command revise(
    instruction: string,
    optional sortOrder: number,
    optional durationMinutes: number
  ) {
    guard self.addedAt != null
    guard self.deletedAt == null
    constraint reviseStepInstruction: length(trim(instruction)) > 0 "Recipe step instruction is required"
    constraint reviseStepDuration: durationMinutes == null or durationMinutes >= 0 "Recipe step duration cannot be negative"
    mutate instruction = instruction
    mutate sortOrder = sortOrder != null ? sortOrder : self.sortOrder
    mutate durationMinutes = durationMinutes
    emit RecipeStepRevised {
      recipeStepId: self.id
      tenantId: self.tenantId
      recipeId: self.recipeId
      instruction: instruction
      sortOrder: sortOrder != null ? sortOrder : self.sortOrder
    }
  }

  command remove(reason: string) {
    guard self.addedAt != null
    guard self.deletedAt == null
    constraint removeStepReason: length(trim(reason)) > 0 "Removal reason is required"
    mutate deletedAt = now()
    emit RecipeStepRemoved {
      recipeStepId: self.id
      tenantId: self.tenantId
      recipeId: self.recipeId
      reason: reason
    }
  }

  store RecipeStep in durable
}

event RecipeDrafted: "recipe.drafted" {
  recipeId: string
  tenantId: string
  name: string
  yieldQuantity: decimal(10, 2)
  yieldUnit: UnitOfMeasure
  servesPerYield: int
  batchMultiplier: decimal(10, 4)
  versionNumber: number
}

event RecipeDraftRevised: "recipe.draft_revised" {
  recipeId: string
  tenantId: string
  name: string
  yieldQuantity: decimal(10, 2)
  yieldUnit: UnitOfMeasure
  servesPerYield: int
  batchMultiplier: decimal(10, 4)
  versionNumber: number
}

event RecipeServesPerYieldSet: "recipe.serves_per_yield_set" {
  recipeId: string
  tenantId: string
  servesPerYield: int
}

event RecipeVersionPublished: "recipe.version_published" {
  recipeId: string
  tenantId: string
  versionNumber: number
  yieldQuantity: decimal(10, 2)
  yieldUnit: UnitOfMeasure
  batchMultiplier: decimal(10, 4)
}

event RecipeVersionRetracted: "recipe.version_retracted" {
  recipeId: string
  tenantId: string
  versionNumber: number
}

event RecipeRetired: "recipe.retired" {
  recipeId: string
  tenantId: string
  reason: string
}

event RecipePurged: "recipe.purged" {
  recipeId: string
  tenantId: string
  reason: string
}

event RecipeIngredientAdded: "recipe_ingredient.added" {
  recipeIngredientId: string
  tenantId: string
  recipeId: string
  ingredientId: string
  quantity: decimal(10, 4)
  unit: UnitOfMeasure
  wasteFactor: decimal(10, 4)
}

event RecipeIngredientWasteFactorSet: "recipe_ingredient.waste_factor_set" {
  recipeIngredientId: string
  tenantId: string
  recipeId: string
  ingredientId: string
  wasteFactor: decimal(10, 4)
}

event RecipeIngredientQuantityAdjusted: "recipe_ingredient.quantity_adjusted" {
  recipeIngredientId: string
  tenantId: string
  recipeId: string
  ingredientId: string
  previousQuantity: decimal(10, 4)
  previousUnit: UnitOfMeasure
  quantity: decimal(10, 4)
  unit: UnitOfMeasure
}

event RecipeIngredientRemoved: "recipe_ingredient.removed" {
  recipeIngredientId: string
  tenantId: string
  recipeId: string
  ingredientId: string
  quantity: decimal(10, 4)
  unit: UnitOfMeasure
  reason: string
}

event RecipeStepAdded: "recipe_step.added" {
  recipeStepId: string
  tenantId: string
  recipeId: string
  instruction: string
  sortOrder: number
}

event RecipeStepRevised: "recipe_step.revised" {
  recipeStepId: string
  tenantId: string
  recipeId: string
  instruction: string
  sortOrder: number
}

event RecipeStepRemoved: "recipe_step.removed" {
  recipeStepId: string
  tenantId: string
  recipeId: string
  reason: string
}
