// Capsule facilities — owned and rented kitchen/service equipment, including
// event reservations and the outbound/return condition record.

use "../foundation/base.manifest"

enum EquipmentOwnership {
  owned
  rented
}

enum EquipmentCondition {
  excellent
  good
  fair
  poor
  out_of_service
}

enum EquipmentStatus {
  active
  retired
}

// serialized = one tagged piece with its own serial (a warmer, a generator);
// bulk = a counted pool (200 chairs, 40 linens). PL-ASSET-CATALOG (AC-339).
enum EquipmentTracking {
  serialized
  bulk
}

// How a piece joins a catalog line: a bundle part always goes with it (the
// lid of a chafer), an accessory is offered with it (a sterno stand).
enum EquipmentPartRole {
  part
  accessory
}

enum EquipmentReservationStatus {
  reserved
  checked_out
  returned
  cancelled
}

// One catalog line per asset (or pooled asset group, e.g. 200 linens).
// category stays an open string until a closed catalog is evidenced
// (same posture as StorageLocation.locationType).
entity Equipment mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  unique [tenantId, assetTag]
  timestamps
  versionProperty version: number

  property required searchable name: string = ""
  property required assetTag: string = ""
  property required category: string = ""
  property required ownership: EquipmentOwnership = "owned"
  property required quantity: int = 1
  property required purchaseValue: money(12, 2) = 0
  property required condition: EquipmentCondition = "good"
  property required status: EquipmentStatus = "active"
  property conditionNote: string?
  property homeLocation: string?
  property currentLocation: string?
  property registeredAt: datetime?
  property retiredAt: datetime?
  property retirementReason: string?
  // PL-ASSET-CATALOG (AC-339, AC-545): the rental catalog facts.
  // Optional so rows saved before these facts existed stay valid; empty
  // tracking reads as bulk, empty unit as "each", empty money as not set.
  property trackingMode: EquipmentTracking?
  property serialNumber: string?
  property description: string?
  // What one counts as ("each", "set of 10", "case of 25").
  property countUnit: string?
  // What it costs to replace one if it is lost or broken.
  property replacementCost: money(12, 2)?
  // What a client pays to rent one for an event.
  property customerPrice: money(12, 2)?
  // Who we rent it from when ownership is rented.
  property vendorId: uuid?
  property indexed primaryImageStorageId: string?
  property primaryImageFileName: string?

  belongsTo vendor: Vendor fields [tenantId, vendorId] references [tenantId, id]
  hasMany reservations: EquipmentReservation
  hasMany maintenanceTasks: EquipmentMaintenanceTask

  computed isActive: boolean = self.status == "active"
  computed totalValue: money(12, 2) = self.quantity * self.purchaseValue

  constraint equipmentQuantityNonnegative: self.quantity >= 0 "This equipment's amount on hand can't be negative. Use zero or more."
  constraint equipmentValueNonnegative: self.purchaseValue >= 0 "This equipment's purchase value can't be negative. Use zero or more."
  constraint equipmentPricesNonnegative: (self.replacementCost == null or self.replacementCost >= 0) and (self.customerPrice == null or self.customerPrice >= 0) "Replacement cost and client price can't be negative. Use zero or more."
  constraint equipmentSerializedSingle: self.trackingMode != "serialized" or self.quantity <= 1 "A piece tracked by serial number is one piece. Count it as 1, or 0 if it is lost. Use a counted item for a group."

  transition status from "active" to ["retired"]
  transition status from "retired" to ["active"]

  // Logistics staff read/execute too: pack-out and event checkout consume this catalog.
  default policy equipmentRead read: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") "Inventory or logistics staff may see equipment"
  default policy equipmentWrite write: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") "Inventory or logistics staff may update equipment"
  default policy equipmentExecute execute: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") "Inventory or logistics staff may change equipment"

  command register(
    name: string,
    assetTag: string,
    category: string,
    ownership: EquipmentOwnership,
    optional quantity: int,
    optional purchaseValue: money(12, 2),
    optional condition: EquipmentCondition,
    optional trackingMode: EquipmentTracking,
    optional serialNumber: string,
    optional description: string,
    optional countUnit: string,
    optional replacementCost: money(12, 2),
    optional customerPrice: money(12, 2),
    optional vendorId: uuid,
    optional homeLocation: string
  ) {
    guard self.registeredAt == null
    guard self.deletedAt == null
    constraint registerEquipmentName: length(trim(name)) > 0 "Give this equipment a name."
    constraint registerEquipmentAssetTag: length(trim(assetTag)) > 0 "Give this equipment its tag number."
    constraint registerEquipmentCategory: length(trim(category)) > 0 "Pick what kind of equipment this is."
    constraint registerEquipmentQuantity: quantity == null or quantity > 0 "This equipment's amount has to be more than zero. Enter how many you have."
    constraint registerEquipmentValue: purchaseValue == null or purchaseValue >= 0 "This equipment's purchase value can't be negative. Use zero or more."
    constraint registerEquipmentSerialSingle: trackingMode != "serialized" or quantity == null or quantity == 1 "A piece tracked by serial number is one piece. Enter 1, or pick counted for a group."
    constraint registerEquipmentPrices: (replacementCost == null or replacementCost >= 0) and (customerPrice == null or customerPrice >= 0) "Replacement cost and client price can't be negative. Use zero or more."
    constraint registerEquipmentVendor: vendorId == null or self.vendor != null "That vendor isn't in your vendor list. Pick one of your vendors."
    mutate name = name
    mutate assetTag = assetTag
    mutate category = category
    mutate ownership = ownership
    mutate quantity = quantity != null ? quantity : 1
    mutate purchaseValue = purchaseValue != null ? purchaseValue : 0
    mutate condition = condition != null ? condition : "good"
    mutate trackingMode = trackingMode != null ? trackingMode : "bulk"
    mutate serialNumber = serialNumber
    mutate description = description
    mutate countUnit = countUnit != null and length(trim(countUnit)) > 0 ? countUnit : "each"
    mutate replacementCost = replacementCost
    mutate customerPrice = customerPrice
    mutate vendorId = vendorId
    mutate homeLocation = homeLocation
    mutate registeredAt = now()
    emit EquipmentRegistered {
      equipmentId: self.id
      tenantId: self.tenantId
      name: name
      assetTag: assetTag
      category: category
      ownership: ownership
    }
  }

  command reviseDetails(
    name: string,
    category: string,
    optional ownership: EquipmentOwnership,
    optional purchaseValue: money(12, 2),
    optional homeLocation: string,
    optional currentLocation: string,
    optional trackingMode: EquipmentTracking,
    optional serialNumber: string,
    optional description: string,
    optional countUnit: string,
    optional replacementCost: money(12, 2),
    optional customerPrice: money(12, 2),
    optional vendorId: uuid
  ) {
    guard self.registeredAt != null
    guard self.status == "active"
    guard self.deletedAt == null
    constraint reviseEquipmentName: length(trim(name)) > 0 "Give this equipment a name."
    constraint reviseEquipmentCategory: length(trim(category)) > 0 "Pick what kind of equipment this is."
    constraint reviseEquipmentValue: purchaseValue == null or purchaseValue >= 0 "This equipment's purchase value can't be negative. Use zero or more."
    constraint reviseEquipmentSerialSingle: trackingMode != "serialized" or self.quantity <= 1 "A piece tracked by serial number is one piece. Recount this line to 1 first, or keep it counted."
    constraint reviseEquipmentPrices: (replacementCost == null or replacementCost >= 0) and (customerPrice == null or customerPrice >= 0) "Replacement cost and client price can't be negative. Use zero or more."
    mutate name = name
    mutate category = category
    mutate ownership = ownership != null ? ownership : self.ownership
    mutate purchaseValue = purchaseValue != null ? purchaseValue : self.purchaseValue
    mutate homeLocation = homeLocation != null ? homeLocation : self.homeLocation
    mutate currentLocation = currentLocation != null ? currentLocation : self.currentLocation
    mutate trackingMode = trackingMode != null ? trackingMode : self.trackingMode
    mutate serialNumber = serialNumber != null ? serialNumber : self.serialNumber
    mutate description = description != null ? description : self.description
    mutate countUnit = countUnit != null and length(trim(countUnit)) > 0 ? countUnit : self.countUnit
    mutate replacementCost = replacementCost != null ? replacementCost : self.replacementCost
    mutate customerPrice = customerPrice != null ? customerPrice : self.customerPrice
    // convex/lib/ownWorkspaceLinks.ts refuses another company's vendor id.
    mutate vendorId = vendorId != null ? vendorId : self.vendorId
    emit EquipmentDetailsRevised {
      equipmentId: self.id
      tenantId: self.tenantId
      name: name
      category: category
    }
  }

  command updateCondition(condition: EquipmentCondition, optional note: string) {
    guard self.registeredAt != null
    guard self.deletedAt == null
    compute previousCondition = self.condition
    mutate condition = condition
    mutate conditionNote = note
    emit EquipmentConditionUpdated {
      equipmentId: self.id
      tenantId: self.tenantId
      previousCondition: previousCondition
      condition: condition
      note: note
    }
  }

  command setPrimaryImage(storageId: string, optional fileName: string) {
    guard self.registeredAt != null
    guard self.deletedAt == null
    constraint equipmentImageStorage: length(trim(storageId)) > 0 "Add a photo before you set it as the main picture."
    mutate primaryImageStorageId = storageId
    mutate primaryImageFileName = fileName
    emit EquipmentImageChanged {
      equipmentId: self.id
      tenantId: self.tenantId
    }
  }

  command clearPrimaryImage() {
    guard self.registeredAt != null
    guard self.deletedAt == null
    mutate primaryImageStorageId = null
    mutate primaryImageFileName = null
    emit EquipmentImageChanged {
      equipmentId: self.id
      tenantId: self.tenantId
    }
  }

  command recount(actualQuantity: int) {
    guard self.registeredAt != null
    guard self.deletedAt == null
    constraint recountEquipmentNonnegative: actualQuantity >= 0 "This equipment's counted amount can't be negative. Use zero or more."
    constraint recountEquipmentSerialSingle: self.trackingMode != "serialized" or actualQuantity <= 1 "A piece tracked by serial number is one piece. Count it as 1, or 0 if it is lost."
    compute previousQuantity = self.quantity
    mutate quantity = actualQuantity
    emit EquipmentRecounted {
      equipmentId: self.id
      tenantId: self.tenantId
      previousQuantity: previousQuantity
      quantity: actualQuantity
    }
  }

  // PL-ASSET-AVAILABILITY (CF-11.3): moving equipment to another place is a
  // recorded move, so the office can see where an item is and where it came
  // from when it is short at one site.
  command transfer(toLocation: string, optional note: string) {
    guard self.registeredAt != null
    guard self.deletedAt == null
    constraint transferEquipmentPlace: length(trim(toLocation)) > 0 "Say where the equipment is going."
    compute fromLocation = self.currentLocation != null ? self.currentLocation : self.homeLocation
    mutate currentLocation = toLocation
    emit EquipmentTransferred {
      equipmentId: self.id
      tenantId: self.tenantId
      fromLocation: fromLocation
      toLocation: toLocation
      note: note
    }
  }

  // Units that did not come back from an event leave the count, so they can
  // no longer be booked. Run by the return check; zero changes nothing.
  command writeOffMissing(missingQuantity: int) {
    guard self.deletedAt == null
    constraint writeOffMissingNonnegative: missingQuantity >= 0 "The missing amount can't be negative. Use zero or more."
    mutate quantity = self.quantity - missingQuantity >= 0 ? self.quantity - missingQuantity : 0
  }

  command retire(reason: string) {
    guard self.status == "active"
    guard self.registeredAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "inventoryManageAccess") or roleAllows(user.role, "logisticsManageAccess")
    constraint retireEquipmentReason: length(trim(reason)) > 0 "Say why you're retiring this equipment."
    mutate status = "retired"
    mutate retiredAt = now()
    mutate retirementReason = reason
    emit EquipmentRetired {
      equipmentId: self.id
      tenantId: self.tenantId
      reason: reason
    }
  }

  command reactivate() {
    guard self.status == "retired"
    guard self.deletedAt == null
    guard roleAllows(user.role, "inventoryManageAccess") or roleAllows(user.role, "logisticsManageAccess")
    mutate status = "active"
    mutate retiredAt = null
    mutate retirementReason = null
    emit EquipmentReactivated {
      equipmentId: self.id
      tenantId: self.tenantId
    }
  }

  store Equipment in durable
}

event EquipmentRegistered: "equipment.registered" {
  equipmentId: string
  tenantId: string
  name: string
  assetTag: string
  category: string
  ownership: EquipmentOwnership
}

event EquipmentDetailsRevised: "equipment.details_revised" {
  equipmentId: string
  tenantId: string
  name: string
  category: string
}

event EquipmentConditionUpdated: "equipment.condition_updated" {
  equipmentId: string
  tenantId: string
  previousCondition: EquipmentCondition
  condition: EquipmentCondition
  note: string?
}

event EquipmentImageChanged: "equipment.image_changed" {
  equipmentId: string
  tenantId: string
}

event EquipmentRecounted: "equipment.recounted" {
  equipmentId: string
  tenantId: string
  previousQuantity: int
  quantity: int
}

event EquipmentTransferred: "equipment.transferred" {
  equipmentId: string
  tenantId: string
  fromLocation: string?
  toLocation: string
  note: string?
}

event EquipmentRetired: "equipment.retired" {
  equipmentId: string
  tenantId: string
  reason: string
}

event EquipmentReactivated: "equipment.reactivated" {
  equipmentId: string
  tenantId: string
}

// One reservation per equipment catalog line and event window. Quantity keeps
// pooled assets (linens, chairs) practical while single tagged assets naturally
// reserve one at a time. Creation is owned by the authored Convex seam because
// the current Convex projection cannot hydrate hasMany overlap guards during a
// generated create command; every later lifecycle change remains generated.
entity EquipmentReservation mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property indexed required equipmentId: string = ""
  property indexed required eventId: string = ""
  property required startsAt: datetime?
  property required endsAt: datetime?
  property required quantity: int = 1
  property required status: EquipmentReservationStatus = "reserved"
  property reservedAt: datetime?
  property checkedOutAt: datetime?
  property checkoutCondition: EquipmentCondition?
  property checkoutNote: string?
  property returnedAt: datetime?
  property returnCondition: EquipmentCondition?
  property returnNote: string?
  // How many of the held units did not come back (lost or left at the site).
  property missingQuantity: int?
  // PL-RETURNS: units back but broken, or back but needing a wash. Each opens
  // an EquipmentIssue that keeps those units out of use until it is resolved.
  property damagedQuantity: int?
  property cleaningQuantity: int?
  property returnCheckedById: uuid?
  // CF-11.4: a manager booked out-of-service equipment on purpose, and why.
  // Set by the reserve seam (convex/equipmentCheckout.ts) only.
  property overrideReason: string?
  property overrideApprovedById: uuid?
  property cancelledAt: datetime?
  property cancellationReason: string?

  belongsTo equipment: Equipment fields [tenantId, equipmentId] references [tenantId, id]
  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]

  constraint equipmentReservationComplete: self.reservedAt == null or (self.startsAt != null and self.endsAt != null and self.endsAt > self.startsAt and self.quantity > 0) "This equipment handoff needs a valid date range and a quantity more than zero."

  transition status from "reserved" to ["checked_out", "cancelled"]
  transition status from "checked_out" to ["returned"]

  // Event managers need execute so EventCancelled can stand down reserved rows.
  default policy equipmentReservationRead read: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") or roleAllows(user.role, "eventManageAccess") "Inventory or logistics staff may see equipment handoffs, or event managers stand down a cancelled event"
  default policy equipmentReservationWrite write: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") or roleAllows(user.role, "eventManageAccess") "Inventory or logistics staff may update equipment handoffs, or event managers stand down a cancelled event"
  default policy equipmentReservationExecute execute: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") or roleAllows(user.role, "eventManageAccess") "Inventory or logistics staff may change equipment handoffs, or event managers stand down a cancelled event"

  command checkOut(condition: EquipmentCondition, optional note: string) {
    guard self.status == "reserved"
    guard self.deletedAt == null
    constraint checkoutEquipmentServiceable: self.equipment != null and (self.equipment.condition != "out_of_service" or self.overrideReason != null) "This equipment is marked out of service, so it can't be checked out. Pick other equipment, or ask a manager to book it anyway with a reason."
    mutate status = "checked_out"
    mutate checkoutCondition = condition
    mutate checkoutNote = note
    mutate checkedOutAt = now()
    emit EquipmentCheckedOut {
      equipmentReservationId: self.id
      equipmentId: self.equipmentId
      eventId: self.eventId
      tenantId: self.tenantId
      condition: condition
      note: note
    }
  }

  command markReturned(condition: EquipmentCondition, optional note: string, optional missingQuantity: int, optional damagedQuantity: int, optional cleaningQuantity: int) {
    guard self.status == "checked_out"
    guard self.deletedAt == null
    constraint returnMissingAmount: missingQuantity == null or (missingQuantity >= 0 and missingQuantity <= self.quantity) "The missing amount has to be between zero and the amount that went out."
    constraint returnDamagedAmount: (damagedQuantity == null or damagedQuantity >= 0) and (cleaningQuantity == null or cleaningQuantity >= 0) "Broken and needs-cleaning amounts can't be negative. Use zero or more."
    constraint returnCountsFit: (missingQuantity != null ? missingQuantity : 0) + (damagedQuantity != null ? damagedQuantity : 0) + (cleaningQuantity != null ? cleaningQuantity : 0) <= self.quantity "Missing, broken and needs-cleaning together can't be more than the amount that went out."
    compute missing = missingQuantity != null ? missingQuantity : 0
    compute damaged = damagedQuantity != null ? damagedQuantity : 0
    compute dirty = cleaningQuantity != null ? cleaningQuantity : 0
    mutate status = "returned"
    mutate returnCondition = condition
    mutate returnNote = note
    mutate missingQuantity = missing
    mutate damagedQuantity = damaged
    mutate cleaningQuantity = dirty
    mutate returnCheckedById = user.personId
    mutate returnedAt = now()
    emit EquipmentReturned {
      equipmentReservationId: self.id
      equipmentId: self.equipmentId
      eventId: self.eventId
      tenantId: self.tenantId
      condition: condition
      note: note
      missingQuantity: missing
      damagedQuantity: damaged
      cleaningQuantity: dirty
    }
  }

  command cancel(optional reason: string) {
    guard self.status == "reserved"
    guard self.deletedAt == null
    mutate status = "cancelled"
    mutate cancellationReason = reason
    mutate cancelledAt = now()
    emit EquipmentReservationCancelled {
      equipmentReservationId: self.id
      equipmentId: self.equipmentId
      eventId: self.eventId
      tenantId: self.tenantId
      reason: reason
    }
  }

  store EquipmentReservation in durable
}

event EquipmentReserved: "equipment.reserved" {
  equipmentReservationId: string
  equipmentId: string
  eventId: string
  tenantId: string
  startsAt: datetime
  endsAt: datetime
  quantity: int
}

event EquipmentCheckedOut: "equipment.checked_out" {
  equipmentReservationId: string
  equipmentId: string
  eventId: string
  tenantId: string
  condition: EquipmentCondition
  note: string?
}

event EquipmentReturned: "equipment.returned" {
  equipmentReservationId: string
  equipmentId: string
  eventId: string
  tenantId: string
  condition: EquipmentCondition
  note: string?
  missingQuantity: int
  damagedQuantity: int
  cleaningQuantity: int
}

event EquipmentReservationCancelled: "equipment.reservation_cancelled" {
  equipmentReservationId: string
  equipmentId: string
  eventId: string
  tenantId: string
  reason: string?
}

// Recurring service task for one catalog item. The next due date advances from
// each newly recorded service while older backfilled entries remain valid
// history without moving the live schedule backwards.
entity EquipmentMaintenanceTask mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property indexed required equipmentId: uuid
  property required searchable taskName: string = ""
  property required intervalDays: int = 30
  property required nextDueAt: datetime?
  property instructions: string?
  property scheduledAt: datetime?
  property lastServicedAt: datetime?

  belongsTo equipment: Equipment fields [tenantId, equipmentId] references [tenantId, id]
  hasMany serviceEntries: EquipmentServiceEntry

  constraint maintenanceTaskComplete: self.scheduledAt == null or (length(trim(self.taskName)) > 0 and self.intervalDays > 0 and self.nextDueAt != null) "Scheduled maintenance needs a task name, a recurring interval, and a due date."

  default policy maintenanceTaskRead read: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") "Inventory or logistics staff may see equipment maintenance"
  default policy maintenanceTaskWrite write: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") "Inventory or logistics staff may update equipment maintenance"
  default policy maintenanceTaskExecute execute: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") "Inventory or logistics staff may change equipment maintenance"

  command schedule(
    equipmentId: uuid,
    taskName: string,
    intervalDays: int,
    nextDueAt: datetime,
    optional instructions: string
  ) {
    guard self.scheduledAt == null
    guard self.deletedAt == null
    guard self.equipment != null
    constraint scheduleMaintenanceEquipmentMatch: equipmentId == self.equipmentId "This maintenance task is for different equipment. Pick the equipment already on this task."
    constraint scheduleMaintenanceName: length(trim(taskName)) > 0 "Say what this maintenance task is."
    constraint scheduleMaintenanceInterval: intervalDays > 0 "The recurring interval has to be at least one day."
    mutate taskName = taskName
    mutate intervalDays = intervalDays
    mutate nextDueAt = nextDueAt
    mutate instructions = instructions
    mutate scheduledAt = now()
    emit EquipmentMaintenanceScheduled {
      maintenanceTaskId: self.id
      equipmentId: equipmentId
      tenantId: self.tenantId
      taskName: taskName
      intervalDays: intervalDays
      nextDueAt: nextDueAt
    }
  }

  command applyService(completedAt: datetime, nextDueAt: datetime) {
    guard self.scheduledAt != null
    guard self.deletedAt == null
    constraint applyServiceNextDue: nextDueAt > completedAt "The next due date has to be after the date the service was completed."
    compute isLatestService = self.lastServicedAt == null or completedAt >= self.lastServicedAt
    mutate lastServicedAt = isLatestService ? completedAt : self.lastServicedAt
    mutate nextDueAt = isLatestService ? nextDueAt : self.nextDueAt
    emit EquipmentMaintenanceAdvanced {
      maintenanceTaskId: self.id
      equipmentId: self.equipmentId
      tenantId: self.tenantId
      completedAt: completedAt
      nextDueAt: isLatestService ? nextDueAt : self.nextDueAt
    }
  }

  store EquipmentMaintenanceTask in durable
}

event EquipmentMaintenanceScheduled: "equipment.maintenance_scheduled" {
  maintenanceTaskId: string
  equipmentId: string
  tenantId: string
  taskName: string
  intervalDays: int
  nextDueAt: datetime
}

event EquipmentMaintenanceAdvanced: "equipment.maintenance_advanced" {
  maintenanceTaskId: string
  equipmentId: string
  tenantId: string
  completedAt: datetime
  nextDueAt: datetime?
}

// Immutable completion history. Recording a service emits the fact that
// advances the linked recurring task in the same generated transaction.
entity EquipmentServiceEntry mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property indexed required maintenanceTaskId: uuid
  property indexed required equipmentId: uuid
  property required technician: string = ""
  property required cost: money(12, 2) = 0
  property notes: string?
  property completedAt: datetime?
  property nextDueAt: datetime?
  property loggedAt: datetime?

  belongsTo maintenanceTask: EquipmentMaintenanceTask fields [tenantId, maintenanceTaskId] references [tenantId, id]
  belongsTo equipment: Equipment fields [tenantId, equipmentId] references [tenantId, id]

  constraint equipmentServiceComplete: self.loggedAt == null or (length(trim(self.technician)) > 0 and self.cost >= 0 and self.completedAt != null and self.nextDueAt != null) "A completed service needs a technician, a cost that isn't negative, a completion time, and a next due date."

  default policy equipmentServiceRead read: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") "Inventory or logistics staff may see equipment service history"
  default policy equipmentServiceWrite write: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") "Inventory or logistics staff may add equipment service"
  default policy equipmentServiceExecute execute: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") "Inventory or logistics staff may change equipment service"

  command record(
    maintenanceTaskId: uuid,
    equipmentId: uuid,
    technician: string,
    cost: money(12, 2),
    completedAt: datetime,
    nextDueAt: datetime,
    optional notes: string
  ) {
    guard self.loggedAt == null
    guard self.deletedAt == null
    guard self.maintenanceTask != null
    guard self.equipment != null
    constraint recordServiceTaskMatch: maintenanceTaskId == self.maintenanceTaskId "This service entry is for a different maintenance task. Pick the maintenance task already on this entry."
    constraint recordServiceEquipmentMatch: equipmentId == self.equipmentId and self.maintenanceTask.equipmentId == equipmentId "This service entry's equipment has to match its maintenance task's equipment."
    constraint recordServiceTechnician: length(trim(technician)) > 0 "Say who did the work."
    constraint recordServiceCost: cost >= 0 "This service's cost can't be negative. Use zero or more."
    constraint recordServiceTime: completedAt <= now() "The completion time can't be in the future."
    constraint recordServiceNextDue: nextDueAt > completedAt "The next due date has to be after the date the service was completed."
    mutate technician = technician
    mutate cost = cost
    mutate notes = notes
    mutate completedAt = completedAt
    mutate nextDueAt = nextDueAt
    mutate loggedAt = now()
    emit EquipmentServiceRecorded {
      serviceEntryId: self.id
      maintenanceTaskId: maintenanceTaskId
      equipmentId: equipmentId
      tenantId: self.tenantId
      technician: technician
      cost: cost
      notes: notes
      completedAt: completedAt
      nextDueAt: nextDueAt
    }
  }

  store EquipmentServiceEntry in durable
}

event EquipmentServiceRecorded: "equipment.service_recorded" {
  serviceEntryId: string
  maintenanceTaskId: string
  equipmentId: string
  tenantId: string
  technician: string
  cost: money(12, 2)
  notes: string?
  completedAt: datetime
  nextDueAt: datetime
}

on EquipmentServiceRecorded run EquipmentMaintenanceTask.applyService
  resolve payload.maintenanceTaskId
  params {
    completedAt: payload.completedAt
    nextDueAt: payload.nextDueAt
  }

// The return checklist is the authoritative latest condition observation.
on EquipmentReturned fanOut Equipment where id = payload.equipmentId
  run updateCondition
  params {
    condition: payload.condition
    note: payload.note
  }

// Units that did not come back leave the catalog count (CF-11.3 missing).
on EquipmentReturned fanOut Equipment where id = payload.equipmentId
  run writeOffMissing
  params {
    missingQuantity: payload.missingQuantity
  }

// A bundle part or accessory of one catalog line (PL-ASSET-CATALOG, AC-545).
// Both sides are this company's own Equipment rows; the part keeps its own
// count, condition and availability.
entity EquipmentPart mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property indexed required equipmentId: uuid
  property required partEquipmentId: uuid
  property required role: EquipmentPartRole = "part"
  property required quantity: int = 1
  property attachedAt: datetime?
  property removedAt: datetime?

  belongsTo equipment: Equipment fields [tenantId, equipmentId] references [tenantId, id]
  belongsTo partEquipment: Equipment fields [tenantId, partEquipmentId] references [tenantId, id]

  constraint equipmentPartQuantity: self.quantity > 0 "A part has to come in an amount of at least 1."

  default policy equipmentPartRead read: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") "Inventory or logistics staff may see equipment parts"
  default policy equipmentPartWrite write: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") "Inventory or logistics staff may update equipment parts"
  default policy equipmentPartExecute execute: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "logisticsAccess") "Inventory or logistics staff may change equipment parts"

  command attach(equipmentId: uuid, partEquipmentId: uuid, role: EquipmentPartRole, optional quantity: int) {
    guard self.attachedAt == null
    guard self.deletedAt == null
    constraint attachPartOwnItems: self.equipment != null and self.partEquipment != null "Pick both the item and its part from your own equipment list."
    constraint attachPartNotItself: equipmentId != partEquipmentId "An item can't be a part of itself. Pick a different part."
    constraint attachPartAmount: quantity == null or quantity > 0 "A part has to come in an amount of at least 1."
    mutate equipmentId = equipmentId
    mutate partEquipmentId = partEquipmentId
    mutate role = role
    mutate quantity = quantity != null ? quantity : 1
    mutate attachedAt = now()
    emit EquipmentPartAttached {
      equipmentPartId: self.id
      tenantId: self.tenantId
      equipmentId: equipmentId
      partEquipmentId: partEquipmentId
      role: role
    }
  }

  command changeAmount(quantity: int) {
    guard self.attachedAt != null and self.removedAt == null
    guard self.deletedAt == null
    constraint changePartAmount: quantity > 0 "A part has to come in an amount of at least 1."
    mutate quantity = quantity
  }

  command detach() {
    guard self.attachedAt != null and self.removedAt == null
    guard self.deletedAt == null
    mutate removedAt = now()
    emit EquipmentPartDetached {
      equipmentPartId: self.id
      tenantId: self.tenantId
      equipmentId: self.equipmentId
    }
  }

  store EquipmentPart in durable
}

event EquipmentPartAttached: "equipment.part_attached" {
  equipmentPartId: string
  tenantId: string
  equipmentId: string
  partEquipmentId: string
  role: EquipmentPartRole
}

event EquipmentPartDetached: "equipment.part_detached" {
  equipmentPartId: string
  tenantId: string
  equipmentId: string
}
