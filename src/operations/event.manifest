// Capsule client engagement, venue, event, and guest-attendance lifecycle.
// EventDish is authored in src/culinary/event-dish.manifest (culinary slice).

use "../identity/person.manifest"
use "./service-style.manifest"
use "./occasion.manifest"

// ---------------------------------------------------------------------------
// Closed vocabularies
// ---------------------------------------------------------------------------

enum ClientType {
  company
  person
}

enum ClientStatus {
  active
  archived
}

enum EventStage {
  quote
  planning
  pending_approval
  approved
  sales_lock
  executing
  final
  completed
  cancelled
  closed_out
}

enum EventRecurrenceFrequency {
  weekly
  monthly
  annually
}

enum EventTimingMilestone {
  staff_on
  shop_departure
  onsite_arrival
  service
  cleanup
  venue_departure
  shop_return
  staff_off
}

enum EventRecurrenceEndCondition {
  on_date
  after_occurrences
}

enum VenueType {
  client_site
  banquet_hall
  outdoor
  office
  private_home
  other
}

enum VenueStatus {
  active
  inactive
}

enum RsvpStatus {
  pending
  confirmed
  declined
}

// ---------------------------------------------------------------------------
// Client — the catering client account behind one or more engagements.
// ---------------------------------------------------------------------------

entity Client mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required clientType: ClientType = "company"
  property searchable companyName: string?
  property searchable givenName: string?
  property searchable familyName: string?
  property encrypted email: string?
  property encrypted phone: string?
  property website: string?
  property encrypted addressLine1: string?
  property encrypted addressLine2: string?
  property encrypted city: string?
  property encrypted region: string?
  property encrypted postalCode: string?
  property encrypted countryCode: string?
  // Calendar date "YYYY-MM-DD" for the Birthday List report (#272). Contact
  // data for person clients; optional and never gating.
  property encrypted birthday: string?
  property private encrypted taxId: string?
  property required taxExempt: boolean = false
  property required paymentTermsDays: int = 30
  property notes: string?
  property assignedToId: uuid?
  property clientMergeAuthorizationId: uuid?
  property mergedIntoClientId: uuid?
  property required status: ClientStatus = "active"
  property registeredAt: datetime?
  property archivedAt: datetime?
  property mergedAt: datetime?

  ref assignedTo: Person fields [tenantId, assignedToId] references [tenantId, id]
  ref clientMergeAuthorization: ClientMerge fields [tenantId, clientMergeAuthorizationId] references [tenantId, id]
  ref mergedIntoClient: Client fields [tenantId, mergedIntoClientId] references [tenantId, id]
  hasMany events: Event

  computed displayName: string = self.clientType == "company" ? self.companyName : self.givenName + " " + self.familyName
  computed isArchived: boolean = self.status == "archived"

  // registeredAt gates the invariant while register applies field mutations.
  constraint clientIdentityComplete: self.registeredAt == null or (self.clientType == "company" and self.companyName != null and length(trim(self.companyName)) > 0) or (self.clientType == "person" and self.givenName != null and length(trim(self.givenName)) > 0) "Company clients require a company name; person clients require a given name"
  constraint validPaymentTerms: self.paymentTermsDays >= 0 and self.paymentTermsDays <= 365 "Payment terms must be between 0 and 365 days"
  constraint validCountryCode: self.countryCode == null or length(trim(self.countryCode)) == 2 "Country code must contain two characters"

  transition status from "active" to ["archived"]
  transition status from "archived" to ["active"]

  default policy clientRead read: roleAllows(user.role, "salesAccess") or roleAllows(user.role, "financeAccess") "Sales and finance may see client accounts for CRM and billing"
  // Write policies gate command mutation (semantics.md § policy enforcement:
  // "enforced only at command execution"; no separate store-level write gate).
  // Staff tier here; manager-only commands carry explicit roleAllows guards.
  default policy clientWrite write: roleAllows(user.role, "salesAccess") "Sales staff may update client accounts"
  default policy clientExecute execute: roleAllows(user.role, "salesAccess") "Sales staff may change client accounts"

  command register(
    clientType: ClientType,
    optional companyName: string,
    optional givenName: string,
    optional familyName: string,
    optional email: string,
    optional phone: string,
    optional website: string,
    optional addressLine1: string,
    optional addressLine2: string,
    optional city: string,
    optional region: string,
    optional postalCode: string,
    optional countryCode: string,
    optional taxId: string,
    optional taxExempt: boolean,
    optional paymentTermsDays: number,
    optional notes: string,
    optional assignedToId: uuid
  ) {
    guard self.registeredAt == null
    guard self.deletedAt == null
    constraint registerIdentity: (clientType == "company" and companyName != null and length(trim(companyName)) > 0) or (clientType == "person" and givenName != null and length(trim(givenName)) > 0) "Company clients require a company name; person clients require a given name"
    constraint registerTerms: paymentTermsDays == null or (paymentTermsDays >= 0 and paymentTermsDays <= 365) "Payment terms must be between 0 and 365 days"
    constraint registerCountry: countryCode == null or length(trim(countryCode)) == 2 "Country code must contain two characters"
    mutate clientType = clientType
    mutate companyName = companyName
    mutate givenName = givenName
    mutate familyName = familyName
    mutate email = email
    mutate phone = phone
    mutate website = website
    mutate addressLine1 = addressLine1
    mutate addressLine2 = addressLine2
    mutate city = city
    mutate region = region
    mutate postalCode = postalCode
    mutate countryCode = countryCode
    mutate taxId = taxId
    mutate taxExempt = taxExempt != null ? taxExempt : false
    mutate paymentTermsDays = paymentTermsDays != null ? paymentTermsDays : 30
    mutate notes = notes
    mutate assignedToId = assignedToId
    mutate registeredAt = now()
    emit ClientRegistered {
      clientId: self.id
      tenantId: self.tenantId
      clientType: clientType
    }
  }

  command changeContact(
    optional email: string,
    optional phone: string,
    optional website: string,
    optional addressLine1: string,
    optional addressLine2: string,
    optional city: string,
    optional region: string,
    optional postalCode: string,
    optional countryCode: string
  ) {
    guard self.status == "active"
    guard self.deletedAt == null
    constraint contactCountry: countryCode == null or length(trim(countryCode)) == 2 "Country code must contain two characters"
    mutate email = email
    mutate phone = phone
    mutate website = website
    mutate addressLine1 = addressLine1
    mutate addressLine2 = addressLine2
    mutate city = city
    mutate region = region
    mutate postalCode = postalCode
    mutate countryCode = countryCode
    emit ClientContactChanged {
      clientId: self.id
      tenantId: self.tenantId
    }
  }

  // Birthday as a calendar date, or null to clear it. Its own command so a
  // contact edit that omits the field never wipes a stored birthday.
  command setBirthday(optional birthday: string) {
    guard self.status == "active"
    guard self.deletedAt == null
    constraint birthdayCalendarDate: birthday == null or length(trim(birthday)) == 10 "Birthday must be a YYYY-MM-DD date"
    mutate birthday = birthday
    emit ClientBirthdaySet {
      clientId: self.id
      tenantId: self.tenantId
    }
  }

  command changeBillingProfile(
    paymentTermsDays: number,
    taxExempt: boolean,
    optional taxId: string
  ) {
    guard self.status == "active"
    guard self.deletedAt == null
    guard roleAllows(user.role, "salesManageAccess")
    constraint billingTerms: paymentTermsDays >= 0 and paymentTermsDays <= 365 "Payment terms must be between 0 and 365 days"
    mutate paymentTermsDays = paymentTermsDays
    mutate taxExempt = taxExempt
    // taxId is private: no screen can read it back to send it again. An omitted
    // value keeps the saved ID; "" clears it.
    mutate taxId = taxId != null ? taxId : self.taxId
    emit ClientBillingProfileChanged {
      clientId: self.id
      tenantId: self.tenantId
      paymentTermsDays: paymentTermsDays
      taxExempt: taxExempt
    }
  }

  command assignOwner(optional assignedToId: uuid) {
    guard self.status == "active"
    guard self.deletedAt == null
    mutate assignedToId = assignedToId
    emit ClientOwnerAssigned {
      clientId: self.id
      tenantId: self.tenantId
      assignedToId: assignedToId
    }
  }

  command archive(reason: string) {
    guard self.status == "active"
    guard self.deletedAt == null
    guard roleAllows(user.role, "salesManageAccess")
    constraint archiveReason: length(trim(reason)) > 0 "Archive reason is required"
    mutate status = "archived"
    mutate archivedAt = now()
    emit ClientArchived {
      clientId: self.id
      tenantId: self.tenantId
      reason: reason
    }
  }

  command reactivate() {
    guard self.status == "archived"
    guard self.deletedAt == null
    guard roleAllows(user.role, "salesManageAccess")
    mutate status = "active"
    mutate archivedAt = null
    emit ClientReactivated {
      clientId: self.id
      tenantId: self.tenantId
    }
  }

  // The first step records the completed merge that authorizes deletion. The
  // follow-up command rehydrates both references before changing the account.
  command stageClientMerge(clientMergeId: uuid, primaryClientId: uuid) {
    guard self.status == "active"
    guard self.deletedAt == null
    guard roleAllows(user.role, "adminAccess")
    mutate clientMergeAuthorizationId = clientMergeId
    mutate mergedIntoClientId = primaryClientId
    emit ClientMergeStaged {
      duplicateClientId: self.id
      clientMergeId: clientMergeId
      tenantId: self.tenantId
    }
  }

  command markMerged(clientId: uuid) {
    guard self.status == "active"
    guard self.deletedAt == null
    guard roleAllows(user.role, "adminAccess")
    guard self.clientMergeAuthorization != null
    guard self.clientMergeAuthorization.deletedAt == null
    guard self.clientMergeAuthorization.mergedAt != null
    guard self.mergedIntoClient != null
    guard self.mergedIntoClient.status == "active"
    guard self.mergedIntoClient.deletedAt == null
    constraint mergeAuthorizedDuplicate: self.clientMergeAuthorization.duplicateClientId == clientId "Merge authorization does not belong to this duplicate"
    constraint mergeAuthorizedPrimary: self.clientMergeAuthorization.primaryClientId == self.mergedIntoClientId "Merge authorization does not match the primary client"
    mutate status = "archived"
    mutate archivedAt = now()
    mutate mergedAt = now()
    mutate deletedAt = now()
    emit ClientMerged {
      duplicateClientId: self.id
      primaryClientId: self.mergedIntoClientId
      tenantId: self.tenantId
    }
  }

  store Client in durable
}

// ---------------------------------------------------------------------------
// Venue — canonical reusable event location plus catering-operational notes.
// ---------------------------------------------------------------------------

entity Venue mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required searchable name: string = ""
  property required venueType: VenueType = "other"
  property encrypted addressLine1: string?
  property encrypted addressLine2: string?
  property encrypted city: string?
  property encrypted region: string?
  property encrypted postalCode: string?
  property encrypted countryCode: string?
  // GPS pin for venues that have no street address — a campsite, a field, a
  // trailhead (#368 item 9). Decimal degrees; north/east positive.
  property latitude: float?
  property longitude: float?
  property encrypted contactName: string?
  property encrypted contactEmail: string?
  property encrypted contactPhone: string?
  property accessNotes: string?
  property cateringNotes: string?
  property required capacity: int = 0
  property onPremise: boolean?
  property kitchenAccess: string?
  property parkingAvailable: boolean?
  property hasFreightElevator: boolean?
  property storageAvailable: boolean?
  property logisticsNotes: string?
  property loadInInstructions: string?
  property powerAvailable: boolean?
  property waterAccess: boolean?
  property hasStairs: boolean?
  property wasteRules: string?
  property permitsInsuranceNotes: string?
  property restrictions: string?
  property required status: VenueStatus = "active"
  property registeredAt: datetime?
  property deactivatedAt: datetime?
  property deactivationReason: string?

  hasMany events: Event

  computed isActive: boolean = self.status == "active"

  constraint venueIdentityComplete: self.registeredAt == null or length(trim(self.name)) > 0 "Registered venues require a name"
  constraint venueCapacityNonnegative: self.capacity >= 0 "Venue capacity cannot be negative"
  constraint venueLatitudeRange: self.latitude == null or (self.latitude >= -90 and self.latitude <= 90) "Latitude must be between -90 and 90"
  constraint venueLongitudeRange: self.longitude == null or (self.longitude >= -180 and self.longitude <= 180) "Longitude must be between -180 and 180"

  transition status from "active" to ["inactive"]
  transition status from "inactive" to ["active"]

  default policy venueRead read: roleAllows(user.role, "eventAccess") "Event staff may see venues"
  default policy venueWrite write: roleAllows(user.role, "eventAccess") "Event staff may update venues"
  default policy venueExecute execute: roleAllows(user.role, "eventAccess") "Event staff may change venues"

  command register(
    name: string,
    venueType: VenueType,
    capacity: number,
    optional onPremise: boolean,
    optional kitchenAccess: string,
    optional parkingAvailable: boolean,
    optional hasFreightElevator: boolean,
    optional storageAvailable: boolean,
    optional logisticsNotes: string,
    optional loadInInstructions: string,
    optional powerAvailable: boolean,
    optional waterAccess: boolean,
    optional hasStairs: boolean,
    optional wasteRules: string,
    optional permitsInsuranceNotes: string,
    optional restrictions: string,
    optional addressLine1: string,
    optional addressLine2: string,
    optional city: string,
    optional region: string,
    optional postalCode: string,
    optional countryCode: string,
    optional latitude: number,
    optional longitude: number,
    optional contactName: string,
    optional contactEmail: string,
    optional contactPhone: string,
    optional accessNotes: string,
    optional cateringNotes: string
  ) {
    guard self.registeredAt == null
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventManageAccess")
    constraint registerVenueName: length(trim(name)) > 0 "Venue name is required"
    constraint registerVenueCapacity: capacity >= 0 "Venue capacity cannot be negative"
    mutate name = name
    mutate venueType = venueType
    mutate capacity = capacity
    mutate onPremise = onPremise
    mutate kitchenAccess = kitchenAccess
    mutate parkingAvailable = parkingAvailable
    mutate hasFreightElevator = hasFreightElevator
    mutate storageAvailable = storageAvailable
    mutate logisticsNotes = logisticsNotes
    mutate loadInInstructions = loadInInstructions
    mutate powerAvailable = powerAvailable
    mutate waterAccess = waterAccess
    mutate hasStairs = hasStairs
    mutate wasteRules = wasteRules
    mutate permitsInsuranceNotes = permitsInsuranceNotes
    mutate restrictions = restrictions
    mutate addressLine1 = addressLine1
    mutate addressLine2 = addressLine2
    mutate city = city
    mutate region = region
    mutate postalCode = postalCode
    mutate countryCode = countryCode
    mutate latitude = latitude
    mutate longitude = longitude
    mutate contactName = contactName
    mutate contactEmail = contactEmail
    mutate contactPhone = contactPhone
    mutate accessNotes = accessNotes
    mutate cateringNotes = cateringNotes
    mutate registeredAt = now()
    emit VenueRegistered {
      venueId: self.id
      tenantId: self.tenantId
      name: name
      venueType: venueType
      capacity: capacity
      onPremise: onPremise
    }
  }

  command updateDetails(
    name: string,
    venueType: VenueType,
    optional onPremise: boolean,
    optional kitchenAccess: string,
    optional parkingAvailable: boolean,
    optional hasFreightElevator: boolean,
    optional storageAvailable: boolean,
    optional logisticsNotes: string,
    optional loadInInstructions: string,
    optional powerAvailable: boolean,
    optional waterAccess: boolean,
    optional hasStairs: boolean,
    optional wasteRules: string,
    optional permitsInsuranceNotes: string,
    optional restrictions: string,
    optional addressLine1: string,
    optional addressLine2: string,
    optional city: string,
    optional region: string,
    optional postalCode: string,
    optional countryCode: string,
    optional latitude: number,
    optional longitude: number,
    optional contactName: string,
    optional contactEmail: string,
    optional contactPhone: string,
    optional accessNotes: string,
    optional cateringNotes: string
  ) {
    guard self.status == "active"
    guard self.deletedAt == null
    constraint updateVenueName: length(trim(name)) > 0 "Venue name is required"
    mutate name = name
    mutate venueType = venueType
    mutate onPremise = onPremise
    mutate kitchenAccess = kitchenAccess
    mutate parkingAvailable = parkingAvailable
    mutate hasFreightElevator = hasFreightElevator
    mutate storageAvailable = storageAvailable
    mutate logisticsNotes = logisticsNotes
    mutate loadInInstructions = loadInInstructions
    mutate powerAvailable = powerAvailable
    mutate waterAccess = waterAccess
    mutate hasStairs = hasStairs
    mutate wasteRules = wasteRules
    mutate permitsInsuranceNotes = permitsInsuranceNotes
    mutate restrictions = restrictions
    mutate addressLine1 = addressLine1
    mutate addressLine2 = addressLine2
    mutate city = city
    mutate region = region
    mutate postalCode = postalCode
    mutate countryCode = countryCode
    mutate latitude = latitude
    mutate longitude = longitude
    mutate contactName = contactName
    mutate contactEmail = contactEmail
    mutate contactPhone = contactPhone
    mutate accessNotes = accessNotes
    mutate cateringNotes = cateringNotes
    emit VenueDetailsUpdated {
      venueId: self.id
      tenantId: self.tenantId
    }
  }

  command changeCapacity(capacity: number) {
    guard self.status == "active"
    guard self.deletedAt == null
    constraint changeVenueCapacity: capacity >= 0 "Venue capacity cannot be negative"
    compute previousCapacity = self.capacity
    mutate capacity = capacity
    emit VenueCapacityChanged {
      venueId: self.id
      tenantId: self.tenantId
      previousCapacity: previousCapacity
      capacity: capacity
    }
  }

  command deactivate(reason: string) {
    guard self.status == "active"
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventManageAccess")
    constraint deactivateVenueReason: length(trim(reason)) > 0 "Venue deactivation reason is required"
    mutate status = "inactive"
    mutate deactivatedAt = now()
    mutate deactivationReason = reason
    emit VenueDeactivated {
      venueId: self.id
      tenantId: self.tenantId
      reason: reason
    }
  }

  command activate() {
    guard self.status == "inactive"
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventManageAccess")
    mutate status = "active"
    mutate deactivatedAt = null
    mutate deactivationReason = null
    emit VenueActivated {
      venueId: self.id
      tenantId: self.tenantId
    }
  }

  store Venue in durable
}

// ---------------------------------------------------------------------------
// Event — the governed engagement shared by every later operational domain.
// Readiness is derived later from prep, staffing, logistics, and quality facts;
// it is intentionally not a manually stored lifecycle stage here.
// ---------------------------------------------------------------------------

entity Event mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property clientId: uuid?
  // Snapshot the booked client printed name so a later catalog edit cannot
  // rewrite the Event (backend §4.1, AC-398 slice).
  property clientName: string?
  property clientMergeAuthorizationId: uuid?
  property mergeTargetClientId: uuid?
  property serviceStyleId: uuid?
  // Snapshot the booked service-style label so a later catalog rename does
  // not retroactively change the Event (backend §4.1, AC-398 slice).
  property serviceStyleName: string?
  property occasionId: uuid?
  // Snapshot the booked occasion label so a later catalog rename does
  // not retroactively change the Event (backend §4.1, AC-398 slice).
  property occasionName: string?
  property referralSourceId: uuid?
  property venueId: uuid?
  property assignedToId: uuid?
  // Printed owner/salesperson name at plan / assign time. A later catalog
  // Person.correctIdentity rename must not rewrite this Event. assignedToId
  // stays the live Person link.
  property ownerName: string?
  property required searchable title: string = ""
  // The 4-digit number the shop calls the event by: on the Event Tracker, the
  // binder spine and the chat channel. The numbering seam
  // (convex/lib/eventNumbering.ts) gives every planned event the next number.
  // A person can type a different one (a TPP-era event keeps its TPP number).
  property indexed eventNumber: string?
  property required eventType: string = ""
  property startsAt: datetime?
  property endsAt: datetime?
  // Explicit service anchor: event start can instead mean guest arrival.
  property serviceStartsAt: datetime?
  property timingSetupMinutes: float?
  property timingLoadMinutes: float?
  property timingOutboundTravelMinutes: float?
  property timingCleanupMinutes: float?
  property timingReturnTravelMinutes: float?
  property timingUnloadMinutes: float?
  property timingConfiguredAt: datetime?
  // Purchasing week bucket key for weekly VendorOrder draft consolidation.
  // Normalized from startsAt on plan/reschedule to the Monday 08:00 UTC that
  // starts the event's week (Monday 00:00 US Pacific / 04:00 US Eastern —
  // every US zone reads it as Monday). Storing the raw start time gave every
  // event its own "week", so two events in one week each subtracted the same
  // stock and ordered separately (#327). Week arithmetic: epoch ms, one week
  // is 604800000 ms, and 374400000 ms is Monday 1970-01-05 08:00 UTC.
  property purchasingWeekStart: datetime?
  property venueName: string?
  property venueAddress: string?
  // Snapshot the selected venue limit so historical event planning does not
  // silently change when the reusable Venue record is revised later.
  property venueCapacity: int?
  property expectedHeadcount: int?
  property encrypted primaryContactName: string?
  // Client contact PII: every staff role reads events, but only event/sales
  // staff work with the client; others see a masked value (day-of sheets
  // read the raw number through convex/eventDayBriefing.ts).
  property encrypted masked(email) primaryContactEmail: string? unmask when roleAllows(user.role, "eventAccess") or roleAllows(user.role, "salesAccess")
  property encrypted masked(phone) primaryContactPhone: string? unmask when roleAllows(user.role, "eventAccess") or roleAllows(user.role, "salesAccess")
  property accessibilityNeeds: list<string> = []
  property serviceRequirements: string?
  property operationalRequirements: string?
  property budgetAmount: money(12, 2)?
  property quotedPrice: money(12, 2)?
  property required stage: EventStage = "planning"
  // Source facts and reconciliation checkpoint remain on the native draft.
  property encrypted importDraftJson: string?
  property importSourceKey: string?
  property draftCapturedAt: datetime?
  property plannedAt: datetime?
  property approvedAt: datetime?
  property executionStartedAt: datetime?
  property completedAt: datetime?
  property cancelledAt: datetime?
  property closedOutAt: datetime?
  property salesLockedAt: datetime?
  property finalizedAt: datetime?
  property cancellationReason: string?
  // Archive is a visibility flag (AC-239): hide the Event from the active list
  // without moving its stage or cancelling work. Not a new EventStage.
  property archivedAt: datetime?
  property archiveReason: string?
  property recurrenceFrequency: EventRecurrenceFrequency?
  property recurrenceEndCondition: EventRecurrenceEndCondition?
  property recurrenceEndsAt: datetime?
  property recurrenceOccurrenceLimit: int?
  property recurrenceAnchorStartsAt: datetime?
  property recurrenceNextStartsAt: datetime?
  property recurrenceGeneratedCount: int?
  property recurrenceSeriesId: string?
  property recurrenceActive: boolean? = false
  property recurrenceConfiguredAt: datetime?
  property recurrenceStoppedAt: datetime?
  property recurrenceCompletedAt: datetime?
  property recurrenceTemplateEventId: uuid?
  property recurrenceSequence: int?
  // Battle board day sheet — responsibility badges + buffet plate order, one
  // free-text value each ("Mangia", "Client", "Third party", "Full clear",
  // "Prefill only", "Yes", "No", "Confirm on site", or any wording the board
  // should print). Empty = not answered; the board omits it.
  property barService: string?
  property cocktailHourFood: string?
  property dessertService: string?
  property bussing: string?
  property placeSettings: string?
  property passedApps: string?
  property stationaryApps: string?
  property beveragesOnMenu: string?
  property tablesideWater: string?
  property mangiaDisposables: string?
  property eventRentals: string?
  property scullery: string?
  property powerOnsite: string?
  property waterOnsite: string?
  // Buffet line order, comma-separated plate names.
  property buffetColdPlates: string?
  property buffetHotPlates: string?
  // Ops Final Lock setup notes (Mangia Ops Final Lock Training part 3, NOTES
  // and EQUIP) — what the packer and the field team read before load-out.
  // Free text like the day sheet ("Ivory", "White napkin in bread basket",
  // "Rustic kit: wood platters, white marble bowls", "Guests inside under
  // tent", "Dropbox > green number 1"). Empty = not answered.
  property linenColorTables: string?
  property linenColorBaskets: string?
  property servingwareKit: string?
  property decorKit: string?
  property rainPlan: string?
  property setupDiagram: string?
  // Event Task Breakdown lines (Event Forms One Print, tab 1) that the day
  // sheet above does not hold. One free-text value each ("Plasticware",
  // "Rented", "Client provided", "Yes", "No", "Serve", "Self-serve").
  property servingwareSource: string?
  property takeRentalsWithUs: string?
  property leaveRentalsOnsite: string?
  property guestTableSetup: string?
  property buffetTableSetup: string?
  property appetizerTableSetup: string?
  property beverageTableSetup: string?
  property beverageDispensers: string?
  property buffetService: string?
  // The event binder is built (Ops Final Lock, Part 4). Built or not built:
  // "fully packed" and "ready" describe the load, which the pack list holds.
  property binderBuiltAt: datetime?

  belongsTo client: Client fields [tenantId, clientId] references [tenantId, id]
  ref clientMergeAuthorization: ClientMerge fields [tenantId, clientMergeAuthorizationId] references [tenantId, id]
  ref mergeTargetClient: Client fields [tenantId, mergeTargetClientId] references [tenantId, id]
  ref serviceStyle: ServiceStyle fields [tenantId, serviceStyleId] references [tenantId, id]
  ref occasion: Occasion fields [tenantId, occasionId] references [tenantId, id]
  ref venue: Venue fields [tenantId, venueId] references [tenantId, id]
  ref assignedTo: Person fields [tenantId, assignedToId] references [tenantId, id]
  ref referralSource: ReferralSource fields [tenantId, referralSourceId] references [tenantId, id]
  ref recurrenceTemplateEvent: Event fields [tenantId, recurrenceTemplateEventId] references [tenantId, id]
  hasMany guests: EventGuest
  // EventDish inverse for live estimatedFoodCost rollup (2026-07-23). Culinary
  // EventDish is in the root compile entry; forward ref is resolved at merge.
  hasMany eventDishes: EventDish
  // Ops inverses below require compile entry packing.manifest / time.manifest
  // (or later) so PrepTask/PackList/Delivery/EventAssignment are in scope.
  hasMany prepTasks: PrepTask
  hasMany packLists: PackList
  hasMany deliveries: Delivery
  hasMany assignments: EventAssignment
  hasMany timelineActivities: EventTimelineActivity
  hasMany packetArtifacts: EventPacketArtifact
  hasMany packetIssues: EventPacketIssue
  hasMany packetResolutions: EventPacketResolution
  hasMany packetRevisions: EventPacketRevision
  hasMany layoutSections: EventLayoutSection

  computed isTerminal: boolean = self.stage == "cancelled" or self.stage == "closed_out"
  computed isArchived: boolean = self.archivedAt != null
  computed timingCanRecalculate: boolean = self.deletedAt == null and self.stage != "completed" and self.stage != "closed_out" and self.stage != "cancelled"
  // Same authority as the staffing commands, evaluated for the current reader.
  computed staffingCanManage: boolean = roleAllows(user.role, "workforceManageAccess") or (roleAllows(user.role, "workforceSelfAccess") and roleAllows(user.role, "eventManageAccess"))
  // Mangia Ops Final Lock Training p4. Unknown durations stay unknown.
  // Suggested setup is presented for explicit acceptance, never silently saved.
  computed timingSuggestedSetupMinutes: float? = self.serviceStyle != null and self.serviceStyle.name == "Full Service" ? 180 : (self.serviceStyle != null and self.serviceStyle.name == "Limited Service" ? 90 : null)
  computed timingOnsiteAt: datetime? = self.serviceStartsAt != null and self.timingSetupMinutes != null ? self.serviceStartsAt - self.timingSetupMinutes * 60000 : null
  computed timingDepartShopAt: datetime? = self.timingOnsiteAt != null and self.timingOutboundTravelMinutes != null ? self.timingOnsiteAt - self.timingOutboundTravelMinutes * 60000 : null
  computed timingStaffOnAt: datetime? = self.timingDepartShopAt != null and self.timingLoadMinutes != null ? self.timingDepartShopAt - self.timingLoadMinutes * 60000 : null
  computed timingDepartVenueAt: datetime? = self.endsAt != null and self.timingCleanupMinutes != null ? self.endsAt + self.timingCleanupMinutes * 60000 : null
  computed timingReturnShopAt: datetime? = self.timingDepartVenueAt != null and self.timingReturnTravelMinutes != null ? self.timingDepartVenueAt + self.timingReturnTravelMinutes * 60000 : null
  computed timingStaffOffAt: datetime? = self.timingReturnShopAt != null and self.timingUnloadMinutes != null ? self.timingReturnShopAt + self.timingUnloadMinutes * 60000 : null
  // Mangia Ops Final Lock Training p4: back out 1 hour to load (more for a
  // large event) and allow 1 hour after event end for cleanup and reload.
  // Suggestions only, like timingSuggestedSetupMinutes — never silently saved.
  computed timingSuggestedLoadMinutes: float = 60
  computed timingSuggestedCleanupMinutes: float = 60
  // Binder color code (training part 4): red = cooked on site (full service),
  // green = limited service, blue = drop-off clipboard.
  computed binderColor: string? = self.serviceStyle != null and self.serviceStyle.name == "Full Service" ? "red" : (self.serviceStyle != null and self.serviceStyle.name == "Limited Service" ? "green" : (self.serviceStyle != null and self.serviceStyle.name == "Drop Off" ? "blue" : null))
  computed isEditable: boolean = self.stage == "planning" or self.stage == "pending_approval" or self.stage == "approved" or self.stage == "sales_lock"
  // Setup readiness for approval / automation (UI EventSetupProgress). Distinct
  // from isReadyForExecution (in-flight prep/pack/delivery). Uses raw child
  // fields via count_of — not child computeds (parent rollup limitation).
  computed hasAssignedClient: boolean = self.client != null and self.client.deletedAt == null
  computed hasExpectedHeadcount: boolean = self.expectedHeadcount > 0
  computed hasMenuDishes: boolean = count_of(self.eventDishes, (d) => d.deletedAt == null and d.removedAt == null) > 0
  computed hasStaffAssigned: boolean = count_of(self.assignments, (a) => a.deletedAt == null and a.status != "unassigned") > 0
  computed isSetupReady: boolean = self.hasAssignedClient and self.hasExpectedHeadcount and self.hasMenuDishes and self.hasStaffAssigned
  // Ops Final Lock readiness (training part 3: INFO, EVENT MENU, TIMELINE).
  // A readiness signal for the tracker and the workbook, not a guard on
  // finalizeEvent: live ops stay correctable (domain-gating-restraint.md).
  computed hasServiceStyle: boolean = self.serviceStyleId != null
  computed hasFinalLockTiming: boolean = self.timingStaffOnAt != null and self.timingDepartShopAt != null and self.timingOnsiteAt != null and self.timingStaffOffAt != null
  computed isFinalLockReady: boolean = self.hasServiceStyle and self.hasExpectedHeadcount and self.hasMenuDishes and self.hasFinalLockTiming
  // Readiness projection only — not a beginExecution/confirmSalesLock gate
  // (issue #384; backend §4.3). Staffing coverage math is not product-defined
  // yet (assignments hasMany is navigation only). Draft pack lists do not
  // count as in-flight work (owner anti-tedium rule, issue #12).
  computed isReadyForExecution: boolean = count_of(self.prepTasks, (t) => t.status != "completed" and t.status != "cancelled") == 0 and count_of(self.packLists, (p) => p.status != "dispatched" and p.status != "cancelled" and p.status != "draft") == 0 and count_of(self.deliveries, (d) => d.status != "delivered" and d.status != "cancelled" and d.status != "failed") == 0
  // Live internal food-cost estimate from menu dishes. Does NOT overwrite
  // budgets, invoices, quotedPrice, or locked customer prices.
  computed estimatedFoodCost: money(12, 2) = sum(filter(self.eventDishes, (item) => item.deletedAt == null and item.addedAt != null), (item) => item.estimatedCost)

  // plannedAt gates full engagement invariants while planEngagement mutates fields.
  constraint eventPlanComplete: self.plannedAt == null or (length(trim(self.title)) > 0 and length(trim(self.eventType)) > 0 and self.startsAt != null and self.endsAt != null and self.endsAt > self.startsAt and self.expectedHeadcount >= 1 and self.expectedHeadcount <= 100000 and self.primaryContactName != null and length(trim(self.primaryContactName)) > 0) "Planned events require a title, type, valid date range, headcount, and primary contact"
  constraint validEventVenueCapacity: self.venueCapacity == null or self.venueCapacity >= 0 "Venue capacity cannot be negative"
  constraint validEventPricing: (self.budgetAmount == null or self.budgetAmount >= 0) and (self.quotedPrice == null or self.quotedPrice >= 0) "Event pricing cannot be negative"
  constraint validRecurrenceCount: self.recurrenceGeneratedCount == null or self.recurrenceGeneratedCount >= 1 "Recurring event generated count cannot be below one"
  constraint validRecurrenceSequence: self.recurrenceSequence == null or self.recurrenceSequence >= 2 "Recurring event instances must follow the source event"

  // Quote → Planning → Pending Approval → Approved → Sales Lock → Executing → Final → Complete → Close Out lifecycle
  transition stage from "quote" to ["planning", "cancelled"]
  transition stage from "planning" to ["pending_approval", "cancelled"]
  transition stage from "pending_approval" to ["planning", "approved", "cancelled"]
  transition stage from "approved" to ["sales_lock", "cancelled"]
  transition stage from "sales_lock" to ["executing", "cancelled"]
  transition stage from "executing" to ["final", "cancelled"]
  transition stage from "final" to ["completed", "cancelled"]
  transition stage from "completed" to ["closed_out"]
  transition stage from "cancelled" to []
  transition stage from "closed_out" to []

  default policy eventRead read: roleAllows(user.role, "staffAccess") "Staff may see shared event plans and operational context"
  // Write policies gate command mutation (see Client note); staff tier here,
  // manager-only commands (approve/cancel/changePricing/...) carry guards.
  default policy eventWrite write: roleAllows(user.role, "eventAccess") or roleAllows(user.role, "salesAccess") "Event and sales staff may update events"
  default policy eventExecute execute: roleAllows(user.role, "eventAccess") or roleAllows(user.role, "salesAccess") "Event and sales staff may change events"

  command planEngagement(
    clientId: uuid,
    title: string,
    eventType: string,
    startsAt: datetime,
    endsAt: datetime,
    expectedHeadcount: number,
    primaryContactName: string,
    budgetAmount: money(12, 2),
    quotedPrice: money(12, 2),
    optional clientName: string,
    optional serviceStyleId: uuid,
    optional serviceStyleName: string,
    optional occasionId: uuid,
    optional occasionName: string,
    optional venueId: uuid,
    optional venueName: string,
    optional venueAddress: string,
    optional venueCapacity: number,
    optional primaryContactEmail: string,
    optional primaryContactPhone: string,
    optional accessibilityNeeds: list<string>,
    optional serviceRequirements: string,
    optional operationalRequirements: string,
    optional assignedToId: uuid,
    optional ownerName: string,
    optional referralSourceId: uuid
  ) {
    guard self.stage == "planning"
    guard self.plannedAt == null
    guard self.deletedAt == null
    constraint planTitle: length(trim(title)) > 0 "Event title is required"
    constraint planType: length(trim(eventType)) > 0 "Event type is required"
    constraint planDates: endsAt > startsAt "Event end must be after its start"
    constraint planHeadcount: expectedHeadcount >= 1 and expectedHeadcount <= 100000 "Headcount must be between 1 and 100000"
    constraint planVenueCapacity: venueCapacity == null or venueCapacity >= 0 "Venue capacity cannot be negative"
    constraint planContact: length(trim(primaryContactName)) > 0 "Primary contact name is required"
    constraint planPricing: budgetAmount >= 0 and quotedPrice >= 0 "Event pricing cannot be negative"
    mutate clientId = clientId
    mutate clientName = clientName
    mutate title = title
    mutate eventType = eventType
    mutate startsAt = startsAt
    mutate endsAt = endsAt
    mutate purchasingWeekStart = startsAt - ((startsAt - 374400000) % 604800000)
    mutate serviceStyleId = serviceStyleId
    mutate serviceStyleName = serviceStyleName
    mutate occasionId = occasionId
    mutate occasionName = occasionName
    mutate venueId = venueId
    mutate venueName = venueName
    mutate venueAddress = venueAddress
    mutate venueCapacity = venueCapacity
    mutate expectedHeadcount = expectedHeadcount
    mutate primaryContactName = primaryContactName
    mutate primaryContactEmail = primaryContactEmail
    mutate primaryContactPhone = primaryContactPhone
    mutate accessibilityNeeds = accessibilityNeeds != null ? accessibilityNeeds : []
    mutate serviceRequirements = serviceRequirements
    mutate operationalRequirements = operationalRequirements
    mutate budgetAmount = budgetAmount
    mutate quotedPrice = quotedPrice
    mutate assignedToId = assignedToId
    mutate ownerName = ownerName
    mutate referralSourceId = referralSourceId
    mutate stage = "planning"
    mutate plannedAt = now()
    emit EventPlanned {
      eventId: self.id
      tenantId: self.tenantId
      clientId: clientId
      serviceStyleId: serviceStyleId
      venueId: venueId
      venueCapacity: venueCapacity
      startsAt: startsAt
      endsAt: endsAt
      expectedHeadcount: expectedHeadcount
    }
  }

  // Save incomplete source facts without asserting engagement readiness.
  command captureDraft(
    title: string,
    optional clientId: uuid,
    optional eventType: string,
    optional startsAt: datetime,
    optional endsAt: datetime,
    optional expectedHeadcount: number,
    optional primaryContactName: string,
    optional budgetAmount: money(12, 2),
    optional quotedPrice: money(12, 2),
    optional serviceStyleId: uuid,
    optional occasionId: uuid,
    optional venueId: uuid,
    optional venueName: string,
    optional venueAddress: string,
    optional venueCapacity: number,
    optional primaryContactEmail: string,
    optional primaryContactPhone: string,
    optional accessibilityNeeds: list<string>,
    optional serviceRequirements: string,
    optional operationalRequirements: string,
    optional assignedToId: uuid,
    optional referralSourceId: uuid,
    optional importDraftJson: string,
    optional importSourceKey: string
  ) {
    // Imports only reconcile a draft; planned engagements use their normal edits.
    guard self.stage == "planning"
    guard self.plannedAt == null
    guard self.deletedAt == null
    guard self.draftCapturedAt == null
    constraint draftTitle: length(trim(title)) > 0 "Draft title is required"
    constraint draftHeadcount: expectedHeadcount == null or (expectedHeadcount >= 0 and expectedHeadcount <= 100000) "Headcount must be between 0 and 100000 when known"
    constraint draftPricing: (budgetAmount == null or budgetAmount >= 0) and (quotedPrice == null or quotedPrice >= 0) "Event pricing cannot be negative"
    mutate title = title
    mutate clientId = clientId != null ? clientId : null
    mutate eventType = eventType != null ? eventType : ""
    mutate startsAt = startsAt != null ? startsAt : null
    mutate endsAt = endsAt != null ? endsAt : null
    mutate expectedHeadcount = expectedHeadcount != null ? expectedHeadcount : null
    mutate primaryContactName = primaryContactName != null ? primaryContactName : null
    mutate budgetAmount = budgetAmount != null ? budgetAmount : null
    mutate quotedPrice = quotedPrice != null ? quotedPrice : null
    mutate serviceStyleId = serviceStyleId != null ? serviceStyleId : null
    mutate occasionId = occasionId != null ? occasionId : null
    mutate venueId = venueId != null ? venueId : null
    mutate venueName = venueName != null ? venueName : null
    mutate venueAddress = venueAddress != null ? venueAddress : null
    mutate venueCapacity = venueCapacity != null ? venueCapacity : null
    mutate primaryContactEmail = primaryContactEmail != null ? primaryContactEmail : null
    mutate primaryContactPhone = primaryContactPhone != null ? primaryContactPhone : null
    mutate accessibilityNeeds = accessibilityNeeds != null ? accessibilityNeeds : []
    mutate serviceRequirements = serviceRequirements != null ? serviceRequirements : null
    mutate operationalRequirements = operationalRequirements != null ? operationalRequirements : null
    mutate assignedToId = assignedToId != null ? assignedToId : null
    mutate referralSourceId = referralSourceId != null ? referralSourceId : null
    mutate importDraftJson = importDraftJson != null ? importDraftJson : null
    mutate importSourceKey = importSourceKey != null ? importSourceKey : null
    mutate purchasingWeekStart = startsAt != null ? startsAt - ((startsAt - 374400000) % 604800000) : self.purchasingWeekStart
    mutate deletedAt = null
    mutate plannedAt = null
    mutate draftCapturedAt = now()
    emit EventDraftCaptured {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  // Save incomplete source facts without asserting engagement readiness.
  command updateImportDraft(
    optional title: string,
    optional clientId: uuid,
    optional eventType: string,
    optional startsAt: datetime,
    optional endsAt: datetime,
    optional expectedHeadcount: number,
    optional primaryContactName: string,
    optional budgetAmount: money(12, 2),
    optional quotedPrice: money(12, 2),
    optional serviceStyleId: uuid,
    optional occasionId: uuid,
    optional venueId: uuid,
    optional venueName: string,
    optional venueAddress: string,
    optional venueCapacity: number,
    optional primaryContactEmail: string,
    optional primaryContactPhone: string,
    optional accessibilityNeeds: list<string>,
    optional serviceRequirements: string,
    optional operationalRequirements: string,
    optional assignedToId: uuid,
    optional referralSourceId: uuid,
    optional importDraftJson: string,
    optional importSourceKey: string
  ) {
    // Imports only reconcile a draft; planned engagements use their normal edits.
    guard self.stage == "planning"
    guard self.plannedAt == null
    guard self.deletedAt == null
    constraint draftHeadcount: expectedHeadcount == null or (expectedHeadcount >= 0 and expectedHeadcount <= 100000) "Headcount must be between 0 and 100000 when known"
    constraint draftPricing: (budgetAmount == null or budgetAmount >= 0) and (quotedPrice == null or quotedPrice >= 0) "Event pricing cannot be negative"
    mutate title = title != null ? title : self.title
    mutate clientId = clientId != null ? clientId : self.clientId
    mutate eventType = eventType != null ? eventType : self.eventType
    mutate startsAt = startsAt != null ? startsAt : self.startsAt
    mutate endsAt = endsAt != null ? endsAt : self.endsAt
    mutate expectedHeadcount = expectedHeadcount != null ? expectedHeadcount : self.expectedHeadcount
    mutate primaryContactName = primaryContactName != null ? primaryContactName : self.primaryContactName
    mutate budgetAmount = budgetAmount != null ? budgetAmount : self.budgetAmount
    mutate quotedPrice = quotedPrice != null ? quotedPrice : self.quotedPrice
    mutate serviceStyleId = serviceStyleId != null ? serviceStyleId : self.serviceStyleId
    mutate occasionId = occasionId != null ? occasionId : self.occasionId
    mutate venueId = venueId != null ? venueId : self.venueId
    mutate venueName = venueName != null ? venueName : self.venueName
    mutate venueAddress = venueAddress != null ? venueAddress : self.venueAddress
    mutate venueCapacity = venueCapacity != null ? venueCapacity : self.venueCapacity
    mutate primaryContactEmail = primaryContactEmail != null ? primaryContactEmail : self.primaryContactEmail
    mutate primaryContactPhone = primaryContactPhone != null ? primaryContactPhone : self.primaryContactPhone
    mutate accessibilityNeeds = accessibilityNeeds != null ? accessibilityNeeds : self.accessibilityNeeds
    mutate serviceRequirements = serviceRequirements != null ? serviceRequirements : self.serviceRequirements
    mutate operationalRequirements = operationalRequirements != null ? operationalRequirements : self.operationalRequirements
    mutate assignedToId = assignedToId != null ? assignedToId : self.assignedToId
    mutate referralSourceId = referralSourceId != null ? referralSourceId : self.referralSourceId
    mutate importDraftJson = importDraftJson != null ? importDraftJson : self.importDraftJson
    mutate importSourceKey = importSourceKey != null ? importSourceKey : self.importSourceKey
    mutate purchasingWeekStart = startsAt != null ? startsAt - ((startsAt - 374400000) % 604800000) : self.purchasingWeekStart
    emit EventDraftCaptured {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  command reschedule(startsAt: datetime, endsAt: datetime) {
    guard self.stage == "planning" or self.stage == "pending_approval" or self.stage == "approved" or self.stage == "sales_lock"
    guard self.deletedAt == null
    constraint scheduleDates: endsAt > startsAt "Event end must be after its start"
    compute shiftedServiceStartsAt = self.serviceStartsAt != null and self.startsAt != null ? self.serviceStartsAt + (startsAt - self.startsAt) : self.serviceStartsAt
    compute previousPurchasingWeekStart = self.purchasingWeekStart
    compute nextPurchasingWeekStart = startsAt - ((startsAt - 374400000) % 604800000)
    mutate serviceStartsAt = shiftedServiceStartsAt
    mutate startsAt = startsAt
    mutate endsAt = endsAt
    mutate purchasingWeekStart = nextPurchasingWeekStart
    emit EventScheduleChanged {
      eventId: self.id
      tenantId: self.tenantId
      startsAt: startsAt
      endsAt: endsAt
    }
    // Purchasing follows the event to its new week (#328). The handler moves
    // live ingredient demand and open purchase needs. Fulfilled demand and
    // submitted orders stay on the week they were already bought for.
    emit EventPurchasingWeekChanged {
      eventId: self.id
      tenantId: self.tenantId
      purchasingWeekStart: nextPurchasingWeekStart
      previousPurchasingWeekStart: previousPurchasingWeekStart
    }
  }

  // Repeatable repair for events planned before week keys were normalized:
  // recomputes the week from the stored start and re-drives the same
  // propagation a reschedule does. Safe to run again; a no-op week change
  // still refreshes copies and moves nothing.
  command normalizePurchasingWeek() {
    guard self.stage == "planning" or self.stage == "pending_approval" or self.stage == "approved" or self.stage == "sales_lock" or self.stage == "executing"
    guard self.deletedAt == null
    guard self.startsAt != null
    compute previousPurchasingWeekStart = self.purchasingWeekStart
    compute nextPurchasingWeekStart = self.startsAt - ((self.startsAt - 374400000) % 604800000)
    mutate purchasingWeekStart = nextPurchasingWeekStart
    emit EventPurchasingWeekChanged {
      eventId: self.id
      tenantId: self.tenantId
      purchasingWeekStart: nextPurchasingWeekStart
      previousPurchasingWeekStart: previousPurchasingWeekStart
    }
  }

  // Full timing form: omitted values deliberately clear unknown inputs.
  command configureTiming(
    optional serviceStartsAt: datetime,
    optional setupMinutes: number,
    optional loadMinutes: number,
    optional outboundTravelMinutes: number,
    optional cleanupMinutes: number,
    optional returnTravelMinutes: number,
    optional unloadMinutes: number
  ) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventAccess") or roleAllows(user.role, "manageAccess") "Event staff and managers may plan the event timeline"
    constraint activeEventTiming: self.stage != "completed" and self.stage != "closed_out" and self.stage != "cancelled" "Finished or cancelled events keep their saved timing; correct individual blocks if needed"
    constraint timingSetupNonnegative: setupMinutes == null or setupMinutes >= 0 "Setup minutes cannot be negative"
    constraint timingLoadNonnegative: loadMinutes == null or loadMinutes >= 0 "Load minutes cannot be negative"
    constraint timingOutboundNonnegative: outboundTravelMinutes == null or outboundTravelMinutes >= 0 "Travel minutes cannot be negative"
    constraint timingCleanupNonnegative: cleanupMinutes == null or cleanupMinutes >= 0 "Cleanup minutes cannot be negative"
    constraint timingReturnNonnegative: returnTravelMinutes == null or returnTravelMinutes >= 0 "Return travel minutes cannot be negative"
    constraint timingUnloadNonnegative: unloadMinutes == null or unloadMinutes >= 0 "Unload minutes cannot be negative"
    mutate serviceStartsAt = serviceStartsAt
    mutate timingSetupMinutes = setupMinutes
    mutate timingLoadMinutes = loadMinutes
    mutate timingOutboundTravelMinutes = outboundTravelMinutes
    mutate timingCleanupMinutes = cleanupMinutes
    mutate timingReturnTravelMinutes = returnTravelMinutes
    mutate timingUnloadMinutes = unloadMinutes
    mutate timingConfiguredAt = now()
    emit EventTimingConfigured {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  command configureRecurrence(
    frequency: EventRecurrenceFrequency,
    endCondition: EventRecurrenceEndCondition,
    optional recurrenceEndsAt: datetime,
    optional occurrenceLimit: int,
    nextStartsAt: datetime,
    seriesId: string
  ) {
    guard self.stage == "planning" or self.stage == "pending_approval" or self.stage == "approved"
    guard self.plannedAt != null
    guard self.startsAt != null
    guard self.endsAt != null
    guard self.deletedAt == null
    guard self.recurrenceTemplateEventId == null
    constraint recurrenceSeriesIdPresent: length(trim(seriesId)) > 0 "Recurring series id is required"
    constraint recurrenceNextAfterSource: nextStartsAt > self.startsAt "The first recurring instance must start after the source event"
    constraint recurrenceEndShape: (endCondition == "on_date" and recurrenceEndsAt != null and recurrenceEndsAt >= nextStartsAt and occurrenceLimit == null) or (endCondition == "after_occurrences" and recurrenceEndsAt == null and occurrenceLimit != null and occurrenceLimit >= 2 and occurrenceLimit <= 1000) "Choose an end date that includes another event or a total occurrence count from 2 to 1000"
    mutate recurrenceFrequency = frequency
    mutate recurrenceEndCondition = endCondition
    mutate recurrenceEndsAt = recurrenceEndsAt
    mutate recurrenceOccurrenceLimit = occurrenceLimit
    mutate recurrenceAnchorStartsAt = self.startsAt
    mutate recurrenceNextStartsAt = nextStartsAt
    mutate recurrenceGeneratedCount = 1
    mutate recurrenceSeriesId = seriesId
    mutate recurrenceActive = true
    mutate recurrenceConfiguredAt = now()
    mutate recurrenceStoppedAt = null
    mutate recurrenceCompletedAt = null
    emit EventRecurrenceConfigured {
      eventId: self.id
      tenantId: self.tenantId
      frequency: frequency
      endCondition: endCondition
      recurrenceEndsAt: recurrenceEndsAt
      occurrenceLimit: occurrenceLimit
      nextStartsAt: nextStartsAt
    }
  }

  command stopRecurrence() {
    guard self.recurrenceActive == true
    guard self.deletedAt == null
    mutate recurrenceActive = false
    mutate recurrenceNextStartsAt = null
    mutate recurrenceStoppedAt = now()
    emit EventRecurrenceStopped {
      eventId: self.id
      tenantId: self.tenantId
      generatedCount: self.recurrenceGeneratedCount
    }
  }

  command changeVenue(
    optional venueId: uuid,
    optional venueName: string,
    optional venueAddress: string,
    optional venueCapacity: number
  ) {
    guard self.stage == "planning" or self.stage == "pending_approval" or self.stage == "approved" or self.stage == "sales_lock"
    guard self.deletedAt == null
    constraint changeVenueCapacity: venueCapacity == null or venueCapacity >= 0 "Venue capacity cannot be negative"
    mutate venueId = venueId
    mutate venueName = venueName
    mutate venueAddress = venueAddress
    mutate venueCapacity = venueCapacity
    emit EventVenueChanged {
      eventId: self.id
      tenantId: self.tenantId
      venueId: venueId
      venueName: venueName
      venueAddress: venueAddress
      venueCapacity: venueCapacity
    }
  }

  command changeHeadcount(newHeadcount: number) {
    guard self.stage == "planning" or self.stage == "pending_approval" or self.stage == "approved" or self.stage == "sales_lock" or self.stage == "executing"
    guard self.deletedAt == null
    constraint headcountRange: newHeadcount >= 1 and newHeadcount <= 100000 "Headcount must be between 1 and 100000"
    compute previousHeadcount = self.expectedHeadcount
    mutate expectedHeadcount = newHeadcount
    emit EventHeadcountChanged {
      eventId: self.id
      tenantId: self.tenantId
      previousHeadcount: previousHeadcount
      newHeadcount: newHeadcount
    }
  }

  // Service corrections stay available during live operations; packet review
  // must use this command so the native reference and event audit agree.
  command changeServiceStyle(serviceStyleId: uuid, optional serviceStyleName: string) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventManageAccess")
    constraint serviceStyleReferenceInput: length(trim(serviceStyleId)) > 0 "Events must reference a service style"
    mutate serviceStyleId = serviceStyleId
    mutate serviceStyleName = serviceStyleName != null ? serviceStyleName : self.serviceStyleName
    emit EventServiceStyleChanged {
      eventId: self.id
      tenantId: self.tenantId
      serviceStyleId: serviceStyleId
      serviceStyleName: serviceStyleName
    }
  }

  command changePrimaryContact(
    primaryContactName: string,
    optional primaryContactEmail: string,
    optional primaryContactPhone: string
  ) {
    guard self.stage == "planning" or self.stage == "pending_approval" or self.stage == "approved" or self.stage == "sales_lock"
    guard self.deletedAt == null
    constraint contactName: length(trim(primaryContactName)) > 0 "Primary contact name is required"
    mutate primaryContactName = primaryContactName
    mutate primaryContactEmail = primaryContactEmail
    mutate primaryContactPhone = primaryContactPhone
    emit EventPrimaryContactChanged {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  command stageClientMerge(clientMergeId: uuid, clientId: uuid) {
    guard self.deletedAt == null
    guard roleAllows(user.role, "adminAccess")
    constraint stageDistinctClient: clientId != self.clientId "Event already belongs to this client"
    mutate clientMergeAuthorizationId = clientMergeId
    mutate mergeTargetClientId = clientId
    emit EventClientMergeStaged {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  command reassignClient() {
    guard self.deletedAt == null
    guard roleAllows(user.role, "adminAccess")
    guard self.clientMergeAuthorization != null
    guard self.clientMergeAuthorization.deletedAt == null
    guard self.clientMergeAuthorization.mergedAt != null
    guard self.mergeTargetClient != null
    guard self.mergeTargetClient.status == "active"
    guard self.mergeTargetClient.deletedAt == null
    constraint reassignAuthorizedSource: self.clientMergeAuthorization.duplicateClientId == self.clientId "Merge authorization does not match the event client"
    constraint reassignAuthorizedTarget: self.clientMergeAuthorization.primaryClientId == self.mergeTargetClientId "Merge authorization does not match the primary client"
    compute previousClientId = self.clientId
    mutate clientId = self.mergeTargetClientId
    emit EventClientReassigned {
      eventId: self.id
      tenantId: self.tenantId
      previousClientId: previousClientId
      clientId: self.mergeTargetClientId
    }
  }

  command changeRequirements(
    optional accessibilityNeeds: list<string>,
    optional serviceRequirements: string,
    optional operationalRequirements: string
  ) {
    guard self.stage == "planning" or self.stage == "pending_approval" or self.stage == "approved" or self.stage == "sales_lock"
    guard self.deletedAt == null
    mutate accessibilityNeeds = accessibilityNeeds != null ? accessibilityNeeds : []
    mutate serviceRequirements = serviceRequirements
    mutate operationalRequirements = operationalRequirements
    emit EventRequirementsChanged {
      eventId: self.id
      tenantId: self.tenantId
      accessibilityNeeds: accessibilityNeeds != null ? accessibilityNeeds : []
      serviceRequirements: serviceRequirements
      operationalRequirements: operationalRequirements
    }
  }

  // Day-sheet save for the battle board. Deliberately NOT stage-gated: the
  // board is a day-of document and live ops must stay correctable during the
  // event (docs/architecture/domain-gating-restraint.md). The editor sends
  // the full set every save; the UI clears a badge by writing an empty
  // string.
  command updateDaySheet(
    optional barService: string,
    optional cocktailHourFood: string,
    optional dessertService: string,
    optional bussing: string,
    optional placeSettings: string,
    optional passedApps: string,
    optional stationaryApps: string,
    optional beveragesOnMenu: string,
    optional tablesideWater: string,
    optional mangiaDisposables: string,
    optional eventRentals: string,
    optional scullery: string,
    optional powerOnsite: string,
    optional waterOnsite: string,
    optional buffetColdPlates: string,
    optional buffetHotPlates: string
  ) {
    guard self.deletedAt == null
    mutate barService = barService
    mutate cocktailHourFood = cocktailHourFood
    mutate dessertService = dessertService
    mutate bussing = bussing
    mutate placeSettings = placeSettings
    mutate passedApps = passedApps
    mutate stationaryApps = stationaryApps
    mutate beveragesOnMenu = beveragesOnMenu
    mutate tablesideWater = tablesideWater
    mutate mangiaDisposables = mangiaDisposables
    mutate eventRentals = eventRentals
    mutate scullery = scullery
    mutate powerOnsite = powerOnsite
    mutate waterOnsite = waterOnsite
    mutate buffetColdPlates = buffetColdPlates
    mutate buffetHotPlates = buffetHotPlates
    emit EventDaySheetUpdated {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  // An omitted value keeps what is saved; send "" to clear one. A caller that
  // knows one answer (the BEO reader, the assistant) must not wipe the rest.
  command updateSetupNotes(
    optional linenColorTables: string,
    optional linenColorBaskets: string,
    optional servingwareKit: string,
    optional decorKit: string,
    optional rainPlan: string,
    optional setupDiagram: string
  ) {
    guard self.deletedAt == null
    mutate linenColorTables = linenColorTables != null ? linenColorTables : self.linenColorTables
    mutate linenColorBaskets = linenColorBaskets != null ? linenColorBaskets : self.linenColorBaskets
    mutate servingwareKit = servingwareKit != null ? servingwareKit : self.servingwareKit
    mutate decorKit = decorKit != null ? decorKit : self.decorKit
    mutate rainPlan = rainPlan != null ? rainPlan : self.rainPlan
    mutate setupDiagram = setupDiagram != null ? setupDiagram : self.setupDiagram
    emit EventSetupNotesUpdated {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  command updateTaskBreakdown(
    optional servingwareSource: string,
    optional takeRentalsWithUs: string,
    optional leaveRentalsOnsite: string,
    optional guestTableSetup: string,
    optional buffetTableSetup: string,
    optional appetizerTableSetup: string,
    optional beverageTableSetup: string,
    optional beverageDispensers: string,
    optional buffetService: string
  ) {
    guard self.deletedAt == null
    mutate servingwareSource = servingwareSource != null ? servingwareSource : self.servingwareSource
    mutate takeRentalsWithUs = takeRentalsWithUs != null ? takeRentalsWithUs : self.takeRentalsWithUs
    mutate leaveRentalsOnsite = leaveRentalsOnsite != null ? leaveRentalsOnsite : self.leaveRentalsOnsite
    mutate guestTableSetup = guestTableSetup != null ? guestTableSetup : self.guestTableSetup
    mutate buffetTableSetup = buffetTableSetup != null ? buffetTableSetup : self.buffetTableSetup
    mutate appetizerTableSetup = appetizerTableSetup != null ? appetizerTableSetup : self.appetizerTableSetup
    mutate beverageTableSetup = beverageTableSetup != null ? beverageTableSetup : self.beverageTableSetup
    mutate beverageDispensers = beverageDispensers != null ? beverageDispensers : self.beverageDispensers
    mutate buffetService = buffetService != null ? buffetService : self.buffetService
    emit EventTaskBreakdownUpdated {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  // Omit the number and the seam gives the event the next free one. The seam
  // also refuses a number that is not 4 to 6 digits or that another event holds.
  command setEventNumber(optional eventNumber: string) {
    guard self.deletedAt == null
    // Stored trimmed: the numbering seam looks a number up by this exact value.
    mutate eventNumber = eventNumber != null ? trim(eventNumber) : null
    emit EventNumberSet {
      eventId: self.id
      tenantId: self.tenantId
      eventNumber: eventNumber
    }
  }

  command markBinderBuilt() {
    guard self.deletedAt == null
    mutate binderBuiltAt = now()
    emit EventBinderBuilt {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  // A binder that is taken apart again (the event changed after the print).
  command clearBinderBuilt() {
    guard self.binderBuiltAt != null
    guard self.deletedAt == null
    mutate binderBuiltAt = null
    emit EventBinderBuiltCleared {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  command changePricing(budgetAmount: money(12, 2), quotedPrice: money(12, 2)) {
    guard self.stage == "planning" or self.stage == "pending_approval" or self.stage == "approved"
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventManageAccess") or roleAllows(user.role, "salesManageAccess")
    constraint pricingNonnegative: budgetAmount >= 0 and quotedPrice >= 0 "Event pricing cannot be negative"
    mutate budgetAmount = budgetAmount
    mutate quotedPrice = quotedPrice
    emit EventPricingChanged {
      eventId: self.id
      tenantId: self.tenantId
      budgetAmount: budgetAmount
      quotedPrice: quotedPrice
    }
  }

  // AC-228: completion freezes Event.changePricing. An authorized
  // correction with a reason still updates the commercial seed and
  // writes one EventCommercialCorrected ledger row. Allowed at
  // completed and closed_out only — sales_lock change-orders are
  // PL-COMMERCIAL-CHANGE, not this command.
  command correctCommercial(reason: string, budgetAmount: money(12, 2), quotedPrice: money(12, 2)) {
    guard self.stage == "completed" or self.stage == "closed_out"
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventManageAccess") or roleAllows(user.role, "salesManageAccess")
    constraint correctionReasonPresent: length(trim(reason)) > 0 "Correction reason is required"
    constraint correctionPricingNonnegative: budgetAmount >= 0 and quotedPrice >= 0 "Event pricing cannot be negative"
    mutate budgetAmount = budgetAmount
    mutate quotedPrice = quotedPrice
    emit EventCommercialCorrected {
      eventId: self.id
      tenantId: self.tenantId
      reason: reason
      budgetAmount: budgetAmount
      quotedPrice: quotedPrice
    }
  }

  command assignOwner(optional assignedToId: uuid, optional ownerName: string) {
    guard self.stage == "planning" or self.stage == "pending_approval" or self.stage == "approved" or self.stage == "sales_lock"
    guard self.deletedAt == null
    mutate assignedToId = assignedToId
    mutate ownerName = assignedToId == null ? null : (ownerName != null ? ownerName : self.ownerName)
    emit EventOwnerAssigned {
      eventId: self.id
      tenantId: self.tenantId
      assignedToId: assignedToId
      startsAt: self.startsAt
      endsAt: self.endsAt
    }
  }

  command submitForApproval() {
    guard self.stage == "planning"
    guard self.plannedAt != null
    guard self.deletedAt == null
    mutate stage = "pending_approval"
    emit EventSubmittedForApproval {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  command returnToPlanning(reason: string) {
    // Transition table + EventReturnToPlanningLifecycle: quote→planning and
    // pending_approval→planning. approved cannot regress (only sales_lock or cancelled).
    guard self.stage == "quote" or self.stage == "pending_approval"
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventManageAccess")
    constraint returnReason: length(trim(reason)) > 0 "Return reason is required"
    mutate stage = "planning"
    mutate approvedAt = null
    emit EventReturnedToPlanning {
      eventId: self.id
      tenantId: self.tenantId
      reason: reason
    }
  }

  command approve() {
    guard self.stage == "pending_approval"
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventManageAccess")
    mutate stage = "approved"
    mutate approvedAt = now()
    emit EventApproved {
      eventId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      expectedHeadcount: self.expectedHeadcount
      startsAt: self.startsAt
      endsAt: self.endsAt
      quotedPrice: self.quotedPrice
      assignedToId: self.assignedToId
    }
  }

  command beginExecution() {
    // Readiness is a projection (isReadyForExecution), not a lifecycle gate:
    // service start must not freeze on unfinished prep/pack/delivery.
    guard self.stage == "sales_lock"
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventAccess")
    mutate stage = "executing"
    mutate executionStartedAt = now()
    emit EventExecutionStarted {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  command complete() {
    guard self.stage == "final"
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventManageAccess")
    mutate stage = "completed"
    mutate completedAt = now()
    emit EventCompleted {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  command cancel(reason: string) {
    guard self.stage == "quote" or self.stage == "planning" or self.stage == "pending_approval" or self.stage == "approved" or self.stage == "sales_lock" or self.stage == "executing" or self.stage == "final"
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventManageAccess")
    constraint cancellationReasonPresent: length(trim(reason)) > 0 "Cancellation reason is required"
    mutate stage = "cancelled"
    mutate cancellationReason = reason
    mutate cancelledAt = now()
    emit EventCancelled {
      eventId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      reason: reason
    }
  }

  command closeOut() {
    guard self.stage == "completed"
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventManageAccess")
    mutate stage = "closed_out"
    mutate closedOutAt = now()
    emit EventClosedOut {
      eventId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      expectedHeadcount: self.expectedHeadcount
      quotedPrice: self.quotedPrice
      budgetAmount: self.budgetAmount
    }
  }

  // Archive hides the Event from the active list (AC-239). It is a visibility
  // flag, not a stage move: any live stage can be archived, and stage, money,
  // and headcount stay exactly as they are.
  command archive(reason: string) {
    guard self.deletedAt == null
    guard self.archivedAt == null
    guard roleAllows(user.role, "eventManageAccess")
    constraint archiveReasonPresent: length(trim(reason)) > 0 "Archive reason is required"
    mutate archivedAt = now()
    mutate archiveReason = reason
    emit EventArchived {
      eventId: self.id
      tenantId: self.tenantId
      reason: reason
    }
  }

  command reactivate() {
    guard self.deletedAt == null
    guard self.archivedAt != null
    guard roleAllows(user.role, "eventManageAccess")
    mutate archivedAt = null
    mutate archiveReason = null
    emit EventReactivated {
      eventId: self.id
      tenantId: self.tenantId
    }
  }

  // Sales Lock pipeline commands per spec §3.3
  command lockForSales() {
    guard self.stage == "approved"
    guard self.deletedAt == null
    guard roleAllows(user.role, "salesAccess")
    // Completeness check: event must have essential data before sales lock
    guard self.clientId != null
    guard self.plannedAt != null
    guard self.startsAt != null
    guard self.endsAt != null
    guard self.expectedHeadcount > 0
    mutate stage = "sales_lock"
    mutate salesLockedAt = now()
    emit EventSalesLocked {
      eventId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      expectedHeadcount: self.expectedHeadcount
      quotedPrice: self.quotedPrice
      startsAt: self.startsAt
      endsAt: self.endsAt
    }
  }

  command confirmSalesLock() {
    guard self.stage == "sales_lock"
    guard self.deletedAt == null
    guard roleAllows(user.role, "salesAccess")
    mutate stage = "executing"
    mutate executionStartedAt = now()
    emit EventSalesLockConfirmed {
      eventId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      startsAt: self.startsAt
    }
  }

  command finalizeEvent() {
    guard self.stage == "executing"
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventManageAccess")
    // Freeze reporting snapshot - event must be complete before finalization
    mutate stage = "final"
    mutate finalizedAt = now()
    emit EventFinalized {
      eventId: self.id
      tenantId: self.tenantId
      clientId: self.clientId
      expectedHeadcount: self.expectedHeadcount
      quotedPrice: self.quotedPrice
    }
  }

  store Event in durable
}

// ---------------------------------------------------------------------------
// EventGuest — individual invitation, RSVP, accommodation, and check-in facts.
// Aggregate Event.expectedHeadcount changes only through Event.changeHeadcount.
// ---------------------------------------------------------------------------

entity EventGuest mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required eventId: uuid
  property required searchable name: string = ""
  property encrypted email: string?
  property encrypted phone: string?
  property dietaryRestrictions: list<string> = []
  property allergenRestrictions: list<string> = []
  property accessibilityNeeds: list<string> = []
  property required specialMealRequired: boolean = false
  property required rsvpStatus: RsvpStatus = "pending"
  property invitedAt: datetime?
  property respondedAt: datetime?
  property declineReason: string?
  property checkedInAt: datetime?
  property tableAssignment: string?

  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]

  computed isCheckedIn: boolean = self.checkedInAt != null

  constraint guestIdentityComplete: self.invitedAt == null or length(trim(self.name)) > 0 "Invited guests require a name"

  transition rsvpStatus from "pending" to ["confirmed", "declined"]
  transition rsvpStatus from "confirmed" to ["confirmed", "declined"]
  transition rsvpStatus from "declined" to []

  default policy eventGuestRead read: roleAllows(user.role, "eventAccess") "Event staff may see guest attendance"
  default policy eventGuestWrite write: roleAllows(user.role, "eventAccess") "Event staff may update the guest list"
  default policy eventGuestExecute execute: roleAllows(user.role, "eventAccess") "Event staff may change the guest list"

  command invite(
    eventId: uuid,
    name: string,
    optional email: string,
    optional phone: string,
    optional dietaryRestrictions: list<string>,
    optional allergenRestrictions: list<string>,
    optional accessibilityNeeds: list<string>,
    optional specialMealRequired: boolean
  ) {
    guard self.invitedAt == null
    guard self.deletedAt == null
    constraint inviteGuestName: length(trim(name)) > 0 "Guest name is required"
    mutate eventId = eventId
    mutate name = name
    mutate email = email
    mutate phone = phone
    mutate dietaryRestrictions = dietaryRestrictions != null ? dietaryRestrictions : []
    mutate allergenRestrictions = allergenRestrictions != null ? allergenRestrictions : []
    mutate accessibilityNeeds = accessibilityNeeds != null ? accessibilityNeeds : []
    mutate specialMealRequired = specialMealRequired != null ? specialMealRequired : false
    mutate rsvpStatus = "pending"
    mutate invitedAt = now()
    emit EventGuestInvited {
      guestId: self.id
      tenantId: self.tenantId
      eventId: eventId
      name: name
    }
  }

  command rsvpConfirm() {
    guard self.rsvpStatus == "pending" or self.rsvpStatus == "confirmed"
    guard self.deletedAt == null
    mutate rsvpStatus = "confirmed"
    mutate respondedAt = now()
    mutate declineReason = null
    emit EventGuestRsvpConfirmed {
      guestId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  command rsvpDecline(optional reason: string) {
    guard self.rsvpStatus == "pending" or self.rsvpStatus == "confirmed"
    guard self.deletedAt == null
    mutate rsvpStatus = "declined"
    mutate respondedAt = now()
    mutate declineReason = reason
    emit EventGuestRsvpDeclined {
      guestId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      reason: reason
    }
  }

  command checkIn() {
    guard self.rsvpStatus == "confirmed"
    guard self.checkedInAt == null
    guard self.deletedAt == null
    compute checkInTime = now()
    mutate checkedInAt = checkInTime
    emit EventGuestCheckedIn {
      guestId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      checkedInAt: checkInTime
    }
  }

  command assignTable(tableAssignment: string) {
    guard self.rsvpStatus != "declined"
    guard self.deletedAt == null
    constraint tableAssignmentPresent: length(trim(tableAssignment)) > 0 "Table assignment is required"
    mutate tableAssignment = tableAssignment
    emit EventGuestTableAssigned {
      guestId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      tableAssignment: tableAssignment
    }
  }

  command withdraw(reason: string) {
    guard self.deletedAt == null
    constraint withdrawReasonPresent: length(trim(reason)) > 0 "Withdrawal reason is required"
    mutate deletedAt = now()
    emit EventGuestWithdrawn {
      guestId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      reason: reason
    }
  }

  store EventGuest in durable
}

// ---------------------------------------------------------------------------
// EventTimelineActivity — a named activity on an event's day-of timeline
// (vendor arrival, kitchen production start, guest arrival, service, breakdown)
// with an optional planned time and responsible party. Rendered as a Gantt-style strip on
// the event detail page and exported to the BEO.
// ---------------------------------------------------------------------------

entity EventTimelineActivity mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required eventId: uuid
  property required searchable name: string = ""
  // Planning block type: load_in, setup, bar_setup, kitchen_setup, service, etc.
  property category: string?
  property startsAt: datetime?
  property endsAt: datetime?
  // Legacy single-string label; kept in sync with assigneeTeams + people for BEO/export.
  property responsibleParty: string?
  // Team buckets: Everyone, FOH, BOH (multi-select with people).
  property assigneeTeams: list<string> = []
  // Individual staff Person ids assigned to this block (multi-select).
  // Stored as string ids (Convex document ids), not RFC UUIDs.
  property assigneePersonIds: list<string> = []
  property notes: string?
  // Site planning notes (parking, loading access, entrances, kitchen/bar location).
  property siteNotes: string?
  // Manual battle-board order (drag-and-drop); lower sorts first.
  // Optional so older timeline rows without the field still load.
  property sortOrder: int = 0
  property scheduledAt: datetime?
  // Run-of-show completion (event-day tracker): the crew marks the block
  // done during the event; null = still open.
  property completedAt: datetime?
  property completedByPersonId: string?
  // Keep automatic planning separate from manual timing and performed work.
  property timingMilestone: EventTimingMilestone?
  property timingManuallyAdjustedAt: datetime?
  property timingPerformedAt: datetime?

  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]

  constraint timelineActivityNameComplete: self.scheduledAt == null or length(trim(self.name)) > 0 "Timeline activities require a name once scheduled"
  constraint timelineActivityWindowOrdered: self.startsAt == null or self.endsAt == null or self.endsAt >= self.startsAt "Timeline activity end must not precede its start"
  constraint timelineActivitySortNonnegative: self.sortOrder >= 0 "Timeline activity sort order cannot be negative"

  default policy eventTimelineActivityRead read: roleAllows(user.role, "staffAccess") "Staff may see the shared event timeline"
  default policy eventTimelineActivityWrite write: roleAllows(user.role, "staffAccess") "Staff may add timeline work"
  default policy eventTimelineActivityExecute execute: roleAllows(user.role, "staffAccess") "Staff may change timeline work"

  command schedule(
    eventId: uuid,
    name: string,
    optional startsAt: datetime,
    optional endsAt: datetime,
    optional responsibleParty: string,
    optional notes: string,
    optional category: string,
    optional siteNotes: string,
    optional sortOrder: number,
    optional assigneeTeams: list<string>,
    optional assigneePersonIds: list<string>
  ) {
    guard self.scheduledAt == null
    guard self.deletedAt == null
    constraint scheduleActivityName: length(trim(name)) > 0 "Activity name is required"
    // Preserve the planning access boundary while crew can mark work done.
    guard roleAllows(user.role, "eventAccess") or roleAllows(user.role, "manageAccess") "Event staff and managers may schedule the event timeline"
    constraint scheduleActivityWindow: startsAt == null or endsAt == null or endsAt >= startsAt "Activity end must not precede its start"
    constraint scheduleActivitySort: sortOrder == null or sortOrder >= 0 "Timeline activity sort order cannot be negative"
    mutate eventId = eventId
    mutate name = name
    mutate startsAt = startsAt
    mutate endsAt = endsAt
    mutate responsibleParty = responsibleParty
    mutate notes = notes
    mutate category = category
    mutate siteNotes = siteNotes
    mutate sortOrder = sortOrder != null ? sortOrder : 0
    mutate assigneeTeams = assigneeTeams != null ? assigneeTeams : []
    mutate assigneePersonIds = assigneePersonIds != null ? assigneePersonIds : []
    mutate scheduledAt = now()
    emit EventTimelineActivityScheduled {
      activityId: self.id
      tenantId: self.tenantId
      eventId: eventId
      name: name
      startsAt: startsAt
    }
  }

  command adjust(
    optional name: string,
    optional startsAt: datetime,
    optional endsAt: datetime,
    optional clearStartsAt: boolean,
    optional clearEndsAt: boolean,
    optional responsibleParty: string,
    optional notes: string,
    optional category: string,
    optional siteNotes: string,
    optional sortOrder: number,
    optional assigneeTeams: list<string>,
    optional assigneePersonIds: list<string>
  ) {
    guard self.scheduledAt != null
    guard self.deletedAt == null
    constraint adjustActivityName: name == null or length(trim(name)) > 0 "Activity name cannot be blanked"
    guard roleAllows(user.role, "eventAccess") or roleAllows(user.role, "manageAccess") "Event staff and managers may adjust the event timeline"
    constraint adjustActivitySort: sortOrder == null or sortOrder >= 0 "Timeline activity sort order cannot be negative"
    compute nextStartsAt = clearStartsAt == true ? null : (startsAt != null ? startsAt : self.startsAt)
    compute nextEndsAt = clearEndsAt == true ? null : (endsAt != null ? endsAt : self.endsAt)
    compute manualTimingChanged = (clearStartsAt == true and self.startsAt != null) or (clearEndsAt == true and self.endsAt != null) or (startsAt != null and startsAt != self.startsAt) or (endsAt != null and endsAt != self.endsAt)
    mutate timingManuallyAdjustedAt = self.timingMilestone != null and manualTimingChanged ? now() : self.timingManuallyAdjustedAt
    // Validate time edits; unrelated notes/assignments can still repair legacy work.
    constraint adjustActivityWindow: (startsAt == null and endsAt == null) or clearStartsAt == true or clearEndsAt == true or (startsAt == null and self.startsAt == null) or (endsAt == null and self.endsAt == null) or (endsAt != null ? endsAt : self.endsAt) >= (startsAt != null ? startsAt : self.startsAt) "Activity end must not precede its start"
    mutate name = name != null ? name : self.name
    mutate startsAt = nextStartsAt
    mutate endsAt = nextEndsAt
    mutate responsibleParty = responsibleParty != null ? responsibleParty : self.responsibleParty
    mutate notes = notes != null ? notes : self.notes
    mutate category = category != null ? category : self.category
    mutate siteNotes = siteNotes != null ? siteNotes : self.siteNotes
    mutate sortOrder = sortOrder != null ? sortOrder : self.sortOrder
    mutate assigneeTeams = assigneeTeams != null ? assigneeTeams : self.assigneeTeams
    mutate assigneePersonIds = assigneePersonIds != null ? assigneePersonIds : self.assigneePersonIds
    emit EventTimelineActivityAdjusted {
      activityId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  // Event-day tracker: mark a run-of-show block done (and undo it).
  command complete(optional completedByPersonId: string) {
    guard self.deletedAt == null
    mutate timingPerformedAt = self.timingPerformedAt != null ? self.timingPerformedAt : now()
    mutate completedAt = now()
    // Keep the optional input for older callers; attribution comes from sign-in.
    mutate completedByPersonId = user.personId
    emit EventTimelineActivityCompleted {
      activityId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  // Reconcile only the timing window. Names, notes, assignments and order stay.
  command planTiming(
    milestone: EventTimingMilestone,
    optional startsAt: datetime,
    optional endsAt: datetime
  ) {
    guard self.deletedAt == null
    guard self.scheduledAt != null
    guard roleAllows(user.role, "eventAccess") or roleAllows(user.role, "manageAccess") "Event staff and managers may plan the event timeline"
    constraint activeTimingParent: self.event != null and self.event.deletedAt == null and self.event.stage != "completed" and self.event.stage != "closed_out" and self.event.stage != "cancelled" "Calculated timing requires an active event; historical blocks keep their saved times"
    constraint sameTimingMilestone: self.timingMilestone == null or self.timingMilestone == milestone "This block already represents another timing milestone"
    constraint plannedTimingWindow: startsAt == null or endsAt == null or endsAt >= startsAt "Activity end must not precede its start"
    compute keepTiming = self.completedAt != null or self.timingPerformedAt != null or self.timingManuallyAdjustedAt != null or (self.timingMilestone == null and (self.startsAt != null or self.endsAt != null))
    mutate timingManuallyAdjustedAt = self.timingMilestone == null and (self.startsAt != null or self.endsAt != null) ? now() : self.timingManuallyAdjustedAt
    mutate timingMilestone = milestone
    mutate startsAt = keepTiming ? self.startsAt : startsAt
    mutate endsAt = keepTiming ? self.endsAt : endsAt
    emit EventTimelineTimingPlanned {
      activityId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  command useCalculatedTiming() {
    guard self.deletedAt == null
    guard self.timingMilestone != null
    guard roleAllows(user.role, "eventAccess") or roleAllows(user.role, "manageAccess") "Event staff and managers may plan the event timeline"
    constraint activeCalculatedTimingParent: self.event != null and self.event.deletedAt == null and self.event.stage != "completed" and self.event.stage != "closed_out" and self.event.stage != "cancelled" "Calculated timing requires an active event; historical blocks keep their saved times"
    // An explicit return to the plan may change manual times, not work history.
    constraint preservePerformedTiming: self.completedAt == null and self.timingPerformedAt == null "Performed work keeps its saved time"
    mutate timingManuallyAdjustedAt = null
    emit EventTimelineCalculatedTimingRequested {
      activityId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  command reopen() {
    guard self.deletedAt == null
    mutate completedAt = null
    mutate completedByPersonId = null
    emit EventTimelineActivityReopened {
      activityId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  command remove() {
    guard self.deletedAt == null
    guard roleAllows(user.role, "eventAccess") or roleAllows(user.role, "manageAccess") "Event staff and managers may remove event timeline activities"
    mutate deletedAt = now()
    emit EventTimelineActivityRemoved {
      activityId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  store EventTimelineActivity in durable
}

// Staff discussion: null activityId = event-level thread (Overview tab).
// Optional activityId scopes a comment to one Timeline run-sheet block.
entity EventTimelineComment mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required eventId: uuid
  // Optional timeline block id (Convex document id string).
  property activityId: string?
  property required authorPersonId: uuid
  property required authorName: string = ""
  // Stamped from trusted auth context on post; never accepted from the browser.
  property authorAuthSubjectId: string?
  property required body: string = ""
  property postedAt: datetime?

  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]
  belongsTo author: Person fields [tenantId, authorPersonId] references [tenantId, id]

  constraint timelineCommentBody: self.postedAt == null or length(trim(self.body)) > 0 "Timeline comment text is required"

  default policy eventTimelineCommentRead read: roleAllows(user.role, "eventAccess") "Event staff may see timeline comments"
  default policy eventTimelineCommentWrite write: roleAllows(user.role, "eventAccess") "Event staff may add timeline comments"
  default policy eventTimelineCommentExecute execute: roleAllows(user.role, "eventAccess") "Event staff may change timeline comments"

  command post(
    eventId: uuid,
    authorPersonId: uuid,
    authorName: string,
    body: string,
    optional activityId: string
  ) {
    guard self.postedAt == null
    guard self.deletedAt == null
    guard user.id != null
    constraint postTimelineCommentBody: length(trim(body)) > 0 "Comment text is required"
    constraint postTimelineCommentAuthor: length(trim(authorName)) > 0 "Author name is required"
    mutate eventId = eventId
    mutate activityId = activityId
    mutate authorPersonId = authorPersonId
    mutate authorName = authorName
    mutate authorAuthSubjectId = user.id
    mutate body = body
    mutate postedAt = now()
    emit EventTimelineCommentPosted {
      commentId: self.id
      tenantId: self.tenantId
      eventId: eventId
      authorPersonId: authorPersonId
    }
  }

  command remove() {
    guard self.deletedAt == null
    guard self.authorAuthSubjectId == user.id or roleAllows(user.role, "adminAccess")
    mutate deletedAt = now()
    emit EventTimelineCommentRemoved {
      commentId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  store EventTimelineComment in durable
}

// ---------------------------------------------------------------------------
// EventLayoutSection — battle-board layout / setup area on an event
// (Buffet, Bar, Kitchen, Parking, …) with free-text instructions.
// ---------------------------------------------------------------------------

entity EventLayoutSection mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required eventId: uuid
  property required type: string = ""
  property instructions: string?
  property required sortOrder: int = 0
  property addedAt: datetime?

  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]

  constraint layoutSectionTypeComplete: self.addedAt == null or length(trim(self.type)) > 0 "Layout section type is required once added"
  constraint layoutSectionSortNonnegative: self.sortOrder >= 0 "Layout section sort order cannot be negative"

  default policy eventLayoutSectionRead read: roleAllows(user.role, "eventAccess") "Event staff may see event layout sections"
  default policy eventLayoutSectionWrite write: roleAllows(user.role, "eventAccess") "Event staff may update the floor plan"
  default policy eventLayoutSectionExecute execute: roleAllows(user.role, "eventAccess") "Event staff may change the floor plan"

  command add(
    eventId: uuid,
    type: string,
    optional instructions: string,
    optional sortOrder: number
  ) {
    guard self.addedAt == null
    guard self.deletedAt == null
    constraint addLayoutType: length(trim(type)) > 0 "Layout section type is required"
    constraint addLayoutSort: sortOrder == null or sortOrder >= 0 "Layout section sort order cannot be negative"
    mutate eventId = eventId
    mutate type = type
    mutate instructions = instructions
    mutate sortOrder = sortOrder != null ? sortOrder : 0
    mutate addedAt = now()
    emit EventLayoutSectionAdded {
      sectionId: self.id
      tenantId: self.tenantId
      eventId: eventId
      type: type
      sortOrder: sortOrder != null ? sortOrder : 0
    }
  }

  command update(
    optional type: string,
    optional instructions: string,
    optional sortOrder: number
  ) {
    guard self.addedAt != null
    guard self.deletedAt == null
    constraint updateLayoutType: type == null or length(trim(type)) > 0 "Layout section type cannot be blanked"
    constraint updateLayoutSort: sortOrder == null or sortOrder >= 0 "Layout section sort order cannot be negative"
    mutate type = type != null ? type : self.type
    mutate instructions = instructions != null ? instructions : self.instructions
    mutate sortOrder = sortOrder != null ? sortOrder : self.sortOrder
    emit EventLayoutSectionUpdated {
      sectionId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  command remove() {
    guard self.deletedAt == null
    mutate deletedAt = now()
    emit EventLayoutSectionRemoved {
      sectionId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
    }
  }

  store EventLayoutSection in durable
}

