// VenueLayoutTemplate — reusable layout/logistics templates owned by a Venue.
//
// Spec §8.2: "A Venue can own reusable layout/logistics templates. An Event
// selects or copies one into an Event-specific snapshot that can be edited
// without rewriting the venue template."
//
// `sections` is a JSON array of { type, instructions, sortOrder } mirroring
// EventLayoutSection's fields, so copying a template into an event creates
// EventLayoutSection rows verbatim. The template is the reusable source; the
// event snapshot stays independently editable.

enum VenueLayoutTemplateStatus {
  active
  archived
}

entity VenueLayoutTemplate mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required venueId: uuid
  property required searchable name: string = ""
  property description: string?
  // JSON array of layout sections: [{ "type": string, "instructions": string|null, "sortOrder": number }].
  // Stored as a string (same posture as ProposalRevision.snapshot) and parsed
  // client-side; mirrors EventLayoutSection so a copy needs no transformation.
  property required sections: string = "[]"
  property required status: VenueLayoutTemplateStatus = "active"
  property definedAt: datetime?
  property archivedAt: datetime?
  property archiveReason: string?

  belongsTo venue: Venue fields [tenantId, venueId] references [tenantId, id]

  computed isActive: boolean = self.status == "active"

  constraint templateComplete: self.definedAt == null or length(trim(self.name)) > 0 "Defined templates require a name"

  transition status from "active" to ["archived"]
  transition status from "archived" to ["active"]

  default policy venueLayoutTemplateRead read: roleAllows(user.role, "eventAccess") "Event staff may read venue layout templates"
  default policy venueLayoutTemplateWrite write: roleAllows(user.role, "eventAccess") "Event staff may write venue layout templates through commands"
  default policy venueLayoutTemplateExecute execute: roleAllows(user.role, "eventAccess") "Event staff may execute venue layout template commands"

  command define(
    venueId: uuid,
    name: string,
    optional description: string,
    optional sections: string
  ) {
    // No `guard self.createdAt == null`: the `timestamps` mixin auto-populates
    // createdAt before guards run, so that guard always threw in the create
    // path (the bug that sank the first venue-layout-template attempt).
    // `definedAt` is set inside this command, so guarding on it correctly
    // means "not yet defined".
    guard self.definedAt == null
    guard self.deletedAt == null
    constraint defineTemplateName: length(trim(name)) > 0 "Template name is required"
    mutate venueId = venueId
    mutate name = name
    mutate description = description
    mutate sections = sections != null ? sections : "[]"
    mutate definedAt = now()
    emit VenueLayoutTemplateDefined {
      templateId: self.id
      tenantId: self.tenantId
      venueId: venueId
      name: name
    }
  }

  command revise(
    name: string,
    optional description: string,
    optional sections: string
  ) {
    guard self.definedAt != null
    guard self.status == "active"
    guard self.deletedAt == null
    constraint reviseTemplateName: length(trim(name)) > 0 "Template name is required"
    mutate name = name
    mutate description = description
    mutate sections = sections != null ? sections : self.sections
    emit VenueLayoutTemplateRevised {
      templateId: self.id
      tenantId: self.tenantId
      venueId: self.venueId
      name: name
    }
  }

  command archive(optional reason: string) {
    guard self.status == "active"
    guard self.definedAt != null
    guard self.deletedAt == null
    // Reason is optional: archiving is reversible and low-stakes, so forcing a
    // reason is exactly the policy tedium the merge gate prohibits. It is
    // captured only when staff choose to record one.
    mutate status = "archived"
    mutate archivedAt = now()
    mutate archiveReason = reason
    emit VenueLayoutTemplateArchived {
      templateId: self.id
      tenantId: self.tenantId
      reason: reason
    }
  }

  command reactivate() {
    guard self.status == "archived"
    guard self.deletedAt == null
    mutate status = "active"
    mutate archivedAt = null
    mutate archiveReason = null
    emit VenueLayoutTemplateReactivated {
      templateId: self.id
      tenantId: self.tenantId
    }
  }

  store VenueLayoutTemplate in durable
}

event VenueLayoutTemplateDefined: "venue_layout_template.defined" {
  templateId: string
  tenantId: string
  venueId: string
  name: string
}

event VenueLayoutTemplateRevised: "venue_layout_template.revised" {
  templateId: string
  tenantId: string
  venueId: string
  name: string
}

event VenueLayoutTemplateArchived: "venue_layout_template.archived" {
  templateId: string
  tenantId: string
  reason: string?
}

event VenueLayoutTemplateReactivated: "venue_layout_template.reactivated" {
  templateId: string
  tenantId: string
}
