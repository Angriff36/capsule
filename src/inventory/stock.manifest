// Capsule inventory foundation — on-hand stock and per-event reservations.
// Demand and waste live in demand.manifest; procurement owns purchase orders.
// Compile entry for this file alone still reaches culinary + operations via location → menu.

use "./location.manifest"

enum InventoryReservationStatus {
  pending
  active
  released
  consumed
}

// On-hand stock of one Ingredient at one StorageLocation (product StockItem;
// folds capsule-pro InventoryStock into the primary stock entity).
entity InventoryItem mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  unique [tenantId, ingredientId, locationId]
  timestamps
  versionProperty version: number

  property required ingredientId: uuid
  property required locationId: uuid
  property required quantityOnHand: decimal(12, 4) = 0
  property required unit: UnitOfMeasure = "each"
  property required parLevel: decimal(12, 4) = 0
  property required reorderThreshold: decimal(12, 4) = 0
  property required unitCost: money(12, 2) = 0
  property stockedAt: datetime?
  property removedAt: datetime?
  // Expiry instants (end of the labeled day). Use-by is the food-safety
  // cutoff that blocks issuance; best-before is advisory quality only.
  property bestBeforeAt: datetime?
  property useByAt: datetime?

  belongsTo ingredient: Ingredient fields [tenantId, ingredientId] references [tenantId, id]
  belongsTo location: StorageLocation fields [tenantId, locationId] references [tenantId, id]
  hasMany reservations: InventoryReservation

  computed isBelowPar: boolean = self.parLevel > 0 and self.quantityOnHand < self.parLevel
  computed isBelowReorder: boolean = self.reorderThreshold > 0 and self.quantityOnHand < self.reorderThreshold
  computed inventoryValue: money(12, 2) = self.quantityOnHand * self.unitCost
  // Free stock for display; over-reservation hard gate stays orchestrator (Convex sum multi-hop).
  computed totalReserved: decimal(12, 4) = sum(self.reservations, (r) => r.status == "active" ? r.quantity : 0)
  computed availableQuantity: decimal(12, 4) = self.quantityOnHand - self.totalReserved

  constraint stockNonnegative: self.stockedAt == null or self.quantityOnHand >= 0 "Quantity on hand cannot be negative"
  constraint stockParNonnegative: self.parLevel >= 0 "Par level cannot be negative"
  constraint stockReorderNonnegative: self.reorderThreshold >= 0 "Reorder threshold cannot be negative"
  constraint stockCostNonnegative: self.unitCost >= 0 "Unit cost cannot be negative"

  default policy inventoryItemRead read: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "manageAccess") "Inventory staff and managers may read stock items"
  default policy inventoryItemWrite write: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "manageAccess") "Inventory staff and managers may write stock items through commands"
  default policy inventoryItemExecute execute: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "manageAccess") "Inventory staff and managers may execute stock item commands"

  command open(
    ingredientId: uuid,
    locationId: uuid,
    unit: UnitOfMeasure,
    optional quantityOnHand: decimal(12, 4),
    optional parLevel: decimal(12, 4),
    optional reorderThreshold: decimal(12, 4),
    optional unitCost: money(12, 2)
  ) {
    guard self.stockedAt == null
    guard self.deletedAt == null
    constraint openStockIngredientMatch: ingredientId == self.ingredientId "Open ingredientId must match the seeded ingredient reference"
    constraint openStockLocationMatch: locationId == self.locationId "Open locationId must match the seeded location reference"
    // Stock is counted in the ingredient's catalog unit. Nothing converts
    // between units (they are opaque labels — see UnitOfMeasure), so a line
    // opened in a different unit silently breaks on-hand vs demand math,
    // low-stock alerts, and suggested purchase quantities (issue #150).
    constraint openStockUnitMatchesCatalog: self.ingredient != null and unit == self.ingredient.unit "Stock line unit must match the ingredient's catalog unit — units do not convert"
    constraint openStockQuantityNonnegative: quantityOnHand == null or quantityOnHand >= 0 "Quantity on hand cannot be negative"
    constraint openStockParNonnegative: parLevel == null or parLevel >= 0 "Par level cannot be negative"
    constraint openStockReorderNonnegative: reorderThreshold == null or reorderThreshold >= 0 "Reorder threshold cannot be negative"
    constraint openStockCostNonnegative: unitCost == null or unitCost >= 0 "Unit cost cannot be negative"
    compute previousQuantity = self.quantityOnHand
    mutate ingredientId = ingredientId
    mutate locationId = locationId
    mutate unit = unit
    mutate quantityOnHand = quantityOnHand != null ? quantityOnHand : 0
    mutate parLevel = parLevel != null ? parLevel : 0
    mutate reorderThreshold = reorderThreshold != null ? reorderThreshold : 0
    mutate unitCost = unitCost != null ? unitCost : 0
    mutate stockedAt = now()
    emit InventoryItemOpened {
      inventoryItemId: self.id
      tenantId: self.tenantId
      actorId: user.id
      ingredientId: ingredientId
      locationId: locationId
      previousQuantity: previousQuantity
      quantityOnHand: quantityOnHand != null ? quantityOnHand : 0
      unit: unit
      unitCost: unitCost != null ? unitCost : 0
    }
  }

  // Receipt lots supply a delta once; repeated lot materialization sends zero.
  command receiveDelivery(ingredientId: uuid, locationId: uuid, quantity: decimal(12, 4), unit: UnitOfMeasure, unitCost: money(12, 2)) {
    guard self.deletedAt == null
    constraint deliveryIngredientMatch: ingredientId == self.ingredientId "Receipt ingredient must match stock"
    constraint deliveryLocationMatch: locationId == self.locationId "Receipt location must match stock"
    constraint deliveryNonnegative: quantity >= 0 and unitCost >= 0 "Receipt quantity and price cannot be negative"
    compute stockUnit = self.stockedAt != null ? self.unit : self.ingredient.unit
    compute sourceMass = unit == "gram" ? 1 : unit == "kilogram" ? 1000 : unit == "ounce" ? 28.349523125 : unit == "pound" ? 453.59237 : 0
    compute sourceVolume = unit == "milliliter" ? 1 : unit == "liter" ? 1000 : unit == "teaspoon" ? 4.92892159375 : unit == "tablespoon" ? 14.78676478125 : unit == "cup" ? 236.5882365 : unit == "pint" ? 473.176473 : unit == "quart" ? 946.352946 : unit == "gallon" ? 3785.411784 : 0
    compute targetMass = stockUnit == "gram" ? 1 : stockUnit == "kilogram" ? 1000 : stockUnit == "ounce" ? 28.349523125 : stockUnit == "pound" ? 453.59237 : 0
    compute targetVolume = stockUnit == "milliliter" ? 1 : stockUnit == "liter" ? 1000 : stockUnit == "teaspoon" ? 4.92892159375 : stockUnit == "tablespoon" ? 14.78676478125 : stockUnit == "cup" ? 236.5882365 : stockUnit == "pint" ? 473.176473 : stockUnit == "quart" ? 946.352946 : stockUnit == "gallon" ? 3785.411784 : 0
    constraint deliveryUnitCompatible: unit == (self.stockedAt != null ? self.unit : self.ingredient.unit) or ((unit == "gram" or unit == "kilogram" or unit == "ounce" or unit == "pound") and ((self.stockedAt != null ? self.unit : self.ingredient.unit) == "gram" or (self.stockedAt != null ? self.unit : self.ingredient.unit) == "kilogram" or (self.stockedAt != null ? self.unit : self.ingredient.unit) == "ounce" or (self.stockedAt != null ? self.unit : self.ingredient.unit) == "pound")) or ((unit == "milliliter" or unit == "liter" or unit == "teaspoon" or unit == "tablespoon" or unit == "cup" or unit == "pint" or unit == "quart" or unit == "gallon") and ((self.stockedAt != null ? self.unit : self.ingredient.unit) == "milliliter" or (self.stockedAt != null ? self.unit : self.ingredient.unit) == "liter" or (self.stockedAt != null ? self.unit : self.ingredient.unit) == "teaspoon" or (self.stockedAt != null ? self.unit : self.ingredient.unit) == "tablespoon" or (self.stockedAt != null ? self.unit : self.ingredient.unit) == "cup" or (self.stockedAt != null ? self.unit : self.ingredient.unit) == "pint" or (self.stockedAt != null ? self.unit : self.ingredient.unit) == "quart" or (self.stockedAt != null ? self.unit : self.ingredient.unit) == "gallon")) "Receipt unit needs a measured conversion to the stock unit"
    compute unitRatio = unit == stockUnit ? 1 : (targetMass > 0 ? sourceMass / targetMass : sourceVolume / targetVolume)
    compute previousQuantity = self.quantityOnHand
    compute receivedQuantity = quantity * unitRatio
    mutate quantityOnHand = self.quantityOnHand + receivedQuantity
    mutate unit = stockUnit
    mutate unitCost = quantity > 0 ? unitCost / unitRatio : self.unitCost
    mutate stockedAt = self.stockedAt != null ? self.stockedAt : now()
    emit InventoryStockReceived {
      inventoryItemId: self.id
      tenantId: self.tenantId
      actorId: user.id
      ingredientId: ingredientId
      locationId: locationId
      previousQuantity: previousQuantity
      quantityOnHand: self.quantityOnHand
      receivedQuantity: receivedQuantity
      unit: self.unit
      unitCost: self.unitCost
    }
  }

  command receiveStock(quantity: decimal(12, 4), optional unitCost: money(12, 2)) {
    guard self.stockedAt != null
    guard self.deletedAt == null
    constraint receiveQuantityPositive: quantity > 0 "Received quantity must be positive"
    constraint receiveCostNonnegative: unitCost == null or unitCost >= 0 "Unit cost cannot be negative"
    compute previousQuantity = self.quantityOnHand
    compute nextQuantity = self.quantityOnHand + quantity
    mutate quantityOnHand = nextQuantity
    mutate unitCost = unitCost != null ? unitCost : self.unitCost
    emit InventoryStockReceived {
      inventoryItemId: self.id
      tenantId: self.tenantId
      actorId: user.id
      ingredientId: self.ingredientId
      locationId: self.locationId
      previousQuantity: previousQuantity
      quantityOnHand: nextQuantity
      receivedQuantity: quantity
      unit: self.unit
      unitCost: unitCost != null ? unitCost : self.unitCost
    }
  }

  command adjustQuantity(delta: decimal(12, 4), reason: string) {
    guard self.stockedAt != null
    guard self.deletedAt == null
    constraint adjustReasonRequired: length(trim(reason)) > 0 "Adjustment reason is required"
    constraint adjustResultNonnegative: self.quantityOnHand + delta >= 0 "Quantity on hand cannot be negative"
    compute previousQuantity = self.quantityOnHand
    compute nextQuantity = self.quantityOnHand + delta
    mutate quantityOnHand = nextQuantity
    emit InventoryQuantityAdjusted {
      inventoryItemId: self.id
      tenantId: self.tenantId
      actorId: user.id
      ingredientId: self.ingredientId
      locationId: self.locationId
      previousQuantity: previousQuantity
      quantityOnHand: nextQuantity
      delta: delta
      unit: self.unit
      reason: reason
    }
  }

  command recount(actualQuantity: decimal(12, 4)) {
    guard self.stockedAt != null
    guard self.deletedAt == null
    constraint recountNonnegative: actualQuantity >= 0 "Recount quantity cannot be negative"
    compute previousQuantity = self.quantityOnHand
    mutate quantityOnHand = actualQuantity
    emit InventoryRecounted {
      inventoryItemId: self.id
      tenantId: self.tenantId
      actorId: user.id
      ingredientId: self.ingredientId
      locationId: self.locationId
      previousQuantity: previousQuantity
      quantityOnHand: actualQuantity
      unit: self.unit
    }
  }

  command transferOut(quantity: decimal(12, 4), destinationLocationId: uuid) {
    guard self.stockedAt != null
    guard self.deletedAt == null
    constraint transferOutPositive: quantity > 0 "Transfer quantity must be positive"
    constraint transferOutAvailable: self.quantityOnHand >= quantity "Cannot transfer more than quantity on hand"
    compute previousQuantity = self.quantityOnHand
    compute nextQuantity = self.quantityOnHand - quantity
    mutate quantityOnHand = nextQuantity
    emit InventoryTransferredOut {
      inventoryItemId: self.id
      tenantId: self.tenantId
      actorId: user.id
      ingredientId: self.ingredientId
      locationId: self.locationId
      destinationLocationId: destinationLocationId
      previousQuantity: previousQuantity
      quantityOnHand: nextQuantity
      transferredQuantity: quantity
      unit: self.unit
    }
  }

  command transferIn(quantity: decimal(12, 4), sourceLocationId: uuid) {
    guard self.stockedAt != null
    guard self.deletedAt == null
    constraint transferInPositive: quantity > 0 "Transfer quantity must be positive"
    compute previousQuantity = self.quantityOnHand
    compute nextQuantity = self.quantityOnHand + quantity
    mutate quantityOnHand = nextQuantity
    emit InventoryTransferredIn {
      inventoryItemId: self.id
      tenantId: self.tenantId
      actorId: user.id
      ingredientId: self.ingredientId
      locationId: self.locationId
      sourceLocationId: sourceLocationId
      previousQuantity: previousQuantity
      quantityOnHand: nextQuantity
      transferredQuantity: quantity
      unit: self.unit
    }
  }

  command updateLevels(
    parLevel: decimal(12, 4),
    reorderThreshold: decimal(12, 4),
    optional unitCost: money(12, 2)
  ) {
    guard self.stockedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "inventoryManageAccess")
    constraint levelsParNonnegative: parLevel >= 0 "Par level cannot be negative"
    constraint levelsReorderNonnegative: reorderThreshold >= 0 "Reorder threshold cannot be negative"
    constraint levelsCostNonnegative: unitCost == null or unitCost >= 0 "Unit cost cannot be negative"
    mutate parLevel = parLevel
    mutate reorderThreshold = reorderThreshold
    mutate unitCost = unitCost != null ? unitCost : self.unitCost
    emit InventoryLevelsUpdated {
      inventoryItemId: self.id
      tenantId: self.tenantId
      ingredientId: self.ingredientId
      locationId: self.locationId
      parLevel: parLevel
      reorderThreshold: reorderThreshold
      unitCost: unitCost != null ? unitCost : self.unitCost
    }
  }

  command setExpiry(optional bestBeforeAt: datetime, optional useByAt: datetime) {
    guard self.stockedAt != null
    guard self.deletedAt == null
    constraint expiryOrder: bestBeforeAt == null or useByAt == null or bestBeforeAt <= useByAt "Best-before cannot be after use-by"
    // Overwrite semantics: omitting a date clears it (relabeling a lot).
    mutate bestBeforeAt = bestBeforeAt
    mutate useByAt = useByAt
    emit InventoryExpiryUpdated {
      inventoryItemId: self.id
      tenantId: self.tenantId
      ingredientId: self.ingredientId
      locationId: self.locationId
      bestBeforeAt: bestBeforeAt
      useByAt: useByAt
    }
  }

  command remove(reason: string) {
    guard self.stockedAt != null
    guard self.deletedAt == null
    guard roleAllows(user.role, "inventoryManageAccess")
    // Release/consume active holds before decommissioning the stock line.
    guard count_of(self.reservations, (r) => r.status == "active") == 0
    constraint removeStockReason: length(trim(reason)) > 0 "Removal reason is required"
    compute previousQuantity = self.quantityOnHand
    mutate deletedAt = now()
    mutate removedAt = now()
    emit InventoryItemRemoved {
      inventoryItemId: self.id
      tenantId: self.tenantId
      ingredientId: self.ingredientId
      locationId: self.locationId
      previousQuantity: previousQuantity
      quantityOnHand: self.quantityOnHand
      reason: reason
    }
  }

  store InventoryItem in durable
}

// Quantity of an InventoryItem held for an Event. Capsule-pro only stored
// aggregate quantityReserved; this entity records each event's hold, release
// and consumption separately so closing an event preserves stock history.
entity InventoryReservation mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required inventoryItemId: uuid
  property indexed inventoryLotId: uuid?
  property required eventId: uuid
  property required ingredientId: uuid
  property required quantity: decimal(12, 4) = 0
  property required status: InventoryReservationStatus = "pending"
  property reservedAt: datetime?
  property releasedAt: datetime?
  property consumedAt: datetime?
  property releaseReason: string?

  belongsTo inventoryItem: InventoryItem fields [tenantId, inventoryItemId] references [tenantId, id]
  belongsTo inventoryLot: InventoryLot fields [tenantId, inventoryLotId] references [tenantId, id]
  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]
  belongsTo ingredient: Ingredient fields [tenantId, ingredientId] references [tenantId, id]

  constraint reservationQuantityPositive: self.reservedAt == null or self.quantity > 0 "Reservation quantity must be positive"

  transition status from "pending" to ["active"]
  transition status from "active" to ["released", "consumed"]
  transition status from "released" to []
  transition status from "consumed" to []

  // Event managers need read+execute so EventCancelled/Completed fanOut can see rows.
  default policy inventoryReservationRead read: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "eventManageAccess") "Inventory staff or event managers may read inventory reservations"
  default policy inventoryReservationWrite write: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "eventManageAccess") "Inventory staff or event managers may write inventory reservations through commands"
  default policy inventoryReservationExecute execute: roleAllows(user.role, "inventoryAccess") or roleAllows(user.role, "eventManageAccess") "Inventory staff or event managers may execute reservation commands"

  command reserve(
    inventoryItemId: uuid,
    eventId: uuid,
    ingredientId: uuid,
    quantity: decimal(12, 4),
    optional inventoryLotId: uuid
  ) {
    guard self.reservedAt == null
    guard self.status == "pending"
    guard self.deletedAt == null
    // Stage check uses belongsTo traversal (semantics.md relationship
    // resolution in guard expressions). Seed eventId before reserve so the
    // parent Event resolves; param must match the seeded FK.
    guard self.event != null and (self.event.stage == "planning" or self.event.stage == "pending_approval" or self.event.stage == "approved" or self.event.stage == "executing")
    guard self.inventoryItem != null and self.inventoryItem.stockedAt != null and self.inventoryItem.deletedAt == null
    constraint reserveItemMatch: inventoryItemId == self.inventoryItemId "Reserve inventoryItemId must match the seeded stock reference"
    constraint reserveEventMatch: eventId == self.eventId "Reserve eventId must match the seeded event reference"
    constraint reserveIngredientMatch: ingredientId == self.inventoryItem.ingredientId "Reserve ingredientId must match the stock ingredient"
    // Lot provenance prevents a recall report from attributing an issue to a
    // different ingredient or storage location. Legacy stock may omit a lot.
    constraint reserveLotMatch: inventoryLotId == null or (self.inventoryLot != null and self.inventoryLot.deletedAt == null and self.inventoryLot.ingredientId == ingredientId and self.inventoryLot.locationId == self.inventoryItem.locationId) "Selected lot must match the reserved ingredient and stock location"
    constraint reserveQuantityPositive: quantity > 0 "Reservation quantity must be positive"
    mutate inventoryItemId = inventoryItemId
    mutate inventoryLotId = inventoryLotId
    mutate eventId = eventId
    mutate ingredientId = ingredientId
    mutate quantity = quantity
    mutate status = "active"
    mutate reservedAt = now()
    emit InventoryReserved {
      inventoryReservationId: self.id
      tenantId: self.tenantId
      actorId: user.id
      inventoryItemId: inventoryItemId
      inventoryLotId: inventoryLotId
      eventId: eventId
      ingredientId: ingredientId
      quantity: quantity
    }
  }

  command release(reason: string) {
    guard self.status == "active"
    guard self.reservedAt != null
    guard self.deletedAt == null
    constraint releaseReasonRequired: length(trim(reason)) > 0 "Release reason is required"
    compute previousQuantity = self.quantity
    mutate status = "released"
    mutate releasedAt = now()
    mutate releaseReason = reason
    emit InventoryReservationReleased {
      inventoryReservationId: self.id
      tenantId: self.tenantId
      actorId: user.id
      inventoryItemId: self.inventoryItemId
      inventoryLotId: self.inventoryLotId
      eventId: self.eventId
      ingredientId: self.ingredientId
      previousQuantity: previousQuantity
      quantity: self.quantity
      reason: reason
    }
  }

  command consume() {
    guard self.status == "active"
    guard self.reservedAt != null
    guard self.deletedAt == null
    // Food-safety gate: never issue stock past its use-by instant. Best-before
    // stays advisory (quality, not safety) — see domain-gating-restraint.
    guard self.inventoryItem == null or self.inventoryItem.useByAt == null or self.inventoryItem.useByAt >= now()
    compute previousQuantity = self.quantity
    mutate status = "consumed"
    mutate consumedAt = now()
    emit InventoryReservationConsumed {
      inventoryReservationId: self.id
      tenantId: self.tenantId
      actorId: user.id
      inventoryItemId: self.inventoryItemId
      inventoryLotId: self.inventoryLotId
      eventId: self.eventId
      ingredientId: self.ingredientId
      previousQuantity: previousQuantity
      quantity: self.quantity
    }
  }

  store InventoryReservation in durable
}

event InventoryItemOpened: "inventory_item.opened" {
  inventoryItemId: string
  tenantId: string
  actorId: string
  ingredientId: string
  locationId: string
  previousQuantity: decimal(12, 4)
  quantityOnHand: decimal(12, 4)
  unit: UnitOfMeasure
  unitCost: money(12, 2)
}

event InventoryStockReceived: "inventory_item.stock_received" {
  inventoryItemId: string
  tenantId: string
  actorId: string
  ingredientId: string
  locationId: string
  previousQuantity: decimal(12, 4)
  quantityOnHand: decimal(12, 4)
  receivedQuantity: decimal(12, 4)
  unit: UnitOfMeasure
  unitCost: money(12, 2)
}

event InventoryQuantityAdjusted: "inventory_item.quantity_adjusted" {
  inventoryItemId: string
  tenantId: string
  actorId: string
  ingredientId: string
  locationId: string
  previousQuantity: decimal(12, 4)
  quantityOnHand: decimal(12, 4)
  delta: decimal(12, 4)
  unit: UnitOfMeasure
  reason: string
}

event InventoryRecounted: "inventory_item.recounted" {
  inventoryItemId: string
  tenantId: string
  actorId: string
  ingredientId: string
  locationId: string
  previousQuantity: decimal(12, 4)
  quantityOnHand: decimal(12, 4)
  unit: UnitOfMeasure
}

event InventoryTransferredOut: "inventory_item.transferred_out" {
  inventoryItemId: string
  tenantId: string
  actorId: string
  ingredientId: string
  locationId: string
  destinationLocationId: string
  previousQuantity: decimal(12, 4)
  quantityOnHand: decimal(12, 4)
  transferredQuantity: decimal(12, 4)
  unit: UnitOfMeasure
}

event InventoryTransferredIn: "inventory_item.transferred_in" {
  inventoryItemId: string
  tenantId: string
  actorId: string
  ingredientId: string
  locationId: string
  sourceLocationId: string
  previousQuantity: decimal(12, 4)
  quantityOnHand: decimal(12, 4)
  transferredQuantity: decimal(12, 4)
  unit: UnitOfMeasure
}

event InventoryLevelsUpdated: "inventory_item.levels_updated" {
  inventoryItemId: string
  tenantId: string
  ingredientId: string
  locationId: string
  parLevel: decimal(12, 4)
  reorderThreshold: decimal(12, 4)
  unitCost: money(12, 2)
}

event InventoryExpiryUpdated: "inventory_item.expiry_updated" {
  inventoryItemId: string
  tenantId: string
  ingredientId: string
  locationId: string
  bestBeforeAt: datetime?
  useByAt: datetime?
}

event InventoryItemRemoved: "inventory_item.removed" {
  inventoryItemId: string
  tenantId: string
  ingredientId: string
  locationId: string
  previousQuantity: decimal(12, 4)
  quantityOnHand: decimal(12, 4)
  reason: string
}

event InventoryReserved: "inventory_reservation.reserved" {
  inventoryReservationId: string
  tenantId: string
  actorId: string
  inventoryItemId: string
  inventoryLotId: string?
  eventId: string
  ingredientId: string
  quantity: decimal(12, 4)
}

event InventoryReservationReleased: "inventory_reservation.released" {
  inventoryReservationId: string
  tenantId: string
  actorId: string
  inventoryItemId: string
  inventoryLotId: string?
  eventId: string
  ingredientId: string
  previousQuantity: decimal(12, 4)
  quantity: decimal(12, 4)
  reason: string
}

event InventoryReservationConsumed: "inventory_reservation.consumed" {
  inventoryReservationId: string
  tenantId: string
  actorId: string
  inventoryItemId: string
  inventoryLotId: string?
  eventId: string
  ingredientId: string
  previousQuantity: decimal(12, 4)
  quantity: decimal(12, 4)
}

// Event cancellation/completion releases only active holds through the
// transactional operational callback. Already released/consumed reservations
// are historical facts; invoking release on them would reject the parent event.

// Consuming a reservation decrements on-hand (release stays status-only).
on InventoryReservationConsumed run InventoryItem.adjustQuantity
  resolve payload.inventoryItemId
  params {
    delta: 0 - payload.quantity,
    reason: "Reservation consumed"
  }
