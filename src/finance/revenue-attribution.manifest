// Capsule revenue attribution — RevenueAttribution and VenueCommissionTerm.
// Enables percent/fixed revenue splits to venues, salespeople, partners with
// effective-dated versioning and approval workflow. Unblocks commission
// tracking and venue-specific reporting (§7.3/8.6).

use "../identity/person.manifest"
use "../operations/event.manifest"
use "../sales/referral-source.manifest"

// ========== VenueCommissionTerm ==========

enum VenueTermStatus {
  active
  retired
}

entity VenueCommissionTerm mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required venueId: uuid
  property required commissionPercent: decimal(5, 2) = 0
  property required effectiveStartDate: datetime
  property effectiveEndDate: datetime?
  property notes: string?
  property definedAt: datetime?
  property retiredAt: datetime?
  property required status: VenueTermStatus = "active"

  belongsTo venue: Venue fields [tenantId, venueId] references [tenantId, id]

  constraint commissionPercentValid: self.commissionPercent >= 0 and self.commissionPercent <= 100 "This venue's commission percent has to be between 0 and 100."

  default policy venueTermRead read: roleAllows(user.role, "financeAccess") "Finance staff may see venue commission terms"
  default policy venueTermWrite write: roleAllows(user.role, "financeAccess") "Finance staff may update venue commission terms"
  default policy venueTermExecute execute: roleAllows(user.role, "financeAccess") "Finance staff may change venue commission terms"

  command define(
    venueId: uuid,
    commissionPercent: decimal(5, 2),
    effectiveStartDate: datetime,
    optional effectiveEndDate: datetime,
    optional notes: string
  ) {
    guard self.deletedAt == null
    guard self.definedAt == null
    constraint defineTermPercent: commissionPercent >= 0 and commissionPercent <= 100 "This venue's commission percent has to be between 0 and 100."
    constraint defineTermDates: effectiveEndDate == null or effectiveEndDate >= effectiveStartDate "The term's end date can't be before its start date."

    mutate venueId = venueId
    mutate commissionPercent = commissionPercent
    mutate effectiveStartDate = effectiveStartDate
    mutate effectiveEndDate = effectiveEndDate
    mutate notes = notes
    mutate definedAt = now()
    emit VenueCommissionTermDefined
  }

  command revise(
    optional commissionPercent: decimal(5, 2),
    optional effectiveEndDate: datetime,
    optional notes: string
  ) {
    guard self.deletedAt == null
    guard self.definedAt != null
    constraint reviseNotRetired: self.retiredAt == null "This venue commission term is already retired. You can't revise it."
    constraint revisePercentRange: commissionPercent == null or (commissionPercent >= 0 and commissionPercent <= 100) "This venue's commission percent has to be between 0 and 100."
    constraint reviseTermDates: effectiveEndDate == null or effectiveEndDate >= self.effectiveStartDate "The term's end date can't be before its start date."

    mutate commissionPercent = commissionPercent != null ? commissionPercent : self.commissionPercent
    mutate effectiveEndDate = effectiveEndDate != null ? effectiveEndDate : self.effectiveEndDate
    mutate notes = notes != null ? notes : self.notes
    emit VenueCommissionTermRevised
  }

  command retire() {
    guard self.deletedAt == null
    guard self.definedAt != null
    constraint retireNotRetired: self.retiredAt == null "This venue commission term is already retired."

    mutate retiredAt = now()
    mutate effectiveEndDate = now()
    mutate status = "retired"
    emit VenueCommissionTermRetired
  }

  store VenueCommissionTerm in durable
}

// ========== RevenueAttribution ==========

enum AttributionType {
  venue_commission
  sales_commission
  referral_fee
  partner_split
  other
}

enum AllocationMethod {
  percent
  fixed
}

enum AttributionStatus {
  draft
  pending_approval
  approved
  rejected
  applied
}

entity RevenueAttribution mixin TenantScoped, SoftDeletable {
  key [tenantId, id]
  timestamps
  versionProperty version: number

  property required eventId: uuid
  property required attributionType: AttributionType = "venue_commission"
  property required allocationMethod: AllocationMethod = "percent"

  property venueId: uuid?
  property salespersonId: uuid?
  property referralSourceId: uuid?
  property partnerPersonId: uuid?
  property partnerClientId: uuid?

  property required percentBasis: decimal(5, 2) = 0
  property required fixedAmount: money(12, 2) = 0
  property required allocatedAmount: money(12, 2) = 0

  property effectiveStartDate: datetime?
  property effectiveEndDate: datetime?

  property required status: AttributionStatus = "draft"
  property requestedById: uuid?
  property requestedAt: datetime?
  property approvedById: uuid?
  property approvedAt: datetime?
  property rejectionReason: string?

  property reason: string?
  property notes: string?
  property appliedAt: datetime?

  // PL-ATTRIBUTION: the venue term in force when the event was booked
  // (booking follow-up). Later term changes never reach this row.
  property venueCommissionTermId: uuid?
  // A person changed the captured percent or amount, and why (changeSplit).
  property overrideReason: string?
  property overriddenById: uuid?
  property overriddenAt: datetime?
  // A person allowed the event's splits to add up to more than its revenue,
  // and why (allowOverRevenue). Checked when the split is applied.
  property overRevenueReason: string?
  property overRevenueAllowedById: uuid?

  belongsTo event: Event fields [tenantId, eventId] references [tenantId, id]
  ref venue: Venue fields [tenantId, venueId] references [tenantId, id]
  ref salesperson: Person fields [tenantId, salespersonId] references [tenantId, id]
  ref referralSource: ReferralSource fields [tenantId, referralSourceId] references [tenantId, id]
  ref partnerPerson: Person fields [tenantId, partnerPersonId] references [tenantId, id]
  ref partnerClient: Client fields [tenantId, partnerClientId] references [tenantId, id]
  ref requestedBy: Person fields [tenantId, requestedById] references [tenantId, id]
  ref approvedBy: Person fields [tenantId, approvedById] references [tenantId, id]
  ref venueCommissionTerm: VenueCommissionTerm fields [tenantId, venueCommissionTermId] references [tenantId, id]
  ref overriddenBy: Person fields [tenantId, overriddenById] references [tenantId, id]
  ref overRevenueAllowedBy: Person fields [tenantId, overRevenueAllowedById] references [tenantId, id]

  constraint percentBasisValid: self.allocationMethod != "percent" or (self.percentBasis > 0 and self.percentBasis <= 100) "This attribution's percent basis has to be between 0 and 100."

  constraint allocationNonnegative: self.allocatedAmount >= 0 "This attribution's allocated amount can't be negative. Use zero or more."

  constraint approvalConsistent: self.status == "approved" and self.approvedAt != null and self.approvedById != null or self.status != "approved" "An approved attribution needs an approver and a time it was approved."

  transition status from "draft" to ["pending_approval", "approved", "rejected"]
  transition status from "pending_approval" to ["approved", "rejected", "draft"]
  transition status from "approved" to ["applied"]
  transition status from "rejected" to ["draft"]
  transition status from "applied" to []

  default policy attributionRead read: roleAllows(user.role, "financeAccess") or roleAllows(user.role, "salesAccess") "Finance and sales staff may see attributions"
  default policy attributionWrite write: roleAllows(user.role, "financeAccess") "Finance staff may update attributions"
  default policy attributionExecute execute: roleAllows(user.role, "financeAccess") "Finance staff may change attributions"

  command create(
    eventId: uuid,
    attributionType: AttributionType,
    allocationMethod: AllocationMethod,
    optional percentBasis: decimal(5, 2),
    optional fixedAmount: money(12, 2),
    optional venueId: uuid,
    optional salespersonId: uuid,
    optional referralSourceId: uuid,
    optional partnerPersonId: uuid,
    optional partnerClientId: uuid,
    optional effectiveStartDate: datetime,
    optional effectiveEndDate: datetime,
    optional reason: string,
    optional venueCommissionTermId: uuid
  ) {
    guard self.deletedAt == null
    guard user.id != null
    // The booking follow-up (convex/lib/bookingAttribution.ts) runs as the
    // company's system role: it captures the venue term in force when the
    // event is approved, as a draft finance approves like any other.
    constraint createNeedsStaffProfile: user.personId != null or user.role == "system" "Link your account to a staff profile before you add a revenue attribution."

    mutate eventId = eventId
    mutate attributionType = attributionType
    mutate allocationMethod = allocationMethod
    mutate percentBasis = percentBasis != null ? percentBasis : 0
    mutate fixedAmount = fixedAmount != null ? fixedAmount : 0
    mutate venueId = venueId
    mutate salespersonId = salespersonId
    mutate referralSourceId = referralSourceId
    mutate partnerPersonId = partnerPersonId
    mutate partnerClientId = partnerClientId
    mutate effectiveStartDate = effectiveStartDate
    mutate effectiveEndDate = effectiveEndDate
    mutate reason = reason
    mutate status = "draft"
    mutate requestedById = user.personId
    mutate requestedAt = now()
    // Approval and the applied amount belong to approve/apply, never the caller.
    mutate allocatedAmount = 0
    mutate approvedById = null
    mutate approvedAt = null
    mutate rejectionReason = null
    mutate appliedAt = null
    // The term link is what the caller named; a change of split or an
    // over-revenue allowance belongs to changeSplit / allowOverRevenue.
    mutate venueCommissionTermId = venueCommissionTermId
    mutate overrideReason = null
    mutate overriddenById = null
    mutate overriddenAt = null
    mutate overRevenueReason = null
    mutate overRevenueAllowedById = null
    emit RevenueAttributionCreated
  }

  // Change the percent or amount of a split not yet approved, saying why.
  command changeSplit(
    reason: string,
    optional percentBasis: decimal(5, 2),
    optional fixedAmount: money(12, 2)
  ) {
    guard self.deletedAt == null
    constraint changeSplitNotApproved: self.status == "draft" or self.status == "pending_approval" or self.status == "rejected" "This split is already approved. Reject it first, or add a new one."
    constraint overrideReasonGiven: length(trim(reason)) > 0 "Say why you are changing this split."
    constraint overrideNeedsStaffProfile: user.personId != null "Link your account to a staff profile before you change a revenue split."
    constraint overridePercent: percentBasis == null or (percentBasis > 0 and percentBasis <= 100) "This attribution's percent basis has to be between 0 and 100."
    constraint overrideAmount: fixedAmount == null or fixedAmount >= 0 "This attribution's fixed amount can't be negative. Use zero or more."
    mutate percentBasis = percentBasis != null ? percentBasis : self.percentBasis
    mutate fixedAmount = fixedAmount != null ? fixedAmount : self.fixedAmount
    mutate overrideReason = reason
    mutate overriddenById = user.personId
    mutate overriddenAt = now()
    emit RevenueAttributionUpdated
  }

  // Let this split take the event's splits past its revenue, saying why.
  command allowOverRevenue(reason: string) {
    guard self.deletedAt == null
    constraint allowOverNotApplied: self.status != "applied" "This split is already applied."
    constraint overRevenueReasonGiven: length(trim(reason)) > 0 "Say why this event's splits may add up to more than its revenue."
    constraint overRevenueNeedsStaffProfile: user.personId != null "Link your account to a staff profile before you allow this."
    mutate overRevenueReason = reason
    mutate overRevenueAllowedById = user.personId
    emit RevenueAttributionUpdated
  }

  command requestApproval() {
    guard self.deletedAt == null
    guard self.status == "draft"

    mutate status = "pending_approval"
    emit RevenueAttributionApprovalRequested
  }

  command approve() {
    guard self.deletedAt == null
    guard self.status == "pending_approval"
    guard roleAllows(user.role, "financeAccess") or roleAllows(user.role, "salesManageAccess")
    guard user.id != null
    constraint approveNeedsStaffProfile: user.personId != null "Link your account to a staff profile before you approve a revenue attribution."

    mutate status = "approved"
    mutate approvedById = user.personId
    mutate approvedAt = now()
    emit RevenueAttributionApproved
  }

  command reject(rejectionReason: string) {
    guard self.deletedAt == null
    guard self.status == "pending_approval"
    guard roleAllows(user.role, "financeAccess") or roleAllows(user.role, "salesManageAccess")
    constraint rejectReasonGiven: length(trim(rejectionReason)) > 0 "Say why you're rejecting this attribution."

    mutate status = "rejected"
    mutate rejectionReason = rejectionReason
    emit RevenueAttributionRejected
  }

  command apply(eventRevenue: money(12, 2)) {
    guard self.deletedAt == null
    guard self.status == "approved"
    constraint applyRevenueNonnegative: eventRevenue >= 0 "This event's revenue can't be negative. Use zero or more."

    // To the cent: revenue x percent is in hundredths of a cent-percent, so
    // round that and divide by 100 (round(x, 2) rounded to whole dollars).
    compute allocation = self.allocationMethod == "percent" ? round(eventRevenue * self.percentBasis) / 100 : self.fixedAmount

    mutate allocatedAmount = allocation
    mutate appliedAt = now()
    mutate status = "applied"
    emit RevenueAttributionApplied {
      revenueAttributionId: self.id
      tenantId: self.tenantId
      eventId: self.eventId
      eventRevenue: eventRevenue
      allocatedAmount: allocation
    }
  }

  command update(
    optional percentBasis: decimal(5, 2),
    optional fixedAmount: money(12, 2),
    optional effectiveStartDate: datetime,
    optional effectiveEndDate: datetime,
    optional reason: string,
    optional notes: string
  ) {
    guard self.deletedAt == null
    guard self.status == "draft" or self.status == "rejected"
    constraint updatePercentRange: percentBasis == null or (percentBasis > 0 and percentBasis <= 100) "This attribution's percent basis has to be between 0 and 100."
    constraint updateAmountNonnegative: fixedAmount == null or fixedAmount >= 0 "This attribution's fixed amount can't be negative. Use zero or more."

    mutate percentBasis = percentBasis != null ? percentBasis : self.percentBasis
    mutate fixedAmount = fixedAmount != null ? fixedAmount : self.fixedAmount
    mutate effectiveStartDate = effectiveStartDate != null ? effectiveStartDate : self.effectiveStartDate
    mutate effectiveEndDate = effectiveEndDate != null ? effectiveEndDate : self.effectiveEndDate
    mutate reason = reason != null ? reason : self.reason
    mutate notes = notes != null ? notes : self.notes
    emit RevenueAttributionUpdated
  }

  store RevenueAttribution in durable
}

// ========== Events ==========

event VenueCommissionTermDefined: "venue_commission_term.defined" {
  venueCommissionTermId: string
  tenantId: string
  venueId: string
  commissionPercent: decimal(5, 2)
  effectiveStartDate: datetime
}

event VenueCommissionTermRevised: "venue_commission_term.revised" {
  venueCommissionTermId: string
  tenantId: string
  venueId: string
}

event VenueCommissionTermRetired: "venue_commission_term.retired" {
  venueCommissionTermId: string
  tenantId: string
  venueId: string
}

event RevenueAttributionCreated: "revenue_attribution.created" {
  revenueAttributionId: string
  tenantId: string
  eventId: string
  attributionType: AttributionType
  allocationMethod: AllocationMethod
  status: AttributionStatus
}

event RevenueAttributionApprovalRequested: "revenue_attribution.approval_requested" {
  revenueAttributionId: string
  tenantId: string
  eventId: string
}

event RevenueAttributionApproved: "revenue_attribution.approved" {
  revenueAttributionId: string
  tenantId: string
  eventId: string
  approvedById: string
}

event RevenueAttributionRejected: "revenue_attribution.rejected" {
  revenueAttributionId: string
  tenantId: string
  eventId: string
  rejectionReason: string
}

event RevenueAttributionUpdated: "revenue_attribution.updated" {
  revenueAttributionId: string
  tenantId: string
  eventId: string
}

event RevenueAttributionApplied: "revenue_attribution.applied" {
  revenueAttributionId: string
  tenantId: string
  eventId: string
  eventRevenue: money(12, 2)
  allocatedAmount: money(12, 2)
}
