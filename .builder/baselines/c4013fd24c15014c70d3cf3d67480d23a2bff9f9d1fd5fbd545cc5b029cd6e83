  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "bun": ">=1.3.4"
  },
  "scripts": {
    "agent:enter-component": "bun scripts/capsule-enter-component.ts",
    "agent:enter-event": "bun scripts/capsule-enter-event.ts",
    "agent:mcp": "bun scripts/capsule-mcp.ts",
    "agent:mint-jwt": "bun scripts/capsule-mint-agent-jwt.ts",
    "baseline:decay": "bun scripts/check-baseline-decay.ts",
    "build": "vite build",
    "build-storybook": "storybook build",
    "check": "bun run toolchain && bun scripts/builder-regen-guard.ts --check-ownership && bun run proof:emit && bun run check:proof && bun run check:manifest-registry && bun run check:manifest-breaking && bun run check:manifest-fmt && bun run check:manifest-scan && bun run check:manifest-completeness && bun run check:wiring-drift && bun run check:manifest-integration && bun run check:design-vocab && bun run typecheck && bun run format:check && bun run secrets && bun run test:coverage && bun run check:access-matrix && bun run build && bun run check:storybook && bun run baseline:decay",
    "check:access-matrix": "bun scripts/check-access-matrix-if-needed.ts",
    "check:design-vocab": "bun scripts/check-design-vocab.ts",
    "check:manifest-breaking": "bun scripts/check-manifest-breaking.ts",
    "check:manifest-completeness": "bun scripts/check-manifest-completeness.ts",
    "check:manifest-fmt": "manifest fmt src --check",
    "check:manifest-integration": "bun scripts/check-manifest-integration.ts",
    "check:manifest-registry": "bun scripts/check-manifest-registry-pin.ts",
    "check:manifest-scan": "manifest scan src --strict",
    "check:proof": "bun scripts/check-proof-registry.ts",
    "check:storybook": "storybook build --quiet -o .artifacts/storybook-static",
    "check:wiring-drift": "bun scripts/check-wiring-consumer-drift.ts",
    "codegen": "convex codegen",
    "convex:env-set": "bun scripts/convex-env-set.ts",
    "deploy": "convex deploy",
    "deploy:production": "bash scripts/vercel-build.sh",
    "dev": "concurrently --kill-others --names backend,frontend --handle-input --default-input-target backend \"bun run dev:convex\" \"bun run dev:frontend\"",
    "dev:convex": "convex dev",
    "dev:frontend": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "manifest:build": "manifest build",
    "manifest:compile": "manifest compile --merge",
    "manifest:regen": "bun scripts/manifest-regen.ts",
    "manifest:regen:check": "bun scripts/manifest-regen-check.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "proof:emit": "bun scripts/emit-proof-kit.ts",
    "release:receipt": "bun scripts/release-receipt.ts",
    "secrets": "bun scripts/check-secrets.ts",
    "seed": "bun scripts/seed-convex.ts",
    "storybook": "storybook dev -p 6007 --no-open",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:proofs": "vitest run tests/proofs tests/proof-registry-gate.test.ts manifest-integration-guard tests/finance-routes.test.ts",
    "toolchain": "bun scripts/check-toolchain.ts",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css,yml,yaml,html}": "prettier --write"
  },
  "dependencies": {
    "@angriff36/manifest": "3.6.58",
