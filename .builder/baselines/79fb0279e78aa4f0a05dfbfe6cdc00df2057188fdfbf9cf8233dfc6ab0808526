  lists: "list params are JSON arrays",
  idempotencyKey: "optional string; retries with the same key do not repeat the command",
  concurrency: "instance commands take docId (Convex document id) plus, when listed, the entity's optional expected-version number for optimistic concurrency",
} as const;

http.route({
  pathPrefix: "/api/manifest/",
  method: "GET",
  handler: httpAction(async (ctx, request) => {
    const identity = await ctx.auth.getUserIdentity();
    if (identity === null) {
      return new Response(JSON.stringify({ error: "Unauthorized" }), { status: 401, headers: { "Content-Type": "application/json" } });
    }
    const registry = COMMAND_DISPATCH as Record<string, { params: readonly string[]; paramMeta: readonly { name: string; type: string; required: boolean }[] }>;
    const url = new URL(request.url);
    if (/^\/api\/manifest\/commands\/?$/.test(url.pathname)) {
      const commands = Object.keys(registry).map((key) => {
        const dot = key.indexOf(".");
        return { entity: key.slice(0, dot), command: key.slice(dot + 1), params: registry[key]!.paramMeta };
      });
      return new Response(JSON.stringify({ commands, wire: DISPATCHER_WIRE_NOTES }), { status: 200, headers: { "Content-Type": "application/json" } });
    }
    const match = url.pathname.match(/^\/api\/manifest\/([^/]+)\/commands\/([^/]+)\/?$/);
    if (!match) {
      return new Response(JSON.stringify({ error: "Not found" }), { status: 404, headers: { "Content-Type": "application/json" } });
    }
    const key = match[1]! + "." + match[2]!;
    const entry = registry[key];
    if (!entry) {
      return new Response(JSON.stringify({ error: "Unknown command " + key }), { status: 404, headers: { "Content-Type": "application/json" } });
    }
    return new Response(JSON.stringify({ entity: match[1], command: match[2], params: entry.paramMeta, execute: "POST /api/manifest/" + match[1] + "/commands/" + match[2], wire: DISPATCHER_WIRE_NOTES }), { status: 200, headers: { "Content-Type": "application/json" } });
  }),
});

export default http;
