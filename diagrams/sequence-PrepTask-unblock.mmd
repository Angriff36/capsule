sequenceDiagram
    participant Client
    participant PrepTask as PrepTask
    participant EventBus
    Client->>+PrepTask: unblock()
    Note over PrepTask: Policies: prepTaskRead, prepTaskWrite, prepTaskExecute
    Note over PrepTask: Guards (4)
    PrepTask->>PrepTask: guard[0]: self.status == #quot;blocked#quot;
    PrepTask->>PrepTask: guard[1]: self.blockedAt != null
    PrepTask->>PrepTask: guard[2]: self.deletedAt == null
    PrepTask->>PrepTask: guard[3]: roleAllows(user.role, #quot;kitchenLeadAccess#quot;)
    PrepTask->>PrepTask: compute.previousStatus
    PrepTask->>PrepTask: mutate.status
    PrepTask->>PrepTask: mutate.blockedAt
    PrepTask->>PrepTask: mutate.blockReason
    PrepTask->>PrepTask: mutate.assignedToId
    PrepTask->>PrepTask: mutate.claimedAt
    PrepTask->>PrepTask: mutate.startedAt
    PrepTask->>EventBus: emit PrepTaskUnblocked on prep_task.unblocked
    PrepTask-->>-Client: void