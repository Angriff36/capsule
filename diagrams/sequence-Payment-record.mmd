sequenceDiagram
    participant Client
    participant Payment as Payment
    participant EventBus
    Client->>+Payment: record(invoiceId, clientId, amount, method, eventId, paymentMethodId, notes)
    Note over Payment: Policies: paymentRead, paymentWrite, paymentExecute
    Note over Payment: Guards (5)
    Payment->>Payment: guard[0]: self.recordedAt == null
    Payment->>Payment: guard[1]: self.status == #quot;pending#quot;
    Payment->>Payment: guard[2]: self.deletedAt == null
    Payment->>Payment: guard[3]: self.invoice != null
    Payment->>Payment: guard[4]: self.client != null
    Payment->>Payment: mutate.invoiceId
    Payment->>Payment: mutate.clientId
    Payment->>Payment: mutate.eventId
    Payment->>Payment: mutate.amount
    Payment->>Payment: mutate.method
    Payment->>Payment: mutate.paymentMethodId
    Payment->>Payment: mutate.notes
    Payment->>Payment: mutate.recordedAt
    Payment->>EventBus: emit PaymentRecorded on payment.recorded
    Payment-->>-Client: void