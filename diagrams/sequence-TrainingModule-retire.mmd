sequenceDiagram
    participant Client
    participant TrainingModule as TrainingModule
    participant EventBus
    Client->>+TrainingModule: retire()
    Note over TrainingModule: Policies: trainingModuleRead, trainingModuleWrite, trainingModuleExecute
    Note over TrainingModule: Guards (4)
    TrainingModule->>TrainingModule: guard[0]: self.status == #quot;active#quot;
    TrainingModule->>TrainingModule: guard[1]: self.definedAt != null
    TrainingModule->>TrainingModule: guard[2]: self.deletedAt == null
    TrainingModule->>TrainingModule: guard[3]: roleAllows(user.role, #quot;workforceManageAccess#quot;)
    TrainingModule->>TrainingModule: mutate.status
    TrainingModule->>TrainingModule: mutate.retiredAt
    TrainingModule->>EventBus: emit TrainingModuleRetired on training_module.retired
    TrainingModule-->>-Client: void