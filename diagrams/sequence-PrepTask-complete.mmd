sequenceDiagram
    participant Client
    participant PrepTask as PrepTask
    participant EventBus
    Client->>+PrepTask: complete(completedQuantity)
    Note over PrepTask: Policies: prepTaskRead, prepTaskWrite, prepTaskExecute
    Note over PrepTask: Guards (3)
    PrepTask->>PrepTask: guard[0]: self.status == #quot;in_progress#quot;
    PrepTask->>PrepTask: guard[1]: self.startedAt != null
    PrepTask->>PrepTask: guard[2]: self.deletedAt == null
    PrepTask->>PrepTask: compute.previousStatus
    PrepTask->>PrepTask: compute.nextCompleted
    PrepTask->>PrepTask: mutate.completedQuantity
    PrepTask->>PrepTask: mutate.status
    PrepTask->>PrepTask: mutate.completedAt
    PrepTask->>EventBus: emit PrepTaskCompleted on prep_task.completed
    PrepTask-->>-Client: void