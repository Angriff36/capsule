sequenceDiagram
    participant Client
    participant TrainingModule as TrainingModule
    participant EventBus
    Client->>+TrainingModule: reactivate()
    Note over TrainingModule: Policies: trainingModuleRead, trainingModuleWrite, trainingModuleExecute
    Note over TrainingModule: Guards (3)
    TrainingModule->>TrainingModule: guard[0]: self.status == #quot;retired#quot;
    TrainingModule->>TrainingModule: guard[1]: self.deletedAt == null
    TrainingModule->>TrainingModule: guard[2]: roleAllows(user.role, #quot;workforceManageAccess#quot;)
    TrainingModule->>TrainingModule: mutate.status
    TrainingModule->>TrainingModule: mutate.retiredAt
    TrainingModule->>EventBus: emit TrainingModuleReactivated on training_module.reactivated
    TrainingModule-->>-Client: void