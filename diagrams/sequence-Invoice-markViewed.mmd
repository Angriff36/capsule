sequenceDiagram
    participant Client
    participant Invoice as Invoice
    participant EventBus
    Client->>+Invoice: markViewed()
    Note over Invoice: Policies: invoiceRead, invoiceWrite, invoiceExecute
    Note over Invoice: Guards (2)
    Invoice->>Invoice: guard[0]: self.status == #quot;sent#quot;
    Invoice->>Invoice: guard[1]: self.deletedAt == null
