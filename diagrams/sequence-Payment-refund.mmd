sequenceDiagram
    participant Client
    participant Payment as Payment
    participant EventBus
    Client->>+Payment: refund(reason)
    Note over Payment: Policies: paymentRead, paymentWrite, paymentExecute
    Note over Payment: Guards (2)
    Payment->>Payment: guard[0]: self.status == #quot;completed#quot;
    Payment->>Payment: guard[1]: self.deletedAt == null
    Payment->>Payment: mutate.status
    Payment->>Payment: mutate.refundedAt
    Payment->>Payment: mutate.refundReason
    Payment->>EventBus: emit PaymentRefunded on payment.refunded
    Payment-->>-Client: void