sequenceDiagram
    participant Client
    participant PrepTask as PrepTask
    participant EventBus
    Client->>+PrepTask: refreshGenerated(quantity, specialInstructions)
    Note over PrepTask: Policies: prepTaskRead, prepTaskWrite, prepTaskExecute
    Note over PrepTask: Guards (3)
    PrepTask->>PrepTask: guard[0]: self.status == #quot;pending#quot;
    PrepTask->>PrepTask: guard[1]: self.deletedAt == null
    PrepTask->>PrepTask: guard[2]: self.isGenerated == true
    PrepTask->>PrepTask: mutate.quantity
    PrepTask->>PrepTask: mutate.specialInstructions
    PrepTask->>EventBus: emit PrepTaskGeneratedRefreshed on prep_task.generated_refreshed
    PrepTask-->>-Client: void