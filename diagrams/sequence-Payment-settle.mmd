sequenceDiagram
    participant Client
    participant Payment as Payment
    participant EventBus
    Client->>+Payment: settle()
    Note over Payment: Policies: paymentRead, paymentWrite, paymentExecute
    Note over Payment: Guards (3)
    Payment->>Payment: guard[0]: self.status == #quot;pending#quot; or self.status == #quot;processing#quot;
    Payment->>Payment: guard[1]: self.recordedAt != null
    Payment->>Payment: guard[2]: self.deletedAt == null
    Payment->>Payment: mutate.status
    Payment->>Payment: mutate.settledAt
    Payment->>EventBus: emit PaymentSettled on payment.settled
    Payment-->>-Client: void