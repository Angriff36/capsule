sequenceDiagram
    participant Client
    participant Qualification as Qualification
    participant EventBus
    Client->>+Qualification: grant(personId, name, issuedAt, certificationType, issuingBody, expiresAt, documentRef, notes)
    Note over Qualification: Policies: qualificationRead, qualificationWrite, qualificationExecute
    Note over Qualification: Guards (5)
    Qualification->>Qualification: guard[0]: self.grantedAt == null
    Qualification->>Qualification: guard[1]: self.status == #quot;active#quot;
    Qualification->>Qualification: guard[2]: self.deletedAt == null
    Qualification->>Qualification: guard[3]: self.person != null and self.person.status == #quot;active#quot;
    Qualification->>Qualification: guard[4]: roleAllows(user.role, #quot;workforceManageAccess#quot;)
    Qualification->>Qualification: mutate.personId
    Qualification->>Qualification: mutate.name
    Qualification->>Qualification: mutate.certificationType
    Qualification->>Qualification: mutate.issuingBody
    Qualification->>Qualification: mutate.issuedAt
    Qualification->>Qualification: mutate.expiresAt
    Qualification->>Qualification: mutate.documentRef
    Qualification->>Qualification: mutate.notes
    Qualification->>Qualification: mutate.grantedAt
    Qualification->>EventBus: emit QualificationGranted on qualification.granted
    Qualification-->>-Client: void