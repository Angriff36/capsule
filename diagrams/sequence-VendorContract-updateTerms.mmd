sequenceDiagram
    participant Client
    participant VendorContract as VendorContract
    participant EventBus
    Client->>+VendorContract: updateTerms(title, startsAt, endsAt, contractNumber, paymentTermsDays, deliveryLeadTimeDays, documentUrl, notes)
    Note over VendorContract: Policies: vendorContractRead, vendorContractWrite, vendorContractExecute
    Note over VendorContract: Guards (3)
    VendorContract->>VendorContract: guard[0]: self.draftedAt != null
    VendorContract->>VendorContract: guard[1]: self.status == #quot;draft#quot;
    VendorContract->>VendorContract: guard[2]: self.deletedAt == null
    VendorContract->>VendorContract: mutate.title
    VendorContract->>VendorContract: mutate.startsAt
    VendorContract->>VendorContract: mutate.endsAt
    VendorContract->>VendorContract: mutate.contractNumber
    VendorContract->>VendorContract: mutate.paymentTermsDays
    VendorContract->>VendorContract: mutate.deliveryLeadTimeDays
    VendorContract->>VendorContract: mutate.documentUrl
    VendorContract->>VendorContract: mutate.notes
    VendorContract->>EventBus: emit VendorContractTermsUpdated on vendor_contract.terms_updated
    VendorContract-->>-Client: void