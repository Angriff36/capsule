# Copy to .env.local for Vite + local tooling. Never commit real secrets.

# --- Required (client / Vite) ---
# Convex deployment URL used by the React app.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Clerk publishable key (safe for the browser).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# --- Required (Convex deployment env — set via `bunx convex env set`) ---
# Clerk JWT issuer domain, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# 32-byte secret for Manifest field encryption (server-only).
CONVEX_FIELD_ENCRYPTION_KEY=

# --- Optional local Clerk / Convex CLI helpers ---
# Written by `bunx convex dev` / dashboard; keep local only.
CONVEX_DEPLOYMENT=
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
CLERK_FRONTEND_API_URL=https://your-app.clerk.accounts.dev
