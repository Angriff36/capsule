# Copy to .env.local for Vite + local tooling. Never commit real secrets.

# --- Required (client / Vite) ---
# Convex deployment URL used by the React app.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Clerk publishable key (safe for the browser).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# --- Required (Convex deployment env — set via `bunx convex env set`) ---
# Clerk JWT issuer domain, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# 32-byte secret for Manifest field encryption (server-only).
# Must exist on the deployment your UI hits. For Vercel production:
#   bunx convex env set CONVEX_FIELD_ENCRYPTION_KEY <secret> --prod
CONVEX_FIELD_ENCRYPTION_KEY=
# Resend API key used by invoice reminders and hire sign-in emails.
RESEND_API_KEY=re_xxxxxxxx
# Verified sender address, either billing@example.com or Brand <billing@example.com>.
# Hire sign-in emails use this unless CAPSULE_SIGNIN_FROM_EMAIL is set.
INVOICE_REMINDER_FROM_EMAIL=billing@example.com
# Optional dedicated sender for hire sign-in emails.
CAPSULE_SIGNIN_FROM_EMAIL=
# Stripe secret key used to create and check hosted Checkout Sessions.
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Public application origin used for Stripe return links and hire sign-in emails.
CAPSULE_PUBLIC_APP_URL=http://localhost:7811
# Google OAuth web client credentials used by the calendar sync worker.
GOOGLE_CALENDAR_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=GOCSPX-xxxxx
# Must exactly match an authorized redirect URI in Google Cloud Console.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:7811/admin/integrations

# --- Optional Convex deployment env ---
# USDA FoodData Central key for ingredient lookup (`bunx convex env set USDA_FDC_API_KEY ...`).
# Without this, lookup falls back to USDA DEMO_KEY (rate-limited).
USDA_FDC_API_KEY=
# Contact email embedded in Open Food Facts User-Agent (required by their API policy).
OPEN_FOOD_FACTS_CONTACT_EMAIL=

# --- Optional local Clerk / Convex CLI helpers ---
# Written by `bunx convex dev` / dashboard; keep local only.
CONVEX_DEPLOYMENT=
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
CLERK_FRONTEND_API_URL=https://your-app.clerk.accounts.dev
