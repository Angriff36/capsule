{
  "schemaVersion": "manifest-integration-guard/v1",
  "versions": {
    "manifestVersion": "3.6.12",
    "projection": "convex",
    "preset": {
      "id": "convex-application",
      "version": "1.3.4"
    }
  },
  "featureRoots": [
    "src/features/inventory"
  ],
  "convexLibRoot": "convex/lib",
  "ownedTables": [
    "ingredientDemands",
    "inventoryItems",
    "inventoryReservations",
    "purchaseNeeds",
    "storageLocations",
    "vendorOrderLines",
    "vendorOrders",
    "vendors"
  ],
  "forbidDirectConvexHooks": true,
  "forbiddenImportPatterns": [
    "(?:^|/)convex/(?:queries|mutations)(?:\\.|$|/)",
    "(?:^|/)convex/_generated(?:/|$)",
    "^convex/react$"
  ],
  "lifecycleLiteralPattern": "\\b(?:from|to)\\s*:\\s*[\"'](?:pending|calculated|confirmed|fulfilled|superseded|active|released|consumed|open|ordered|cancelled|draft|submitted|partially_received|received)[\"']",
  "lifecyclePolicies": [
    {
      "pathSuffix": "/SupplyLifecyclePolicy.ts",
      "bindingsImport": "../../generated/manifest-wiring-bindings\"",
      "requiredSymbols": [
        "IngredientDemandConfirmLifecycle",
        "VendorOrderSubmitLifecycle"
      ]
    }
  ],
  "exceptions": []
}
