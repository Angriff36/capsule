{
  "schemaVersion": "manifest-integration-guard/v1",
  "versions": {
    "manifestVersion": "3.6.20",
    "projection": "convex",
    "preset": {
      "id": "convex-application",
      "version": "1.3.4"
    }
  },
  "featureRoots": [
    "src/features/workforce"
  ],
  "convexLibRoot": "convex/lib",
  "ownedTables": [
    "availabilityWindows",
    "eventAssignments",
    "payrollInputs",
    "qualifications",
    "shifts",
    "timeRecords"
  ],
  "forbidDirectConvexHooks": true,
  "forbiddenImportPatterns": [
    "(?:^|/)convex/(?:queries|mutations)(?:\\.|$|/)",
    "(?:^|/)convex/_generated(?:/|$)",
    "^convex/react$"
  ],
  "lifecycleLiteralPattern": "\\b(?:from|to)\\s*:\\s*[\"'](?:assigned|confirmed|checked_in|checked_out|no_show|unassigned|scheduled|started|completed|cancelled|active|withdrawn|open|closed|corrected|expired|revoked)[\"']",
  "lifecyclePolicies": [
    {
      "pathSuffix": "/WorkforceLifecyclePolicy.ts",
      "bindingsImport": "../../generated/manifest-wiring-bindings\"",
      "requiredSymbols": [
        "ShiftStartLifecycle",
        "EventAssignmentCheckInLifecycle"
      ]
    }
  ],
  "exceptions": []
}
