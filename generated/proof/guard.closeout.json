{
  "schemaVersion": "manifest-integration-guard/v1",
  "versions": {
    "manifestVersion": "3.6.29",
    "projection": "convex",
    "preset": {
      "id": "convex-application",
      "version": "1.3.5"
    }
  },
  "featureRoots": [
    "src/features/finance"
  ],
  "convexLibRoot": "convex/lib",
  "ownedTables": [
    "eventCloseouts"
  ],
  "forbidDirectConvexHooks": true,
  "forbiddenImportPatterns": [
    "(?:^|/)convex/(?:queries|mutations)(?:\\.|$|/)",
    "(?:^|/)convex/_generated(?:/|$)",
    "^convex/react$"
  ],
  "lifecycleLiteralPattern": "\\b(?:from|to)\\s*:\\s*[\"'](?:draft|finalized)[\"']",
  "lifecyclePolicies": [
    {
      "pathSuffix": "/CloseoutLifecyclePolicy.ts",
      "bindingsImport": "../../generated/manifest-wiring-bindings\"",
      "requiredSymbols": [
        "EventCloseoutFinalizeLifecycle"
      ]
    }
  ],
  "exceptions": []
}
