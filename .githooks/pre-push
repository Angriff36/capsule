#!/bin/sh
# Branch rule (owner, 2026-08-25): nothing pushes to main by hand. Work lives
# on a branch; every branch push is a chore (Vercel ignores non-main refs via
# vercel.json ignoreCommand). ONE merge to main happens at the end of the
# branch, through `bash scripts/release.sh`. That script runs `bun run check`
# and writes the passing commit's sha to .artifacts/release-check-passed.
# A main push is accepted only when CAPSULE_RELEASE=1 AND that file names the
# exact commit being pushed. CI does not run on main, so this is the gate.
while read -r _local_ref local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      if [ "${CAPSULE_RELEASE:-0}" != "1" ]; then
        echo ""
        echo "pre-push blocked: direct push to main."
        echo "Push your branch instead. Release with: bash scripts/release.sh --reviewer <model>"
        exit 1
      fi
      passed="$(cat .artifacts/release-check-passed 2>/dev/null || true)"
      if [ "$passed" != "$local_sha" ]; then
        echo ""
        echo "pre-push blocked: no passing 'bun run check' recorded for $local_sha."
        echo "Only scripts/release.sh writes that proof. Run the release script; do not push main by hand."
        exit 1
      fi
      ;;
  esac
done

# Regeneration is a local gate (owner policy 2026-07-19): Builder-owned output
# must be regenerated and current BEFORE anything reaches GitHub — CI has no
# Builder checkout and cannot regenerate. Blocks the push when the Builder
# plan shows pending changes or conflicts.
bun scripts/manifest-regen-check.ts || {
  echo ""
  echo "pre-push blocked: Builder output is stale or conflicted (see above)."
  exit 1
}
