#!/bin/sh
# Branch rule (owner, 2026-08-25): nothing pushes to main by hand. Work lives
# on a branch; every branch push is a chore (Vercel ignores non-main refs via
# vercel.json ignoreCommand). ONE merge to main happens at the end of the
# branch, through `bash scripts/release.sh`. That script runs `bun run check`
# and writes the passing commit's sha to .artifacts/release-check-passed.
# A main push is accepted only when CAPSULE_RELEASE=1 AND that file names the
# exact commit being pushed. CI does not run on main, so this is the gate.
# Loop rule (owner, 2026-09-20): the loop's maker never lands its own work.
# A push from a loop worktree is accepted only from .claude/loop-land.ps1,
# which sets LOOP_LANDER=1 after an independent review said APPROVE.
case "$(git rev-parse --show-toplevel)" in
  */.loop-worktrees/*)
    if [ "${LOOP_LANDER:-0}" != "1" ]; then
      echo ""
      echo "pre-push blocked: loop worktrees do not push. Commit, write the hand-off file, and stop."
      exit 1
    fi
    ;;
esac

ref_count=0
archive_ref=""
archive_sha=""
deleted_ref=""
deleted_sha=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  ref_count=$((ref_count + 1))
  case "$local_sha" in
    0000000000000000000000000000000000000000)
      deleted_ref="$remote_ref"
      deleted_sha="$remote_sha"
      ;;
    *)
      case "$remote_ref" in
        refs/heads/archive/*) archive_ref="$remote_ref"; archive_sha="$local_sha" ;;
      esac
      ;;
  esac
  case "$remote_ref" in
    refs/heads/main)
      if [ "${CAPSULE_RELEASE:-0}" != "1" ]; then
        echo ""
        echo "pre-push blocked: direct push to main."
        echo "Push your branch instead. Release with: bash scripts/release.sh --reviewer <model>"
        exit 1
      fi
      passed="$(cat .artifacts/release-check-passed 2>/dev/null || true)"
      if [ "$passed" != "$local_sha" ]; then
        echo ""
        echo "pre-push blocked: no passing 'bun run check' recorded for $local_sha."
        echo "Only scripts/release.sh writes that proof. Run the release script; do not push main by hand."
        exit 1
      fi
      ;;
  esac
done

# A release archive only renames the already-published source commit. Match
# both ref updates and their SHAs; an unrelated/mixed push still runs the gate.
if [ "$ref_count" = "2" ] && [ -n "$archive_sha" ] &&
   [ "$archive_sha" = "$deleted_sha" ] &&
   [ "$archive_ref" = "refs/heads/archive/${deleted_ref#refs/heads/}" ]; then
  # Check the actual push destination, not a possibly stale tracking ref.
  # If it cannot be verified (including a new SHA missing locally), use the
  # ordinary regeneration gate instead of granting the archive shortcut.
  remote_main="$(git ls-remote "${2:-${1:-origin}}" refs/heads/main 2>/dev/null | cut -f1)"
  if [ -n "$remote_main" ] && git merge-base --is-ancestor "$archive_sha" "$remote_main" 2>/dev/null; then
    echo "pre-push: released branch archive only; generated output is unchanged."
    exit 0
  fi
fi

# Regeneration uses the CLI committed in scripts/manifest-builder. Owned output
# must be regenerated and current BEFORE anything reaches GitHub. Blocks when the Builder
# plan shows pending changes or conflicts.
bun scripts/manifest-regen-check.ts || {
  echo ""
  echo "pre-push blocked: Builder output is stale or conflicted (see above)."
  exit 1
}

# The proof catalogs are generated from the manifests too. A manifest change
# pushed without them makes every release check fail later (2026-09-24).
bun run proof:emit >/dev/null 2>&1 && git diff --quiet -- generated/proof || {
  echo ""
  echo "pre-push blocked: generated/proof is stale. It was just regenerated: commit generated/proof and push again."
  exit 1
}
