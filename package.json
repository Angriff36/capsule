{
  "name": "capsule",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.4"
  },
  "scripts": {
    "agent:enter-recipe": "bun scripts/capsule-enter-recipe.ts",
    "agent:mcp": "bun scripts/capsule-mcp.ts",
    "agent:mint-jwt": "bun scripts/capsule-mint-agent-jwt.ts",
    "baseline:decay": "bun scripts/check-baseline-decay.ts",
    "build": "vite build",
    "check": "bun run toolchain && bun scripts/builder-regen-guard.ts --check-ownership && bun run proof:emit && bun run check:proof && bun run check:manifest-registry && bun run check:event-manifest && bun run check:culinary-manifest && bun run check:supply-manifest && bun run check:production-manifest && bun run check:workforce-manifest && bun run check:logistics-manifest && bun run check:commercial-manifest && bun run check:closeout-manifest && bun run check:payroll-manifest && bun run check:design-vocab && bun run typecheck && bun run format:check && bun run secrets && bun run test:coverage && bun run build && bun run baseline:decay",
    "check:closeout-manifest": "bun scripts/check-closeout-manifest-integration.ts",
    "check:commercial-manifest": "bun scripts/check-commercial-manifest-integration.ts",
    "check:culinary-manifest": "bun scripts/check-culinary-manifest-integration.ts",
    "check:design-vocab": "bun scripts/check-design-vocab.ts",
    "check:event-manifest": "bun scripts/check-event-manifest-integration.ts",
    "check:logistics-manifest": "bun scripts/check-logistics-manifest-integration.ts",
    "check:manifest-registry": "bun scripts/check-manifest-registry-pin.ts",
    "check:payroll-manifest": "bun scripts/check-payroll-manifest-integration.ts",
    "check:production-manifest": "bun scripts/check-production-manifest-integration.ts",
    "check:proof": "bun scripts/check-proof-registry.ts",
    "check:supply-manifest": "bun scripts/check-supply-manifest-integration.ts",
    "check:workforce-manifest": "bun scripts/check-workforce-manifest-integration.ts",
    "codegen": "convex codegen",
    "convex:env-set": "bun scripts/convex-env-set.ts",
    "deploy": "convex deploy",
    "dev": "vite",
    "dev:convex": "convex dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "manifest:build": "manifest build",
    "manifest:compile": "manifest compile --merge",
    "manifest:regen": "bun scripts/manifest-regen.ts",
    "manifest:regen:check": "bun scripts/manifest-regen-check.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "proof:emit": "bun scripts/emit-proof-kit.ts",
    "secrets": "bun scripts/check-secrets.ts",
    "seed": "bun scripts/seed-convex.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:proofs": "vitest run tests/proofs tests/proof-registry-gate.test.ts tests/supply-manifest-integration-guard.test.ts tests/production-manifest-integration-guard.test.ts tests/workforce-manifest-integration-guard.test.ts tests/logistics-manifest-integration-guard.test.ts tests/commercial-manifest-integration-guard.test.ts tests/closeout-manifest-integration-guard.test.ts tests/payroll-manifest-integration-guard.test.ts tests/finance-routes.test.ts",
    "toolchain": "bun scripts/check-toolchain.ts",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css,yml,yaml,html}": "prettier --write"
  },
  "dependencies": {
    "@angriff36/manifest": "3.6.45",
    "@clerk/backend": "^3.11.7",
    "@clerk/react": "^6.12.4",
    "@fontsource-variable/archivo": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "convex": "^1.27.0",
    "jspdf": "^4.2.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.0",
    "recharts": "^3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "3.2.7",
    "convex-test": "0.0.54",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.4"
  },
  "manifestPreset": {
    "id": "convex-application",
    "version": "1.3.5",
    "complete": true,
    "blockers": []
  }
}
