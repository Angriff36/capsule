{
  "name": "capsule",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.4"
  },
  "scripts": {
    "baseline:decay": "bun scripts/check-baseline-decay.ts",
    "build": "vite build",
    "check": "bun run toolchain && bun run check:event-manifest && bun run typecheck && bun run format:check && bun run secrets && bun run test:coverage && bun run build && bun run baseline:decay",
    "check:event-manifest": "bun scripts/check-event-manifest-integration.ts",
    "codegen": "convex codegen",
    "deploy": "convex deploy",
    "dev": "vite",
    "dev:convex": "convex dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "manifest:build": "manifest build",
    "manifest:compile": "manifest compile --merge",
    "prepare": "git config core.hooksPath .githooks",
    "secrets": "bun scripts/check-secrets.ts",
    "seed": "bun scripts/seed-convex.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "toolchain": "bun scripts/check-toolchain.ts",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css,yml,yaml,html}": "prettier --write"
  },
  "dependencies": {
    "@angriff36/manifest": "3.6.10",
    "@clerk/react": "^6.12.4",
    "@fontsource-variable/archivo": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "convex": "^1.27.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "3.2.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.4"
  },
  "manifestPreset": {
    "id": "convex-application",
    "version": "1.3.4",
    "complete": true,
    "blockers": []
  }
}
