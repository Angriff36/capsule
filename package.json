{
  "name": "capsule",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "bun": ">=1.3.4"
  },
  "scripts": {
    "agent:enter-component": "bun scripts/capsule-enter-component.ts",
    "agent:mcp": "bun scripts/capsule-mcp.ts",
    "agent:mint-jwt": "bun scripts/capsule-mint-agent-jwt.ts",
    "baseline:decay": "bun scripts/check-baseline-decay.ts",
    "build": "vite build",
    "build-storybook": "storybook build",
    "check": "bun run toolchain && bun scripts/builder-regen-guard.ts --check-ownership && bun run proof:emit && bun run check:proof && bun run check:manifest-registry && bun run check:manifest-breaking && bun run check:wiring-drift && bun run check:manifest-integration && bun run check:design-vocab && bun run typecheck && bun run format:check && bun run secrets && bun run test:coverage && bun run build && bun run baseline:decay",
    "check:design-vocab": "bun scripts/check-design-vocab.ts",
    "check:manifest-breaking": "bun scripts/check-manifest-breaking.ts",
    "check:manifest-integration": "bun scripts/check-manifest-integration.ts",
    "check:manifest-registry": "bun scripts/check-manifest-registry-pin.ts",
    "check:proof": "bun scripts/check-proof-registry.ts",
    "check:wiring-drift": "bun scripts/check-wiring-consumer-drift.ts",
    "codegen": "convex codegen",
    "convex:env-set": "bun scripts/convex-env-set.ts",
    "deploy": "convex deploy",
    "deploy:production": "bash scripts/vercel-build.sh",
    "dev": "vite",
    "dev:convex": "convex dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "manifest:build": "manifest build",
    "manifest:compile": "manifest compile --merge",
    "manifest:regen": "bun scripts/manifest-regen.ts",
    "manifest:regen:check": "bun scripts/manifest-regen-check.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "proof:emit": "bun scripts/emit-proof-kit.ts",
    "release:receipt": "bun scripts/release-receipt.ts",
    "secrets": "bun scripts/check-secrets.ts",
    "seed": "bun scripts/seed-convex.ts",
    "storybook": "storybook dev -p 6007 --no-open",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:proofs": "vitest run tests/proofs tests/proof-registry-gate.test.ts manifest-integration-guard tests/finance-routes.test.ts",
    "toolchain": "bun scripts/check-toolchain.ts",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css,yml,yaml,html}": "prettier --write"
  },
  "dependencies": {
    "@angriff36/manifest": "3.6.58",
    "@clerk/backend": "^3.11.7",
    "@clerk/react": "^6.14.5",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "convex": "^1.27.0",
    "jspdf": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "recharts": "^3.10.1",
    "web-push": "3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "3.2.7",
    "convex-test": "0.0.54",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "react-is": "^18.3.1",
    "semver": "^7.8.5",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vercel": "59.11.7",
    "vite": "^6.3.0",
    "vitest": "^3.2.4",
    "yaml": "2.9.0"
  },
  "manifestPreset": {
    "id": "convex-application",
    "version": "1.3.5",
    "complete": true,
    "blockers": []
  }
}
