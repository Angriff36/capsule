{
  "name": "capsule",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.4"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "dev:convex": "convex dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "secrets": "bun scripts/check-secrets.ts",
    "check": "bun run typecheck && bun run lint && bun run secrets && bun run test && bun run build",
    "codegen": "convex codegen",
    "seed": "bun scripts/seed-convex.ts",
    "deploy": "convex deploy"
  },
  "dependencies": {
    "@angriff36/manifest": "3.6.10",
    "@clerk/react": "^6.12.4",
    "@fontsource-variable/archivo": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "convex": "^1.27.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.4"
  },
  "manifestPreset": {
    "id": "convex-application",
    "version": "1.3.4",
    "complete": true,
    "blockers": []
  }
}
